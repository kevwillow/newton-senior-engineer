# read_cat: design 3.8 row cat; /etc/config files must be regular, not symlinks.
read_cat() {
	local p cfg
	[ "$#" -eq 2 ] || refuse arg-count 2
	p=$2
	case "$p" in
		/etc/openwrt_release|/tmp/dhcp.leases|/proc/uptime|/proc/loadavg|/proc/meminfo) ;;
		/etc/config/*)
			cfg=${p#/etc/config/}
			case "$cfg" in
				-*) refuse bad-arg 2 2 ;;
			esac
			is_cfg "$cfg" || refuse bad-arg 2 2
			[ -f "$R$p" ] || refuse bad-arg 2 2
			[ ! -L "$R$p" ] || refuse bad-arg 2 2
			;;
		*) refuse bad-arg 2 2 ;;
	esac
	read_run cat "$R$p"
}

