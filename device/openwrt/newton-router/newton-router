# read_uname: design 3.8 row uname; one token -[asnrvmpio]{1,9}.
read_uname() {
	[ "$#" -le 2 ] || refuse arg-count 2
	[ "$#" -eq 2 ] || { set -- "$UNAME"; read_run "$@"; return; }
	case "$2" in
		-[asnrvmpio]*) ;;
		*) refuse bad-arg 2 2 ;;
	esac
	case "${2#-}" in
		''|*[!asnrvmpio]*) refuse bad-arg 2 2 ;;
	esac
	[ "${#2}" -le 10 ] || refuse bad-arg 2 2
	set -- "$UNAME" "$2"
	read_run "$@"
}

# read_wifi: design 3.8 row wifi.
read_wifi() {
	[ "$#" -eq 2 ] || refuse arg-count 2
	case "$2" in
		status) ;;
		*) refuse bad-arg 2 2 ;;
	esac
	set -- "$WIFI" status
	read_run "$@"
}

# read_logread: design 3.8 row logread; -e and -l, each at most once, any order.
read_logread() {
	case "$#" in
		1) set -- "$LOGREAD" ;;
		3)
			case "$2" in
				-e)
					is_logpat "$3" || refuse bad-arg 2 3
					set -- "$LOGREAD" -e "$3"
					;;
				-l)
					is_lines "$3" || refuse bad-arg 2 3
					set -- "$LOGREAD" -l "$3"
					;;
				*) refuse bad-arg 2 2 ;;
			esac
			;;
		5)
			case "$2" in
				-e)
					case "$4" in
						-l) ;;
						*) refuse bad-arg 2 4 ;;
					esac
					is_logpat "$3" || refuse bad-arg 2 3
					is_lines "$5" || refuse bad-arg 2 5
					set -- "$LOGREAD" -e "$3" -l "$5"
					;;
				-l)
					case "$4" in
						-e) ;;
						*) refuse bad-arg 2 4 ;;
					esac
					is_lines "$3" || refuse bad-arg 2 3
					is_logpat "$5" || refuse bad-arg 2 5
					set -- "$LOGREAD" -l "$3" -e "$5"
					;;
				*) refuse bad-arg 2 2 ;;
			esac
			;;
		*) refuse arg-count 2 ;;
	esac
	read_run "$@"
}

# read_apk: design 3.8 row apk.
read_apk() {
	[ "$#" -ge 2 ] || refuse arg-count 2
	case "$2" in
		list) ;;
		info) ;;
		search) ;;
		*) refuse bad-arg 2 2 ;;
	esac
	case "$2" in
		list)
			case "$#" in
				2) set -- "$APK" list ;;
				3)
					case "$3" in
						-I|-u|-a) set -- "$APK" list "$3" ;;
						*)
							is_apkname "$3" || refuse bad-arg 2 3
							set -- "$APK" list "$3"
							;;
					esac
					;;
				4)
					case "$3" in
						-I|-u|-a) ;;
						*) refuse bad-arg 2 3 ;;
					esac
					is_apkname "$4" || refuse bad-arg 2 4
					set -- "$APK" list "$3" "$4"
					;;
				*) refuse arg-count 2 ;;
			esac
			;;
		info)
			case "$#" in
				3)
					is_apkname "$3" || refuse bad-arg 2 3
					set -- "$APK" info "$3"
					;;
				4)
					case "$3" in
						-L|-d|-s|-R|-r) ;;
						*) refuse bad-arg 2 3 ;;
					esac
					is_apkname "$4" || refuse bad-arg 2 4
					set -- "$APK" info "$3" "$4"
					;;
				*) refuse arg-count 2 ;;
			esac
			;;
		search)
			[ "$#" -eq 3 ] || refuse arg-count 2
			is_apkname "$3" || refuse bad-arg 2 3
			set -- "$APK" search "$3"
			;;
	esac
	read_run "$@"
}

# read_ping: design 3.8 row ping.
read_ping() {
	[ "$#" -eq 4 ] || refuse arg-count 2
	case "$2" in
		-c) ;;
		*) refuse bad-arg 2 2 ;;
	esac
	is_count "$3" || refuse bad-arg 2 3
	case "$4" in -*) refuse bad-arg 2 4 ;; esac
	is_host "$4" || refuse bad-arg 2 4
	set -- "$PING" -c "$3" -W 2 "$4"
	read_run "$@"
}

# read_traceroute: design 3.8 row traceroute.
read_traceroute() {
	[ "$#" -eq 2 ] || refuse arg-count 2
	case "$2" in -*) refuse bad-arg 2 2 ;; esac
	is_host "$2" || refuse bad-arg 2 2
	set -- "$TRACEROUTE" -m 10 -q 1 -w 2 "$2"
	read_run "$@"
}

# read_nslookup: design 3.8 row nslookup.
read_nslookup() {
	case "$#" in
		2|3) ;;
		*) refuse arg-count 2 ;;
	esac
	case "$2" in -*) refuse bad-arg 2 2 ;; esac
	is_host "$2" || refuse bad-arg 2 2
	if [ "$#" -eq 3 ]; then
		case "$3" in -*) refuse bad-arg 2 3 ;; esac
		is_host "$3" || refuse bad-arg 2 3
	fi
	shift
	set -- "$NSLOOKUP" "$@"
	read_run "$@"
}

# read_wifiscan: design P9 row wifiscan; the request 'read wifiscan radioN'
# runs one Wi-Fi scan with the router's own radio and prints the raw ubus
# JSON, unmodified. The radio name is the caller's word (radio[0-9]{1,2});
# the router resolves it to a phy with ubus and scans with that phy, so no
# netdev is needed and the scan works with the APs off. One scan per radio
# per 60 s; the gate is the stamp file $R/tmp/newton/ws.<radio> (see
# ws_gate_check).
#
# The order is fixed (design P9):
#   1. the radio -> phy resolution, BEFORE the program lock: the ubus call
#      is bounded 25 s and the lock is never held across a ubus call, so a
#      hung rpcd cannot block every change verb for the whole bound;
#   2. the program lock (fd 8), the uptime read INSIDE it (so the stamp is
#      not stale by the length of the lock wait), the rate-limit check and
#      the stamp write: one critical section, so two callers cannot both
#      pass the gate;
#   3. the lock released, then the scan: the stamp is the gate from then
#      on, so a scan never blocks a change.
read_wifiscan() {
	local radio phy json rc nbytes
	[ "$#" -eq 2 ] || refuse arg-count 2
	radio=$2
	case "$radio" in
		radio[0-9]|radio[0-9][0-9]) ;;
		*) refuse bad-arg 2 2 ;;
	esac
	json=$(printf '{"section":"%s"}' "$radio")
	ubus_capture "$UBUS" call iwinfo phyname "$json"
	rc=$?
	case "$rc" in
		0) ;;
		124) printf 'error read-timeout\n' >&2; return 124 ;;
		127) return 127 ;;
		*) refuse no-radio 2 ;;
	esac
	# ubus prints {"phyname": "phyN"} over three lines (measured on Pulsar,
	# 2026-10-24); take the value out of the compacted text and validate it.
	phy=$(printf '%s' "$UBUS_OUT" | tr -d ' \t\r\n')
	case "$phy" in
		'{"phyname":"phy'*'"}') ;;
		*) refuse no-radio 2 ;;
	esac
	phy=${phy#'{"phyname":"'}
	phy=${phy%'"}'}
	case "$phy" in
		phy[0-9]|phy[0-9][0-9]) ;;
		*) refuse no-radio 2 ;;
	esac
	lock_take 10
	uptime_stamp
	ws_gate_check "$radio" "$UP_STAMP"
	ws_stamp_write "$radio" "$UP_STAMP"
	exec 8>&-
	json=$(printf '{"device":"%s"}' "$phy")
	run_bounded 25 "$UBUS" call iwinfo scan "$json"
	rc=$?
	case "$rc" in
		0) ;;
		137|143)
			cat "$ERR" >&2
			printf 'error read-timeout\n' >&2
			return 124
			;;
		255)
			cat "$ERR" >&2
			return 125
			;;
	esac
	if [ "$rc" -ne 0 ]; then
		cat "$ERR" >&2
		return "$rc"
	fi
	nbytes=$(wc -c < "$OUT")
	if [ "$nbytes" -gt 131072 ]; then
		fail scan-too-large 1
	fi
	cat "$OUT"
	return 0
}

# cmd_read VERB ARGS...: design 3.5e; dispatch on the verb (3.8 table).
cmd_read() {
	case "$1" in
		uci) read_uci "$@" ;;
		ubus) read_ubus "$@" ;;
		ip) read_ip "$@" ;;
		ifstatus) read_ifstatus "$@" ;;
		fw4) read_fw4 "$@" ;;
		nft) read_nft "$@" ;;
		cat) read_cat "$@" ;;
		iwinfo) read_iwinfo "$@" ;;
		netstat) read_netstat "$@" ;;
		df) read_df "$@" ;;
		free) read_free "$@" ;;
		uptime) read_uptime "$@" ;;
		uname) read_uname "$@" ;;
		wifi) read_wifi "$@" ;;
		logread) read_logread "$@" ;;
		apk) read_apk "$@" ;;
		ping) read_ping "$@" ;;
		traceroute) read_traceroute "$@" ;;
		nslookup) read_nslookup "$@" ;;
		wifiscan) read_wifiscan "$@" ;;
		*) refuse bad-arg 2 1 ;;
	esac
}

# cmd_approval_selftest NONCE: direct-mode proof of the installed key
# (design 3.5f). The dispatcher has already enforced direct mode.
cmd_approval_selftest() {
	local nonce="$1" NL msg token
	approval_key_value || fail approval-key-missing 3
	NL='
'
	msg="newton-selftest-v1${NL}${nonce}${NL}"
	token=$(hmac "$KEY_HEX" "$msg")
	printf 'approval-selftest %s %s\n' "$nonce" "$token"
}

# ---- 8. main (design 3.1 step 6) ----

main() {
	local rc
	sweep_scratch
	compute_from
	detect_mode "$@"
	if [ "$FORCED" -eq 1 ]; then
		read_request
		IFS=' '
		# shellcheck disable=SC2086  # word splitting is the point (design 3.2 step 5)
		set -- $REQ_TOKENS
		unset IFS
	else
		check_argv_request "$@"
	fi
	handle "$@"
	rc=$?
	[ "$rc" -ne 255 ] || rc=1
	RC=$rc
	exit "$rc"
}

main "$@"
