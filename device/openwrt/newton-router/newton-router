# probe_sysctl_equals KEY TEXT: design 4.3 and 4.2. Each KEY part that starts
# @dev: or @l3dev: becomes the ifstatus device of that interface and must
# satisfy the IFACE class, else error.
probe_sysctl_equals() {
	local rest="$PB_1" part ifc jexpr dev key rc scratch v
	scratch=$(mktemp "$R/tmp/newton/pb.$PROG_PID.XXXXXX") || { PB_REASON=error; return 1; }
	SCRATCH="$SCRATCH $scratch"
	key=
	while :; do
		case "$rest" in
			*/*) part=${rest%%/*}; rest=${rest#*/} ;;
			*) part=$rest; rest= ;;
		esac
		case "$part" in
			@dev:*|@l3dev:*)
				case "$part" in
					@dev:*) ifc=${part#@dev:}; jexpr='@.device' ;;
					*) ifc=${part#@l3dev:}; jexpr='@.l3_device' ;;
				esac
				run_bounded 5 "$IFSTATUS" "$ifc"
				rc=$?
				if [ "$rc" -ne 0 ]; then
					if probe_killed "$rc"; then PB_REASON=timeout; else PB_REASON=error; fi
					return 1
				fi
				cat "$OUT" > "$scratch" || { PB_REASON=error; return 1; }
				run_bounded 5 "$JSONFILTER" -i "$scratch" -e "$jexpr"
				rc=$?
				if probe_killed "$rc"; then
					PB_REASON=timeout
					return 1
				fi
				if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
					PB_REASON=error
					return 1
				fi
				dev=
				IFS= read -r dev < "$OUT" || dev=
				is_iface "$dev" || { PB_REASON=error; return 1; }
				part=$dev
				;;
		esac
		if [ -n "$key" ]; then
			key="$key/$part"
		else
			key=$part
		fi
		[ -n "$rest" ] || break
	done
	[ -f "$R/proc/sys/net/$key" ] || { PB_REASON=error; return 1; }
	v=
	IFS= read -r v < "$R/proc/sys/net/$key" || :
	[ "$v" = "$PB_2" ] && return 0
	PB_REASON=mismatch
	return 1
}

# probe_ra_absent IFACE: design 4.3. The device is the l3_device of the
# interface (else its device); the ipv6ra answer must not name it.
probe_ra_absent() {
	local scratch dev rc
	run_bounded 5 "$IFSTATUS" "$PB_1"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if probe_killed "$rc"; then PB_REASON=timeout; else PB_REASON=error; fi
		return 1
	fi
	scratch=$(mktemp "$R/tmp/newton/pb.$PROG_PID.XXXXXX") || { PB_REASON=error; return 1; }
	SCRATCH="$SCRATCH $scratch"
	cat "$OUT" > "$scratch" || { PB_REASON=error; return 1; }
	run_bounded 5 "$JSONFILTER" -i "$scratch" -e '@.l3_device'
	rc=$?
	if probe_killed "$rc"; then
		PB_REASON=timeout
		return 1
	fi
	if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
		PB_REASON=error
		return 1
	fi
	dev=
	IFS= read -r dev < "$OUT" || dev=
	if [ -z "$dev" ]; then
		run_bounded 5 "$JSONFILTER" -i "$scratch" -e '@.device'
		rc=$?
		if probe_killed "$rc"; then
			PB_REASON=timeout
			return 1
		fi
		if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
			PB_REASON=error
			return 1
		fi
		dev=
		IFS= read -r dev < "$OUT" || dev=
	fi
	[ -n "$dev" ] || { PB_REASON=error; return 1; }
	run_bounded 5 "$UBUS" call dhcp ipv6ra
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if probe_killed "$rc"; then PB_REASON=timeout; else PB_REASON=error; fi
		return 1
	fi
	if grep -Fq "\"$dev\"" "$OUT"; then
		PB_REASON=present
		return 1
	fi
	return 0
}

# probe_root_password_class CLASS: design 4.3 and R31. Only the class word
# leaves this function; the shadow field itself is never printed or kept.
probe_root_password_class() {
	local cls rc
	# shellcheck disable=SC2016  # the awk program is fixed text (design 3.1)
	run_bounded 5 awk -F: '
		$1 == "root" {
			n++
			if (n == 1) {
				if ($2 == "") c = "EMPTY"
				else if (substr($2, 1, 1) == "*" || substr($2, 1, 1) == "!") c = "LOCKED"
				else c = "HASH"
			}
		}
		END {
			if (n == 0) print "NOROOT"
			else if (n > 1) print "MULTIROOT"
			else print c
		}
	' "$R/etc/shadow"
	rc=$?
	if probe_killed "$rc"; then
		PB_REASON=timeout
		return 1
	fi
	[ "$rc" -eq 0 ] || { PB_REASON=error; return 1; }
	cls=
	IFS= read -r cls < "$OUT" || cls=
	case "$cls" in
		EMPTY|LOCKED|HASH|NOROOT|MULTIROOT) ;;
		*) PB_REASON=error; return 1 ;;
	esac
	[ "$cls" = "$PB_1" ] && return 0
	PB_REASON="class=$cls"
	return 1
}

# probe_listen PROTO ADDR PORT PROG EXPECT: design 4.3. Field 1 must start
# with the protocol, field 4 splits at its last : into address and port, the
# program is the text after / in the last field. netstat output is never
# printed; only the row count matters.
probe_listen() {
	local flag rc
	case "$PB_1" in
		tcp) flag=-t ;;
		udp) flag=-u ;;
	esac
	run_bounded 5 "$NETSTAT" -lnp "$flag"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if probe_killed "$rc"; then PB_REASON=timeout; else PB_REASON=error; fi
		return 1
	fi
	probe_capture || return 1
	# shellcheck disable=SC2016  # the awk program is fixed text (design 3.1)
	run_bounded 5 awk -v proto="$PB_1" -v addr="$PB_2" -v port="$PB_3" -v want="$PB_4" '
		{
			if ($1 != proto && $1 != proto "6") next
			lf = $NF
			s = index(lf, "/")
			have = ""
			if (s > 0) have = substr(lf, s + 1)
			if (want != "any" && have != want) next
			f4 = $4
			c = 0
			j = 1
			while (j <= length(f4)) {
				if (substr(f4, j, 1) == ":") c = j
				j = j + 1
			}
			a = substr(f4, 1, c - 1)
			pn = substr(f4, c + 1)
			if (pn != port) next
			if (addr == "any") { cnt = cnt + 1; next }
			if (addr == "wildcard") {
				if (a == "0.0.0.0" || a == "::") cnt = cnt + 1
				next
			}
			if (a == addr) cnt = cnt + 1
		}
		END { print cnt + 0 }
	' "$PROBE_FILE"
	rc=$?
	if probe_killed "$rc"; then PB_REASON=timeout; return 1; fi
	[ "$rc" -eq 0 ] || { PB_REASON=error; return 1; }
	MATCH_COUNT=
	IFS= read -r MATCH_COUNT < "$OUT" || MATCH_COUNT=
	case "$MATCH_COUNT" in ''|*[!0-9]*) PB_REASON=error; return 1 ;; esac
	expect_ok "$PB_5" "$MATCH_COUNT"
}

# probe_nft_rule FAM TABLE CHAIN|ruleset EXPECT TEXT...: design 4.3; the
# count of matching lines of the listing (4.2) must meet EXPECT.
probe_nft_rule() {
	local rc
	nft_list "$PB_1" "$PB_2" "$PB_3"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if probe_killed "$rc"; then PB_REASON=timeout; else PB_REASON=error; fi
		return 1
	fi
	probe_capture || return 1
	match_count "$((PB_NARGS - 4))" "$PROBE_FILE" "${PB_5-}" "${PB_6-}" "${PB_7-}" "${PB_8-}" || return 1
	expect_ok "$PB_4" "$MATCH_COUNT"
}

# probe_nft_rule_order FAM TABLE CHAIN TEXT-A TEXT-B: design 4.3. Both TEXTs
# must be found (single fixed strings) and the first line holding A must come
# before the first line holding B.
probe_nft_rule_order() {
	local rc v
	nft_list "$PB_1" "$PB_2" "$PB_3"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if probe_killed "$rc"; then PB_REASON=timeout; else PB_REASON=error; fi
		return 1
	fi
	probe_capture || return 1
	# shellcheck disable=SC2016  # the awk program is fixed text (design 3.1)
	run_bounded 5 awk -v a="$PB_4" -v b="$PB_5" '
		{
			if (la == 0 && index($0, a) > 0) la = NR
			if (lb == 0 && index($0, b) > 0) lb = NR
		}
		END {
			if (la == 0 || lb == 0) print "absent"
			else if (la < lb) print "ok"
			else print "order"
		}
	' "$PROBE_FILE"
	rc=$?
	if probe_killed "$rc"; then PB_REASON=timeout; return 1; fi
	[ "$rc" -eq 0 ] || { PB_REASON=error; return 1; }
	v=
	IFS= read -r v < "$OUT" || v=
	case "$v" in
		ok) return 0 ;;
		absent) PB_REASON=absent ;;
		*) PB_REASON=order ;;
	esac
	return 1
}

# probe_nft_rule_near FAM TABLE CHAIN|ruleset TEXT-A NEAR TEXT-B: design
# 4.3. Some line i must hold A and a line in i to i+NEAR must hold B.
probe_nft_rule_near() {
	local rc v
	nft_list "$PB_1" "$PB_2" "$PB_3"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if probe_killed "$rc"; then PB_REASON=timeout; else PB_REASON=error; fi
		return 1
	fi
	probe_capture || return 1
	# shellcheck disable=SC2016  # the awk program is fixed text (design 3.1)
	run_bounded 5 awk -v a="$PB_4" -v near="$PB_5" -v b="$PB_6" '
		{
			if (win > 0) {
				if (index($0, b) > 0) { ok = 1; exit }
				win = win - 1
			}
			if (index($0, a) > 0) {
				if (index($0, b) > 0) { ok = 1; exit }
				win = near
			}
		}
		END {
			if (ok) print "ok"
			else print "not-near"
		}
	' "$PROBE_FILE"
	rc=$?
	if probe_killed "$rc"; then PB_REASON=timeout; return 1; fi
	[ "$rc" -eq 0 ] || { PB_REASON=error; return 1; }
	v=
	IFS= read -r v < "$OUT" || v=
	if [ "$v" = ok ]; then
		return 0
	fi
	PB_REASON=not-near
	return 1
}

# probe_nft_set_has FAM TABLE SET ELEMENT STATE: design 4.3. The element
# list is the text between the words elements = { and the closing brace,
# spaces and newlines removed, split on commas.
probe_nft_set_has() {
	local rc v found ncnt
	run_bounded 5 "$NFT" list set "$PB_1" "$PB_2" "$PB_3"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if probe_killed "$rc"; then PB_REASON=timeout; else PB_REASON=error; fi
		return 1
	fi
	probe_capture || return 1
	# shellcheck disable=SC2016  # the awk program is fixed text (design 3.1)
	run_bounded 5 awk -v elem="$PB_4" '
		{
			s = $0
			gsub(/[ \t\r]/, "", s)
			all = all s
		}
		END {
			found = 0
			ncnt = 0
			p = index(all, "elements={")
			if (p > 0) {
				s = substr(all, p + 10)
				q = index(s, "}")
				if (q > 0) {
					s = substr(s, 1, q - 1)
					n = split(s, el, ",")
					for (i = 1; i <= n; i++)
						if (el[i] != "") {
							ncnt = ncnt + 1
							if (el[i] == elem) found = 1
						}
				}
			}
			print found, ncnt
		}
	' "$PROBE_FILE"
	rc=$?
	if probe_killed "$rc"; then PB_REASON=timeout; return 1; fi
	[ "$rc" -eq 0 ] || { PB_REASON=error; return 1; }
	found=
	ncnt=
	IFS=' ' read -r found ncnt < "$OUT" || found=
	case "$found" in ''|*[!0-9]*) PB_REASON=error; return 1 ;; esac
	case "$ncnt" in ''|*[!0-9]*) PB_REASON=error; return 1 ;; esac
	case "$PB_5" in
		present)
			[ "$found" -eq 1 ] && return 0
			PB_REASON=absent
			;;
		absent)
			[ "$found" -eq 0 ] && return 0
			PB_REASON=present
			;;
		only)
			if [ "$found" -eq 1 ] && [ "$ncnt" -eq 1 ]; then return 0; fi
			PB_REASON=mismatch
			;;
	esac
	return 1
}

# probe_conf_has DNSSVC MODE EXPECT TEXT: design 4.3. The files are the -C
# arguments of the running dnsmasq pids (each must match the dnsmasq.conf
# path shape), else every matching name in /var/etc. The count of lines that
# equal, start with or contain TEXT must meet EXPECT.
probe_conf_has() {
	local rc pid a suf wantc name f files cs inputs hf
	files=
	cs=$(mktemp "$R/tmp/newton/pb.$PROG_PID.XXXXXX") || { PB_REASON=error; return 1; }
	SCRATCH="$SCRATCH $cs"
	run_bounded 5 "$PIDOF" "$PB_1"
	rc=$?
	if probe_killed "$rc"; then
		PB_REASON=timeout
		return 1
	fi
	if [ "$rc" -eq 0 ]; then
		# shellcheck disable=SC2086,SC2013  # pidof prints pids, words are the point
		for pid in $(cat "$OUT"); do
			case "$pid" in ''|*[!0-9]*) continue ;; esac
			[ -r "$R/proc/$pid/cmdline" ] || continue
			tr '\000' '\n' < "$R/proc/$pid/cmdline" > "$cs" 2>/dev/null || continue
			wantc=0
			while IFS= read -r a; do
				if [ "$wantc" -eq 1 ]; then
					wantc=0
					case "$a" in
						/var/etc/dnsmasq.conf.*|/tmp/etc/dnsmasq.conf.*)
							suf=${a#*/dnsmasq.conf.}
							case "$suf" in
								''|*[!A-Za-z0-9_.-]*) ;;
								*)
									case "$files" in
										*" $R$a") ;;
										*) [ "${#suf}" -le 64 ] && files="$files $R$a" ;;
									esac
									;;
							esac
							;;
					esac
				fi
				[ "$a" = -C ] && wantc=1
			done < "$cs"
		done
	fi
	if [ -z "$files" ]; then
		run_bounded 5 ls -1 "$R/var/etc"
		rc=$?
		if probe_killed "$rc"; then PB_REASON=timeout; return 1; fi
		[ "$rc" -eq 0 ] || { PB_REASON=error; return 1; }
		probe_capture || return 1
		while IFS= read -r name; do
			case "$name" in
				dnsmasq.conf.*)
					suf=${name#dnsmasq.conf.}
					case "$suf" in
						''|*[!A-Za-z0-9_.-]*) ;;
						*)
							case "$files" in
								*" $R/var/etc/$name") ;;
								*) [ "${#suf}" -le 64 ] && files="$files $R/var/etc/$name" ;;
							esac
							;;
					esac
					;;
			esac
		done < "$PROBE_FILE"
	fi
	[ -n "$files" ] || { PB_REASON=error; return 1; }
	# shellcheck disable=SC2086  # the listed paths carry no spaces
	set -- $files
	# the dnsmasq addn-hosts file at /tmp/hosts/dhcp.<SUF> (same SUF as the
	# conf file name) also carries the records the probe may be asked about
	# (e.g. dhcp domain -> name/ip lines); the file is optional, so a missing
	# or unreadable one is skipped, and the conf file stays mandatory.
	inputs=
	for f; do
		[ -r "$f" ] || { PB_REASON=error; return 1; }
		inputs="$inputs $f"
		suf=${f##*/dnsmasq.conf.}
		hf="$R/tmp/hosts/dhcp.$suf"
		[ -f "$hf" ] && [ -r "$hf" ] && inputs="$inputs $hf"
	done
	# shellcheck disable=SC2086  # the listed paths carry no spaces
	set -- $inputs
	# shellcheck disable=SC2016  # the awk program is fixed text (design 3.1)
	run_bounded 5 awk -v m="$PB_2" -v t="$PB_4" '
		{
			if (m == "line") hold = ($0 == t)
			else if (m == "prefix") hold = (substr($0, 1, length(t)) == t)
			else hold = (index($0, t) > 0)
			if (hold) cnt = cnt + 1
		}
		END { print cnt + 0 }
	' "$@"
	rc=$?
	if probe_killed "$rc"; then PB_REASON=timeout; return 1; fi
	[ "$rc" -eq 0 ] || { PB_REASON=error; return 1; }
	MATCH_COUNT=
	IFS= read -r MATCH_COUNT < "$OUT" || MATCH_COUNT=
	case "$MATCH_COUNT" in ''|*[!0-9]*) PB_REASON=error; return 1 ;; esac
	expect_ok "$PB_3" "$MATCH_COUNT"
}

# probe_dev_of @dev:IFACE | @l3dev:IFACE: design 4.2; the device of the
# interface in DEV_OUT; 1 with PB_REASON set on error.
probe_dev_of() {
	local ifc jexpr scratch rc dev
	case "$1" in
		@dev:*) ifc=${1#@dev:}; jexpr='@.device' ;;
		*) ifc=${1#@l3dev:}; jexpr='@.l3_device' ;;
	esac
	run_bounded 5 "$IFSTATUS" "$ifc"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if probe_killed "$rc"; then PB_REASON=timeout; else PB_REASON=error; fi
		return 1
	fi
	scratch=$(mktemp "$R/tmp/newton/pb.$PROG_PID.XXXXXX") || { PB_REASON=error; return 1; }
	SCRATCH="$SCRATCH $scratch"
	cat "$OUT" > "$scratch" || { PB_REASON=error; return 1; }
	run_bounded 5 "$JSONFILTER" -i "$scratch" -e "$jexpr"
	rc=$?
	if probe_killed "$rc"; then
		PB_REASON=timeout
		return 1
	fi
	if [ "$rc" -ne 0 ] && [ "$rc" -ne 1 ]; then
		PB_REASON=error
		return 1
	fi
	dev=
	IFS= read -r dev < "$OUT" || dev=
	is_iface "$dev" || { PB_REASON=error; return 1; }
	DEV_OUT=$dev
	return 0
}

# argv_elems_hold N E1 E2 E3 E4 FILE: 0 when some N consecutive argv
# elements equal E1..EN (design 4.3 proc-args); 2 on error.
argv_elems_hold() {
	local n="$1" e1="$2" e2="$3" e3="$4" e4="$5" file="$6" rc v
	# shellcheck disable=SC2016  # the awk program is fixed text (design 3.1)
	run_bounded 5 awk -v n="$n" -v e1="$e1" -v e2="$e2" -v e3="$e3" -v e4="$e4" '
		{ line[NR] = $0; nl = NR }
		END {
			ans = 0
			for (i = 1; i + n - 1 <= nl; i++) {
				good = 1
				for (j = 1; j <= n; j++) {
					v = e1
					if (j == 2) v = e2
					if (j == 3) v = e3
					if (j == 4) v = e4
					if (line[i + j - 1] != v) { good = 0; break }
				}
				if (good) { ans = 1; break }
			}
			print ans
		}
	' "$file"
	rc=$?
	if probe_killed "$rc"; then PB_REASON=timeout; return 2; fi
	[ "$rc" -eq 0 ] || { PB_REASON=error; return 2; }
	v=
	IFS= read -r v < "$OUT" || v=
	[ "$v" = 1 ]
}

# spec_hold SPEC FILE: 0 when one proc-args SPEC holds for the argv in FILE,
# 1 when not, 2 on error (design 4.3).
spec_hold() {
	local spec="$1" file="$2" text rest e n e1 e2 e3 e4
	case "$spec" in
		'~'*)
			text=${spec#\~}
			grep -Fq -e "$text" "$file"
			return
			;;
	esac
	e1=
	e2=
	e3=
	e4=
	n=0
	rest=$spec
	while :; do
		case "$rest" in
			*' '*) e=${rest%% *}; rest=${rest#* } ;;
			*) e=$rest; rest= ;;
		esac
		n=$((n + 1))
		case "$e" in
			@dev:*|@l3dev:*)
				probe_dev_of "$e" || return 2
				e=$DEV_OUT
				;;
		esac
		case $n in
			1) e1=$e ;;
			2) e2=$e ;;
			3) e3=$e ;;
			4) e4=$e ;;
		esac
		[ -n "$rest" ] || break
	done
	argv_elems_hold "$n" "$e1" "$e2" "$e3" "$e4" "$file"
	return
}

# probe_specs_hold FILE: 0 when every SPEC of the current probe line holds
# for the argv in FILE, 1 when one does not, 2 on error.
probe_specs_hold() {
	local file="$1" k spec negate rc
	PB_REASON=
	k=1
	while [ "$k" -lt "$PB_NARGS" ]; do
		k=$((k + 1))
		spec=
		case $k in
			2) spec=$PB_2 ;;
			3) spec=$PB_3 ;;
			4) spec=$PB_4 ;;
			5) spec=$PB_5 ;;
			6) spec=$PB_6 ;;
			7) spec=$PB_7 ;;
			8) spec=$PB_8 ;;
			9) spec=$PB_9 ;;
		esac
		negate=0
		case "$spec" in
			'!'*) negate=1; spec=${spec#!} ;;
		esac
		spec_hold "$spec" "$file"
		rc=$?
		if [ "$rc" -eq 2 ]; then
			return 2
		fi
		if [ "$rc" -eq 0 ]; then
			if [ "$negate" -eq 1 ]; then return 1; fi
		else
			if [ "$negate" -eq 0 ]; then return 1; fi
		fi
	done
	return 0
}

# probe_proc_args PROC SPEC...: design 4.3. Passes when at least one pid of
# PROC has an argv that satisfies every SPEC. A pid whose cmdline has
# vanished is skipped.
probe_proc_args() {
	local rc pid argvfile hold
	run_bounded 5 "$PIDOF" "$PB_1"
	rc=$?
	if probe_killed "$rc"; then
		PB_REASON=timeout
		return 1
	fi
	if [ "$rc" -ne 0 ] || [ ! -s "$OUT" ]; then
		PB_REASON=no-process
		return 1
	fi
	argvfile=$(mktemp "$R/tmp/newton/pb.$PROG_PID.XXXXXX") || { PB_REASON=error; return 1; }
	SCRATCH="$SCRATCH $argvfile"
	# shellcheck disable=SC2086,SC2013  # pidof prints pids, words are the point
	for pid in $(cat "$OUT"); do
		case "$pid" in ''|*[!0-9]*) continue ;; esac
		[ -r "$R/proc/$pid/cmdline" ] || continue
		tr '\000' '\n' < "$R/proc/$pid/cmdline" > "$argvfile" 2>/dev/null || continue
		probe_specs_hold "$argvfile"
		hold=$?
		if [ "$hold" -eq 0 ]; then
			return 0
		fi
		if [ "$hold" -eq 2 ]; then
			return 1
		fi
	done
	PB_REASON=mismatch
	return 1
}

# probe_log_has EXPECT TEXT...: design 4.3; the count of matching logread
# lines (4.2) must meet EXPECT.
probe_log_has() {
	local rc
	run_bounded 5 "$LOGREAD"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if probe_killed "$rc"; then PB_REASON=timeout; else PB_REASON=error; fi
		return 1
	fi
	probe_capture || return 1
	match_count "$((PB_NARGS - 1))" "$PROBE_FILE" "${PB_2-}" "${PB_3-}" "${PB_4-}" || return 1
	expect_ok "$PB_1" "$MATCH_COUNT"
}

# probe_run: dispatch on PB_NAME (design 3.5d); every probe returns 0 or 1
# with PB_REASON set to one of the 4.3 reason words.
probe_run() {
	PB_REASON=
	case "$PB_NAME" in
		fail) probe_fail ;;
		ping) probe_ping ;;
		resolve) probe_resolve ;;
		service-running) probe_service_running ;;
		uci-equals) probe_uci_equals ;;
		uci-unset) probe_uci_unset ;;
		listen) probe_listen ;;
		nft-rule) probe_nft_rule ;;
		nft-rule-order) probe_nft_rule_order ;;
		nft-rule-near) probe_nft_rule_near ;;
		nft-set-has) probe_nft_set_has ;;
		conf-has) probe_conf_has ;;
		proc-args) probe_proc_args ;;
		iface-field) probe_iface_field ;;
		iface-absent) probe_iface_absent ;;
		sysctl-equals) probe_sysctl_equals ;;
		ra-absent) probe_ra_absent ;;
		log-has) probe_log_has ;;
		root-password-class) probe_root_password_class ;;
		*) fail internal 1 not-built ;;
	esac
}

# cmd_probe: design 3.5d. Stdin is read bounded 30 s; the content must be
# exactly one probe line, which probe_check then validates. Router output is
# never printed; only the ok or fail line reaches stdout.
cmd_probe() {
	local line nbytes rc
	run_bounded_in 30 head -c 514
	rc=$?
	case "$rc" in
		0) ;;
		137|143) fail stdin-timeout 2 ;;
		*) fail internal 1 head ;;
	esac
	nbytes=$(wc -c < "$OUT")
	if [ "$nbytes" -gt 513 ]; then
		fail bad-probe 2 '1 too-long'
	fi
	if [ "$nbytes" -eq 0 ] || [ "$(wc -l < "$OUT")" -ne 1 ] || [ -n "$(tail -c 1 "$OUT")" ]; then
		fail bad-probe 2 '1 syntax'
	fi
	line=
	IFS= read -r line < "$OUT" || line=
	probe_check "$line" || fail bad-probe 2 "1 $PB_REASON"
	if [ "$PB_NAME" = root-password-class ] && [ "$ROLE" != change ]; then
		fail role 3
	fi
	probe_run
	rc=$?
	if [ "$rc" -eq 0 ]; then
		printf 'probe %s ok\n' "$PB_NAME"
		return 0
	fi
	printf 'probe %s fail %s\n' "$PB_NAME" "$PB_REASON"
	return 1
}

# read_run ARGV...: run a validated read command bounded 25 s, pass its stdout
# and stderr through, map its exit code (design 3.5e). If the underlying
# binary is not installed the shell would otherwise emit "line N: NAME: not
# found" (rc 127) or "line N: PATH: Permission denied" (rc 126), leaking the
# script path and line number. In production the first argument is a bare
# name (uci, iwinfo, ...) resolved through PATH; in test mode it is a
# $R/bin/<name> path, which command -v also resolves. The error line uses
# the basename, so a test-mode path never appears.
read_run() {
	local rc tool_path bare
	bare=${1##*/}
	tool_path=$(command -v -- "$1" 2>/dev/null) || tool_path=
	if [ -z "$tool_path" ]; then
		printf 'error tool-missing %s\n' "$bare" >&2
		return 127
	fi
	# A bare name (BusyBox applet) is always present; only a real path
	# needs the executable bit, which a non-install would also clear.
	case "$tool_path" in
		*/*) [ -x "$tool_path" ] || {
			printf 'error tool-missing %s\n' "$bare" >&2
			return 127
		} ;;
	esac
	run_bounded 25 "$@"
	rc=$?
	cat "$OUT"
	cat "$ERR" >&2
	case "$rc" in
		137|143)
			printf 'error read-timeout\n' >&2
			rc=124
			;;
		255) rc=125 ;;
	esac
	return "$rc"
}

# read_uci: design 3.8 row uci; positions count from 1 = the verb.
read_uci() {
	case "$#" in
		2)
			case "$2" in
				show|export|changes) set -- "$UCI" "$2" ;;
				*) refuse bad-arg 2 2 ;;
			esac
			;;
		3)
			case "$3" in
				-*) refuse bad-arg 2 3 ;;
			esac
			case "$2" in
			show)
				is_ucipath "$3" || is_cfg "$3" || refuse bad-arg 2 3
				set -- "$UCI" show "$3"
				;;
			export|changes)
				is_cfg "$3" || refuse bad-arg 2 3
				set -- "$UCI" "$2" "$3"
				;;
				get)
					is_ucipath "$3" || refuse bad-arg 2 3
					set -- "$UCI" get "$3"
					;;
				*) refuse bad-arg 2 2 ;;
			esac
			;;
		*) refuse arg-count 2 ;;
	esac
	read_run "$@"
}

# read_ubus: design 3.8 row ubus.
read_ubus() {
	local ifc
	case "$#" in
		2)
			case "$2" in
				list) set -- "$UBUS" list ;;
				*) refuse bad-arg 2 2 ;;
			esac
			;;
		3)
			case "$2" in
				list)
					is_obj "$3" || refuse bad-arg 2 3
					set -- "$UBUS" list "$3"
					;;
				*) refuse bad-arg 2 2 ;;
			esac
			;;
		4)
			case "$2" in
				call) ;;
				*) refuse bad-arg 2 2 ;;
			esac
			case "$3" in
				system)
					case "$4" in board|info) ;; *) refuse bad-arg 2 4 ;; esac
					;;
				network.interface)
					case "$4" in dump) ;; *) refuse bad-arg 2 4 ;; esac
					;;
				network.device|network.wireless)
					case "$4" in status) ;; *) refuse bad-arg 2 4 ;; esac
					;;
				network.interface.*)
					ifc=${3#network.interface.}
					is_iface "$ifc" || refuse bad-arg 2 3
					case "$4" in status) ;; *) refuse bad-arg 2 4 ;; esac
					;;
				*) refuse bad-arg 2 3 ;;
			esac
			set -- "$UBUS" call "$3" "$4"
			;;
		*) refuse arg-count 2 ;;
	esac
	read_run "$@"
}

# read_ip: the fix-read-ip grammar (design 3.8 row ip); options only before the
# OBJECT, full words only, each option and selector at most once.
read_ip() {
	local fam=0 sf=0 df=0 sfp=0 dfp=0 obj='' act='' dev='' tbl='' host='' ifc pos=1
	shift
	while [ $# -gt 0 ]; do
		case "$1" in
			-4) [ "$fam" -eq 0 ] || refuse bad-arg 2 "$((pos + 1))"
				fam=4 ;;
			-6) [ "$fam" -eq 0 ] || refuse bad-arg 2 "$((pos + 1))"
				fam=6 ;;
			-s) [ "$sf" -eq 0 ] || refuse bad-arg 2 "$((pos + 1))"
				sf=1
				sfp=$((pos + 1)) ;;
			-d) [ "$df" -eq 0 ] || refuse bad-arg 2 "$((pos + 1))"
				df=1
				dfp=$((pos + 1)) ;;
			*) break ;;
		esac
		shift
		pos=$((pos + 1))
	done
	[ $# -ge 1 ] || refuse arg-count 2
	pos=$((pos + 1))
	case "$1" in
		addr|address|route|link|neigh|rule) obj=$1 ;;
		*) refuse bad-arg 2 "$pos" ;;
	esac
	shift
	if [ "${1-}" = get ]; then
		[ "$obj" = route ] || refuse bad-arg 2 "$((pos + 1))"
		[ "$sf" -eq 0 ] || refuse bad-arg 2 "$sfp"
		[ "$df" -eq 0 ] || refuse bad-arg 2 "$dfp"
		shift
		[ $# -eq 1 ] || refuse arg-count 2
		case "$1" in -*) refuse bad-arg 2 "$((pos + 2))" ;; esac
		is_host "$1" || refuse bad-arg 2 "$((pos + 2))"
		host=$1
		set -- "$IP"
		[ "$fam" -eq 0 ] || set -- "$@" "-$fam"
		set -- "$@" route get "$host"
		read_run "$@"
		return
	fi
	if [ "${1-}" = show ] || [ "${1-}" = list ]; then
		act=$1
		shift
		pos=$((pos + 1))
	fi
	while [ $# -gt 0 ]; do
		case "$1" in
			dev)
				case "$obj" in addr|address|link|neigh|route) ;; *) refuse bad-arg 2 "$((pos + 1))" ;; esac
				[ -z "$dev" ] || refuse bad-arg 2 "$((pos + 1))"
				[ $# -ge 2 ] || refuse arg-count 2
				case "$2" in -*) refuse bad-arg 2 "$((pos + 2))" ;; esac
				is_iface "$2" || refuse bad-arg 2 "$((pos + 2))"
				dev=$2
				shift 2
				pos=$((pos + 2))
				;;
			table)
				case "$obj" in route|rule) ;; *) refuse bad-arg 2 "$((pos + 1))" ;; esac
				[ -z "$tbl" ] || refuse bad-arg 2 "$((pos + 1))"
				[ $# -ge 2 ] || refuse arg-count 2
				case "$2" in -*) refuse bad-arg 2 "$((pos + 2))" ;; esac
				is_table "$2" || refuse bad-arg 2 "$((pos + 2))"
				tbl=$2
				shift 2
				pos=$((pos + 2))
				;;
			*) refuse bad-arg 2 "$((pos + 1))" ;;
		esac
	done
	set -- "$IP"
	[ "$fam" -eq 0 ] || set -- "$@" "-$fam"
	[ "$sf" -eq 0 ] || set -- "$@" -s
	[ "$df" -eq 0 ] || set -- "$@" -d
	set -- "$@" "$obj"
	[ -n "$act" ] && set -- "$@" "$act"
	[ -n "$dev" ] && set -- "$@" dev "$dev"
	[ -n "$tbl" ] && set -- "$@" table "$tbl"
	read_run "$@"
}
# read_ifstatus: design 3.8 row ifstatus.
read_ifstatus() {
	[ "$#" -eq 2 ] || refuse arg-count 2
	is_iface "$2" || refuse bad-arg 2 2
	set -- "$IFSTATUS" "$2"
	read_run "$@"
}

# read_fw4: design 3.8 row fw4.
read_fw4() {
	[ "$#" -eq 2 ] || refuse arg-count 2
