# read_nft: design 3.8 row nft.
read_nft() {
	[ "$#" -ge 2 ] || refuse arg-count 2
	case "$2" in
		list) ;;
		*) refuse bad-arg 2 2 ;;
	esac
	case "$#" in
		3)
			case "$3" in
				ruleset|tables) ;;
				*) refuse bad-arg 2 3 ;;
			esac
			;;
		5)
			case "$3" in
