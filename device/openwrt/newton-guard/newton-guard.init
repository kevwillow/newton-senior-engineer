#!/bin/sh /etc/rc.common

# S09 restores before S10boot can inspect, alter, or snapshot UCI config.
# shellcheck disable=SC2034
START=09
# shellcheck disable=SC2034
USE_PROCD=1
GUARD=/usr/libexec/newton-guard

boot() {
	"$GUARD" boot
	start "$@"
}

start_service() {
	[ -f /etc/newton/pending ] || return 0
	[ ! -f /etc/newton/failed ] || return 0
	procd_open_instance timer
	procd_set_param command "$GUARD" timer
	procd_set_param respawn 3600 1 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
