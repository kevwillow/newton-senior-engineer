#!/bin/sh /etc/rc.common
# Newton WAN health-check procd service.

# shellcheck disable=SC2034
USE_PROCD=1
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10

start_service() {
    enabled="$(uci -q get newton_wanhealth.main.enabled)"
    [ "$enabled" = "1" ] || return 0
    procd_open_instance
    procd_set_param command /usr/libexec/newton/newton-wan-health run
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /usr/libexec/newton/newton-wan-health restore
}

service_triggers() {
    procd_add_reload_trigger newton_wanhealth
}
