#!/bin/sh
# Forced command for Newton's client checks on a vantage host.
#
# The original command is DATA: it is parsed with parameter expansion into
# one of five fixed shapes, and one of a fixed set of argv lists is then
# executed.  Nothing the caller sends is ever interpolated into a command
# string.
#
# The reply is exactly one stdout line:
#   RESULT <PASS|FAIL|NOTTESTED> <word>
# A grammar that is not in the closed set below is refused (rc 2) without
# running anything.
set -eu
set -f

# The replies of the tools are matched in English ("Connection refused"),
# so the locale is fixed here once and for all.
LC_ALL=C
export LC_ALL

PROGRAM=newton-vantage-check
ALLOW_FILE=${0%/*}/newton-vantage-check.allow

STATUS=
WORD=
ZONE_SRC=
ZONE_CANARY_IP=
ZONE_CANARY_PORT=
ZONE_IFACE=
ZONE_NETNS=
TARGETS=
PROBE_OUT=
PROBE_RC=0
DNS_OUT=
DHCP_OUT=
ZL_BAD=0
ZL_FOUND=0
ZL_NAMES=
ZL_TARGETS=
ZL_TARGET_COUNT=0
ZL_TARGET_NAMES=
PL_IFACE=
PL_NETNS=

refuse() {
	printf '%s: refused\n' "$PROGRAM" >&2
	exit 2
}

reply() {
	printf 'RESULT %s %s\n' "$1" "$2"
	exit 0
}

valid_octet() {
	case $1 in
		0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;;
		*) return 1 ;;
	esac
	if [ "$1" -gt 255 ]; then
		return 1
	fi
	return 0
}

valid_ipv4() {
	_o1=${1%%.*}
	_rest=${1#*.}
	if [ "$_rest" = "$1" ]; then
		return 1
	fi
	_o2=${_rest%%.*}
	_next=${_rest#*.}
	if [ "$_next" = "$_rest" ]; then
		return 1
	fi
	_rest=$_next
	_o3=${_rest%%.*}
	_o4=${_rest#*.}
	if [ "$_o4" = "$_rest" ]; then
		return 1
	fi
	case $_o4 in
		*.*) return 1 ;;
	esac
	valid_octet "$_o1" || return 1
	valid_octet "$_o2" || return 1
	valid_octet "$_o3" || return 1
	valid_octet "$_o4" || return 1
	return 0
}

valid_port() {
	case $1 in
		[1-9]|[1-9][0-9]|[1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9]) ;;
		*) return 1 ;;
	esac
	if [ "$1" -gt 65535 ]; then
		return 1
	fi
	return 0
}

valid_zone_name() {
	case $1 in
		''|[!a-z]*) return 1 ;;
	esac
	case $1 in
		*[!a-z0-9-]*) return 1 ;;
	esac
	if [ "${#1}" -gt 32 ]; then
		return 1
	fi
	return 0
}

valid_iface() {
	case $1 in
		''|[!A-Za-z0-9_]*) return 1 ;;
	esac
	case $1 in
		*[!A-Za-z0-9_.-]*) return 1 ;;
	esac
	if [ "${#1}" -gt 15 ]; then
		return 1
	fi
	return 0
}

valid_netns() {
	case $1 in
		''|[!a-z]*) return 1 ;;
	esac
	case $1 in
		*[!a-z0-9_-]*) return 1 ;;
	esac
	if [ "${#1}" -gt 32 ]; then
		return 1
	fi
	return 0
}

valid_cidr() {
	_base=${1%/*}
	_prefix=${1#*/}
	if [ "$_base" = "$1" ] || [ "$_prefix" = "$_base" ]; then
		return 1
	fi
	case $_prefix in
		8|9|[1-9][0-9]) ;;
		*) return 1 ;;
	esac
	if [ "$_prefix" -lt 8 ] || [ "$_prefix" -gt 32 ]; then
		return 1
	fi
	valid_ipv4 "$_base" || return 1
	return 0
}

# ip_in_cidr <ipv4> <cidr>: the address is inside the network.  The
# comparison is done octet by octet (and bit by bit inside the octet the
# prefix ends in), so no 32 bit overflow is possible in a small shell.
ip_in_cidr() {
	_ip=$1
	_base=${2%/*}
	_prefix=${2#*/}
	_b1=${_base%%.*}
	_b_rest=${_base#*.}
	_b2=${_b_rest%%.*}
	_b_rest=${_b_rest#*.}
	_b3=${_b_rest%%.*}
	_b4=${_b_rest#*.}
	_i1=${_ip%%.*}
	_i_rest=${_ip#*.}
	_i2=${_i_rest%%.*}
	_i_rest=${_i_rest#*.}
	_i3=${_i_rest%%.*}
	_i4=${_i_rest#*.}
	_full=$((_prefix / 8))
	_rem=$((_prefix % 8))
	case $_full in
		0) ;;
		1)
			[ "$_b1" = "$_i1" ] || return 1
			;;
		2)
			[ "$_b1" = "$_i1" ] || return 1
			[ "$_b2" = "$_i2" ] || return 1
			;;
		3)
			[ "$_b1" = "$_i1" ] || return 1
			[ "$_b2" = "$_i2" ] || return 1
			[ "$_b3" = "$_i3" ] || return 1
			;;
		4)
			[ "$_b1" = "$_i1" ] || return 1
			[ "$_b2" = "$_i2" ] || return 1
			[ "$_b3" = "$_i3" ] || return 1
			[ "$_b4" = "$_i4" ] || return 1
			;;
		*) return 1 ;;
	esac
	if [ "$_rem" -eq 0 ]; then
		return 0
	fi
	# The remainder of the prefix lives in the octet right after the
	# fully compared ones.
	case $_full in
		0) _bn=$_b1; _in=$_i1 ;;
		1) _bn=$_b2; _in=$_i2 ;;
		2) _bn=$_b3; _in=$_i3 ;;
		3) _bn=$_b4; _in=$_i4 ;;
		*) return 0 ;;
	esac
	_shift=$((8 - _rem))
	if [ $((_bn >> _shift)) -eq $((_in >> _shift)) ]; then
		return 0
	fi
	return 1
}

# run_in_zone <cmd...>: run the command where the zone's addresses live.
# A zone with a netns runs inside that netns; a zone without one runs in
# the current namespace.
run_in_zone() {
	if [ -n "$ZONE_NETNS" ]; then
		sudo -n ip netns exec "$ZONE_NETNS" "$@"
		return $?
	fi
	"$@"
}

# run_root_in_zone <cmd...>: the same, but as root (the DHCP probe needs
# a raw socket).
run_root_in_zone() {
	if [ -n "$ZONE_NETNS" ]; then
		sudo -n ip netns exec "$ZONE_NETNS" "$@"
		return $?
	fi
	sudo -n "$@"
}

# probe_tcp <ipv4> <port> <seconds>: one TCP connect attempt.  The exit
# status is the connect's, PROBE_OUT holds what bash said about it.
probe_tcp() {
	PROBE_OUT=$(run_in_zone timeout "$3" bash -c 'exec 3<>/dev/tcp/"$1"/"$2"' bash "$1" "$2" 2>&1) \
		&& PROBE_RC=0 || PROBE_RC=$?
	return "$PROBE_RC"
}

# zone_ready: the zone's src address is configured where the check runs.
# The address field is matched exactly: "10.0.0.1/24" is not satisfied by
# "110.0.0.1/24".
zone_ready() {
	ADDRS=$(run_in_zone ip -4 -o addr show 2>/dev/null) || ADDRS=
	case $ADDRS in
		*" $ZONE_SRC/"*) return 0 ;;
	esac
	return 1
}

# route_src_ok <ipv4>: the route to the address leaves through the zone's
# own source address.  A zone without a netns probes from the routing
# default otherwise, and the answer would be about the wrong address.
route_src_ok() {
	ROUTE_OUT=$(run_in_zone ip -4 route get "$1" 2>/dev/null) || return 1
	case $ROUTE_OUT in
		*" src $ZONE_SRC "*|*" src $ZONE_SRC") return 0 ;;
	esac
	return 1
}

parse_zone_line() {
	PL_IFACE=
	PL_NETNS=
	if [ "$#" -lt 7 ]; then
		return 1
	fi
	if [ "$1" != "zone" ]; then
		return 1
	fi
	if [ "$3" != "src" ] || [ "$5" != "canary" ]; then
		return 1
	fi
	valid_zone_name "$2" || return 1
	valid_ipv4 "$4" || return 1
	valid_ipv4 "$6" || return 1
	valid_port "$7" || return 1
	case $# in
		7)
			;;
		9)
			case $8 in
				iface)
					valid_iface "$9" || return 1
					PL_IFACE=$9
					;;
				netns)
					valid_netns "$9" || return 1
					PL_NETNS=$9
					;;
				*)
					return 1
					;;
			esac
			;;
		11)
			if [ "$8" != "iface" ] || [ "${10}" != "netns" ]; then
				return 1
			fi
			valid_iface "$9" || return 1
			valid_netns "${11}" || return 1
			PL_IFACE=$9
			PL_NETNS=${11}
			;;
		*)
			return 1
			;;
	esac
	return 0
}

name_seen() {
	for seen in $ZL_NAMES; do
		if [ "$seen" = "$1" ]; then
			return 0
		fi
	done
	return 1
}

target_seen() {
	for seen in $ZL_TARGET_NAMES; do
		if [ "$seen" = "$1" ]; then
			return 0
		fi
	done
	return 1
}

# load_allow_list: read the root-owned allow-list next to this script and
# take the requested zone out of it.  A missing file, a malformed line or
# an unknown zone is answered, never guessed.
load_allow_list() {
	if [ ! -f "$ALLOW_FILE" ] || [ ! -r "$ALLOW_FILE" ]; then
		reply NOTTESTED no-config
	fi
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in
			''|'#'*) continue ;;
		esac
		old_ifs=$IFS
		set -- $line
		if [ "$#" -eq 0 ]; then
			continue
		fi
		IFS=' '
		if [ "$line" != "$*" ]; then
			IFS=$old_ifs
			ZL_BAD=1
			continue
		fi
		IFS=$old_ifs
		case $1 in
			zone)
				if ! parse_zone_line "$@"; then
					ZL_BAD=1
					continue
				fi
				if name_seen "$2"; then
					ZL_BAD=1
					continue
				fi
				ZL_NAMES="${ZL_NAMES}$2
"
				if [ "$ZL_FOUND" = 0 ] && [ "$2" = "$ZONE" ]; then
					ZL_FOUND=1
					ZONE_SRC=$4
					ZONE_CANARY_IP=$6
					ZONE_CANARY_PORT=$7
					ZONE_IFACE=$PL_IFACE
					ZONE_NETNS=$PL_NETNS
				fi
				;;
			target)
				if [ "$#" -ne 2 ] || ! valid_cidr "$2" || target_seen "$2"; then
					ZL_BAD=1
					continue
				fi
				ZL_TARGET_COUNT=$((ZL_TARGET_COUNT + 1))
				if [ "$ZL_TARGET_COUNT" -gt 32 ]; then
					ZL_BAD=1
					continue
				fi
				ZL_TARGET_NAMES="${ZL_TARGET_NAMES}$2
"
				ZL_TARGETS="${ZL_TARGETS}$2
"
				;;
			*)
				ZL_BAD=1
				continue
				;;
		esac
	done <"$ALLOW_FILE"
	if [ "$ZL_BAD" = 1 ]; then
		reply NOTTESTED bad-config
	fi
	if [ "$ZL_FOUND" != 1 ]; then
		reply NOTTESTED unknown-zone
	fi
	TARGETS=$ZL_TARGETS
}

do_canary() {
	if ! route_src_ok "$ZONE_CANARY_IP"; then
		reply NOTTESTED wrong-zone
	fi
	if probe_tcp "$ZONE_CANARY_IP" "$ZONE_CANARY_PORT" 5; then
		STATUS=PASS
		WORD=reached
		return 0
	fi
	STATUS=NOTTESTED
	WORD=unreachable
	return 0
}

do_dns() {
	if ! command -v host >/dev/null 2>&1; then
		STATUS=NOTTESTED
		WORD=no-tool
		return 0
	fi
	DNS_OUT=$(run_in_zone host -W 4 openwrt.org "$ZONE_CANARY_IP" 2>&1) || DNS_OUT=
	case $DNS_OUT in
		*'has address'*)
			STATUS=PASS
			WORD=resolved
			;;
		*)
			STATUS=FAIL
			WORD=no-answer
			;;
	esac
	return 0
}

do_internet() {
	do_dns
	if [ "$STATUS" != PASS ]; then
		STATUS=FAIL
		WORD=no-internet
		return 0
	fi
	if ! route_src_ok 1.1.1.1; then
		reply NOTTESTED wrong-zone
	fi
	if probe_tcp 1.1.1.1 443 5; then
		STATUS=PASS
		WORD=online
		return 0
	fi
	if ! route_src_ok 9.9.9.9; then
		reply NOTTESTED wrong-zone
	fi
	if probe_tcp 9.9.9.9 443 5; then
		STATUS=PASS
		WORD=online
		return 0
	fi
	STATUS=FAIL
	WORD=no-internet
	return 0
}

# dhcp_probe: a raw socket DHCPDISCOVER.  The chaddr is random and no
# REQUEST is ever sent, so no lease is taken.
dhcp_probe() {
	run_root_in_zone python3 - "$ZONE_IFACE" "$ZONE_CANARY_IP" 12 <<'PYEOF'
import os, socket, struct, sys, time

IFACE, SERVER, WAIT = sys.argv[1], sys.argv[2], float(sys.argv[3])

def csum(b):
    s = sum(struct.unpack('!%dH' % (len(b) // 2), b))
    s = (s >> 16) + (s & 0xffff)
    s += s >> 16
    return ~s & 0xffff

def opts_of(buf):
    out, i = {}, 0
    while i < len(buf):
        c = buf[i]
        if c == 255:
            break
        if c == 0:
            i += 1
            continue
        out[c] = buf[i + 2:i + 2 + buf[i + 1]]
        i += 2 + buf[i + 1]
    return out

mac = bytes([0x02]) + os.urandom(5)
xid = struct.unpack('!I', os.urandom(4))[0]
nic = bytes.fromhex(open('/sys/class/net/' + IFACE + '/address').read().strip().replace(':', ''))
body = struct.pack('!BBBBIHH4s4s4s4s16s64s128s4s', 1, 1, 6, 0, xid, 0, 0x8000,
                   bytes(4), bytes(4), bytes(4), bytes(4), mac + bytes(10), bytes(64), bytes(128),
                   b'\x63\x82\x53\x63')
body += b'\x35\x01\x01' + b'\x3d\x07\x01' + mac + b'\x37\x05\x01\x03\x06\x0f\x33' + b'\xff'
body += bytes(max(0, 300 - len(body)))
udp = struct.pack('!HHHH', 68, 67, 8 + len(body), 0) + body
ip = struct.pack('!BBHHHBBH4s4s', 0x45, 0, 20 + len(udp), 0, 0, 64, 17, 0, bytes(4), b'\xff' * 4)
ip = ip[:10] + struct.pack('!H', csum(ip)) + ip[12:]
frame = b'\xff' * 6 + nic + b'\x08\x00' + ip + udp
s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.htons(0x0800))
s.bind((IFACE, 0))
t0 = time.time()
nxt = 0.0
while time.time() - t0 < WAIT:
    if time.time() - t0 >= nxt:
        s.send(frame)
        nxt += 4.0
    s.settimeout(0.5)
    try:
        pkt, info = s.recvfrom(4096)
    except socket.timeout:
        continue
    if info[2] == socket.PACKET_OUTGOING or len(pkt) < 14 + 20 + 8 + 240:
        continue
    ihl = (pkt[14] & 0x0f) * 4
    if pkt[14 + 9] != 17:
        continue
    sport, dport = struct.unpack('!HH', pkt[14 + ihl:14 + ihl + 4])
    d = pkt[14 + ihl + 8:]
    if sport != 67 or dport != 68 or len(d) < 240 or d[0] != 2:
        continue
    if struct.unpack('!I', d[4:8])[0] != xid or d[28:34] != mac or d[236:240] != b'\x63\x82\x53\x63':
        continue
    o = opts_of(d[240:])
    if o.get(53) != b'\x02':
        continue
    srv = socket.inet_ntoa(pkt[14 + 12:14 + 16])
    if srv != SERVER:
        continue
    print('newton-dhcp-offer: DHCPOFFER from %s yiaddr=%s after %.1fs (no REQUEST sent)'
          % (srv, socket.inet_ntoa(d[16:20]), time.time() - t0))
    sys.exit(0)
print('newton-dhcp-offer: no DHCPOFFER from %s on %s within %.0fs' % (SERVER, IFACE, WAIT))
sys.exit(1)
PYEOF
}

do_dhcp() {
	if [ -z "$ZONE_IFACE" ]; then
		STATUS=NOTTESTED
		WORD=no-iface
		return 0
	fi
	if ! command -v python3 >/dev/null 2>&1; then
		STATUS=NOTTESTED
		WORD=no-tool
		return 0
	fi
	DHCP_OUT=$(dhcp_probe 2>&1) || true
	case $DHCP_OUT in
		*'newton-dhcp-offer: DHCPOFFER'*)
			STATUS=PASS
			WORD=offer
			;;
		*)
			STATUS=FAIL
			WORD=no-offer
			;;
	esac
	return 0
}

do_blocked() {
	allowed=0
	if [ "$1" = 1.1.1.1 ] || [ "$1" = 9.9.9.9 ]; then
		allowed=1
	fi
	for target in $TARGETS; do
		if ip_in_cidr "$1" "$target"; then
			allowed=1
		fi
	done
	if [ "$allowed" != 1 ]; then
		STATUS=NOTTESTED
		WORD=not-allowed
		return 0
	fi
	case $2 in
		22|53|80|443)
			;;
		*)
			STATUS=NOTTESTED
			WORD=not-allowed
			return 0
			;;
	esac
	if ! route_src_ok "$1"; then
		reply NOTTESTED wrong-zone
	fi
	probe_tcp "$1" "$2" 6 || true
	case $PROBE_RC in
		0)
			STATUS=FAIL
			WORD=open
			;;
		124)
			STATUS=PASS
			WORD=timeout
			;;
		*)
			case $PROBE_OUT in
				*'Connection refused'*)
					STATUS=PASS
					WORD=refused
					;;
				*)
					STATUS=NOTTESTED
					WORD=unreachable
					;;
			esac
			;;
	esac
	return 0
}

# The original command is data.  Only the characters below may appear in
# it, and only the shapes below are commands.
command=${SSH_ORIGINAL_COMMAND-}
case $command in
	''|*[!A-Za-z0-9./\ -]*|' '*|*' '|*'  '*) refuse ;;
esac

verb=${command%% *}
rest=${command#* }
[ "$rest" != "$command" ] || refuse
ZONE=${rest%% *}
next=${rest#* }
[ "$next" != "$rest" ] || refuse
rest=$next
check=${rest%% *}

if [ "$verb" != check ]; then
	refuse
fi
valid_zone_name "$ZONE" || refuse

case $check in
	canary|dns|dhcp|internet)
		[ "$rest" = "$check" ] || refuse
		;;
	blocked)
		block_pair=${rest#* }
		[ "$block_pair" != "$rest" ] || refuse
		block_ip=${block_pair%% *}
		block_port=${block_pair#* }
		[ "$block_port" != "$block_pair" ] || refuse
		tail=${block_port#* }
		[ "$tail" = "$block_port" ] || refuse
		valid_ipv4 "$block_ip" || refuse
		valid_port "$block_port" || refuse
		;;
	*)
		refuse
		;;
esac

load_allow_list

# Every check first proves that the zone's address is configured where the
# check runs: a vantage that is not in the zone cannot answer for it.
if ! zone_ready; then
	reply NOTTESTED wrong-zone
fi

case $check in
	canary) do_canary ;;
	dns) do_dns ;;
	dhcp) do_dhcp ;;
	internet) do_internet ;;
	blocked) do_blocked "$block_ip" "$block_port" ;;
esac

reply "$STATUS" "$WORD"
