#!/usr/bin/env bash
#
# newton-router-setup -- administer the Newton router over ssh.
#
# usage:
#   newton-router-setup [--password-file FILE] [--admin plain-key|password] [--plain-key FILE] DEVICE ACTION [ARGS]
#   ACTION: check | install | approval-key [--passphrase-file FILE] | swap-key [--new-key] [LABEL] | add-key [--new-key] LABEL ROLE | revoke LABEL
#           | profile lab|prod | upgrade | rollback | uninstall | lab-snapshot [--new-key] [--labels L1,L2] [--gates-cmd CMD | --skip-gates]
#
# Notes on behaviour that the code alone does not explain:
# - Every admin call runs inside a command substitution, so the admin lane
#   captures ssh's stderr itself. The remote command carries a fixed marker
#   on its stderr: an exit 255 with the marker is the remote command's own
#   status, without it a connect or authentication failure. Every real
#   failure is recorded and printed once, as a FAIL line, before STOPPED.
# - install prints the block "What Newton puts on your router"
#   (router_disclosure_block, sizes measured from the sources it is about to
#   install) before the first ssh call, and the owner must type "yes"; any
#   other answer stops with "nothing was changed". The same text stands in
#   README.md, docs/INSTALL.md and SETUP.md. upgrade does not ask (it was
#   agreed when the mode was chosen); lab-snapshot prints it and asks
#   nothing (lab profile only, unattended).
# - approval-key offers the authenticator app (totp_offer) after the
#   passphrase is chosen, except when the passphrase came from a file, when
#   NEWTON_SKIP_TOTP_OFFER=1 (newton-enrol rotate) or when the device
#   already asks for a 6-digit code.
# - upgrade restarts an already-enabled WAN-health daemon only after the
#   changed files are verified, never starts a disabled one, and leaves an
#   unchanged daemon alone (its restart path can re-promote a WAN it had
#   marked dead). A per-device restart-pending marker makes a later upgrade
#   retry after a failed restart.
# - no-install sets up Newton's own limited rpcd user (one login section in
#   /etc/config/rpcd, a password that never leaves the host, pinned HTTPS);
#   uninstall tears it down. The group lists come from the newton-rpcd CLI,
#   so the router and Newton cannot drift apart. rpcd is never restarted:
#   a restart drops a pending rollback (measured), and a new login section
#   works at once (measured).

set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 2
DEFAULT_SRC=$(dirname -- "$SCRIPT_DIR")
DEFAULT_INVENTORY=/var/lib/newton/devices.toml
DEFAULT_KEYS_DIR=/var/lib/newton/keys
FIXED_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The key label a router is enrolled with: it names the role the restricted
# key plays (the agent that drives the router), not a host.
DEFAULT_LABEL='newton-agent'

# environment state, filled by init
SEAMS=0
RR=''
SRC=''
SLEEP=''
KEYS_DIR=''
INVENTORY=''
TMP_DIR=''
TRUSTED_KNOWN_HOSTS=''
# the no-install mode: the newton-rpcd CLI, the seam
# NEWTON_SETUP_RPCD points at another copy of it
RPCD=''

# command line state, filled by parse_args
DEVICE=''
ACTION=''
PASSWORD_FILE=''
ADMIN_OPT=''
PLAIN_KEY_OPT=''
ADMIN_MODE=''
PLAIN_KEY=''
LABEL=''
ROLE=''
NEW_KEY=0
PROFILE_VALUE=''
PASSPHRASE_FILE=''
LABELS=''
GATES_CMD=''
SKIP_GATES=0
LAB_LABELS=()

# inventory state, filled by load_inventory
DEV_HOST=''
DEV_PORT=22
DEV_AUTH=key
DEV_PROXY=''
DEV_PROFILE=prod
DEV_MGMT_IFACE=lan
DEV_MGMT_ZONE=lan
DEV_WAN_ZONES=wan
DEV_KEY_FILE=''
DEV_KNOWN_HOSTS=''
# the no-install mode: the access mode of the device, the
# rpcd credential file and the pinned certificate of a no-install device.
# https_host and https_port are the owner's own values; the setup never
# writes them.
DEV_PLATFORM='openwrt'
DEV_ACCESS='installed'
DEV_RPCD_PASSWORD_FILE=''
DEV_HTTPS_SPKI=''
DEV_HTTPS_HOST=''
DEV_HTTPS_PORT='443'
# the answer of the installed-mode offer:
# "declined" when the owner said no.  Empty means the owner was never
# asked (or never answered).
DEV_INSTALLED_OFFER=''

# the router state description printed just before every STOPPED line
STATE_NOTE='router unchanged'

# the owner script run: the plan id of the owner script the
# owner runs, and the --print flag (show the script and its hash, send
# nothing).
OWNER_SID=''
OWNER_PRINT=0

# The backtick, built without a literal one: the tool's static lint
# forbids a backtick in the code (there it is a command substitution), and
# the messages quote a command name with it.
BT=$(printf '\140')

# swap-key sub-step state (design 8.3): OLD_BLOB is the pub
# blob of PLAIN_KEY, NEW_BLOB the pub blob of KEYFILE (the new key for
# LABEL), NEW_LINE the restricted authorized_keys line, SWAP_APPENDED 1
# only when swap_stage_new_line appended NEW_LINE in this run.
OLD_BLOB=''
NEW_BLOB=''
NEW_LINE=''
SWAP_APPENDED=0

# set by refuse_if_busy: 1 when the guard status is exactly `idle` (0
# also when the guard is not installed), so the upgrade step can choose
# whether to also upload guard and init
GUARD_IDLE=0

# set by approval_key_run: 1 when this run wrote a new approve.key (not
# the `already set` path), so totp_offer can tell a stale TOTP record
APPROVAL_KEY_CHANGED=0

# set by forward_admin_start: the pid of the password fifo writer (when
# ADMIN_MODE is not plain-key) and the fifo path; forward_ssh_stop reaps
# the writer and removes the fifo for a clean password-lane forward end.
FWD_WRITER=0
FWD_FIFO=''

# the admin lane's login failure: ADMIN_FAIL_FILE holds the run's
# record of the real admin-login failures (one line each, in the order
# they happened; a later successful call never truncates it), ADMIN_MARKER
# is the fixed marker the admin lane writes to the remote stderr, and
# SSH_ERR_FILE is the file the lane writes ssh's stderr into (empty = the
# stderr passes through to the caller).  The record lives in a file and not
# in a variable because every admin call runs inside a command
# substitution, where a variable would not reach the parent shell.
ADMIN_FAIL_FILE=''
ADMIN_MARKER='NEWTON-ADMIN-SESSION'
SSH_ERR_FILE=''
SSH_ERR_TAIL=''

# Contract: print_usage -- no arguments; prints the usage text on stdout.
print_usage() {
	cat <<'EOF'
newton-router-setup [--password-file FILE] [--admin plain-key|password] [--plain-key FILE] DEVICE ACTION [ARGS]
ACTION: check | install | no-install | offer-installed | approval-key [--passphrase-file FILE] | swap-key [--new-key] [LABEL] | add-key [--new-key] LABEL ROLE | revoke LABEL
        | profile lab|prod | upgrade | rollback | uninstall | lab-snapshot [--new-key] [--labels L1,L2] [--gates-cmd CMD | --skip-gates]
        | owner-run SID [--print] | owner-finish SID
EOF
}

# Contract: usage_error TEXT -- prints "error: TEXT" and the usage text on
# stderr, exit 2.
usage_error() {
	printf 'error: %s\n' "$*" >&2
	print_usage >&2
	exit 2
}

# Contract: cleanup -- the EXIT trap; kills every background job this shell
# started and removes TMP_DIR; stdout: nothing.
cleanup() {
	local pid
	# jobs -p prints one pid per word, so the expansion must word-split
	for pid in $(jobs -p); do
		kill "$pid" 2>/dev/null || true
	done
	case "${OWNER_SCRIPT_SENT:-}" in
		0)
			# The owner script was never sent to the router: the approval
			# is settled as "not reached" (the token did not reach the
			# router) and the start of the run is cleared, so the plan may
			# be aborted.
			owner_finish_run '' no >/dev/null 2>&1 || true
			;;
		1)
			# The script was sent and the read-back did not run: the
			# approval is spent (the token may have reached the router)
			# and the read-back says what the router did with the
			# change.  The finish is marked as done, so it never runs
			# twice.
			OWNER_SCRIPT_SENT=2
			owner_finish_run '' yes >/dev/null 2>&1 || true
			;;
	esac
	if [[ -n "${TMP_DIR:-}" ]]; then
		rm -rf -- "$TMP_DIR"
	fi
}

# Contract: seam_gate -- no arguments; exit 2 with
# "error: NEWTON_SETUP_* variables need NEWTON_SETUP_SEAMS=1" on stderr when a
# NEWTON_SETUP_* variable other than the marker is set without
# NEWTON_SETUP_SEAMS=1; with the marker the seam values are shape-checked
# (seam_value_gate) and then "note: test seams active" is printed as the
# first stderr line and SEAMS=1 is set.
seam_gate() {
	local name found=0
	# the prefix expansion must word-split into variable names
	for name in ${!NEWTON_SETUP_@}; do
		[[ "$name" == "NEWTON_SETUP_SEAMS" ]] && continue
		found=1
	done
	if [[ $found -eq 1 && "${NEWTON_SETUP_SEAMS:-}" != "1" ]]; then
		printf '%s\n' 'error: NEWTON_SETUP_* variables need NEWTON_SETUP_SEAMS=1' >&2
		exit 2
	fi
	if [[ "${NEWTON_SETUP_SEAMS:-}" == "1" ]]; then
		# the values are checked before the note: a refused value never
		# runs with the seams active
		seam_value_gate
		printf '%s\n' 'note: test seams active' >&2
		SEAMS=1
	fi
}

# Contract: seam_value_gate -- no arguments; the seam values that leave
# the host are shape-checked before anything uses them:
# NEWTON_SETUP_REMOTE_ROOT is interpolated into shell text that runs on
# the router (as root, over the admin ssh lane), so it must be empty or match
# ^[A-Za-z0-9_./-]*$; NEWTON_SETUP_BIN is prepended to PATH, so it must
# be empty or an absolute path without a colon (a colon would add PATH
# entries) and without a newline (PATH entries are newline separated);
# NEWTON_SETUP_RPCD is the newton-rpcd program the no-install mode runs,
# so it must be empty or an absolute path without a colon or a newline.
# A bad value prints "error: ..." on stderr and exits 2; exit 0 otherwise.
seam_value_gate() {
	local rr="${NEWTON_SETUP_REMOTE_ROOT:-}" bin="${NEWTON_SETUP_BIN:-}"
	local rpcd="${NEWTON_SETUP_RPCD:-}"
	local answer_timeout="${NEWTON_SETUP_ANSWER_TIMEOUT:-}"
	# the shape checks run under LC_ALL=C so the ranges match ASCII only
	if [[ -n $rr ]] && ! ( LC_ALL=C; [[ $rr =~ ^[A-Za-z0-9_./-]*$ ]] ); then
		printf '%s\n' 'error: NEWTON_SETUP_REMOTE_ROOT must be empty or match [A-Za-z0-9_./-]' >&2
		exit 2
	fi
	if [[ -n "$bin" ]]; then
		if [[ "$bin" != /* || "$bin" == *:* || "$bin" == *$'\n'* ]]; then
			printf '%s\n' 'error: NEWTON_SETUP_BIN must be an absolute path without a colon or a newline' >&2
			exit 2
		fi
	fi
	if [[ -n "$rpcd" ]]; then
		if [[ "$rpcd" != /* || "$rpcd" == *:* || "$rpcd" == *$'\n'* ]]; then
			printf '%s\n' 'error: NEWTON_SETUP_RPCD must be an absolute path without a colon or a newline' >&2
			exit 2
		fi
	fi
	# the answer timeout is the number of seconds a question waits before
	# it gives up: a whole number of seconds, and never more than the
	# production value of 300
	if [[ -n "$answer_timeout" ]]; then
		if [[ ! "$answer_timeout" =~ ^[0-9]+$ ]] || [[ "$answer_timeout" -lt 1 ]] \
			|| [[ "$answer_timeout" -gt 300 ]]; then
			printf '%s\n' 'error: NEWTON_SETUP_ANSWER_TIMEOUT must be a whole number of seconds between 1 and 300' >&2
			exit 2
		fi
	fi
}

# Contract: home_dir -- prints the non-empty home directory of the running
# user read from getent passwd (not $HOME); a failed lookup or empty home
# dies with exit 2.
home_dir() {
	local entry home user
	user=$(id -un)
	entry=$(getent passwd "$user" 2>/dev/null) \
		|| die "cannot find the home directory of $user"
	home=$(printf '%s\n' "$entry" | cut -d: -f6)
	[[ -n "$home" ]] || die "cannot find the home directory of $user"
	printf '%s\n' "$home"
}

# Contract: state_dir -- prints the host-side state directory the setup
# tool and approve.py share: NEWTON_STATE_DIR when it is set, else
# `<home>/.local/state/newton` (the home of the running user); the
# trailing slash is dropped; returns non-zero when the fallback home
# directory cannot be read (home_dir dies with exit 2).
state_dir() {
	if [[ -n "${NEWTON_STATE_DIR:-}" ]]; then
		printf '%s\n' "${NEWTON_STATE_DIR%/}"
		return 0
	fi
	local home
	home=$(home_dir) || return 1
	printf '%s\n' "${home%/}/.local/state/newton"
}

# Contract: init -- no arguments; runs the seam gate, fixes PATH (the BIN seam
# first), LC_ALL=C, umask 077, unsets BASH_ENV ENV CDPATH, sets RR SRC SLEEP
# KEYS_DIR INVENTORY TRUSTED_KNOWN_HOSTS, opens the typed-input seam once in
# the parent shell, creates the private temp dir and installs the EXIT trap;
# stdout: nothing; exit 2 on a bad seam use, an unreadable typed-input file
# or when the temp dir cannot be made.
init() {
	seam_gate
	PATH="$FIXED_PATH"
	if [[ $SEAMS -eq 1 && -n "${NEWTON_SETUP_BIN:-}" ]]; then
		PATH="${NEWTON_SETUP_BIN}:${PATH}"
	fi
	export PATH
	LC_ALL=C
	export LC_ALL
	umask 077
	unset BASH_ENV ENV CDPATH
	INVENTORY="${NEWTON_INVENTORY:-$DEFAULT_INVENTORY}"
	KEYS_DIR="${NEWTON_KEYS_DIR:-$DEFAULT_KEYS_DIR}"
	if [[ $SEAMS -eq 1 ]]; then
		SRC="${NEWTON_SETUP_SRC:-$DEFAULT_SRC}"
		SLEEP="${NEWTON_SETUP_SLEEP:-sleep}"
		RR="${NEWTON_SETUP_REMOTE_ROOT:-}"
		if [[ -n "${NEWTON_SETUP_TTY:-}" ]]; then
			# One open file description is inherited by every subshell, so all
			# prompts advance the same stream offset.
			if ! exec {TTY_FD}<"$NEWTON_SETUP_TTY"; then
				die "cannot read the typed-input file"
			fi
		fi
	else
		SRC="$DEFAULT_SRC"
		SLEEP='sleep'
		RR=''
	fi
	# the newton-rpcd CLI of the no-install mode: the installed layout
	# (<code root>/venv/bin/newton-rpcd) or the seam, so a test or a repo
	# checkout can point at another copy
	if [[ $SEAMS -eq 1 && -n "${NEWTON_SETUP_RPCD:-}" ]]; then
		RPCD="$NEWTON_SETUP_RPCD"
	else
		RPCD="${SRC}/venv/bin/newton-rpcd"
	fi
	if [[ -n "${NEWTON_TRUSTED_KNOWN_HOSTS:-}" ]]; then
		TRUSTED_KNOWN_HOSTS="$NEWTON_TRUSTED_KNOWN_HOSTS"
	else
		TRUSTED_KNOWN_HOSTS=$(home_dir) || exit 2
		TRUSTED_KNOWN_HOSTS="${TRUSTED_KNOWN_HOSTS}/.ssh/known_hosts"
	fi
	TMP_DIR=$(mktemp -d) || die 'cannot create a private temp dir'
	ADMIN_FAIL_FILE="${TMP_DIR}/admin-login-fail"
	trap cleanup EXIT
}

# Contract: pass TEXT... -- prints "PASS TEXT" on stdout; exit status 0.
pass() {
	printf 'PASS %s\n' "$*"
}

# Contract: fail TEXT... -- prints "FAIL TEXT" on stdout; exit status 0.
fail() {
	printf 'FAIL %s\n' "$*"
}

# Contract: info TEXT... -- prints "INFO TEXT" on stdout; exit status 0.
info() {
	printf 'INFO %s\n' "$*"
}

# Contract: note TEXT... -- prints "NOTE TEXT" on stdout; exit status 0.
note() {
	printf 'NOTE %s\n' "$*"
}

# Contract: warn TEXT... -- prints "WARN TEXT" on stdout; exit status 0.
warn() {
	printf 'WARN %s\n' "$*"
}

# Contract: die TEXT... -- prints "error: TEXT" on stderr, exit 2.  The
# recorded admin-login failures are printed first: they explain
# the error.
die() {
	report_admin_login_failure
	printf 'error: %s\n' "$*" >&2
	exit 2
}

# Contract: stopped REASON -- prints "NOTE state: $STATE_NOTE" and then
# "STOPPED ACTION DEVICE: REASON" on stdout, exit 1.  The recorded
# admin-login failures are printed before both, so the owner reads
# why the admin call failed before the stop.
stopped() {
	report_admin_login_failure
	printf 'NOTE state: %s\n' "${STATE_NOTE:-router unchanged}"
	printf 'STOPPED %s %s: %s\n' "$ACTION" "$DEVICE" "$1"
	exit 1
}

# Contract: done_line -- no arguments; prints "DONE ACTION DEVICE" on stdout.
done_line() {
	printf 'DONE %s %s\n' "$ACTION" "$DEVICE"
}

# Contract: escape_text TEXT -- prints TEXT with every byte outside
# 0x20-0x7e as \xNN, cut to 200 bytes with a "...[truncated]" marker;
# pure bash, byte semantics via LC_ALL=C.  The untrusted text (ssh's own
# words) is never a format string.  The same helper as the one in
# scripts/newton-doctor.
escape_text() {
	local input=$1 out='' suffix='' ch
	local -i i len code
	local LC_ALL=C
	if (( ${#input} > 200 )); then
		input=${input:0:200}
		suffix='...[truncated]'
	fi
	len=${#input}
	for ((i = 0; i < len; i++)); do
		ch=${input:i:1}
		printf -v code '%d' "'$ch"
		if (( code >= 32 && code <= 126 )); then
			out+=$ch
		else
			printf -v ch '\\x'"%02x" "$((code & 255))"
			out+=$ch
		fi
	done
	printf '%s%s\n' "$out" "$suffix"
}

# Contract: valid_owner_sid SID -- exit 0 when SID is 32 lowercase
# hexadecimal characters (the plan id of an owner script), else exit 1.
valid_owner_sid() {
	[[ "$1" =~ ^[0-9a-f]{32}$ ]]
}

# Contract: valid_device NAME -- exit 0 when NAME matches
# ^[a-z][a-z0-9-]{0,31}$, else exit 1.
valid_device() {
	[[ "$1" =~ ^[a-z][a-z0-9-]{0,31}$ ]]
}

# Contract: valid_label LABEL -- exit 0 when LABEL matches
# ^[a-z][a-z0-9-]{1,31}$, else exit 1.
valid_label() {
	[[ "$1" =~ ^[a-z][a-z0-9-]{1,31}$ ]]
}

# Contract: valid_role ROLE -- exit 0 when ROLE is change or read, else
# exit 1.
valid_role() {
	[[ "$1" == "change" || "$1" == "read" ]]
}

# Contract: valid_hex STRING -- exit 0 when STRING is a non-empty lowercase
# hex string, else exit 1.
valid_hex() {
	[[ "$1" =~ ^[0-9a-f]+$ ]]
}

# Contract: valid_host HOST -- exit 0 when HOST matches
# ^[A-Za-z0-9._:-]+$, else exit 1.
valid_host() {
	[[ "$1" =~ ^[A-Za-z0-9._:-]+$ ]]
}

# Contract: valid_zone NAME -- exit 0 when NAME matches
# ^[A-Za-z0-9_-]{1,32}$, else exit 1.
valid_zone() {
	[[ "$1" =~ ^[A-Za-z0-9_-]{1,32}$ ]]
}

# Contract: valid_path_chars PATH -- exit 0 when every character of PATH is
# in [A-Za-z0-9_./-] and PATH is non-empty, else exit 1.
valid_path_chars() {
	[[ "$1" =~ ^[A-Za-z0-9_./-]+$ ]]
}

# Contract: parse_args "$@" -- reads the global options before DEVICE, then
# DEVICE, ACTION and the action arguments; sets DEVICE ACTION LABEL ROLE
# NEW_KEY PROFILE_VALUE PASSPHRASE_FILE LABELS GATES_CMD SKIP_GATES
# PASSWORD_FILE ADMIN_OPT PLAIN_KEY_OPT; stdout: the usage text on
# -h/--help (exit 0);
# exit 2 with "error: ..." plus the usage on stderr for a missing or unknown
# option, a missing or unknown action, a wrong argument count or a bad
# device, label or role value.
parse_args() {
	NEW_KEY=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-h|--help)
				print_usage
				exit 0
				;;
			--password-file)
				[[ $# -ge 2 ]] || usage_error "option $1 needs a value"
				PASSWORD_FILE="$2"
				shift 2
				;;
			--admin)
				[[ $# -ge 2 ]] || usage_error "option $1 needs a value"
				[[ "$2" == "plain-key" || "$2" == "password" ]] || usage_error "--admin must be plain-key or password"
				ADMIN_OPT="$2"
				shift 2
				;;
			--plain-key)
				[[ $# -ge 2 ]] || usage_error "option $1 needs a value"
				PLAIN_KEY_OPT="$2"
				shift 2
				;;
			--)
				shift
				break
				;;
			-*)
				usage_error "unknown option: $1"
				;;
			*)
				break
				;;
		esac
	done
	[[ $# -ge 1 ]] || usage_error "missing DEVICE and ACTION"
	DEVICE="$1"
	valid_device "$DEVICE" || usage_error "bad device: $DEVICE"
	shift
	[[ $# -ge 1 ]] || usage_error "missing ACTION for $DEVICE"
	ACTION="$1"
	shift
	case "$ACTION" in
		check|install|no-install|offer-installed|upgrade|rollback|uninstall)
			[[ $# -eq 0 ]] || usage_error "$ACTION takes no arguments"
			;;
		approval-key)
			while [[ $# -gt 0 ]]; do
				case "$1" in
					--passphrase-file)
						[[ $# -ge 2 ]] || usage_error "option $1 needs a value"
						PASSPHRASE_FILE="$2"
						shift 2
						;;
					*)
						usage_error "unknown argument for approval-key: $1"
						;;
				esac
			done
			;;
		swap-key)
			LABEL=''
			while [[ $# -gt 0 ]]; do
				case "$1" in
					--new-key)
						NEW_KEY=1
						shift
						;;
					-*)
						usage_error "unknown argument for swap-key: $1"
						;;
					*)
						[[ -z "$LABEL" ]] || usage_error "swap-key takes at most one LABEL"
						LABEL="$1"
						shift
						;;
				esac
			done
			LABEL="${LABEL:-$DEFAULT_LABEL}"
			valid_label "$LABEL" || usage_error "bad label: $LABEL"
			;;
		add-key)
			LABEL=''
			ROLE=''
			while [[ $# -gt 0 ]]; do
				case "$1" in
					--new-key)
						NEW_KEY=1
						shift
						;;
					-*)
						usage_error "unknown argument for add-key: $1"
						;;
					*)
						if [[ -z "$LABEL" ]]; then
							LABEL="$1"
						elif [[ -z "$ROLE" ]]; then
							ROLE="$1"
						else
							usage_error "add-key takes LABEL ROLE"
						fi
						shift
						;;
				esac
			done
			[[ -n "$LABEL" && -n "$ROLE" ]] \
				|| usage_error "add-key takes LABEL ROLE"
			valid_label "$LABEL" || usage_error "bad label: $LABEL"
			valid_role "$ROLE" || usage_error "bad role: $ROLE (change or read)"
			;;
		revoke)
			[[ $# -eq 1 ]] || usage_error "revoke takes LABEL"
			LABEL="$1"
			valid_label "$LABEL" || usage_error "bad label: $LABEL"
			;;
		profile)
			[[ $# -eq 1 ]] || usage_error "profile takes lab or prod"
			[[ "$1" == "lab" || "$1" == "prod" ]] || usage_error "profile takes lab or prod"
			PROFILE_VALUE="$1"
			;;
		lab-snapshot)
			parse_lab_snapshot_args "$@"
			;;
		owner-run)
			OWNER_SID=''
			OWNER_PRINT=0
			while [[ $# -gt 0 ]]; do
				case "$1" in
					--print)
						OWNER_PRINT=1
						shift
						;;
					-*)
						usage_error "unknown argument for owner-run: $1"
						;;
					*)
						[[ -z "$OWNER_SID" ]] || usage_error "owner-run takes one plan id"
						OWNER_SID="$1"
						shift
						;;
				esac
			done
			[[ -n "$OWNER_SID" ]] || usage_error "owner-run needs the plan id"
			valid_owner_sid "$OWNER_SID" || usage_error "bad plan id: $OWNER_SID"
			;;
		owner-finish)
			[[ $# -eq 1 ]] || usage_error "owner-finish takes the plan id"
			OWNER_SID="$1"
			valid_owner_sid "$OWNER_SID" || usage_error "bad plan id: $OWNER_SID"
			;;
		*)
			usage_error "unknown action: $ACTION"
			;;
	esac
}

# Contract: parse_lab_snapshot_args "$@" -- the arguments after
# lab-snapshot; sets LABELS GATES_CMD SKIP_GATES NEW_KEY (LABELS defaults
# to "$DEFAULT_LABEL,lab-runner", exactly one of --gates-cmd/--skip-gates
# is required); exit 2 with the usage on stderr on any violation.
parse_lab_snapshot_args() {
	local labels item
	LABELS="$DEFAULT_LABEL,lab-runner"
	GATES_CMD=''
	SKIP_GATES=0
	NEW_KEY=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--new-key)
				NEW_KEY=1
				shift
				;;
			--labels)
				[[ $# -ge 2 ]] || usage_error "option $1 needs a value"
				LABELS="$2"
				shift 2
				;;
			--gates-cmd)
				[[ $# -ge 2 ]] || usage_error "option $1 needs a value"
				GATES_CMD="$2"
				shift 2
				;;
			--skip-gates)
				SKIP_GATES=1
				shift
				;;
			*)
				usage_error "unknown argument for lab-snapshot: $1"
				;;
		esac
	done
	[[ -z "$GATES_CMD" && $SKIP_GATES -eq 0 ]] && usage_error "lab-snapshot needs --gates-cmd CMD or --skip-gates"
	[[ -n "$GATES_CMD" && $SKIP_GATES -eq 1 ]] && usage_error "--gates-cmd and --skip-gates are mutually exclusive"
	labels="$LABELS"
	local IFS=','
	# the expansion must word-split on the commas
	for item in $labels; do
		valid_label "$item" || usage_error "bad label: $item"
	done
}

# Contract: load_inventory DEVICE -- runs the embedded python3 tomllib reader
# on $INVENTORY and fills DEV_HOST DEV_PORT DEV_AUTH DEV_PROXY DEV_PROFILE
# DEV_MGMT_IFACE DEV_MGMT_ZONE DEV_WAN_ZONES DEV_KEY_FILE DEV_KNOWN_HOSTS
# DEV_PLATFORM DEV_ACCESS DEV_RPCD_PASSWORD_FILE DEV_HTTPS_SPKI
# DEV_HTTPS_HOST DEV_HTTPS_PORT;
# every value is validated in python before it is printed, bash reads the
# key=value lines with read -r; exit 2 (python prints "error: ..." on stderr)
# on an unreadable inventory, an unknown device or a bad value.
load_inventory() {
	local device="$1"
	local out line key val
	if ! out=$(python3 - "$INVENTORY" "$device" <<'PYEOF'
import os
import re
import stat
import sys
import tomllib

inv, dev = sys.argv[1], sys.argv[2]

def err(msg):
    print("error: " + msg, file=sys.stderr)
    sys.exit(2)

# Same checks as mcp/newton_mcp/inventory_file.py, with the same wording, so
# an operator sees one set of messages.  A missing file is not a refusal here:
# the read below keeps its own "cannot read inventory" message.
try:
    info = os.lstat(inv)
except FileNotFoundError:
    info = None
except OSError as exc:
    err("inventory file cannot be inspected: {}".format(exc.strerror))

if info is not None:
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        err("inventory file must be a regular file, not a symlink")
    if stat.S_IMODE(info.st_mode) & 0o022:
        err("inventory file must not be group- or world-writable (run: chmod go-w {})".format(inv))
    if info.st_uid != os.geteuid():
        err("inventory file must be owned by the user running the MCP server")

try:
    with open(inv, "rb") as fh:
        data = tomllib.load(fh)
except Exception as exc:
    err("cannot read inventory {}: {}".format(inv, exc))

devices = data.get("devices", {})
if not isinstance(devices, dict) or dev not in devices:
    err("unknown device: {}".format(dev))
entry = devices[dev]
if not isinstance(entry, dict):
    err("device {} is not a table".format(dev))

host = entry.get("host")
if not isinstance(host, str) or not re.fullmatch(r"[A-Za-z0-9._:-]+", host):
    err("bad host for {}".format(dev))

port = entry.get("port", 22)
if isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535:
    err("bad port for {}".format(dev))

user = entry.get("user", "root")
if user != "root":
    err("user must be root for {}".format(dev))

auth = entry.get("auth", "key")
if auth not in ("key", "password"):
    err("bad auth for {}".format(dev))

proxy = entry.get("proxy_command", "")
if not isinstance(proxy, str) or "\n" in proxy or "\r" in proxy:
    err("bad proxy_command for {}".format(dev))
# Same allowlist as newton_mcp.adapters.ssh_cli.PROXY_COMMAND_RE: the value
# reaches ssh as -o ProxyCommand=<value>, so anything a shell could act on is
# refused.
if proxy and not re.fullmatch(r"[A-Za-z0-9 _./:@%~=,+-]{1,512}", proxy):
    err("bad proxy_command for {}".format(dev))

profile = entry.get("profile", "prod")
if profile not in ("lab", "prod"):
    err("bad profile for {}".format(dev))

zone_re = re.compile(r"[A-Za-z0-9_-]{1,32}")

def zone(value, what):
    if not isinstance(value, str) or not zone_re.fullmatch(value):
        err("bad {} for {}".format(what, dev))
    return value

mgmt_iface = zone(entry.get("mgmt_interface", "lan"), "mgmt_interface")
mgmt_zone = zone(entry.get("mgmt_zone", "lan"), "mgmt_zone")
wan = entry.get("wan_zones", ["wan"])
if not isinstance(wan, list) or not 1 <= len(wan) <= 4:
    err("bad wan_zones for {}".format(dev))
wan = [zone(item, "wan zone") for item in wan]

path_re = re.compile(r"[A-Za-z0-9_./-]+")

def pathval(name):
    value = entry.get(name, "")
    if not isinstance(value, str) or (value and not path_re.fullmatch(value)):
        err("bad {} for {}".format(name, dev))
    return value

key_file = pathval("key_file")
known_hosts = pathval("known_hosts")

# the no-install mode: the access mode of the device, the
# rpcd credential file and the pinned certificate.  The same values the
# MCP server reads (server.py), with the same rules: an access mode that
# is neither installed nor no-install is refused, and the pin must be the
# base64 sha256 of a 32-byte digest.
#
# The platform is NOT refused here: this tool only knows OpenWrt, so a
# platform it does not know is reported as it is and the no-install
# action refuses it (the shared inventory cases ask for exactly this:
# the setup loader accepts what the MCP loader refuses).
platform = entry.get("platform", "openwrt")
if not isinstance(platform, str):
    platform = ""

access = entry.get("access", "installed")
if access not in ("installed", "no-install"):
    err("bad access for {}".format(dev))

# the answer of the installed-mode offer: the field belongs
# to a no-install device and holds one value, "declined".  Anything else
# is refused the way a bad access is refused: the offer is the owner's
# own answer and nothing else may be written in its place.
installed_offer = entry.get("installed_offer", "")
if "installed_offer" in entry:
    if not isinstance(installed_offer, str) or installed_offer != "declined":
        err("bad installed_offer for {}".format(dev))
    if access != "no-install":
        err("bad installed_offer for {}".format(dev))
    # The field is an OpenWrt field: the MCP loader refuses an access
    # mode on any other platform, so a no-install device is an OpenWrt
    # device and the offer of the installed mode belongs to one.
    if platform != "openwrt":
        err("bad installed_offer for {}".format(dev))

rpcd_password_file = pathval("rpcd_password_file")

https_spki = entry.get("https_spki", "")
if not isinstance(https_spki, str) or (https_spki and not re.fullmatch(r"[A-Za-z0-9+/]{43}=", https_spki)):
    err("bad https_spki for {}".format(dev))

https_host = entry.get("https_host", "")
if not isinstance(https_host, str) or (https_host and not re.fullmatch(r"[A-Za-z0-9._:-]+", https_host)):
    err("bad https_host for {}".format(dev))

https_port = entry.get("https_port", 443)
if isinstance(https_port, bool) or not isinstance(https_port, int) or not 1 <= https_port <= 65535:
    err("bad https_port for {}".format(dev))

print("host=" + host)
print("port={}".format(port))
print("auth=" + auth)
print("proxy=" + proxy)
print("profile=" + profile)
print("mgmt_iface=" + mgmt_iface)
print("mgmt_zone=" + mgmt_zone)
print("wan_zones=" + ",".join(wan))
print("key_file=" + key_file)
print("known_hosts=" + known_hosts)
print("platform=" + platform)
print("access=" + access)
print("installed_offer=" + installed_offer)
print("rpcd_password_file=" + rpcd_password_file)
print("https_spki=" + https_spki)
print("https_host=" + https_host)
print("https_port={}".format(https_port))
PYEOF
); then
		exit 2
	fi
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		key="${line%%=*}"
		val="${line#*=}"
		case "$key" in
			host) DEV_HOST="$val" ;;
			port) DEV_PORT="$val" ;;
			auth) DEV_AUTH="$val" ;;
			proxy) DEV_PROXY="$val" ;;
			profile) DEV_PROFILE="$val" ;;
			mgmt_iface) DEV_MGMT_IFACE="$val" ;;
			mgmt_zone) DEV_MGMT_ZONE="$val" ;;
			wan_zones) DEV_WAN_ZONES="$val" ;;
			key_file) DEV_KEY_FILE="$val" ;;
			known_hosts) DEV_KNOWN_HOSTS="$val" ;;
			platform) DEV_PLATFORM="$val" ;;
			access) DEV_ACCESS="$val" ;;
			installed_offer) DEV_INSTALLED_OFFER="$val" ;;
			rpcd_password_file) DEV_RPCD_PASSWORD_FILE="$val" ;;
			https_spki) DEV_HTTPS_SPKI="$val" ;;
			https_host) DEV_HTTPS_HOST="$val" ;;
			https_port) DEV_HTTPS_PORT="$val" ;;
		esac
	done <<< "$out"
}

# Contract: known_hosts_file -- no arguments; prints the known_hosts path for
# DEVICE on stdout (the inventory known_hosts, else
# KEYS_DIR/DEVICE.known_hosts).
known_hosts_file() {
	if [[ -n "$DEV_KNOWN_HOSTS" ]]; then
		printf '%s\n' "$DEV_KNOWN_HOSTS"
	else
		printf '%s\n' "${KEYS_DIR}/${DEVICE}.known_hosts"
	fi
}

# Contract: require_known_hosts -- no arguments; exit 2 with
# "error: no known_hosts for DEVICE; run check first" on stderr when the
# known_hosts file is missing or empty, else exit 0.
require_known_hosts() {
	local kh
	kh=$(known_hosts_file)
	if [[ ! -s "$kh" ]]; then
		die "no known_hosts for ${DEVICE}; run check first"
	fi
}

# Contract: choose_admin_path -- no arguments; sets ADMIN_MODE (plain-key or
# password) and PLAIN_KEY; --admin wins, else --password-file or inventory
# auth = "password", else an inventory key_file, else (for the `no-install`
# action and for a device whose inventory says access = no-install, unless
# --plain-key is given) the root password, else the plain key
# (--plain-key FILE, default <home>/.ssh/id_ed25519); --password-file is
# allowed only on a lab profile and must be mode 0600; when ACTION is
# `swap-key` the admin path must be the plain key: --admin password or
# --password-file with swap-key dies with `swap-key needs the plain-key
# admin path`, and otherwise ADMIN_MODE is forced to plain-key even when
# the inventory has key_file or auth = "password" (a second swap-key run
# after the swap must still find the plain key; the plain key file is
# checked like for any plain-key run); exit 2 on any violation,
# including a missing plain key file (the error names --plain-key).
choose_admin_path() {
	local home mode
	if [[ -n "$PASSWORD_FILE" ]]; then
		valid_path_chars "$PASSWORD_FILE" || die "--password-file: bad characters in path: $PASSWORD_FILE"
		[[ "$DEV_PROFILE" == "lab" ]] || die "--password-file is allowed only when the inventory profile is lab"
		[[ -f "$PASSWORD_FILE" ]] || die "--password-file: no such file: $PASSWORD_FILE"
		mode=$(stat -c '%a' -- "$PASSWORD_FILE")
		[[ "$mode" == "600" ]] || die "--password-file must have mode 0600 (got $mode)"
	fi
	ADMIN_MODE=''
	PLAIN_KEY=''
	if [[ "$ACTION" == "swap-key" ]]; then
		# swap-key must use the plain-key admin path: a second run
		# after the swap will need the plain key, and the inventory
		# may already have key_file (and even auth = "password") from
		# the first run, so the ordinary rules would pick the wrong
		# path; force plain-key here, and reject the explicit
		# password-path options
		if [[ -n "$ADMIN_OPT" && "$ADMIN_OPT" != "plain-key" ]]; then
			die "swap-key needs the plain-key admin path"
		fi
		if [[ -n "$PASSWORD_FILE" ]]; then
			die "swap-key needs the plain-key admin path"
		fi
		ADMIN_MODE='plain-key'
	elif [[ -n "$ADMIN_OPT" ]]; then
		ADMIN_MODE="$ADMIN_OPT"
	elif [[ -n "$PASSWORD_FILE" || "$DEV_AUTH" == "password" ]]; then
		ADMIN_MODE='password'
	elif [[ -n "$DEV_KEY_FILE" ]]; then
		ADMIN_MODE='password'
	elif [[ -z "$PLAIN_KEY_OPT" && ( "$ACTION" == "no-install" || "$DEV_ACCESS" == "no-install" ) ]]; then
		# the no-install mode leaves no Newton key on the router and
		# Newton never removes a key, so the root-capable plain key is
		# not the default there: the root password is
		ADMIN_MODE='password'
	else
		ADMIN_MODE='plain-key'
	fi
	if [[ "$ADMIN_MODE" == "plain-key" ]]; then
		if [[ -n "$PLAIN_KEY_OPT" ]]; then
			valid_path_chars "$PLAIN_KEY_OPT" || die "--plain-key: bad characters in path: $PLAIN_KEY_OPT"
			PLAIN_KEY="$PLAIN_KEY_OPT"
		else
			home=$(home_dir) || exit 2
			PLAIN_KEY="${home}/.ssh/id_ed25519"
		fi
		[[ -f "$PLAIN_KEY" ]] || die "--plain-key: file not found: $PLAIN_KEY"
	fi
}

# Contract: refuse_no_install_action -- no arguments; called by main
# right after load_inventory and before choose_admin_path: a no-install
# device stops (router unchanged) for every action that writes Newton's
# files or keys or runs the install: the two modes never mix (install
# and upgrade refuse here and again in their own action, which is the
# second line).  The refusal comes before the admin path is chosen, so
# it is the refusal the owner reads on a host that has no plain key
# (and with --admin password or --password-file): the no-install mode
# is answered, not a key or a password file.
#
# The approval-key is NOT on the list:
# on a no-install device the approval key is host-only work -- the
# passphrase and the fingerprint on this host, nothing on the router --
# so it is allowed there.
refuse_no_install_action() {
	if [[ "$DEV_ACCESS" == "no-install" ]]; then
		case "$ACTION" in
			profile|swap-key|add-key|revoke|rollback|lab-snapshot|install|upgrade)
				STATE_NOTE='router unchanged'
				stopped "this device uses no-install access; run ${BT}uninstall${BT} first"
				;;
		esac
	fi
}

# Contract: validate_action_args -- no arguments; called by main right
# after choose_admin_path and before require_known_hosts and the password
# prefetch: approval-key with --passphrase-file dies (exit 2) unless the
# inventory profile is lab and the file is readable; lab-snapshot runs
# its config preflight; every other action: nothing.  The no-install
# refusal is not here: it runs before the admin path is chosen (see
# refuse_no_install_action).
validate_action_args() {
	case "$ACTION" in
		owner-run|owner-finish)
			# An owner script is for a router Newton cannot manage:
			# a device with installed access is not one.
			if [[ "$DEV_ACCESS" != "no-install" ]]; then
				STATE_NOTE='router unchanged'
				stopped "an owner script is for a no-install router; this device uses installed access"
			fi
			;;
	esac
	case "$ACTION" in
		approval-key)
			if [[ -n "$PASSPHRASE_FILE" ]]; then
				[[ "$DEV_PROFILE" == "lab" ]] \
					|| die "--passphrase-file is allowed only when the inventory profile is lab"
				[[ -r "$PASSPHRASE_FILE" ]] \
					|| die "cannot read --passphrase-file: $PASSPHRASE_FILE"
			fi
			;;
		lab-snapshot)
			lab_snapshot_config_preflight
			;;
	esac
}

# Contract: password_only_proof -- calls admin_password_get in the current
# shell (so ROOT_PW_DONE blocks a second fetch later in the same action),
# then `rsh_pw true </dev/null`; prints exactly "PASS password-only login
# works" or "FAIL password-only login failed" (the same line action_check
# prints today) and returns 0 or 1; pure router side: no stdout from ssh
# reaches the caller.
password_only_proof() {
	local rc=0
	admin_password_get
	if rsh_pw true </dev/null; then
		pass "password-only login works"
	else
		fail "password-only login failed"
		rc=1
	fi
	return "$rc"
}

# Contract: restricted_key_check -- the two restricted-key proofs the
# doctor's F2 router-line check (design 7.2 row newton-doctor) needs on every device that has an installed restricted
# key: proof_hello and proof_unknown_and_empty. The proofs run over the
# restricted-key lane (rsh_key/hello_key; stdin /dev/null) and print
# their own PASS/FAIL lines, so the doctor's grep -Fxq finds the two
# whole lines it requires for PASS:
#   PASS proof hello: restricted identity
#   PASS proof unknown-and-empty: rejected
#
# The key file is the one the inventory's `key_file` entry names for
# this device (DEV_KEY_FILE, set by load_inventory from the toml); the
# label is derived from the basename (by convention the file lives at
# ${KEYS_DIR}/${DEVICE}-<label>, the path keypair_path hands out, the
# same path add-key / swap-key / lab-snapshot reference); the role is `change`, the canonical agent
# role every restricted-key path in the tool installs (add-key's
# default, swap-key's restricted_line, lab-snapshot's prove_restricted_key
# calls: see lines 1409, 1937, 3837).
#
# Read-only: every call here is a hello or an id/empty call against the
# router program, never anything that writes; no secret reaches argv,
# any file or the environment of anything but those short ssh calls.
#
# Failure modes:
#   - DEV_KEY_FILE empty: nothing was installed yet; print one WARN
#     line and return 0 so the doctor stays INCONCLUSIVE (absence of a
#     proof is not a violation);
#   - DEV_KEY_FILE set but the file is absent on the host: same WARN
#     skip behaviour (rc=0; no proof lines);
#   - DEV_KEY_FILE set, file present, but its name does not start with
#     "${DEVICE}-" or the derived label fails valid_label: WARN skip;
#   - file present and valid: run proof_hello and proof_unknown_and_empty.
#     A failing proof leaves rc=1 so the caller can route the FAIL
#     through its stopped line.
restricted_key_check() {
	local label rc=0
	if [[ -z "$DEV_KEY_FILE" ]]; then
		warn "restricted-key proofs skipped: no key_file in the inventory"
		return 0
	fi
	if [[ ! -f "$DEV_KEY_FILE" ]]; then
		warn "restricted-key proofs skipped: key file not installed: $DEV_KEY_FILE"
		return 0
	fi
	label=${DEV_KEY_FILE##*/}
	if [[ "$label" != "${DEVICE}-"* ]]; then
		warn "restricted-key proofs skipped: key file $DEV_KEY_FILE does not name the device"
		return 0
	fi
	label=${label#"${DEVICE}-"}
	if ! valid_label "$label"; then
		warn "restricted-key proofs skipped: derived label '$label' is not a valid label"
		return 0
	fi
	proof_hello "$DEV_KEY_FILE" "$label" change || rc=1
	proof_unknown_and_empty "$DEV_KEY_FILE" "$label" change || rc=1
	return "$rc"
}

# Contract: action_check -- the check action, read-only:
# ensure_known_hosts, the full report captured before check_lines (the plain
# key's blob passed only on the plain-key admin path; a failed report call
# prints only "FAIL router report: ssh failed" before stopping; an incomplete
# report likewise stops before any proof), then the
# password-only proof (admin_password_get once, then true through rsh_pw
# with </dev/null), then the two restricted-key proofs the doctor's F2
# router-line check needs (proof_hello and proof_unknown_and_empty on
# the inventory DEV_KEY_FILE -- the key file label that add-key,
# swap-key and lab-snapshot install under ${KEYS_DIR}/${DEVICE}-<label>;
# role=change is the canonical agent role and matches what add-key /
# swap-key / lab-snapshot install -- see prove_restricted_key): when DEV_KEY_FILE is empty or the file is absent,
# print one WARN line and skip the proofs (the doctor stays
# INCONCLUSIVE; absence of the proofs is not a violation), otherwise
# run proof_hello and proof_unknown_and_empty, each of which prints its
# own PASS/FAIL line; any FAIL printed ends with stopped "check found a
# problem" (exit 1, STATE_NOTE 'router unchanged'), else done_line.
action_check() {
	local blob='' rc=0 report report_rc
	ensure_known_hosts
	if [[ "$ADMIN_MODE" == "plain-key" ]]; then
		blob=$(pub_blob "$PLAIN_KEY") || exit 2
	fi
	report=$(check_report "$blob")
	report_rc=$?
	if [[ $report_rc -ne 0 ]]; then
		fail "router report: ssh failed (exit ${report_rc})"
		STATE_NOTE='router unchanged'
		stopped "cannot read the router report"
	fi
	check_lines <<<"$report"
	rc=$?
	if [[ $rc -eq 3 ]]; then
		STATE_NOTE='router unchanged'
		stopped "cannot read the router report"
	fi
	if ! password_only_proof; then
		rc=1
	fi
	if ! restricted_key_check; then
		rc=1
	fi
	if [[ $rc -ne 0 ]]; then
		STATE_NOTE='router unchanged'
		stopped "check found a problem"
	fi
	done_line
}

# Contract: human_size BYTES -- prints the size in plain words: the exact
# byte count below 1024 ("525 B"), else the size in KB rounded to the
# nearest whole number ("146 KB").  Pure; used by the disclosure block.
human_size() {
	local bytes="$1" kb
	if (( bytes < 1024 )); then
		printf '%d B\n' "$bytes"
		return 0
	fi
	kb=$(( (bytes + 512) / 1024 ))
	printf '%d KB\n' "$kb"
}

# Contract: router_disclosure_block [ROOT] -- prints the shared block
# "What Newton puts on your router" on stdout: the shell files the install
# uploads with the sizes MEASURED from the sources under ROOT ($SRC by
# default, never written by hand), the rest of the footprint (the config
# files, the WAN-health settings, the boot links and the sysupgrade.conf
# lines), why the program is there, what protects the owner, what the
# trade-off is and what uninstall leaves behind.  Every claim in the text is
# one the code makes true: the approval rule is per profile (prod asks for
# every change, lab only for the leash ones), the key claim holds for the
# restricted key after swap-key or add-key (the install never writes
# authorized_keys), and the leftovers are the ones uninstall_config and
# uninstall_rm_files do not touch.
# The same rendered text stands in README.md (the public tree publishes
# docs/release/README-1.0.md as README.md), docs/INSTALL.md and SETUP.md.
# This file is a host tool run from the owner's machine; it is not installed
# on the router.  The test
# tests/protocol/test_router_setup_disclosure.py keeps the copies equal, so
# the file list and the sizes in the docs cannot drift from the code.
router_disclosure_block() {
	local root="${1:-$SRC}" row rel remote bytes total=0 count=0 what
	local -a file_lines=()
	for row in "${CODE_FILES[@]}" "${EXTRA_FILES[@]}"; do
		IFS='|' read -r rel remote mode rotate <<<"$row"
		bytes=$(wc -c <"${root}/${rel}") || return 1
		bytes=$(( bytes ))
		total=$(( total + bytes ))
		count=$(( count + 1 ))
		case "$remote" in
		"${R_PROG}") what='the program Newton talks to' ;;
		"${R_HELPER}") what='the change helper' ;;
		"${R_GUARD}") what='the rollback guard' ;;
		"${R_INIT}") what='starts the guard at boot' ;;
		"${R_WANHEALTH}") what='the dual-WAN health check' ;;
		"${R_WANHEALTH_INIT}") what='starts the health check' ;;
		*) what='' ;;
		esac
		file_lines+=("$(printf '  %-36s %7s  %s' \
			"$remote" "$(human_size "$bytes")" "$what")")
	done
	cat <<EOF
What Newton puts on your router

Newton's executable code is a small set of POSIX shell scripts; it also writes the configuration and service entries listed below.
No package is installed and nothing is compiled: about $(human_size "$total") of shell in ${count} files.

$(printf '%s\n' "${file_lines[@]}")

It also writes the device name, the profile and the zones under ${R_NEWTON_DIR}
(and, once you pick an approval passphrase, the approval key), the WAN-health
settings in /etc/config/newton_wanhealth, the boot links
/etc/rc.d/S09newton-guard, /etc/rc.d/S95newton-wan-health and
/etc/rc.d/K10newton-wan-health, and
${#SYSUPGRADE_LINES[@]} lines in /etc/sysupgrade.conf, so a firmware upgrade
keeps them. The guard service runs at boot; the WAN-health check stays idle
until you set newton_wanhealth.main.enabled=1. One more line goes into
${R_AUTH_KEYS}, but the install does not write it: swap-key
or add-key does.

Why: the rollback has to survive a reboot or a cut link, so it lives on the
router; and Newton's key may run Newton's program and nothing else.

What protects you:
  - on the default prod profile every change needs your approval, and Newton
    only reads until you give one;
  - a router you set to lab applies changes without asking, except the ones
    Newton always asks about. Among them: SSH (dropbear), the web interface
    (uhttpd), rpcd, a users or keys config, the management interface or zone,
    opening more to the WAN, and options that run commands or write files
    (22 rules in all, in the router program's leash). The inventory entry
    has to say lab = true as well, or every change still needs your
    approval;
  - the guard keeps the last good settings on the router's own flash, and if a
    Newton change is still waiting for confirmation at boot, it puts them back;
  - the agent never gets a root shell through Newton's restricted key: once
    swap-key or add-key has written it, that key can run Newton's program and
    nothing else. Until you run swap-key, every key already on the router
    stays as it is. The setup tool itself logs in as root with your password
    or your admin key, when you run it; the agent never gets that login.

The trade-off: your router runs Newton's code, so it has to be kept in step with
Newton: run 'sudo -u newton /usr/local/bin/newton-router-setup <device> upgrade'.
'sudo -u newton /usr/local/bin/newton-router-setup <device> uninstall' removes
the program, the guard, the boot links, the config files, EVERY Newton key line
on the router for every host and label (including the key the Newton server
itself uses), and the sysupgrade lines. The run prints each removed key with its
restore command; after a reinstall, restore each one, on the Newton host that holds that
key, with
'sudo -u newton /usr/local/bin/newton-router-setup <device> add-key <label> <role>'.
On purpose it keeps the guard's saved copies of your settings
(${R_NEWTON_DIR}/lkg and ${R_NEWTON_DIR}/quarantine) and the rest of ${R_NEWTON_DIR}
(the guard's lock and log), /usr/libexec/newton, the WAN-health settings file
/etc/config/newton_wanhealth, the copy of your keys from before swap-key,
${R_AUTH_KEYS}.newton-prev, and the /etc/sysupgrade.conf file.
The Newton lines go out of that file; the file itself stays, empty when the
install created it. The copy of the keys holds the key line swap-key took
out; if you still want that key to log in, copy the line back first. To
remove those by hand:
  rm -rf ${R_NEWTON_DIR} /usr/libexec/newton /etc/config/newton_wanhealth ${R_AUTH_KEYS}.newton-prev
and delete /etc/sysupgrade.conf once you have checked that none of your own
lines are left in it.
The run-time files in /tmp/newton and ${R_LOCK} are in memory and go at
the next reboot. The uninstall stops the WAN-health check first, and its
restore removes the WAN-health run-time state in /var/run/newton-wan-health
(every *.state file and all_down.flag); the directory itself stays, empty.
EOF
}

# Contract: install_disclose_and_confirm -- prints the shared block
# (router_disclosure_block) and asks the owner to type "yes"; any other
# answer, and the end of the input, stops the run with "nothing was
# changed" and the router untouched (no ssh call was made, because the
# question comes before step 1).  The upgrade action does not ask: it was
# agreed when the mode was chosen.
install_disclose_and_confirm() {
	local answer=''
	printf '\n'
	router_disclosure_block "$SRC" || die "cannot measure the files to install"
	printf 'Type "yes" to install Newton on %s: ' "$DEVICE" >&2
	read_answer answer
	if [[ "$answer" != "yes" ]]; then
		STATE_NOTE='router unchanged'
		stopped "nothing was changed"
	fi
}

# Contract: install_run -- the seven primary steps of 3.2 plus three extra
# WAN-health steps between step 3 and step 4 (the "extras" prefix avoids
# the "PASS install step" prefix the existing tests pin to a count of
# seven); between step 1 and step 2 the router is checked for the
# no-install login (install_refuse_if_no_install_login), so the check
# runs before the first router write and a refusal leaves the router
# untouched; ends in stopped on failure (a failure from step 3 on first runs
# install_restore, which removes the wan-health extras and reports the
# hello result); the run prints one PASS line per step and never calls
# done_line. Behaviour identical to the body of the earlier action_install
# except for the inserted extras 1-3.
install_run() {
	install_check_sources
	require_known_hosts
	install_refuse_if_busy || stopped "install step 1 failed"
	pass "install step 1: router not busy"
	# the router is checked for the no-install login before the first
	# write: the two modes never mix, whatever the inventory says.
	install_refuse_if_no_install_login
	install_dirs || stopped "install step 2 failed"
	pass "install step 2: directories ready"
	install_code_files || { install_restore; stopped "install step 3 failed"; }
	pass "install step 3: code files in place"
	install_wan_health_files || { install_restore; stopped "install extras 1 failed"; }
	pass "install extras 1: wan-health code files in place"
	install_wan_health_config || { install_restore; stopped "install extras 2 failed"; }
	pass "install extras 2: wan-health config and init enabled"
	install_wan_health_verify || { install_restore; stopped "install extras 3 failed"; }
	pass "install extras 3: wan-health sha256 verified"
	install_guard_enable || { install_restore; stopped "install step 4 failed"; }
	pass "install step 4: guard enabled"
	install_config_files || { install_restore; stopped "install step 5 failed"; }
	pass "install step 5: config files written"
	install_sysupgrade || { install_restore; stopped "install step 6 failed"; }
	pass "install step 6: sysupgrade.conf lines present"
	install_verify || { install_restore; stopped "install step 7 failed"; }
	pass "install step 7: hello verified"
}

# Contract: install_refuse_if_no_install_login -- no arguments; the
# install refuses while the router still holds the no-install login of
# Newton (the rpcd.newton section): the two modes never mix, and the
# router is the proof, not the inventory.  The inventory can lie about
# it: the owner may have taken the no-install fields out by hand while
# the login was still live on the router, and then the install would put
# Newton's program next to a login that answers without its approval.
#
# The proof comes from the router, with the strict rpcd probe of the
# no-install setup (rpcd_sections_probe and rpcd_sections_scan): the
# scan says whether a section named newton is there and whether it
# carries Newton's owner tag.  A section that is not Newton's is
# refused too (Newton never touches it), and a probe that cannot read
# the rpcd config fails closed: "I could not look" is not "there is
# nothing there".
#
# The check runs before the first router write of the install, so a
# refused install leaves the router as it was.
install_refuse_if_no_install_login() {
	local out=''
	out=$(rpcd_sections_probe) || {
		STATE_NOTE='router unchanged'
		stopped "cannot read the router's rpcd config"
	}
	if ! rpcd_sections_scan <<<"$out"; then
		STATE_NOTE='router unchanged'
		stopped "the rpcd config of the router is not readable"
	fi
	if [[ "$RPCD_PRESENT" -ne 1 ]]; then
		return 0
	fi
	STATE_NOTE='router unchanged'
	if [[ "$RPCD_OURS" -eq 1 ]]; then
		stopped "the no-install login of Newton is still on the router; run ${BT}uninstall${BT} first"
	fi
	stopped "the router has an rpcd.${RPCD_SECTION} section that is not Newton's; Newton never touches it"
}

# Contract: action_install -- the install action and
# design 8.2: a device in the no-install mode is refused before
# anything is sent (the two modes never mix);
# install_check_sources (the sources are checked on the host, before the
# owner is asked),
# install_disclose_and_confirm (the shared block "What Newton puts on
# your router" and the question "Type "yes" to install Newton on
# <device>: "; any other answer stops the run with "nothing was changed"
# and the router untouched), install_run (which checks the router for
# the no-install login before its first write), the next-step hint
# (install_next_step_hint) and done_line; a refusal or a failing step
# ends in stopped (a failure from step 3 on first runs install_restore).
action_install() {
	if [[ "$DEV_ACCESS" == "no-install" ]]; then
		STATE_NOTE='router unchanged'
		stopped "this device uses no-install access; run ${BT}uninstall${BT} first"
	fi
	install_check_sources
	# ADR-021 point 9: the two access modes side by side, before the
	# owner says yes and before the first router write.
	access_modes_notes
	install_disclose_and_confirm
	install_run
	install_next_step_hint
	done_line
}

# Contract: install_next_step_hint -- no arguments; prints the INFO line
# that names the approval-key step when the device has no approval
# fingerprint yet (the passphrase is chosen after the install), and
# nothing when the fingerprint is there; the hint never fails the run.
install_next_step_hint() {
	local dir fp
	dir=$(state_dir) || return 0
	fp="${dir}/approval-fp/${DEVICE}"
	[[ -e "$fp" ]] && return 0
	info "next: choose the approval passphrase: $(owner_command) ${DEVICE} approval-key"
	return 0
}

# Contract: derive_k DEVICE -- reads the passphrase bytes from stdin
# (never argv or a file) and prints K on stdout: 64 lowercase hex, the
# PBKDF2-HMAC-SHA256 of the passphrase with the salt
# `newton-approve-v1:` + DEVICE, 600000 iterations, 32 bytes; the python
# code text is a constant (python -c, so stdin stays free for the
# passphrase); prints nothing else.
derive_k() {
	python3 -c 'import hashlib, sys
print(hashlib.pbkdf2_hmac("sha256", sys.stdin.buffer.read(),
                          b"newton-approve-v1:" + sys.argv[1].encode("utf-8"),
                          600000, 32).hex())' "$1"
}

# Contract: selftest_hmac NONCE -- reads K (64 hex) from stdin and
# prints the 64 hex HMAC-SHA256 of `newton-selftest-v1\n` + NONCE + `\n`
# keyed with the 32 bytes of K; the python code text is a constant
# (python -c, so stdin stays free for K).
selftest_hmac() {
	python3 -c 'import hashlib, hmac, sys
key = bytes.fromhex(sys.stdin.buffer.read().strip().decode("ascii"))
msg = b"newton-selftest-v1\n" + sys.argv[1].encode("ascii") + b"\n"
print(hmac.new(key, msg, hashlib.sha256).hexdigest())' "$1"
}

# Contract: approval_fingerprint_write -- reads K (64 lowercase hex) from
# the env var K_FOR_FP and writes
# `STATE_DIR/approval-fp/<DEVICE>` (the NEWTON_STATE_DIR or
# `$(home_dir)/.local/state/newton`, dir 0700, file 0600, atomic via
# temp + rename) holding `v1 <HEX>\\n` where HEX is HMAC-SHA256 of the
# literal message `newton-approval-fingerprint-v1` keyed with the 32
# bytes of K; K travels to the python tool via env (NEVER argv, NEVER
# the command line -- argv never carries secrets, rule 3). The caller
# MUST have already validated K (otherwise the file would record a
# wrong value and break approve.py's later check). Exit 0 on success,
# non-zero on any filesystem failure (the caller prints a NOTE and
# continues).
#
# Why storing this fingerprint is safe: the value is HMAC-SHA256(K
# bytes, constant), not K itself. Someone who reads it can test passphrase
# guesses offline, each guess costing a PBKDF2 run (600000 iterations of
# HMAC-SHA256), but the approval files already under
# STATE_DIR/approvals/<plan-id>.json allow the same test (they hold HMACs
# of K over a known digest), so the exposure does not grow.
approval_fingerprint_write() {
	local rc
	K_FOR_FP="$k" python3 - "$DEVICE" <<'PYEOF'
import hashlib
import hmac
import os
import pathlib
import stat
import sys
import tempfile

device = sys.argv[1]
k_hex = os.environ["K_FOR_FP"]

# state_dir resolution matches approve.py's state_dir() (NEWTON_STATE_DIR
# is set by the setup launcher; when it is not, fall back to the running
# user's home, mirroring approve.py's `~/.local/state/newton`).
state_dir = os.environ.get("NEWTON_STATE_DIR")
if not state_dir:
    state_dir = str(pathlib.Path.home() / ".local/state/newton")

target_dir = pathlib.Path(state_dir) / "approval-fp"
# parent-sticky check, same rule as mcp/newton_mcp/receipts.py
# check_state_dir_parent: the PARENT (state_dir) is stat()ed (links followed)
# and refused when it is group- or world-writable without the sticky bit; a
# parent that does not exist yet cannot be inspected and mkdir below lays it
# down under the process umask.
try:
    _parent = os.stat(target_dir.parent)
except FileNotFoundError:
    pass
except OSError as exc:
    sys.stderr.write("newton-router-setup: approval-fp parent %s cannot be inspected: %s\n" % (target_dir.parent, exc.strerror))
    sys.exit(1)
else:
    if (stat.S_IMODE(_parent.st_mode) & 0o022) and not (_parent.st_mode & stat.S_ISVTX):
        sys.stderr.write("newton-router-setup: state directory parent %s of approval-fp is group- or world-writable without the sticky bit\n" % target_dir.parent)
        sys.exit(1)
target_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
os.chmod(target_dir, 0o700)
target = target_dir / device
fp_hex = hmac.new(
    bytes.fromhex(k_hex),
    b"newton-approval-fingerprint-v1",
    hashlib.sha256,
).hexdigest()

# R8 (a-2): remove the OLD fingerprint BEFORE writing the new one.  If
# the write below fails (mkstemp, write, fsync, replace), the old fp
# would otherwise stay and approve.py would compare the new K's
# fingerprint against the OLD fp, refusing the new passphrase as
# "wrong".  By unlinking first, a failed write leaves the fp missing
# (which, after the approval-record claim change, approve.py now treats as a refusal:
# the operator must re-run ``approval-key`` to (re)write the fp).
try:
    target.unlink()
except FileNotFoundError:
    pass

fd, tmp = tempfile.mkstemp(prefix="." + device + ".", dir=str(target_dir))
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="ascii") as stream:
        stream.write("v1 %s\n" % fp_hex)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(tmp, target)
except BaseException:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    # No partial file left behind at `target` either: the unlink above
    # already removed it, and os.replace is atomic (a failed replace
    # never creates a partial target).  Belt-and-braces: if anything
    # ever did leave a half-written file here, scrub it so approve.py
    # sees the missing-file state (a refusal),
    # not a stale fingerprint.
    try:
        target.unlink()
    except FileNotFoundError:
        pass
    raise
PYEOF
	rc=$?
	unset K_FOR_FP
	return $rc
}

# Contract: wan_health_restart_pending_path -- no arguments; prints
# `STATE_DIR/wan-health-restart-pending/<DEVICE>` (the state_dir layout
# used by approval-fp) and nothing else; returns non-zero when the
# fallback home directory cannot be read.
wan_health_restart_pending_path() {
	local dir
	dir=$(state_dir) || return 1
	printf '%s\n' "${dir}/wan-health-restart-pending/${DEVICE}"
}

# Contract: check_state_dir_parent_sticky <dir> <label> -- returns 0 when
# <dir>'s PARENT (one level up) is not group- or world-writable without the
# sticky bit, or prints a one-line refusal to stderr and returns 1.  A parent
# that does not exist yet cannot be inspected: the caller's mkdir lays it down
# mode 0700 and a parent we just made is ours alone, so that case is accepted.
# Same rule as mcp/newton_mcp/receipts.py check_state_dir_parent: stat -c %a
# prints the mode as 3 or 4 octal digits (a leading 1/2/4 is
# sticky/setgid/setuid), so read it as base 8.
check_state_dir_parent_sticky() {
	local dir=$1 label=$2 parent mode
	parent=$(dirname -- "$dir") || return 1
	[[ -d $parent ]] || return 0
	mode=$(stat -c %a -- "$parent") || return 1
	if (( (8#$mode & 022) && !(8#$mode & 01000) )); then
		printf '%s\n' "newton-router-setup: state directory parent $parent of $label ($dir) is group- or world-writable without the sticky bit" >&2
		return 1
	fi
	return 0
}

# Contract: wan_health_restart_pending_write -- no arguments; atomically
# records `v1\n` at wan_health_restart_pending_path after creating its parent
# with mode 0700 (the marker itself is 0600); returns 0 on success and
# non-zero on any filesystem failure without leaving a temporary file.
wan_health_restart_pending_write() {
	local marker_dir marker tmp
	marker_dir=$(wan_health_restart_pending_path) || return 1
	marker_dir="${marker_dir%/*}"
	# refuse before the mkdir below when the state dir itself is group- or
	# world-writable without the sticky bit
	check_state_dir_parent_sticky "$marker_dir" wan-health-restart-pending || return 1
	mkdir -p -- "$marker_dir" \
		&& chmod 700 -- "$marker_dir" \
		|| return 1
	marker="${marker_dir}/${DEVICE}"
	tmp=$(mktemp "${marker_dir}/.${DEVICE}.XXXXXX") || return 1
	if printf '%s\n' v1 >"$tmp" \
		&& chmod 600 -- "$tmp" \
		&& mv -f -- "$tmp" "$marker"; then
		return 0
	fi
	rm -f -- "$tmp"
	return 1
}

# Contract: wan_health_restart_pending_clear -- no arguments; removes exactly
# wan_health_restart_pending_path (an absent marker is success); returns 0 on
# success and non-zero when the path cannot be resolved or unlinked.
wan_health_restart_pending_clear() {
	local marker
	marker=$(wan_health_restart_pending_path) || return 1
	rm -f -- "$marker"
}

# Contract: lab_passphrase_path -- prints the expanded
# approve_passphrase_file of the [ssh] table of NEWTON_LAB_TOML (default
# <repo>/lab/lab.toml), nothing when the toml, the table or the key is
# absent or the toml cannot be read; pure, never calls the router.
lab_passphrase_path() {
	local toml="${NEWTON_LAB_TOML:-${DEFAULT_SRC}/lab/lab.toml}"
	python3 - "$toml" <<'PYEOF'
import os
import sys
import tomllib

try:
    with open(sys.argv[1], "rb") as fh:
        data = tomllib.load(fh)
except Exception:
    sys.exit(0)
table = data.get("ssh")
if not isinstance(table, dict):
    sys.exit(0)
value = table.get("approve_passphrase_file")
if not isinstance(value, str) or not value:
    sys.exit(0)
print(os.path.expanduser(value))
PYEOF
}

# Contract: router_selftest NONCE -- validates NONCE (32 lowercase hex,
# else die) and runs `${RR}/usr/libexec/newton/newton-router
# approval-selftest NONCE` through rsh_admin with </dev/null; prints the
# hmac of the reply (`approval-selftest NONCE HMAC`, 64 lowercase hex),
# nothing on `error approval-key-missing` or any failure; always returns
# 0.
router_selftest() {
	local nonce="$1" out rc first second third
	[[ "$nonce" =~ ^[0-9a-f]{32}$ ]] || die "bad nonce"
	out=$(rsh_admin "\"${RR}${R_PROG}\" approval-selftest ${nonce}" </dev/null 2>/dev/null)
	rc=$?
	[[ $rc -eq 0 ]] || return 0
	# the reply split must not glob ()
	IFS=' ' read -r first second third _ <<<"$out"
	if [[ "$first" == "approval-selftest" && "$second" == "$nonce" \
		&& "$third" =~ ^[0-9a-f]{64}$ ]]; then
		printf '%s\n' "$third"
	fi
	return 0
}

# Contract: approval_passphrase_read -- no arguments; asks the owner for
# the approval passphrase and leaves it in APPROVAL_PP.  The rules are
# the ones of the installed approval step (design 5.4), so the two modes
# ask the same question the same way: --passphrase-file FILE (the
# inventory profile lab only, else exit 2; one trailing LF dropped), else
# two no-echo prompts that must match; on a prod device a passphrase
# equal to the readable lab passphrase file refuses before anything is
# sent, an unreadable or absent file prints the NOTE before the prompt;
# an empty passphrase refuses.  A refusal stops the run with "router
# unchanged".  The passphrase is never printed, never exported and never
# written to a file; the caller unsets APPROVAL_PP when it is done with
# it.
approval_passphrase_read() {
	APPROVAL_PP='' APPROVAL_LABPP=''
	local pp='' pp2=''
	if [[ -n "$PASSPHRASE_FILE" ]]; then
		[[ "$DEV_PROFILE" == "lab" ]] \
			|| die "--passphrase-file is allowed only when the inventory profile is lab"
		[[ -r "$PASSPHRASE_FILE" ]] \
			|| die "cannot read --passphrase-file: $PASSPHRASE_FILE"
		APPROVAL_PP=$(cat -- "$PASSPHRASE_FILE" && printf 'x')
		APPROVAL_PP=${APPROVAL_PP%x}
		APPROVAL_PP=${APPROVAL_PP%$'\n'}
	else
		if [[ "$DEV_PROFILE" == "prod" ]]; then
			APPROVAL_LABPP=$(lab_passphrase_path)
			if [[ -n "$APPROVAL_LABPP" && -r "$APPROVAL_LABPP" ]]; then
				APPROVAL_LABPP=$(cat -- "$APPROVAL_LABPP" && printf 'x')
				APPROVAL_LABPP=${APPROVAL_LABPP%x}
				APPROVAL_LABPP=${APPROVAL_LABPP%$'\n'}
			else
				APPROVAL_LABPP=''
				note "the approval passphrase must differ from the lab passphrase file"
			fi
		fi
		read_secret pp 'approval passphrase: '
		read_secret pp2 'approval passphrase again: '
		if [[ "$pp" != "$pp2" ]]; then
			STATE_NOTE='router unchanged'
			stopped "the approval passphrases differ"
		fi
		if [[ -n "$APPROVAL_LABPP" && "$pp" == "$APPROVAL_LABPP" ]]; then
			STATE_NOTE='router unchanged'
			stopped "the approval passphrase equals the lab passphrase file"
		fi
		APPROVAL_PP="$pp"
	fi
	if [[ -z "$APPROVAL_PP" ]]; then
		STATE_NOTE='router unchanged'
		stopped "the approval passphrase is empty"
	fi
}

# Contract: approval_key_run -- the body of action_approval_key (design 5.4), without the final done_line: require_known_hosts,
# a direct hello as the prerequisite (else exit 2 `error: run install
# first`, or `error: the admin login failed (see the FAIL line above)`
# when the admin login itself was refused); the passphrase from
# approval_passphrase_read (the same prompt and the same rules as the
# no-install mode asks with); K = derive_k DEVICE; the
# first router_selftest that already matches ends with `PASS approval key
# already set` and returns from approval_key_run (no write, no done_line);
# else `K\n` goes from a pipe through put_stream to /etc/newton/approve.key
# (mode 600, no rotation) and a second selftest must match (a mismatch
# ends stopped); nothing prints K or the passphrase and every variable
# that held a secret is unset before approval_key_run returns.
approval_key_run() {
	local nonce local_hmac remote_hmac sha
	local pp='' k=''
	require_known_hosts
	# the root password first on the password lane, so every later
	# captured ssh call (which re-reads it in its own subshell under the
	# seams) comes after the passphrase prompts in the typed order
	if [[ "$ADMIN_MODE" == "password" ]]; then
		admin_password_get
	fi
	nonce=$(new_nonce)
	if ! hello_direct "$nonce" >/dev/null 2>&1; then
		# a refused admin login is not a missing install: rsh_admin
		# recorded it, and die prints that FAIL line first.  No "nothing
		# was changed": lab-snapshot runs this after its install.
		if [[ -n "$ADMIN_FAIL_FILE" && -s "$ADMIN_FAIL_FILE" ]]; then
			die "the admin login failed (see the FAIL line above)"
		fi
		die "run install first"
	fi
	approval_passphrase_read
	pp="$APPROVAL_PP"
	k=$(printf '%s' "$pp" | derive_k "$DEVICE")
	if ! [[ "$k" =~ ^[0-9a-f]{64}$ ]]; then
		unset pp k APPROVAL_PP APPROVAL_LABPP
		die "cannot derive the approval key"
	fi
	nonce=$(new_nonce)
	remote_hmac=$(router_selftest "$nonce")
	local_hmac=$(printf '%s\n' "$k" | selftest_hmac "$nonce")
	if [[ -n "$remote_hmac" && "$remote_hmac" == "$local_hmac" ]]; then
		pass "approval key already set"
		if ! approval_fingerprint_write; then
			note "could not record the approval fingerprint for $DEVICE; re-run approval-key to retry"
		fi
		unset pp k local_hmac remote_hmac APPROVAL_PP APPROVAL_LABPP
		return 0
	fi
	sha=$(printf '%s\n' "$k" | sha256sum)
	sha=${sha%% *}
	if ! printf '%s\n' "$k" | put_stream "${R_NEWTON_DIR}/approve.key" 600 "$sha"; then
		unset pp k local_hmac remote_hmac sha APPROVAL_PP APPROVAL_LABPP
		STATE_NOTE='router unchanged'
		stopped "cannot write approve.key"
	fi
	nonce=$(new_nonce)
	remote_hmac=$(router_selftest "$nonce")
	local_hmac=$(printf '%s\n' "$k" | selftest_hmac "$nonce")
	if [[ -z "$remote_hmac" || "$remote_hmac" != "$local_hmac" ]]; then
		unset pp k local_hmac remote_hmac sha APPROVAL_PP APPROVAL_LABPP
		STATE_NOTE='approve.key was written but the selftest failed'
		stopped "approval selftest mismatch"
	fi
	pass "approval key verified"
	APPROVAL_KEY_CHANGED=1
	if ! approval_fingerprint_write; then
		note "could not record the approval fingerprint for $DEVICE; re-run approval-key to retry"
	fi
	unset pp k local_hmac remote_hmac sha APPROVAL_PP APPROVAL_LABPP
}

# Contract: approval_key_no_install_run -- the approval key of a
# no-install device: the passphrase is
# asked with the rules of the installed approval step, the key is
# derived on this host and the fingerprint is written to
# `STATE_DIR/approval-fp/<DEVICE>`.  NOTHING goes to the router: no
# admin lane, no approve.key on the router, no selftest.  The router
# keeps nothing of Newton but the web-interface user of the setup, and
# the fingerprint is the only thing this host keeps.
approval_key_no_install_run() {
	local k=''
	approval_passphrase_read
	k=$(printf '%s' "$APPROVAL_PP" | derive_k "$DEVICE")
	if ! [[ "$k" =~ ^[0-9a-f]{64}$ ]]; then
		unset k APPROVAL_PP APPROVAL_LABPP
		die "cannot derive the approval key"
	fi
	if ! approval_fingerprint_write; then
		# On a no-install router the fingerprint is the ONLY thing this
		# host keeps of the owner's passphrase, so a failed write
		# is a stop and never a DONE: the old fingerprint is gone and
		# the new one is not there, so the owner has to run
		# approval-key again.  The router is untouched by this failure.
		unset k APPROVAL_PP APPROVAL_LABPP
		note "could not record the approval fingerprint for $DEVICE; re-run approval-key to retry"
		STATE_NOTE='router unchanged'
		stopped "cannot write the approval fingerprint"
	fi
	pass "approval fingerprint stored on this host (nothing was written to the router)"
	unset k APPROVAL_PP APPROVAL_LABPP
	return 0
}

# Contract: approval_key_no_install_step -- the closing step of the
# no-install setup: the owner's approval passphrase is asked for and the
# host-side fingerprint is written.  A device that already has a
# fingerprint keeps it: the passphrase is changed only when the owner
# asks for it (the approval-key action), exactly as on an installed
# device.
approval_key_no_install_step() {
	local dir='' fp=''
	dir=$(state_dir) || return 1
	fp="${dir}/approval-fp/${DEVICE}"
	if [[ -e "$fp" ]]; then
		info "the approval passphrase of ${DEVICE} is unchanged; run ${BT}approval-key${BT} to change it"
		return 0
	fi
	approval_key_no_install_run
}

# Contract: action_approval_key -- approval_key_run, the offer of the
# authenticator app (totp_offer) and done_line.  On a no-install device
# the approval key is host-only work (approval_key_no_install_run): the
# authenticator offer belongs to the installed mode's program, so it is
# not offered here.
action_approval_key() {
	if [[ "$DEV_ACCESS" == "no-install" ]]; then
		approval_key_no_install_run
		done_line
		return 0
	fi
	approval_key_run
	totp_offer
	done_line
}

# Contract: totp_offer -- no arguments; the offer of the authenticator
# app that follows the owner's own passphrase: nothing at all when the
# passphrase came from a file (--passphrase-file; the owner is not there
# to answer) or when NEWTON_SKIP_TOTP_OFFER=1 (newton-enrol rotate sets
# it, because the rotation throws the TOTP record away a second later);
# one INFO line when the device already asks for a 6-digit code
# (levels/<device> reads totp) and this run kept the key; with a new key
# one INFO line that the app no longer works, then the offer; otherwise
# the three INFO lines of the
# offer and, when there is a terminal to read and the enrolment program
# is installed, the question whether to set the authenticator up now. An
# accepted offer runs `$SRC/venv/bin/newton-enrol totp <device>` with an
# argv list (never a shell string) and reports what happened. The
# passphrase stays the proof in every case and the run always ends in
# exit 0.
totp_offer() {
	local enrol="$SRC/venv/bin/newton-enrol" dir='' level='' answer=''
	local rc=0
	# a passphrase from a file is not the owner's own typing
	[[ -n "$PASSPHRASE_FILE" ]] && return 0
	# the rotation throws the TOTP record away right after this run
	[[ "${NEWTON_SKIP_TOTP_OFFER:-}" == "1" ]] && return 0
	dir=$(state_dir) || dir=''
	if [[ -n "$dir" && -f "${dir}/levels/${DEVICE}" ]]; then
		IFS= read -r level <"${dir}/levels/${DEVICE}" || :
		level="${level//[[:space:]]/}"
		if [[ "$level" == "totp" && $APPROVAL_KEY_CHANGED -eq 0 ]]; then
			info "an authenticator app is already set up for ${DEVICE}"
			return 0
		fi
		# the TOTP record keeps the key of the passphrase typed at
		# enrolment, so a new key leaves the app unable to approve
		if [[ "$level" == "totp" ]]; then
			info "the authenticator app for ${DEVICE} was set up with the old passphrase and no longer works; set it up again"
		fi
	fi
	info "optional: an authenticator app can replace this passphrase in Newton's approval dialog"
	info "it shows a 6-digit code that changes every 30 seconds, so a code someone sees is useless a minute later"
	info "the passphrase stays in use unless you set this up; to do it later run: sudo -u newton /usr/local/bin/newton-enrol totp ${DEVICE}"
	# the question needs a terminal to read and the program to run
	[[ -x "$enrol" ]] || return 0
	has_terminal || return 0
	printf '%s' 'Set up an authenticator app now? [y/N] ' >&2
	read_answer answer
	answer="${answer//[[:space:]]/}"
	case "$answer" in
		[yY]|[yY][eE][sS]) ;;
		*) return 0 ;;
	esac
	if [[ $SEAMS -eq 1 ]]; then
		"$enrol" totp "$DEVICE" </dev/null || rc=$?
	else
		"$enrol" totp "$DEVICE" </dev/tty || rc=$?
	fi
	if [[ $rc -eq 0 ]]; then
		pass "authenticator set up"
	else
		note "authenticator not set up; the passphrase stays in use"
	fi
	return 0
}

# Contract: swap_replace_key_lines -- swap-key sub-step 5 (design 8.3):
# ONE rsh_admin call with fixed text (${RR} on every location, </dev/null)
# builds authorized_keys.new with awk_filter_program (awk -v blob='OLD_BLOB')
# so every line whose blob is not OLD_BLOB stays byte for byte; before the
# mv, awk_match_program must find NEW_BLOB exactly once and OLD_BLOB zero
# times in the .new; on any failure rm -f the .new (nothing else touched)
# and exit 1; then chmod 600 and mv it over the live file. Both blobs are
# validated as base64 (same rule as auth_remove_blob) before they enter the
# script text. Returns the call's status.
swap_replace_key_lines() {
	local blob_old="$OLD_BLOB" blob_new="$NEW_BLOB" script
	[[ "$blob_old" =~ ^[A-Za-z0-9+/=]+$ ]] || die "bad public key blob"
	[[ "$blob_new" =~ ^[A-Za-z0-9+/=]+$ ]] || die "bad public key blob"
	script="f=\"${RR}${R_AUTH_KEYS}\"
n=\"\${f}.new\"
awk -v blob='${blob_old}' '$(awk_filter_program)' \"\$f\" > \"\$n\" || { rm -f \"\$n\"; exit 1; }
new=\$(awk -v blob='${blob_new}' '$(awk_match_program)' \"\$n\" | grep -c '')
old=\$(awk -v blob='${blob_old}' '$(awk_match_program)' \"\$n\" | grep -c '')
[ \"\$new\" = 1 ] && [ \"\$old\" = 0 ] || { rm -f \"\$n\"; exit 1; }
chmod 600 \"\$n\" || { rm -f \"\$n\"; exit 1; }
mv \"\$n\" \"\$f\" || { rm -f \"\$n\"; exit 1; }"
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: swap_confirm_new_key NONCE2 -- swap-key sub-step 6 (design
# 8.3): hello_key "$KEYFILE" "$NONCE2" from a fresh connection; returns 0
# only when the reply carries caller=$LABEL role=change door=ssh
# mode=prod; otherwise returns 1.
swap_confirm_new_key() {
	local nonce2="$1" reply
	reply=$(hello_key "$KEYFILE" "$nonce2") || return 1
	if [[ "$(hello_field "$reply" caller 2>/dev/null)" == "$LABEL" \
		&& "$(hello_field "$reply" role 2>/dev/null)" == "change" \
		&& "$(hello_field "$reply" door 2>/dev/null)" == "ssh" \
		&& "$(hello_field "$reply" mode 2>/dev/null)" == "prod" ]]; then
		return 0
	fi
	return 1
}

# Contract: swap_old_key_refused -- swap-key sub-step 7 (design 8.3):
# rsh_key "$PLAIN_KEY" true </dev/null must exit 255 (the plain key is no
# longer accepted); any other status returns 1.
swap_old_key_refused() {
	local rc
	rsh_key "$PLAIN_KEY" true </dev/null 2>/dev/null
	rc=$?
	[[ $rc -eq 255 ]] || return 1
	return 0
}

# Contract: swap_settle -- swap-key sub-step 8 (design 8.3): wait_router
# 95, then a fresh-nonce hello_key with KEYFILE must pass the same field
# check as swap_confirm_new_key and the plain key must still be refused;
# returns 0 on success, 1 on any failure.
swap_settle() {
	local nonce
	wait_router 95
	nonce=$(new_nonce)
	swap_confirm_new_key "$nonce" || return 1
	swap_old_key_refused || return 1
	return 0
}

# Contract: swap_recover -- failure path of swap-key sub-step 6 (design
# 8.3): up to 24 rounds of wait_router 5 then
# rsh_key "$PLAIN_KEY" true </dev/null (24 * 5 = 120 s of recovery time);
# whenever the plain key works, one rsh_admin call compares the sha256 of
# ${RR}${R_AUTH_KEYS} and ${RR}${R_AUTH_KEYS}.newton-prev on the router
# (sha256sum only, no cmp): equal sets STATE_NOTE='restored by the dead-man
# switch; the old key works again' and stops; different keeps waiting. After
# the 24th try, report either that the plain key worked but the files differ,
# or that the router was NOT restored. Every case ends in stopped "the new
# key was not proven in time" (the action prints NOTE state: then STOPPED).
swap_recover() {
	local i rc out sha_live sha_prev plain_worked=0
	for i in $(seq 1 24); do
		wait_router 5
		rsh_key "$PLAIN_KEY" true </dev/null 2>/dev/null
		rc=$?
		if [[ $rc -eq 0 ]]; then
			plain_worked=1
			out=$(rsh_admin "sha256sum \"${RR}${R_AUTH_KEYS}\" \"${RR}${R_AUTH_KEYS}.newton-prev\" 2>/dev/null" </dev/null 2>/dev/null) || out=''
			sha_live=$(printf '%s\n' "$out" | head -n 1 | awk '{print $1}')
			sha_prev=$(printf '%s\n' "$out" | sed -n '2p' | awk '{print $1}')
			if [[ -n "$sha_live" && -n "$sha_prev" && "$sha_live" == "$sha_prev" ]]; then
				STATE_NOTE='restored by the dead-man switch; the old key works again'
				stopped "the new key was not proven in time"
			fi
		fi
	done
	if [[ $plain_worked -eq 1 ]]; then
		STATE_NOTE='the plain key works but authorized_keys differs from authorized_keys.newton-prev; look at the router'
	else
		STATE_NOTE='NOT restored; use the root password, LuCI or the console (design 8.6)'
	fi
	stopped "the new key was not proven in time"
}

# Contract: inventory_set_key_text DEVICE KEYFILE KNOWN_HOSTS -- pure:
# reads the toml text on stdin and prints the rewritten text on stdout;
# inside the [devices.DEVICE] table only replaces the line
# key_file = ... and the line known_hosts = ... when they exist, else
# adds key_file = "KEYFILE" and known_hosts = "KNOWN_HOSTS" after the
# last key line of that table (or after the last non-blank line of the
# table when no key line exists), before the next table header or end
# of text; every other byte stays. KEYFILE and KNOWN_HOSTS are validated
# against [A-Za-z0-9_./-]+ before use (else "error: ..." on stderr, exit
# 2). A device that has no table dies with "error: ..." on stderr, exit
# 2. The python code is a constant passed through python3 -c "$(cat
# <<'PYEOF' ... PYEOF)" so the caller's stdin (the toml text) still
# reaches the python interpreter.
inventory_set_key_text() {
	python3 -c "$(cat <<'PYEOF'
import re
import sys

DEVICE, KEYFILE, KNOWN_HOSTS = sys.argv[1], sys.argv[2], sys.argv[3]


def err(msg):
    print("error: " + msg, file=sys.stderr)
    sys.exit(2)


val_re = re.compile(r"^[A-Za-z0-9_./-]+$")
if not val_re.fullmatch(KEYFILE):
    err("bad KEYFILE value: " + repr(KEYFILE))
if not val_re.fullmatch(KNOWN_HOSTS):
    err("bad KNOWN_HOSTS value: " + repr(KNOWN_HOSTS))

text = sys.stdin.read()
lines = text.splitlines(keepends=True)

table_re = re.compile(r"^(\[\[?)([A-Za-z_][A-Za-z0-9_.\-]*)(\]\]?)\s*(#.*)?$")
target = "[devices." + DEVICE + "]"

start = None
end = len(lines)
for i, line in enumerate(lines):
    stripped = line.rstrip("\n").rstrip()
    m = table_re.match(stripped)
    if not m:
        continue
    if start is None:
        if stripped == target:
            start = i
    else:
        end = i
        break

if start is None:
    err("device not in inventory: " + DEVICE)

key_file_re = re.compile(r"^\s*key_file\s*=")
known_hosts_re = re.compile(r"^\s*known_hosts\s*=")

key_file_idx = -1
known_hosts_idx = -1
last_nonblank_idx = start
for j in range(start + 1, end):
    line = lines[j]
    if key_file_idx < 0 and key_file_re.match(line):
        key_file_idx = j
    if known_hosts_idx < 0 and known_hosts_re.match(line):
        known_hosts_idx = j
    if line.rstrip("\n").rstrip():
        last_nonblank_idx = j

key_positions = [i for i in (key_file_idx, known_hosts_idx) if i >= 0]
if key_positions:
    insert_after = max(key_positions)
elif last_nonblank_idx > start:
    insert_after = last_nonblank_idx
else:
    insert_after = start
insert_at = insert_after + 1

# the table's last line may have no final newline (the
# inventory file ends without one); without this fix, the inserted
# key_file / known_hosts lines would glue to the previous line and
# tomllib would reject the result as not valid toml
if insert_after < len(lines) and not lines[insert_after].endswith("\n"):
    lines[insert_after] = lines[insert_after] + "\n"

if key_file_idx >= 0:
    lines[key_file_idx] = 'key_file = "%s"\n' % KEYFILE
if known_hosts_idx >= 0:
    lines[known_hosts_idx] = 'known_hosts = "%s"\n' % KNOWN_HOSTS

to_add = []
if key_file_idx < 0:
    to_add.append('key_file = "%s"\n' % KEYFILE)
if known_hosts_idx < 0:
    to_add.append('known_hosts = "%s"\n' % KNOWN_HOSTS)
for offset, new_line in enumerate(to_add):
    lines.insert(insert_at + offset, new_line)

sys.stdout.write("".join(lines))
PYEOF
)" "$1" "$2" "$3"
}

# Contract: inventory_set_key DEVICE KEYFILE KNOWN_HOSTS -- reads
# $INVENTORY, runs the pure inventory_set_key_text core, writes the
# result to $INVENTORY.new in the same directory (mode copied from the
# old file), re-parses the new text with tomllib and checks that every
# OTHER device parses to the same values as the original parse and that
# this DEVICE has both keys, then renames over the inventory; on any
# failure the .new is removed, an error is printed, and the function returns
# 1 so action_swap_key can report the router's post-swap state.
inventory_set_key() {
	local device="$1" keyfile="$2" kh="$3" new_text inv_new mode
	# `new_text=$(...)` strips every trailing newline,
	# so the rewritten inventory would lose the final LF. The sentinel
	# keeps every byte: append `x` inside the substitution, strip it
	# here, then write with `printf '%s'`.
	if ! new_text=$(inventory_set_key_text "$device" "$keyfile" "$kh" <"$INVENTORY" && printf x); then
		printf 'error: cannot update inventory: %s\n' "$device" >&2
		return 1
	fi
	new_text=${new_text%x}
	if [[ -z "$new_text" ]]; then
		printf 'error: cannot update inventory: %s\n' "$device" >&2
		return 1
	fi
	inv_new="${INVENTORY}.new"
	mode=''
	if [[ -e "$INVENTORY" ]]; then
		mode=$(stat -c '%a' -- "$INVENTORY" 2>/dev/null) || mode=''
	fi
	if ! printf '%s' "$new_text" >"$inv_new"; then
		rm -f "$inv_new"
		printf 'error: cannot write %s\n' "$inv_new" >&2
		return 1
	fi
	if [[ -n "$mode" ]]; then
		if ! chmod "$mode" -- "$inv_new"; then
			rm -f "$inv_new"
			printf 'error: cannot chmod %s\n' "$inv_new" >&2
			return 1
		fi
	fi
	if ! python3 - "$inv_new" "$INVENTORY" "$device" <<'PYEOF'
import sys
import tomllib

inv_new = sys.argv[1]
inv_old = sys.argv[2]
device = sys.argv[3]


def err(msg):
    print("error: " + msg, file=sys.stderr)
    sys.exit(2)


with open(inv_new, "rb") as fh:
    new_data = tomllib.load(fh)
devs = new_data.get("devices", {})
if not isinstance(devs, dict) or device not in devs:
    err("device missing after write: " + device)
entry = devs[device]
if not isinstance(entry, dict):
    err("device is not a table after write: " + device)
for k in ("key_file", "known_hosts"):
    if not isinstance(entry.get(k), str) or not entry[k]:
        err("device " + device + " has no " + k)

with open(inv_old, "rb") as fh:
    old_data = tomllib.load(fh)
old_devs = old_data.get("devices", {}) or {}
for d, old_entry in old_devs.items():
    if d == device:
        continue
    new_entry = devs.get(d)
    if new_entry != old_entry:
        err("device " + d + " values changed")
PYEOF
	then
		rm -f "$inv_new"
		printf 'error: inventory re-parse failed\n' >&2
		return 1
	fi
	if ! mv -- "$inv_new" "$INVENTORY"; then
		rm -f "$inv_new"
		printf 'error: cannot rename over inventory\n' >&2
		return 1
	fi
}

# Contract: action_swap_key -- the swap-key action and
# design 8.3: require_known_hosts, then the eight sub-steps of swap-
# key with one PASS swap step N (or the already_swapped PASS, or the
# swap step 5 INFO) line per sub-step; a failing sub-step ends in
# `NOTE state: <what the router looks like now>` and `STOPPED swap-key
# DEVICE: <reason>` (exit 1); the success path ends with the inventory
# write of 3.5 (key_file, known_hosts), one INFO next: newton-doctor
# line and `DONE swap-key DEVICE`. The plain key is never replaced
# without the dead-man switch running.
action_swap_key() {
	local nonce2 rc missing existing blob
	local -a existing_blobs=()
	require_known_hosts
	keypair_path "$LABEL"
	local_key_rule "$LABEL"
	if [[ $NEW_KEY -eq 1 ]]; then
		existing=$(auth_newton_label_blobs "$LABEL") || {
			STATE_NOTE='router unchanged'
			stopped "cannot read the existing key for label $LABEL"
		}
		if [[ -n "$existing" ]]; then
			while IFS= read -r blob; do
				existing_blobs+=("$blob")
			done <<<"$existing"
		fi
		if ((${#existing_blobs[@]} > 0)); then
			STATE_NOTE='router unchanged'
			stopped "the router already has a Newton key line for label $LABEL; revoke it first (sudo -u newton /usr/local/bin/newton-router-setup $DEVICE revoke $LABEL)"
		fi
	fi
	swap_prepare
	if swap_router_done; then
		if [[ "$DEV_KEY_FILE" == "$KEYFILE" ]]; then
			pass "already swapped"
		else
			if ! inventory_set_key "$DEVICE" "$KEYFILE" "$(known_hosts_file)"; then
				STATE_NOTE='the swap is done and the new key works (the plain key is refused); the inventory was NOT updated: add key_file and known_hosts to the device by hand'
				stopped "cannot update the inventory"
			fi
			pass "already swapped; inventory updated"
		fi
		done_line
		return 0
	fi
	missing=$(swap_deadman_tools)
	rc=$?
	if [[ $rc -eq 1 ]]; then
		STATE_NOTE='router unchanged'
		stopped "the router lacks ${missing%$'\n'}, which the dead-man switch needs"
	fi
	if [[ $rc -eq 2 ]]; then
		STATE_NOTE='router unchanged'
		stopped "cannot check the tools the dead-man switch needs"
	fi
	if ! swap_stage_new_line; then
		STATE_NOTE='router unchanged'
		stopped "cannot stage the new key line"
	fi
	pass "swap step 2: new key line staged"
	swap_prove_new_key
	pass "swap step 3: new key proven"
	nonce2=$(new_nonce)
	if ! swap_start_deadman "$nonce2"; then
		if [[ $SWAP_APPENDED -eq 1 ]]; then
			auth_remove_blob "$NEW_BLOB" </dev/null 2>/dev/null || true
		fi
		STATE_NOTE='router unchanged (the new line was removed again)'
		stopped "cannot start the dead-man switch"
	fi
	pass "swap step 4: dead-man switch started"
	if swap_replace_key_lines; then
		info "swap step 5: authorized_keys replaced"
	else
		info "swap step 5: authorized_keys replace failed"
	fi
	if ! swap_confirm_new_key "$nonce2"; then
		swap_recover
	fi
	pass "swap step 6: new key confirmed"
	if ! swap_old_key_refused; then
		STATE_NOTE='both keys work; nothing was lost'
		stopped "the old key still works"
	fi
	pass "swap step 7: old key refused"
	if ! swap_settle; then
		STATE_NOTE='the new key or the old-key refusal changed after the 95 s wait; look at the router'
		stopped "the swap did not hold after 95 s"
	fi
	pass "swap step 8: settled"
	if ! inventory_set_key "$DEVICE" "$KEYFILE" "$(known_hosts_file)"; then
		STATE_NOTE='the swap is done and the new key works (the plain key is refused); the inventory was NOT updated: add key_file and known_hosts to the device by hand'
		stopped "cannot update the inventory"
	fi
	info "next: newton-doctor --router root@${DEV_HOST}"
	done_line
}

# Contract: add_key_run LABEL ROLE -- enforces local_key_rule, makes one
# router read that counts every Newton line for LABEL, refuses when any such
# line exists (so no second line is appended), refuses when the key blob is
# already on the router in any other line, makes the private pair only with
# NEW_KEY, appends and proves the restricted line, removes exactly the line
# this run appended on failure and also deletes a pair this run made; prints
# the PASS line and ends in stopped on any failure (no done_line).  In the
# lab-snapshot action, one matching line with the local blob is reported as
# already present instead.
add_key_run() {
	local label="$1" role="$2"
	local new_blob new_line existing rc removed blob
	local -a existing_blobs=()
	local appended=0
	require_known_hosts
	local_key_rule "$label"
	existing=$(auth_newton_label_blobs "$label") || {
		STATE_NOTE='router unchanged'
		stopped "cannot read the existing key for label $label"
	}
	if [[ -n "$existing" ]]; then
		while IFS= read -r blob; do
			existing_blobs+=("$blob")
		done <<<"$existing"
	fi
	if ((${#existing_blobs[@]} > 0)); then
		if [[ "$ACTION" == "lab-snapshot" \
			&& ${#existing_blobs[@]} -eq 1 \
			&& "${existing_blobs[0]}" == "$(pub_blob "$KEYFILE")" ]]; then
			pass "add-key $label: already on the router"
			return 0
		fi
		STATE_NOTE='router unchanged'
		stopped "the router already has a Newton key line for label $label; revoke it first (sudo -u newton /usr/local/bin/newton-router-setup $DEVICE revoke $label)"
	fi
	if [[ ! -f "$KEYFILE" ]]; then
		if [[ $NEW_KEY -ne 1 ]]; then
			STATE_NOTE='router unchanged'
			stopped "no key for label $label on this host ($KEYFILE is missing): the key lives on the Newton host that added it; run this there, or pass --new-key to make a new key on purpose"
		fi
		keypair_create "$label"
	fi
	new_blob=$(pub_blob "$KEYFILE")
	auth_has_blob "$new_blob"
	rc=$?
	if [[ $rc -eq 0 ]]; then
		STATE_NOTE='router unchanged'
		stopped "this key is already on the router in another line; add-key leaves existing lines alone (remove that line by hand or use another label)"
	elif [[ $rc -ne 1 ]]; then
		STATE_NOTE='router unchanged'
		stopped "cannot check whether the key is on the router"
	fi
	new_line=$(restricted_line "$label" "$role" "$new_blob")
	if ! auth_append_line "$new_line"; then
		STATE_NOTE='router unchanged'
		stopped "cannot append the restricted key"
	fi
	appended=1
	rc=0
	if ! prove_restricted_key "$label" "$role" "$KEYFILE"; then
		if [[ $appended -eq 1 ]]; then
			removed=$(auth_remove_exact_line "$new_line") || {
				STATE_NOTE='the new line could not be removed again'
				stopped "the key failed its proofs"
			}
			if [[ "$removed" != "1" ]]; then
				STATE_NOTE='the new line could not be removed again'
				stopped "the key failed its proofs"
			fi
			if keypair_delete_if_made "$KEYFILE"; then
				:
			elif [[ $? -eq 2 ]]; then
				STATE_NOTE='router unchanged except the new key file could not be removed'
				stopped "the key failed its proofs"
			fi
			STATE_NOTE='router unchanged (the new line was removed again)'
		else
			STATE_NOTE='the existing line was left in place'
		fi
		stopped "the key failed its proofs"
	fi
	pass "add-key: key file $KEYFILE"
}

# Contract: action_add_key -- add_key_run with the global LABEL and ROLE
# and the final done_line; behaviour identical to the earlier version.
action_add_key() {
	add_key_run "$LABEL" "$ROLE"
	done_line
}

# Contract: action_revoke -- removes all router lines for LABEL, keeps any
# local key files, reports already-revoked idempotence, then reports done.
action_revoke() {
	local n keyfile files=''
	require_known_hosts
	n=$(auth_remove_label "$LABEL") || {
		STATE_NOTE='router unchanged'
		stopped "cannot revoke label $LABEL"
	}
	if [[ "$n" == "0" ]]; then
		pass "already revoked"
	else
		pass "revoked $n line(s) for $LABEL"
	fi
	keyfile="${KEYS_DIR}/${DEVICE}-${LABEL}"
	[[ -e "$keyfile" ]] && files="$keyfile"
	[[ -e "${keyfile}.pub" ]] && files="${files:+${files} }${keyfile}.pub"
	if [[ -n "$files" ]]; then
		info "local key files kept: $files"
	fi
	done_line
}

# Contract: action_profile -- the profile action (design
# 8.1): requires known_hosts, then puts the profile file
# (${R_NEWTON_DIR}/profile, mode 600) with PROFILE_VALUE and a final LF
# through put_text; when PUT_CHANGED=1 prints `PASS profile set to
# PROFILE_VALUE`, else `PASS profile already PROFILE_VALUE`; when
# PROFILE_VALUE differs from DEV_PROFILE prints the NOTE; a failed
# put_text sets STATE_NOTE='router unchanged' and stopped "cannot
# write the profile file"; ends with done_line.
action_profile() {
	require_known_hosts
	if [[ "$PROFILE_VALUE" != "$DEV_PROFILE" ]]; then
		note "the inventory says ${DEV_PROFILE}; the controller refuses a router whose profile differs"
	fi
	# here-string, not a pipe: the pipe would run put_text in a
	# subshell and PUT_CHANGED would never be visible in this shell
	put_text "${R_NEWTON_DIR}/profile" 600 <<<"$PROFILE_VALUE" \
		|| { STATE_NOTE='router unchanged'; stopped "cannot write the profile file"; }
	if [[ $PUT_CHANGED -eq 1 ]]; then
		pass "profile set to ${PROFILE_VALUE}"
	else
		pass "profile already ${PROFILE_VALUE}"
	fi
	done_line
}

# Contract: action_upgrade -- the upgrade action (design
# 8.5): requires known_hosts (no extra admin prompt: the parent shell
# prefetches the password on the password lane); the six steps of 3.7
# in order, each ending in `PASS upgrade step N: ...`; a refusal in
# step 2 ends in stopped; a failure from step 3 on first runs
# install_restore and then stopped "upgrade step N failed"; step 5
# adds a fresh-nonce hello_key (DEV_KEY_FILE must name an existing
# file; when it is empty the step prints the restricted-key-check
# NOTE); after all verification, restarts an already-enabled WAN-health
# daemon when this run changed one of its two files or a host-side marker
# says an earlier restart is pending (a disabled daemon is never started),
# then appends any SYSUPGRADE_LINES entry the router lacks
# (`PASS upgrade extras 3: ...`), then ends with
# `pass "upgrade: prog=<first 12 hex>"` and done_line; a second run with
# unchanged sources writes nothing
# (put_file skips identical files) and exits 0.
action_upgrade() {
	local nonce reply row rel sha_prog i n field want_sha name wan_rc entry
	local wan_health_changed=0 restart_marker
	local -a upgrade_rows=() hello_names=(prog helper guard init)
	if [[ "$DEV_ACCESS" == "no-install" ]]; then
		STATE_NOTE='router unchanged'
		stopped "this device uses no-install access; run ${BT}uninstall${BT} first"
	fi
	require_known_hosts
	install_check_sources
	pass "upgrade step 1: sources present"
	refuse_if_busy upgrade || stopped "upgrade step 2 failed"
	pass "upgrade step 2: router not busy"
	# step 3: upload program + helper always, guard + init only when idle
	upgrade_rows=("${CODE_FILES[0]}" "${CODE_FILES[1]}")
	if [[ $GUARD_IDLE -eq 1 ]]; then
		upgrade_rows+=("${CODE_FILES[2]}" "${CODE_FILES[3]}")
	fi
	INSTALL_REPLACED=()
	put_code_rows upgrade_rows \
		|| { install_restore; stopped "upgrade step 3 failed"; }
	pass "upgrade step 3: code files uploaded"
	# WAN-health extras: upload always (no guard-idle dependency); the
	# put_code_rows call populates INSTALL_REPLACED with a |prev entry
	# when the file already existed (R9b+c: extras rotate=yes), so
	# install_restore copies .prev back on a later failure instead of
	# rm -f'ing a working install.
	install_wan_health_files \
		|| { install_restore; stopped "upgrade extras 1 failed"; }
	pass "upgrade extras 1: wan-health code files uploaded"
	# put_code_rows appends a row only when put_file actually rewrote the
	# remote file, so this sees changed files without trusting .prev presence.
	for entry in "${INSTALL_REPLACED[@]}"; do
		if [[ "${entry%%|*}" == "${R_WANHEALTH}" \
			|| "${entry%%|*}" == "${R_WANHEALTH_INIT}" ]]; then
			wan_health_changed=1
			break
		fi
	done
	if ! install_wan_health_verify; then
		install_restore
		stopped "upgrade extras 2 failed"
	fi
	pass "upgrade extras 2: wan-health sha256 verified"
	if ! verify_hello "$GUARD_IDLE"; then
		install_restore
		stopped "upgrade step 4 failed"
	fi
	pass "upgrade step 4: hello verified"
	if [[ -n "$DEV_KEY_FILE" && -f "$DEV_KEY_FILE" ]]; then
		nonce=$(new_nonce)
		reply=$(hello_key "$DEV_KEY_FILE" "$nonce") || {
			install_restore; stopped "upgrade step 5 failed"; }
		# door=ssh, mode=prod and the same sha256
		# fields as step 4 (program and helper, plus guard and init
		# when step 3 handled them)
		if [[ "$(hello_field "$reply" door 2>/dev/null)" != "ssh" \
			|| "$(hello_field "$reply" mode 2>/dev/null)" != "prod" ]]; then
			install_restore
			stopped "upgrade step 5 failed"
		fi
		n=2
		[[ $GUARD_IDLE -eq 1 ]] && n=4
		for i in $(seq 0 $((n - 1))); do
			name="${hello_names[i]}"
			row="${CODE_FILES[i]}"
			rel="${row%%|*}"
			want_sha=$(sha256_file "${SRC}/${rel}")
			field=$(hello_field "$reply" "$name") || {
				install_restore; stopped "upgrade step 5 failed"; }
			[[ "$field" == "$want_sha" ]] || {
				install_restore; stopped "upgrade step 5 failed"; }
		done
		pass "upgrade step 5: restricted key checks pass"
	else
		info "restricted-key check skipped: no key_file in the inventory"
	fi
	# Activate only what was already enabled and changed: an operator-disabled
	# service stays disabled, while an enabled daemon must not keep running old
	# code. A restart also runs the daemon's restore path, so an unchanged
	# daemon is left alone during a no-op upgrade.
	restart_marker=$(wan_health_restart_pending_path) || {
		fail "upgrade wan-health restart: cannot resolve the pending marker"
		STATE_NOTE='the wan-health files are already upgraded; a pending restart could not be checked'
		stopped "upgrade wan-health restart marker failed"
	}
	if [[ -e "$restart_marker" ]]; then
		info "wan-health restart pending from an earlier upgrade"
		wan_health_changed=1
	fi
	if [[ $wan_health_changed -eq 1 ]]; then
		if ! wan_health_restart_pending_write; then
			fail "upgrade wan-health restart: cannot record pending restart"
			STATE_NOTE='the wan-health files are already upgraded; a pending restart could not be recorded'
			stopped "upgrade wan-health restart marker failed"
		fi
		wan_health_enabled
		wan_rc=$?
		case "$wan_rc" in
			0)
				if wan_health_restart; then
					if ! wan_health_restart_pending_clear; then
						fail "upgrade wan-health restart: cannot clear pending restart"
						STATE_NOTE='the enabled daemon restarted but its pending marker could not be removed'
						stopped "upgrade wan-health restart marker failed"
					fi
					pass "upgrade wan-health: enabled daemon restarted"
				else
					fail "upgrade wan-health restart: enabled daemon restart failed"
					STATE_NOTE='the wan-health files are already upgraded; the daemon was not restarted; rerunning upgrade will retry the restart; manually run /etc/init.d/newton-wan-health restart on the router, or reboot it; a manual restart does not clear the marker; the next upgrade restarts the daemon once more (harmless)'
					stopped "upgrade wan-health restart failed"
				fi
				;;
			1)
				if ! wan_health_restart_pending_clear; then
					fail "upgrade wan-health restart: cannot clear pending restart"
					STATE_NOTE='the wan-health init is not enabled but its pending marker could not be removed'
					stopped "upgrade wan-health restart marker failed"
				fi
				info "wan-health init not enabled; daemon not restarted"
				;;
			*)
				fail "upgrade wan-health restart: enabled state could not be read"
				STATE_NOTE='the wan-health files are already upgraded; the daemon enabled state is unknown; rerunning upgrade will retry the restart; manually run /etc/init.d/newton-wan-health restart on the router, or reboot it; a manual restart does not clear the marker; the next upgrade restarts the daemon once more (harmless)'
				stopped "upgrade wan-health restart failed"
				;;
		esac
	else
		info "wan-health files are unchanged; daemon not restarted"
	fi
	# a router installed before a line joined SYSUPGRADE_LINES gains it
	# here; install_sysupgrade appends only missing lines and writes
	# nothing when all are present. The code is already verified, so a
	# failure here stops without a restore. It runs after the WAN-health
	# restart, so a failure here cannot leave an enabled daemon on old
	# code with no pending marker for the rerun to find.
	if ! install_sysupgrade; then
		STATE_NOTE='the code is upgraded; /etc/sysupgrade.conf could not be updated'
		stopped "upgrade extras 3 failed"
	fi
	pass "upgrade extras 3: sysupgrade.conf lines present"
	# the success line shows the first 12 hex chars of the program sha
	row="${CODE_FILES[0]}"
	rel="${row%%|*}"
	sha_prog=$(sha256_file "${SRC}/${rel}")
	pass "upgrade: prog=${sha_prog:0:12}"
	done_line
}

# Contract: rollback_state_call -- ONE rsh_admin call (fixed text, ${RR}
# on every location, </dev/null) that for the program, helper and the two
# WAN-health files
# prints the basename-prefixed facts: <name>_exists=0|1, <name>_live=<sha>
# and <name>_prev=<sha> (empty when the file is absent); the exit status
# is the call's. Used by action_rollback to decide whether to refuse and
# which files to restore. Names come from the shell's `${f##*/}` (with a
# fixed `.init` suffix for the WAN-health init, whose remote basename would
# otherwise collide with its script) so the router-side command text only
# names the G0 tools (`basename` is not on that list, repair
# RC2 (c)).
rollback_state_call() {
	local script
	script=$(cat <<EOF
prog="${RR}${R_PROG}"
helper="${RR}${R_HELPER}"
wanhealth="${RR}${R_WANHEALTH}"
wanhealthinit="${RR}${R_WANHEALTH_INIT}"
for f in "\$prog" "\$helper" "\$wanhealth" "\$wanhealthinit"; do
	case "\$f" in
		"\$wanhealthinit") name=newton-wan-health.init ;;
		*) name=\${f##*/} ;;
	esac
	live_sha=""
	prev_sha=""
	exists=0
	if [ -e "\$f" ]; then
		live_sha=\$(sha256sum "\$f" 2>/dev/null | awk '{print \$1}')
	fi
	if [ -e "\${f}.prev" ]; then
		prev_sha=\$(sha256sum "\${f}.prev" 2>/dev/null | awk '{print \$1}')
		exists=1
	fi
	echo "\${name}_exists=\$exists"
	echo "\${name}_live=\$live_sha"
	echo "\${name}_prev=\$prev_sha"
done
EOF
	)
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: rollback_restore_one REMOTE -- the single rsh_admin call of
# action_rollback when a file's live sha256 differs from its .prev's:
# `cp -p REMOTE.prev REMOTE.new && chmod 755 REMOTE.new && mv REMOTE.new
# REMOTE` (fixed text, ${RR} on the locations, </dev/null); the exit
# status is the call's.
rollback_restore_one() {
	rsh_admin "cp -p \"${RR}$1.prev\" \"${RR}$1.new\" && chmod 755 \"${RR}$1.new\" && mv \"${RR}$1.new\" \"${RR}$1\"" </dev/null 2>/dev/null
}

# Contract: action_rollback -- the rollback action (design
# 8.6): require_known_hosts, ONE state-gathering rsh_admin call (the
# program, helper and two WAN-health files, basenames from their rows); when
# the call fails or neither core file has a `.prev`: STATE_NOTE='router
# unchanged (no .prev to roll back to)' and stopped "nothing to roll
# back to". For each file: when `.prev` is absent, info "<NAME> has no
# .prev" and no write; when live equals `.prev`, info "<NAME> already
# equals .prev" and no write; else ONE rollback_restore_one rsh_admin
# call. When either WAN-health file changed and its init is enabled, a
# checked restart follows. After the files: a fresh-nonce hello_direct;
# failure sets
# STATE_NOTE to the list of restored files and "hello after rollback:
# failed" and stopped "hello failed after the rollback"; success prints
# "PASS rollback: prog=<first 12 hex of prog sha256> helper=<first 12
# hex of helper sha256>" from the hello fields and done_line. A second
# run when both files already equal `.prev` writes nothing and exits 0.
# After the WAN-health restore/restart decision, the device's host-side
# restart-pending marker is cleared; a clear failure only prints FAIL.
action_rollback() {
	require_known_hosts
	local out restored='' wan_restored=0 wan_rc restart_marker
	local prog_exists='' prog_live='' prog_prev=''
	local helper_exists='' helper_live='' helper_prev=''
	local wan_exists='' wan_live='' wan_prev=''
	local wan_init_exists='' wan_init_live='' wan_init_prev=''
	out=$(rollback_state_call) || {
		STATE_NOTE='router unchanged (no .prev to roll back to)'
		stopped "nothing to roll back to"
	}
	while IFS= read -r line; do
		case "$line" in
			newton-router_exists=*) prog_exists="${line#newton-router_exists=}" ;;
			newton-router_live=*) prog_live="${line#newton-router_live=}" ;;
			newton-router_prev=*) prog_prev="${line#newton-router_prev=}" ;;
			newton-safe-apply_exists=*) helper_exists="${line#newton-safe-apply_exists=}" ;;
			newton-safe-apply_live=*) helper_live="${line#newton-safe-apply_live=}" ;;
			newton-safe-apply_prev=*) helper_prev="${line#newton-safe-apply_prev=}" ;;
			newton-wan-health_exists=*) wan_exists="${line#newton-wan-health_exists=}" ;;
			newton-wan-health_live=*) wan_live="${line#newton-wan-health_live=}" ;;
			newton-wan-health_prev=*) wan_prev="${line#newton-wan-health_prev=}" ;;
			newton-wan-health.init_exists=*) wan_init_exists="${line#newton-wan-health.init_exists=}" ;;
			newton-wan-health.init_live=*) wan_init_live="${line#newton-wan-health.init_live=}" ;;
			newton-wan-health.init_prev=*) wan_init_prev="${line#newton-wan-health.init_prev=}" ;;
		esac
	done <<<"$out"
	if [[ "$prog_exists" != "1" && "$helper_exists" != "1" ]]; then
		STATE_NOTE='router unchanged (no .prev to roll back to)'
		stopped "nothing to roll back to"
	fi
	if [[ "$prog_exists" == "1" ]]; then
		if [[ "$prog_live" == "$prog_prev" ]]; then
			info "newton-router already equals .prev"
		elif rollback_restore_one "$R_PROG"; then
			restored="${restored}newton-router "
		else
			STATE_NOTE="the restore of newton-router failed; the router may be in a partial state"
			stopped "rollback failed for newton-router"
		fi
	else
		info "newton-router has no .prev"
	fi
	if [[ "$helper_exists" == "1" ]]; then
		if [[ "$helper_live" == "$helper_prev" ]]; then
			info "newton-safe-apply already equals .prev"
		elif rollback_restore_one "$R_HELPER"; then
			restored="${restored}newton-safe-apply "
		else
			STATE_NOTE="the restore of newton-safe-apply failed; the router may be in a partial state"
			stopped "rollback failed for newton-safe-apply"
		fi
	else
		info "newton-safe-apply has no .prev"
	fi
	if [[ "$wan_exists" == "1" ]]; then
		if [[ "$wan_live" == "$wan_prev" ]]; then
			info "newton-wan-health already equals .prev"
		elif rollback_restore_one "$R_WANHEALTH"; then
			restored="${restored}newton-wan-health "
			wan_restored=1
		else
			STATE_NOTE="the restore of newton-wan-health failed; the router may be in a partial state"
			stopped "rollback failed for newton-wan-health"
		fi
	else
		info "newton-wan-health has no .prev"
	fi
	if [[ "$wan_init_exists" == "1" ]]; then
		if [[ "$wan_init_live" == "$wan_init_prev" ]]; then
			info "newton-wan-health.init already equals .prev"
		elif rollback_restore_one "$R_WANHEALTH_INIT"; then
			restored="${restored}newton-wan-health.init "
			wan_restored=1
		else
			STATE_NOTE="the restore of newton-wan-health.init failed; the router may be in a partial state"
			stopped "rollback failed for newton-wan-health.init"
		fi
	else
		info "newton-wan-health.init has no .prev"
	fi
	if [[ $wan_restored -eq 1 ]]; then
		wan_health_enabled
		wan_rc=$?
		case "$wan_rc" in
			0)
				if ! wan_health_restart; then
					STATE_NOTE="restored from .prev: ${restored% }; wan-health restart failed"
					stopped "rollback failed for wan-health restart"
				fi
				;;
			1)
				# A disabled service is not started by rollback.
				;;
			*)
				STATE_NOTE="restored from .prev: ${restored% }; the wan-health enabled state is unknown"
				stopped "cannot tell whether wan-health is enabled"
				;;
		esac
	fi
	restart_marker=$(wan_health_restart_pending_path) \
		|| restart_marker=''
	if ! wan_health_restart_pending_clear; then
		fail "rollback wan-health restart marker: cannot clear ${restart_marker:-the pending marker}"
	fi
	local nonce reply prog_sha helper_sha
	nonce=$(new_nonce)
	if ! reply=$(hello_direct "$nonce"); then
		if [[ -n "$restored" ]]; then
			STATE_NOTE="restored from .prev: ${restored% }; hello after rollback: failed"
		else
			STATE_NOTE="hello after rollback: failed"
		fi
		stopped "hello failed after the rollback"
	fi
	prog_sha=$(hello_field "$reply" prog) || {
		if [[ -n "$restored" ]]; then
			STATE_NOTE="restored from .prev: ${restored% }; hello after rollback: missing prog field"
		else
			STATE_NOTE="hello after rollback: missing prog field"
		fi
		stopped "hello failed after the rollback"
	}
	helper_sha=$(hello_field "$reply" helper) || {
		if [[ -n "$restored" ]]; then
			STATE_NOTE="restored from .prev: ${restored% }; hello after rollback: missing helper field"
		else
			STATE_NOTE="hello after rollback: missing helper field"
		fi
		stopped "hello failed after the rollback"
	}
	pass "rollback: prog=${prog_sha:0:12} helper=${helper_sha:0:12}"
	done_line
}

# Contract: uninstall_check_guard -- ONE rsh_admin call (fixed text,
# ${RR} on the location, </dev/null) that prints guard=<status> when the
# guard file is present (its first line of `${RR}${R_GUARD} status 2>/dev/null`)
# or guard=not-installed when it is missing; returns 0 when the value is
# exactly `idle` or `not-installed`, 1 when the value is anything else, and
# 2 when the ssh call itself failed (so the caller can tell a wrong root
# password on the password lane apart from a guard that is not idle).
uninstall_check_guard() {
	local out rc status
	out=$(rsh_admin "if [ -e '${RR}${R_GUARD}' ]; then echo \"guard=\$('${RR}${R_GUARD}' status 2>/dev/null)\"; else echo \"guard=not-installed\"; fi" </dev/null 2>/dev/null)
	rc=$?
	[[ $rc -ne 0 ]] && return 2
	status="${out#guard=}"
	if [[ "$status" == "not-installed" || "$status" == "idle" ]]; then
		return 0
	fi
	return 1
}

# Contract: uninstall_authorized_keys -- ONE rsh_admin call (fixed text,
# ${RR} on the location, </dev/null) that, before removal, prints one
# `removed_key=<caller> <role>` record for every matching line (`-` for a
# missing argument), then builds authorized_keys.new from the live file with
# `grep -vF -e '<pattern1>' -e '<pattern2'>` (the two fixed strings are the
# exact `command="/usr/libexec/newton/newton-router ` with trailing space and
# `command="/usr/libexec/newton/newton-router"`), checks that the count fell by
# exactly the number of matching lines (grep -cF), chmod 600 the .new and mv it
# over the live file; when no line matches the patterns the .new is never
# created and the live file is left alone; every other line stays byte for
# byte. The host captures the records in UNINSTALL_REMOVED_KEYS; it never
# prints an unvalidated field. The grep -vF exit status is captured and only
# rc > 1 is an error (rc 1 = no match, which is fine when every line was a
# Newton line (a)).
UNINSTALL_REMOVED_KEYS=''
uninstall_authorized_keys() {
	local script out rc
	UNINSTALL_REMOVED_KEYS=''
	script=$(cat <<EOF
f="${RR}${R_AUTH_KEYS}"
n="\${f}.new"
before=\$(grep -c '' "\$f" 2>/dev/null)
before=\${before:-0}
matches=\$(grep -cF -e 'command="/usr/libexec/newton/newton-router ' -e 'command="/usr/libexec/newton/newton-router"' "\$f" 2>/dev/null)
matches=\${matches:-0}
[ "\$matches" -gt 0 ] 2>/dev/null || { rm -f "\$n"; exit 0; }
awk '
index(\$0, "command=\"/usr/libexec/newton/newton-router ") || index(\$0, "command=\"/usr/libexec/newton/newton-router\"") {
	caller = "-"
	role = "-"
	if (match(\$0, /--caller=[^ "]+/))
		caller = substr(\$0, RSTART + 9, RLENGTH - 9)
	if (match(\$0, /--role=[^ "]+/))
		role = substr(\$0, RSTART + 7, RLENGTH - 7)
	print "removed_key=" caller " " role
}' "\$f" || { rm -f "\$n"; exit 1; }
grep -vF -e 'command="/usr/libexec/newton/newton-router ' -e 'command="/usr/libexec/newton/newton-router"' "\$f" > "\$n"
rc=\$?
[ "\$rc" -le 1 ] || { rm -f "\$n"; exit 1; }
after=\$(grep -c '' "\$n")
removed=\$((before - after))
[ "\$removed" -eq "\$matches" ] || { rm -f "\$n"; exit 1; }
chmod 600 "\$n" || { rm -f "\$n"; exit 1; }
mv "\$n" "\$f" || { rm -f "\$n"; exit 1; }
EOF
	)
	out=$(rsh_admin "$script" </dev/null 2>/dev/null)
	rc=$?
	[[ $rc -eq 0 ]] || return "$rc"
	UNINSTALL_REMOVED_KEYS="$out"
}

# Contract: uninstall_init_disable -- ONE rsh_admin call (fixed text,
# ${RR} on the location, </dev/null) that runs
# `${RR}/etc/init.d/newton-guard disable` when that file exists; the
# exit status is 0 when the file is missing and the call's exit status
# when it is present (the guard's disable also removes
# /etc/rc.d/S09newton-guard on real hardware).
uninstall_init_disable() {
	rsh_admin "if [ -e '${RR}${R_INIT}' ]; then '${RR}${R_INIT}' disable; fi" </dev/null 2>/dev/null
}

# Contract: uninstall_wan_health_init -- TWO checked rsh_admin calls (fixed
# text, ${RR} on each location, </dev/null): wan_health_stop, then only after
# a successful stop wan_health_disable, so the procd-managed instance
# releases the WAN-health runtime state before its files are removed. An
# absent init is success for both; return 2 means stop failed, 1 means
# disable failed, and 0 means both succeeded.
uninstall_wan_health_init() {
	local rc
	wan_health_stop
	rc=$?
	if [[ $rc -ne 0 ]]; then
		return 2
	fi
	wan_health_disable || return 1
}

# Contract: uninstall_rm_files -- ONE rsh_admin call (fixed text, ${RR}
# on every location, </dev/null) that runs `rm -f` on the program, the
# helper, the guard, the init, the two core `.prev` files, the two WAN
# health files and their two `.prev` files; /etc/config/newton_wanhealth is
# left in place (user data,
# not touched by uninstall); the exit status is the call's.
uninstall_rm_files() {
	rsh_admin "rm -f '${RR}${R_PROG}' '${RR}${R_PROG}.prev' '${RR}${R_HELPER}' '${RR}${R_HELPER}.prev' '${RR}${R_GUARD}' '${RR}${R_INIT}' '${RR}${R_WANHEALTH}' '${RR}${R_WANHEALTH}.prev' '${RR}${R_WANHEALTH_INIT}' '${RR}${R_WANHEALTH_INIT}.prev'" </dev/null 2>/dev/null
}

# Contract: uninstall_sysupgrade -- ONE rsh_admin call (fixed text,
# ${RR} on the location, </dev/null) that removes exactly the lines of
# SYSUPGRADE_LINES from ${RR}/etc/sysupgrade.conf with one `-e` per
# line of `grep -vxF`; every `-e` is built in a for-loop over the array
# rather than by hardcoded indexes so a count change is picked up here
# without a code edit. When the file does not exist the call exits 0
# without creating it; when no SYSUPGRADE_LINES line is present the
# .new is never created and the live file is left alone; the .new is
# otherwise mv'd over the live file; all other lines keep their order.
# The exit status is the call's. The grep -vxF exit status is captured
# and only rc > 1 is an error (rc 1 = no match, which is fine when the
# file holds only the Newton lines (b)).
uninstall_sysupgrade() {
	local script
	script=$(cat <<EOF
f="${RR}/etc/sysupgrade.conf"
n="\${f}.new"
[ -e "\$f" ] || exit 0
matched=0
for want in ${SYSUPGRADE_LINES[*]}; do
	if grep -qxF "\$want" "\$f"; then matched=1; break; fi
done
[ "\$matched" -eq 1 ] || exit 0
set --
for want in ${SYSUPGRADE_LINES[*]}; do
	set -- "\$@" -e "\$want"
done
grep -vxF "\$@" "\$f" > "\$n"
rc=\$?
[ "\$rc" -le 1 ] || { rm -f "\$n"; exit 1; }
mv "\$n" "\$f" || { rm -f "\$n"; exit 1; }
EOF
	)
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: uninstall_config -- ONE rsh_admin call (fixed text, ${RR} on
# every location, </dev/null) that runs `rm -f` on device-id, profile,
# zones and approve.key under ${RR}/etc/newton; /etc/newton/lkg and
# /etc/newton/quarantine are never touched and no directory is removed;
# the exit status is the call's.
uninstall_config() {
	rsh_admin "rm -f '${RR}/etc/newton/device-id' '${RR}/etc/newton/profile' '${RR}/etc/newton/zones' '${RR}/etc/newton/approve.key'" </dev/null 2>/dev/null
}

# Contract: action_uninstall -- the uninstall action (design 8.7): require_known_hosts, then (1) one uninstall_check_guard
# rsh_admin call (the guard file missing or its status exactly `idle`
# goes on; rc=1: STATE_NOTE='router unchanged' and stopped "uninstall
# refused: the guard is not idle"; rc=2: STATE_NOTE='router unchanged'
# and stopped "cannot read the guard status"); (2) password_only_proof
# (on failure: STATE_NOTE='router unchanged' and stopped "the
# password-only login failed; nothing was removed"); (3) the five
# idempotent steps each ending in `PASS uninstall step N: ...` (a
# failing router call sets STATE_NOTE='uninstall stopped half way; run
# it again' and stops); (4) password_only_proof again (on failure:
# STATE_NOTE='everything was removed but the password-only login failed
# afterwards' and stopped "the password-only login failed after the
# removal"); (5) done_line. A second run on a router whose Newton files
# are already gone writes nothing new and exits 0 (the guard file is
# gone so step 1 sees `not-installed` and the remaining steps find
# nothing to remove). After the WAN-health files are removed, the
# device's host-side restart-pending marker is cleared; a clear failure
# only prints FAIL and uninstall continues.
#
# A device in the no-install mode (ADR-021 point 8) has nothing of
# Newton on the router: the no-install teardown runs instead, and it
# removes the rpcd login section, the rpcd sessions and the host-side
# credentials.
action_uninstall() {
	local restart_marker line fields label role
	if [[ "$DEV_ACCESS" == "no-install" ]]; then
		uninstall_no_install
		return 0
	fi
	require_known_hosts
	uninstall_check_guard
	rc=$?
	case "$rc" in
		0) ;;
		1)
			STATE_NOTE='router unchanged'
			stopped "uninstall refused: the guard is not idle"
			;;
		2)
			STATE_NOTE='router unchanged'
			stopped "cannot read the guard status"
			;;
	esac
	if ! password_only_proof; then
		STATE_NOTE='router unchanged'
		stopped "the password-only login failed; nothing was removed"
	fi
	if ! uninstall_authorized_keys; then
		STATE_NOTE='uninstall stopped half way; run it again'
		stopped "uninstall step 1 failed"
	fi
	pass "uninstall step 1: authorized_keys cleaned"
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		case "$line" in
			removed_key=*)
				fields=${line#removed_key=}
				label=${fields%% *}
				role=${fields#* }
				if valid_label "$label" && valid_role "$role"; then
					info "removed Newton key ${label} (role ${role}); to restore it, on the Newton host that holds this key run: sudo -u newton /usr/local/bin/newton-router-setup ${DEVICE} add-key ${label} ${role}"
				elif valid_label "$label"; then
					warn "removed Newton key ${label} whose role cannot be read; re-add it with add-key ${label} <role>"
				else
					warn "removed a Newton key whose label or role cannot be read; re-add it with add-key"
				fi
				;;
			*)
				;;
		esac
	done <<<"$UNINSTALL_REMOVED_KEYS"
	if ! uninstall_init_disable; then
		STATE_NOTE='uninstall stopped half way; run it again'
		stopped "uninstall step 2 failed"
	fi
	pass "uninstall step 2: init disabled"
	# WAN-health init: same shape as uninstall_init_disable but with stop
	# before disable, so the procd-managed instance releases its state.
	# `rm -f` of both wan-health files is part of step 3 below.
	uninstall_wan_health_init
	rc=$?
	case "$rc" in
		0) ;;
		2)
			STATE_NOTE='wan-health stop failed; no code files removed; run uninstall again'
			stopped "uninstall step 2a failed"
			;;
		*)
			STATE_NOTE='wan-health disable failed; no code files removed; run uninstall again'
			stopped "uninstall step 2a failed"
			;;
	esac
	pass "uninstall step 2a: wan-health init stopped and disabled"
	if ! uninstall_rm_files; then
		STATE_NOTE='uninstall stopped half way; run it again'
		stopped "uninstall step 3 failed"
	fi
	pass "uninstall step 3: code files removed"
	restart_marker=$(wan_health_restart_pending_path) \
		|| restart_marker=''
	if ! wan_health_restart_pending_clear; then
		fail "uninstall wan-health restart marker: cannot clear ${restart_marker:-the pending marker}"
	fi
	if ! uninstall_sysupgrade; then
		STATE_NOTE='uninstall stopped half way; run it again'
		stopped "uninstall step 4 failed"
	fi
	pass "uninstall step 4: sysupgrade.conf cleaned"
	if ! uninstall_config; then
		STATE_NOTE='uninstall stopped half way; run it again'
		stopped "uninstall step 5 failed"
	fi
	pass "uninstall step 5: config files removed"
	if ! password_only_proof; then
		STATE_NOTE='everything was removed but the password-only login failed afterwards'
		stopped "the password-only login failed after the removal"
	fi
	done_line
}

# Contract: lab_snapshot_config_preflight -- validate the lab profile, PVE
# settings, approval passphrase file and gates command without contacting
# the router; set PASSPHRASE_FILE and the PVE globals for the action.
lab_snapshot_config_preflight() {
	local pp
	[[ "$DEV_PROFILE" == "lab" ]] \
		|| die "lab-snapshot works only on a device whose inventory profile is lab"
	pve_load
	pp=$(lab_toml_get ssh approve_passphrase_file)
	[[ -n "$pp" ]] \
		|| die "lab-snapshot needs lab.toml's ssh.approve_passphrase_file to be set"
	[[ -r "$pp" ]] \
		|| die "lab-snapshot: cannot read approve_passphrase_file: $pp"
	PASSPHRASE_FILE="$pp"
	if [[ -n "$GATES_CMD" ]]; then
		valid_path_chars "$GATES_CMD" \
			|| die "lab-snapshot --gates-cmd: bad characters in path: $GATES_CMD"
		[[ -x "$GATES_CMD" && -f "$GATES_CMD" ]] \
			|| die "lab-snapshot --gates-cmd: no such executable file: $GATES_CMD"
	fi
}

# Contract: lab_snapshot_preflight -- run lab_snapshot_config_preflight,
# resolve every label, run local_key_rule for every one, and with NEW_KEY
# make only the still-missing pairs; set LAB_LABELS for the action.  No
# router call is made.
lab_snapshot_preflight() {
	local label
	local -a wanted=()
	LAB_LABELS=()
	lab_snapshot_config_preflight
	IFS=',' read -ra wanted <<<"$LABELS"
	for label in "${wanted[@]}"; do
		LAB_LABELS+=("$label")
		local_key_rule "$label"
	done
	for label in "${LAB_LABELS[@]}"; do
		keypair_path "$label"
		if [[ ! -f "$KEYFILE" && $NEW_KEY -eq 1 ]]; then
			keypair_create "$label"
		fi
	done
}

# Contract: action_lab_snapshot -- the lab-snapshot action, in order: pre-flight checks; the shared block (router_disclosure_block)
# and the install; add-key for each label; approval-key; repeat the
# restricted-key proofs; gates; PVE snapshot.
action_lab_snapshot() {
	local label version name upid body nonce rc
	local -a labels=()
	# 1. pre-flight checks, all before any router call
	lab_snapshot_preflight
	# 2. the same block the install action prints, then the install.
	# The block is printed here too: the lab owner reads the same facts the
	# install shows.  It does NOT ask the "yes" question, because this
	# action is the unattended lab path: lab_snapshot_preflight refuses
	# every device whose inventory profile is not lab, --password-file is
	# allowed only on a lab profile (choose_admin_path), the lab mode was
	# agreed when the lab was set up, and the runner drives this action
	# with no owner at the terminal.  A question here would stop the run
	# and take the lab down.
	router_disclosure_block "$SRC" || die "cannot measure the files to install"
	install_run
	# 3. add-key for each label resolved by the preflight (the default
	# label falls back to the label the router was enrolled with, so an
	# old router gets no second key)
	labels=("${LAB_LABELS[@]}")
	for label in "${labels[@]}"; do
		add_key_run "$label" change
	done
	# 4. approval-key
	approval_key_run
	# 5. re-prove every key now that approve.key is on the router
	for label in "${labels[@]}"; do
		if ! prove_restricted_key "$label" change "${KEYS_DIR}/${DEVICE}-${label}"; then
			STATE_NOTE='the router work is done but the proofs failed'
			stopped "a key failed its proofs after the approval key was set"
		fi
	done
	# 6. gates
	if [[ $SKIP_GATES -eq 1 ]]; then
		warn "gates skipped"
	else
		STATE_NOTE='router work done; the snapshot was NOT taken'
		# CMD's stdout goes to stderr (the run's notes); stdin from
		# /dev/null; non-zero exit stops the action.
		if ! "$GATES_CMD" "$DEVICE" </dev/null >&2; then
			stopped "the gates failed"
		fi
	fi
	# 7. snapshot
	nonce=$(new_nonce)
	body=$(hello_direct "$nonce") || {
		STATE_NOTE='router work done; the snapshot was NOT taken'
		stopped "the Proxmox snapshot failed: hello_direct failed"
	}
	version=$(hello_field "$body" version) || {
		STATE_NOTE='router work done; the snapshot was NOT taken'
		stopped "the Proxmox snapshot failed: no version in hello"
	}
	name=$(pve_snapshot_name "$version")
	url="https://${PVE_HOST}:8006/api2/json/nodes/${PVE_NODE}/qemu/${PVE_VMID}/snapshot"
	# Flush the router's disk so files written right before the snapshot
	# (e.g. /etc/newton/approve.key) are committed; a snapshot taken before
	# the flush can lose data on rollback. Stdin from /dev/null (rule 2.2).
	if ! rsh_admin sync </dev/null; then
		STATE_NOTE='router work done; the snapshot was NOT taken'
		stopped "the router sync failed; no snapshot was taken"
	fi
	rc=0
	body=$(pve_request POST "$url" "snapname=${name}" 2>/dev/null) || rc=$?
	if [[ $rc -ne 0 ]]; then
		info "the Proxmox snapshot name $name is used once; an existing one must be deleted in Proxmox first"
		STATE_NOTE='router work done; the snapshot was NOT taken'
		stopped "the Proxmox snapshot $name failed"
	fi
	upid=$(printf '%s' "$body" | pve_json_field data) || upid=''
	if [[ -z "$upid" ]]; then
		STATE_NOTE='router work done; the snapshot was NOT taken'
		stopped "the Proxmox snapshot $name failed"
	fi
	if ! pve_wait_task "$upid"; then
		STATE_NOTE='router work done; the snapshot was NOT taken'
		stopped "the Proxmox snapshot $name failed"
	fi
	# 8. done
	pass "snapshot $name created"
	info "next: point lab.toml's snapshot for $DEVICE at $name"
	unset PVE_TOKEN
	done_line
}

# state for the ssh layer and secrets, filled by the functions that came first
STRICT=''
TTY_FD=''
ROOT_PW=''
ROOT_PW_DONE=0
ASKPASS=''
SSH_OPTS=()

# Contract: new_nonce -- prints 32 lowercase hex characters read from
# /dev/urandom (no external program beyond od and tr) as one line on stdout.
new_nonce() {
	local hex
	hex=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
	printf '%s\n' "$hex"
}

# Contract: sha256_file FILE -- prints the sha256 of FILE (64 lowercase hex)
# on stdout; exit 2 with "error: ..." on stderr when the file cannot be read.
sha256_file() {
	local out
	out=$(sha256sum -- "$1") || die "cannot hash $1"
	printf '%s\n' "${out%% *}"
}

# Contract: wait_router SECONDS -- waits SECONDS of router time by running
# "$SLEEP" SECONDS (the SLEEP seam, else sleep); the exit status is its.
wait_router() {
	"$SLEEP" "$1"
}

# Contract: wait_local SECONDS -- waits SECONDS with the real sleep; the only
# other wait of the tool is wait_router.
wait_local() {
	sleep "$1"
}

# Contract: read_secret VARNAME PROMPT -- prints PROMPT on stderr and reads
# one line without echo into the shell variable VARNAME; production reads
# from /dev/tty (read -rs), with seams the next line of the NEWTON_SETUP_TTY
# stream opened once by init; no terminal or no line left: "error: ..." on
# stderr, exit 2; the value is never exported, printed or written to a file.
read_secret() {
	local var="$1" line
	printf '%s' "$2" >&2
	if [[ $SEAMS -eq 1 && -n "${NEWTON_SETUP_TTY:-}" ]]; then
		IFS= read -r -u "$TTY_FD" line || die "no line left in the typed-input file"
	else
		[[ -r /dev/tty ]] || die 'needs a terminal'
		IFS= read -rs line </dev/tty || die 'no line read from the terminal'
		printf '\n' >&2
	fi
	printf -v "$var" '%s' "$line"
}

# Contract: has_terminal -- exit 0 when this run can ask the owner a
# question: with the typed-input seam (the TTY_FD of init) yes, in
# production when /dev/tty is readable.
has_terminal() {
	if [[ $SEAMS -eq 1 && -n "${TTY_FD:-}" ]]; then
		return 0
	fi
	# -r alone is true without a controlling terminal; opening proves it
	{ : </dev/tty; } 2>/dev/null
}

# Contract: answer_timeout -- no arguments; prints the number of seconds
# a question waits for its answer before it gives up.  Production: 300
# (five minutes).  With the seams the value may be lowered
# (NEWTON_SETUP_ANSWER_TIMEOUT) so that a test need not wait five
# minutes; the seam gate refuses a value that is not a whole number of
# seconds between 1 and 300.
answer_timeout() {
	if [[ $SEAMS -eq 1 && -n "${NEWTON_SETUP_ANSWER_TIMEOUT:-}" ]]; then
		printf '%s' "$NEWTON_SETUP_ANSWER_TIMEOUT"
		return 0
	fi
	printf '300'
}

# Contract: read_answer VAR -- reads one answer line into VAR and never
# fails: with the typed-input seam (TTY_FD open) the next line of that
# stream, and an empty answer when no line is left (a run that asked no
# question must not die on it); in production one line from /dev/tty
# when that is readable, else an empty answer.  The read is bounded
# (answer_timeout): a terminal that never answers must not stop a run
# for ever.  The answer is not a secret, so it is echoed and never
# written to a file.
read_answer() {
	local var="$1" line='' timeout=''
	timeout=$(answer_timeout)
	if [[ $SEAMS -eq 1 && -n "${TTY_FD:-}" ]]; then
		IFS= read -r -t "$timeout" -u "$TTY_FD" line || line=''
	else
		if [[ -r /dev/tty ]]; then
			IFS= read -r -t "$timeout" line </dev/tty || line=''
		fi
	fi
	printf -v "$var" '%s' "$line"
}

# Contract: admin_password_get -- fills ROOT_PW with the router root
# password, once per run: with --password-file one line read from that file,
# else one read_secret prompt; sets ROOT_PW_DONE; exit 2 when the file
# cannot be read or the prompt dies.
admin_password_get() {
	if [[ $ROOT_PW_DONE -eq 1 ]]; then
		return 0
	fi
	if [[ -n "$PASSWORD_FILE" ]]; then
		ROOT_PW=''
		if ! IFS= read -r ROOT_PW <"$PASSWORD_FILE"; then
			[[ -n "$ROOT_PW" ]] || die "cannot read --password-file: $PASSWORD_FILE"
		fi
	else
		read_secret ROOT_PW 'root password: '
	fi
	ROOT_PW_DONE=1
}

# Contract: askpass_prepare -- writes the askpass script into TMP_DIR
# (mode 0700) and sets ASKPASS to its path; with --password-file the script
# is "exec cat -- FILE", otherwise "exec cat -- TMP_DIR/askpass.fifo".
askpass_prepare() {
	ASKPASS="${TMP_DIR}/askpass"
	if [[ -n "$PASSWORD_FILE" ]]; then
		printf '#!/bin/sh\nexec cat -- "%s"\n' "$PASSWORD_FILE" >"$ASKPASS" || die "cannot write the askpass script"
	else
		printf '#!/bin/sh\nexec cat -- "%s"\n' "${TMP_DIR}/askpass.fifo" >"$ASKPASS" || die "cannot write the askpass script"
	fi
	chmod 700 -- "$ASKPASS"
}

# Contract: ssh_base_opts [PORTFLAG] -- (re)fills the array SSH_OPTS with the
# common options of 2.2: -F /dev/null, the port as -p for ssh (-P for scp
# and sftp when PORTFLAG is -P), ConnectTimeout=8, ServerAliveInterval=5,
# ServerAliveCountMax=2, ControlMaster=no, ControlPath=none,
# GlobalKnownHostsFile=/dev/null, UserKnownHostsFile=<known_hosts_file>,
# StrictHostKeyChecking=${STRICT:-yes} and ProxyCommand when the inventory
# has one.
ssh_base_opts() {
	local portflag='-p' kh
	[[ "${1:-}" == '-P' ]] && portflag='-P'
	kh=$(known_hosts_file)
	SSH_OPTS=(-F /dev/null "$portflag" "$DEV_PORT" -o ConnectTimeout=8 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 -o ControlMaster=no -o ControlPath=none -o GlobalKnownHostsFile=/dev/null -o UserKnownHostsFile="$kh" -o "StrictHostKeyChecking=${STRICT:-yes}")
	if [[ -n "$DEV_PROXY" ]]; then
		SSH_OPTS+=(-o "ProxyCommand=$DEV_PROXY")
	fi
}

# Rule: a caller without data redirects stdin from /dev/null (2.2).
#
# Contract: ssh_err_tail -- leaves the last non-empty line of
# $SSH_ERR_FILE in SSH_ERR_TAIL (the raw text; the caller escapes it);
# SSH_ERR_TAIL stays empty when there is no file or no line.
ssh_err_tail() {
	SSH_ERR_TAIL=''
	[[ -n "$SSH_ERR_FILE" && -s "$SSH_ERR_FILE" ]] || return 0
	SSH_ERR_TAIL=$(grep -v '^[[:space:]]*$' -- "$SSH_ERR_FILE" 2>/dev/null | tail -n 1) || true
	return 0
}

# Contract: admin_lane_run LANE ARG... -- runs the admin lane with its
# stderr in $SSH_ERR_FILE (the file rsh_admin reads the reason from), or
# with the stderr passing through when there is no such file; the lane's
# stdout passes through and the exit status is the lane's.
admin_lane_run() {
	if [[ -n "$SSH_ERR_FILE" ]]; then
		"$@" 2>"$SSH_ERR_FILE"
	else
		"$@"
	fi
}

# Contract: rsh_key KEYFILE CMD -- runs the command string CMD once on the
# router over the key lane (the common options plus -i KEYFILE,
# IdentitiesOnly=yes, BatchMode=yes, PreferredAuthentications=publickey,
# PasswordAuthentication=no), destination root@HOST, under timeout 60; the
# caller's stdin, stdout and stderr pass through; the exit status is ssh's.
rsh_key() {
	ssh_base_opts
	timeout --foreground 60 ssh "${SSH_OPTS[@]}" -i "$1" -o IdentitiesOnly=yes -o BatchMode=yes -o PreferredAuthentications=publickey -o PasswordAuthentication=no "root@$DEV_HOST" "$2"
}

# Contract: rsh_pw CMD -- runs CMD once on the router over the password lane
# (the common options plus BatchMode=no,
# PreferredAuthentications=password,keyboard-interactive,
# PubkeyAuthentication=no, NumberOfPasswordPrompts=1) under timeout 60; the
# password comes from admin_password_get and reaches ssh through a per-call
# FIFO askpass (mkfifo -m 600, background writer, SSH_ASKPASS,
# SSH_ASKPASS_REQUIRE=force and DISPLAY set for this one call only, then the
# writer is killed and reaped without noise and the fifo removed); the
# caller's stdio passes through; the exit status is ssh's.
rsh_pw() {
	local cmd="$1" fifo wr rc
	ssh_base_opts
	admin_password_get
	askpass_prepare
	fifo="${TMP_DIR}/askpass.fifo"
	mkfifo -m 600 -- "$fifo" || die "cannot create the askpass fifo"
	printf '%s\n' "$ROOT_PW" >"$fifo" &
	wr=$!
	rc=0
	SSH_ASKPASS="$ASKPASS" SSH_ASKPASS_REQUIRE=force DISPLAY="${DISPLAY:-x}" \
		timeout --foreground 60 ssh "${SSH_OPTS[@]}" -o BatchMode=no -o PreferredAuthentications=password,keyboard-interactive -o PubkeyAuthentication=no -o NumberOfPasswordPrompts=1 "root@$DEV_HOST" "$cmd" || rc=$?
	kill "$wr" 2>/dev/null || true
	wait "$wr" 2>/dev/null || true
	rm -f -- "$fifo"
	return "$rc"
}

# Contract: rsh_admin CMD -- runs CMD once on the router over the admin path:
# the plain-key lane with $PLAIN_KEY when ADMIN_MODE is plain-key, else the
# password lane; the caller's stdout passes through; the exit status is the
# lane's.
#
# This is the one place every admin caller routes through, so the
# login failure is caught here and not in one caller: the admin calls sit
# inside a command substitution, so their stderr never reached the owner
# and a refused login ended in a bare STOPPED line.  The lane's stderr goes
# into $SSH_ERR_FILE here.
#
# The remote command is prefixed with the fixed marker
# (`echo NEWTON-ADMIN-SESSION >&2;`): the marker reaches the client only
# when the login worked and the remote command ran.  So an exit 255 WITH
# the marker is the remote command's own status (an init script that
# failed) and an exit 255 WITHOUT it is a connect or authentication
# failure -- the one case the FAIL line is about.  The marker line is
# stripped from the captured stderr before anything else sees it.
#
# Every real login failure of the run is recorded in $ADMIN_FAIL_FILE (one
# line each, in the order they happened); a later successful call never
# truncates the record, and the run prints the recorded lines (each of
# them once) before its STOPPED line.
rsh_admin() {
	rsh_admin_run "$1" 1
}

# Contract: rsh_admin_run CMD MARKER -- the admin lane itself; MARKER=1
# puts the fixed session marker in front of the remote command (the
# login-failure detection), MARKER=0 sends the remote command exactly as
# it is given.  The owner script lane needs the second: the remote
# command is the fixed string `sh -s` and nothing else may reach the
# router's command line.  The login failure is still reported the same
# way: the owner script never exits 255, so an exit 255 is a connect or
# authentication failure there too.
rsh_admin_run() {
	local cmd="$1" marker_on="$2" rc=0 tail='' msg='' marker=0
	SSH_ERR_FILE=''
	if [[ -n "$TMP_DIR" ]]; then
		SSH_ERR_FILE="${TMP_DIR}/admin-ssh-stderr"
		: >"$SSH_ERR_FILE" 2>/dev/null || SSH_ERR_FILE=''
	fi
	if [[ "$marker_on" == "1" ]]; then
		cmd="echo ${ADMIN_MARKER} >&2; $cmd"
	fi
	if [[ "$ADMIN_MODE" == "plain-key" ]]; then
		admin_lane_run rsh_key "$PLAIN_KEY" "$cmd"
	else
		admin_lane_run rsh_pw "$cmd"
	fi
	rc=$?
	if [[ -n "$SSH_ERR_FILE" && -s "$SSH_ERR_FILE" ]]; then
		if grep -q -F -- "$ADMIN_MARKER" "$SSH_ERR_FILE" 2>/dev/null; then
			marker=1
		fi
		grep -v -F -- "$ADMIN_MARKER" "$SSH_ERR_FILE" >"${SSH_ERR_FILE}.clean" 2>/dev/null || true
		mv -f -- "${SSH_ERR_FILE}.clean" "$SSH_ERR_FILE" 2>/dev/null || true
	fi
	if [[ $rc -eq 255 && $marker -eq 0 ]]; then
		if [[ -n "$SSH_ERR_FILE" && -s "$SSH_ERR_FILE" ]]; then
			ssh_err_tail
			tail="$SSH_ERR_TAIL"
		fi
		# the root password is never echoed, not even by ssh
		if [[ -n "$ROOT_PW" && "$tail" == *"$ROOT_PW"* ]]; then
			tail=''
		fi
		if [[ "$ADMIN_MODE" == "plain-key" ]]; then
			msg="admin login to root@${DEV_HOST} failed (key ${PLAIN_KEY}). Check that the key is in the router's authorized keys."
		else
			msg="admin login to root@${DEV_HOST} failed (password login). If the router refuses root passwords, rerun with --admin plain-key --plain-key <your admin key>."
		fi
		if [[ -n "$tail" ]]; then
			msg="${msg} ssh said: $(escape_text "$tail")"
		fi
		# the run's record: every real login failure, in order; the same
		# line twice is one failure to report
		if [[ -n "$ADMIN_FAIL_FILE" ]]; then
			if ! grep -Fxq -- "FAIL ${msg}" "$ADMIN_FAIL_FILE" 2>/dev/null; then
				printf 'FAIL %s\n' "$msg" >>"$ADMIN_FAIL_FILE" 2>/dev/null || true
			fi
		fi
	fi
	SSH_ERR_FILE=''
	return "$rc"
}

# Contract: rsh_owner_script SCRIPTFILE -- sends the owner script to the
# router over the admin lane.  The remote command is the fixed string
# `sh -s` and the script travels on stdin only: nothing from the host
# reaches the router's command line, and the script never becomes an
# argument.  The caller's stdin is the script; the lane itself reads
# nothing from stdin (the password goes through the askpass fifo), so
# the script arrives whole.
rsh_owner_script() {
	local script="$1"
	[[ -r "$script" ]] || die "cannot read the owner script: $script"
	rsh_admin_run 'sh -s' 0 <"$script"
}

# Contract: report_admin_login_failure -- prints the recorded admin-login
# FAIL lines (the run's real login failures, in order, each of them once)
# on stdout and forgets them; nothing when the run had no login failure.
# The lines are printed before the run's STOPPED line, so the owner reads
# why the admin call failed before the stop.
report_admin_login_failure() {
	local line=''
	[[ -n "$ADMIN_FAIL_FILE" && -s "$ADMIN_FAIL_FILE" ]] || return 0
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -n "$line" ]] || continue
		printf '%s\n' "$line"
	done <"$ADMIN_FAIL_FILE"
	: >"$ADMIN_FAIL_FILE" 2>/dev/null || true
	return 0
}

# Contract: rscp_key KEYFILE SRC DEST_ON_ROUTER -- copies SRC once to
# root@HOST:DEST_ON_ROUTER over the key lane with legacy SCP protocol (-O)
# and the common options (-P for the port) under timeout 60; the exit status
# is scp's.
rscp_key() {
	ssh_base_opts -P
	timeout --foreground 60 scp -O "${SSH_OPTS[@]}" -i "$1" -o IdentitiesOnly=yes -o BatchMode=yes -o PreferredAuthentications=publickey -o PasswordAuthentication=no "$2" "root@${DEV_HOST}:$3"
}

# Contract: rsftp_key KEYFILE -- runs sftp once over the key lane with the
# common options (-P for the port) under timeout 60, the batch read from the
# caller's stdin (-b -); the exit status is sftp's.
rsftp_key() {
	ssh_base_opts -P
	timeout --foreground 60 sftp "${SSH_OPTS[@]}" -i "$1" -o IdentitiesOnly=yes -o BatchMode=yes -o PreferredAuthentications=publickey -o PasswordAuthentication=no -b - "root@$DEV_HOST"
}

# Contract: ensure_known_hosts -- no arguments; makes sure the known_hosts
# file of 2.4 exists: (a) a non-empty file is used as it is, (b) else the
# entries that ssh-keygen -F finds in $TRUSTED_KNOWN_HOSTS (HOST written
# [HOST]:PORT when the port is not 22, the "# Host" comment lines dropped)
# are written to it, (c) else the host key is learned with exactly one
# STRICT=accept-new rsh_admin true call and
# "NOTE host key learned: <ssh-keygen -lf output>; compare it with the
# router before you go on" is printed; after learning STRICT is yes again;
# exit 2 with "error: ..." on stderr when the learning call fails or the
# file cannot be written.  The NOTE is printed exactly when a key was newly
# learned and kept: when the learning call fails (ssh saves the key during
# the key exchange, before the login) or a later step dies before the NOTE,
# the file is removed, so the next run learns again and shows the
# fingerprint.
ensure_known_hosts() {
	local kh host entries fp dir
	kh=$(known_hosts_file)
	if [[ -s "$kh" ]]; then
		return 0
	fi
	host="$DEV_HOST"
	if [[ "$DEV_PORT" != "22" ]]; then
		host="[${DEV_HOST}]:${DEV_PORT}"
	fi
	entries=''
	if [[ -s "$TRUSTED_KNOWN_HOSTS" ]]; then
		entries=$(ssh-keygen -F "$host" -f "$TRUSTED_KNOWN_HOSTS" 2>/dev/null | grep -v '^#') || entries=''
	fi
	dir=$(dirname -- "$kh")
	# refuse before the mkdir below: the router identity pin is written into
	# an operator-settable dir (the inventory known_hosts, else KEYS_DIR), so
	# a parent any local user can write to is a symlink-planting hole for the
	# host key
	check_state_dir_parent_sticky "$dir" known_hosts \
		|| die "cannot write $kh: refusing a world-writable parent"
	mkdir -p -- "$dir" || die "cannot create $dir"
	if [[ -n "$entries" ]]; then
		printf '%s\n' "$entries" >"$kh" || die "cannot write $kh"
		return 0
	fi
	STRICT=accept-new
	if ! rsh_admin true </dev/null; then
		STRICT=yes
		# ssh saves the host key during the key exchange, before the login:
		# a failed call must not leave it behind unshown (rm does not
		# follow a symlink; the file was absent or empty before the call)
		rm -f -- "$kh"
		die "cannot learn the host key for ${DEVICE}: the ssh call failed"
	fi
	STRICT=yes
	[[ -s "$kh" ]] || { rm -f -- "$kh"; die "the learned known_hosts file is empty: $kh"; }
	fp=$(ssh-keygen -lf "$kh") || { rm -f -- "$kh"; die "cannot fingerprint $kh"; }
	note "host key learned: ${fp}; compare it with the router before you go on"
}

# Router path constants (design 2.1, 2.2).
R_PROG='/usr/libexec/newton/newton-router'
R_HELPER='/usr/libexec/newton/newton-safe-apply'
R_GUARD='/usr/libexec/newton-guard'
R_INIT='/etc/init.d/newton-guard'
R_NEWTON_DIR='/etc/newton'
R_AUTH_KEYS='/etc/dropbear/authorized_keys'
R_LOCK='/tmp/owrt-safe-apply.lock'

# WAN health tool paths (the extras installed by the WAN health extras).
R_WANHEALTH='/usr/libexec/newton/newton-wan-health'
R_WANHEALTH_INIT='/etc/init.d/newton-wan-health'

# The four code files (design 2.1 and 3.2): SRC_RELATIVE_PATH|ROUTER_PATH|MODE|ROTATE.
CODE_FILES=(
	"device/openwrt/newton-router/newton-router|${R_PROG}|755|yes"
	"scripts/owrt-safe-apply.sh|${R_HELPER}|755|yes"
	"device/openwrt/newton-guard/newton-guard|${R_GUARD}|755|no"
	"device/openwrt/newton-guard/newton-guard.init|${R_INIT}|755|no"
)

# WAN health extras (same row format). rotate=yes mirrors the program and
# the helper of CODE_FILES: the upload takes a .prev whenever the file is
# already on the router, so install_restore can copy it back when a later
# step of an upgrade fails. install_check_sources also walks this array,
# and install_run puts it as a separate step after CODE_FILES, before
# install_guard_enable.
EXTRA_FILES=(
	"scripts/newton-wan-health.sh|${R_WANHEALTH}|755|yes"
	"scripts/newton-wan-health.init|${R_WANHEALTH_INIT}|755|yes"
)

# The lines install and upgrade append to /etc/sysupgrade.conf when missing
# (design 2.3, R9b+c): the eight code/config paths, the four WAN-health ones
# (the rc.d start and stop symlinks the init's `enable` creates on install,
# the wan-health script and its init) and the approval key, which a
# firmware upgrade used to lose. /etc/config is kept by sysupgrade by
# default and stays out of this list. Every site that uses this array
# iterates over the whole thing -- install, upgrade, uninstall -- so a
# count change here is picked up by all of them.
SYSUPGRADE_LINES=(
	"${R_PROG}"
	"${R_HELPER}"
	"${R_GUARD}"
	"${R_INIT}"
	'/etc/rc.d/S09newton-guard'
	'/etc/rc.d/S95newton-wan-health'
	'/etc/rc.d/K10newton-wan-health'
	"${R_WANHEALTH}"
	"${R_WANHEALTH_INIT}"
	"${R_NEWTON_DIR}/device-id"
	"${R_NEWTON_DIR}/profile"
	"${R_NEWTON_DIR}/zones"
	"${R_NEWTON_DIR}/approve.key"
)

# The G0 tool names of design 9.4 the check action probes with command -v.
G0_TOOLS=(sha256sum md5sum flock mktemp setsid head tr awk sed sort tar jsonfilter ucode uci ubus nft fw4 ifstatus netstat pidof logread logger nslookup ping traceroute iwinfo apk)

# set by put_file and put_text: 1 when this call wrote the router file, 0
# otherwise; set by put_stream: 1 when this call made a .prev, 0 otherwise
PUT_CHANGED=0
PUT_ROTATED=0

# Contract: mode_symbolic MODE -- prints the 9-character symbolic form of the
# octal mode MODE (755 prints rwxr-xr-x) on stdout.
mode_symbolic() {
	local mode="$1" out='' i digit
	for i in 1 2 3; do
		digit="${mode:i-1:1}"
		case "$digit" in
			0) out+='---' ;;
			1) out+='--x' ;;
			2) out+='-w-' ;;
			3) out+='-wx' ;;
			4) out+='r--' ;;
			5) out+='r-x' ;;
			6) out+='rw-' ;;
			7) out+='rwx' ;;
			*) return 1 ;;
		esac
	done
	printf '%s\n' "$out"
}

# Contract: router_sha256 REMOTE -- prints the router's sha256 of REMOTE (the
# ${RR} prefix on the location) as 64 lowercase hex on stdout, or nothing when
# the file is absent; the exit status is the ssh call's.
router_sha256() {
	local out rc
	out=$(rsh_admin "sha256sum \"${RR}$1\" 2>/dev/null" </dev/null 2>/dev/null)
	rc=$?
	if [[ $rc -ne 0 ]]; then
		return "$rc"
	fi
	printf '%s\n' "${out%% *}"
}

# Contract: router_mode REMOTE -- prints the 9-character permission string of
# REMOTE (the ${RR} prefix on the location) from ls -l on stdout, or nothing;
# the exit status is the ssh call's.
router_mode() {
	local out perms
	out=$(rsh_admin "ls -l \"${RR}$1\"" </dev/null 2>/dev/null) || return $?
	read -r perms _rest <<<"$out" || return 1
	printf '%s\n' "${perms#?}"
}

# Contract: router_has_file REMOTE -- exit 0 when REMOTE (the ${RR} prefix on
# the location) exists on the router, else the ssh call's exit status.
router_has_file() {
	rsh_admin "test -e \"${RR}$1\"" </dev/null 2>/dev/null
}

# Contract: already_identical REMOTE SHA SYM -- exit 0 when the router file
# REMOTE exists with exactly the sha256 SHA and the symbolic mode SYM (the
# 2.6 idempotence rule), else exit 1.
already_identical() {
	if ! router_has_file "$1"; then
		return 1
	fi
	[[ "$(router_sha256 "$1")" == "$2" && "$(router_mode "$1")" == "$3" ]]
}

# Contract: put_stream REMOTE MODE SHA [ROTATE] -- the shared 2.6 write:
# the data on the caller's stdin goes to REMOTE.new through rsh_admin,
# then chmod MODE and sha256sum REMOTE.new must equal SHA; on a mismatch
# rm -f REMOTE.new and exit 1, else the final remote call mvs over
# REMOTE, first running `cp -p REMOTE REMOTE.prev && chmod 644
# REMOTE.prev` when ROTATE is `rotate` and the live file exists with
# other bytes (nothing is rotated when the content is identical or the
# file is new); sets PUT_CHANGED=1 on the write and PUT_ROTATED=1 when a
# .prev was made; exit 0; prints nothing.
put_stream() {
	local remote="$1" mode="$2" want="$3" rotate="${4:-}"
	local out rc cur='' do_rotate=0 mv_cmd
	PUT_ROTATED=0
	mv_cmd="mv \"${RR}${remote}.new\" \"${RR}${remote}\""
	if [[ "$rotate" == "rotate" ]] && router_has_file "$remote"; then
		cur=$(router_sha256 "$remote")
		if [[ -n "$cur" && "$cur" != "$want" ]]; then
			do_rotate=1
			mv_cmd="cp -p \"${RR}${remote}\" \"${RR}${remote}.prev\" && chmod 644 \"${RR}${remote}.prev\" && ${mv_cmd}"
		fi
	fi
	out=$(rsh_admin "umask 077 && cat > \"${RR}${remote}.new\" && chmod \"$mode\" \"${RR}${remote}.new\" && sha256sum \"${RR}${remote}.new\"" 2>/dev/null)
	rc=$?
	if [[ $rc -ne 0 ]]; then
		rsh_admin "rm -f \"${RR}${remote}.new\"" </dev/null 2>/dev/null || true
		return 1
	fi
	if [[ "${out%% *}" != "$want" ]]; then
		rsh_admin "rm -f \"${RR}${remote}.new\"" </dev/null 2>/dev/null || true
		return 1
	fi
	if ! rsh_admin "$mv_cmd" </dev/null 2>/dev/null; then
		rsh_admin "rm -f \"${RR}${remote}.new\"" </dev/null 2>/dev/null || true
		return 1
	fi
	PUT_CHANGED=1
	if [[ $do_rotate -eq 1 ]]; then
		PUT_ROTATED=1
	fi
	return 0
}

# Contract: put_file LOCAL REMOTE MODE [ROTATE] -- sends LOCAL (its
# sha256 computed first) through put_stream with mode MODE and, when
# ROTATE is `rotate`, the .prev rule of put_stream; the whole write is
# skipped when the router file already has the same sha256 and mode;
# prints nothing; returns 0 (written or already identical, with
# PUT_CHANGED 1 or 0 and PUT_ROTATED 1 or 0) or 1.
put_file() {
	local local_file="$1" remote="$2" mode="$3" want sym
	PUT_CHANGED=0
	PUT_ROTATED=0
	want=$(sha256_file "$local_file")
	sym=$(mode_symbolic "$mode") || return 1
	if already_identical "$remote" "$want" "$sym"; then
		return 0
	fi
	if [[ "${4:-}" == "rotate" ]]; then
		put_stream "$remote" "$mode" "$want" rotate <"$local_file"
	else
		put_stream "$remote" "$mode" "$want" <"$local_file"
	fi
}

# Contract: put_text REMOTE MODE -- the content on the caller's stdin (read
# once into a variable, so it can be hashed and re-sent) through put_stream
# with mode MODE; the same skip rule, return values and PUT_CHANGED as
# put_file; prints nothing.
put_text() {
	local remote="$1" mode="$2" want sym content
	PUT_CHANGED=0
	content=$(cat && printf 'x')
	content=${content%x}
	want=$(printf '%s' "$content" | sha256sum)
	want=${want%% *}
	sym=$(mode_symbolic "$mode") || return 1
	if already_identical "$remote" "$want" "$sym"; then
		return 0
	fi
	# process substitution, not a pipe: put_stream must set PUT_CHANGED in
	# this shell, and the content still only travels through a pipe
	put_stream "$remote" "$mode" "$want" < <(printf '%s' "$content")
}

# set by keypair_path; KEYPAIRS_MADE lists only the pairs keypair_create
# made in this run
KEYFILE=''
KEYPAIRS_MADE=()

# Contract: keypair_path LABEL -- validates LABEL and only sets KEYFILE to
# ${KEYS_DIR}/${DEVICE}-${LABEL}; it does no directory or file work.
keypair_path() {
	local label="$1"
	valid_label "$label" || die "bad label: $label"
	KEYFILE="${KEYS_DIR}/${DEVICE}-${label}"
}

# Contract: keypair_create LABEL -- validates LABEL through keypair_path,
# refuses when KEYFILE already exists, creates KEYS_DIR with mode 0700 after
# the sticky-parent check, creates a new pair with ssh-keygen -q -t ed25519
# -N '' -C newton-router-LABEL -f KEYFILE, prints
# "INFO new key made: KEYFILE", records KEYFILE in KEYPAIRS_MADE, and dies
# on any failure.
keypair_create() {
	local label="$1"
	keypair_path "$label"
	if [[ -e "$KEYFILE" ]]; then
		die "a key for label $label already exists on this host ($KEYFILE); run it again without --new-key"
	fi
	# refuse before the mkdir below: KEYS_DIR is operator-settable
	# (NEWTON_KEYS_DIR) and holds the device private keys, so a parent any
	# local user can write to is a symlink-planting hole for them
	check_state_dir_parent_sticky "$KEYS_DIR" NEWTON_KEYS_DIR \
		|| die "cannot create $KEYS_DIR: refusing a world-writable parent"
	mkdir -p -- "$KEYS_DIR" || die "cannot create $KEYS_DIR"
	chmod 700 -- "$KEYS_DIR" || die "cannot set the mode of $KEYS_DIR"
	ssh-keygen -q -t ed25519 -N '' -C "newton-router-${label}" -f "$KEYFILE" \
		|| die "ssh-keygen failed for $KEYFILE"
	KEYPAIRS_MADE+=("$KEYFILE")
	info "new key made: $KEYFILE"
}

# Contract: keypair_made_this_run KEYFILE -- exit 0 only when KEYFILE is in
# KEYPAIRS_MADE; no file work.
keypair_made_this_run() {
	local made
	for made in "${KEYPAIRS_MADE[@]}"; do
		[[ "$made" == "$1" ]] && return 0
	done
	return 1
}

# Contract: keypair_delete_if_made KEYFILE -- when KEYFILE was made by this
# run, remove both pair files and return 0; otherwise return 1 without file
# work.  A removal failure returns 2.
keypair_delete_if_made() {
	local key="$1"
	keypair_made_this_run "$key" || return 1
	rm -f -- "$key" "${key}.pub" || return 2
	return 0
}

# Contract: local_key_rule LABEL -- keypair_path LABEL, then enforce the
# host-side key rule before any router call: a missing private file without
# NEW_KEY stops with the host that owns the key and the explicit --new-key
# way out; a present private file with NEW_KEY stops for add-key and
# swap-key, while lab-snapshot reuses present files and makes only the
# missing ones.
local_key_rule() {
	local label="$1"
	keypair_path "$label"
	if [[ ! -f "$KEYFILE" && $NEW_KEY -eq 0 ]]; then
		STATE_NOTE='router unchanged'
		stopped "no key for label $label on this host ($KEYFILE is missing): the key lives on the Newton host that added it; run this there, or pass --new-key to make a new key on purpose"
	fi
	if [[ -f "$KEYFILE" && $NEW_KEY -eq 1 && "$ACTION" != "lab-snapshot" ]]; then
		STATE_NOTE='router unchanged'
		stopped "a key for label $label already exists on this host ($KEYFILE); run it again without --new-key"
	fi
}

# Contract: pub_blob FILE -- prints the second field of `ssh-keygen -y -f FILE`; die when it fails.
pub_blob() {
	local out
	out=$(ssh-keygen -y -f "$1" 2>/dev/null | awk '{print $2}') \
		|| die "cannot read the public key: $1"
	[[ -n "$out" ]] || die "cannot read the public key: $1"
	printf '%s\n' "$out"
}

# Contract: restricted_line LABEL ROLE BLOB -- the design 2.4 line verbatim, comment newton-router-LABEL; validates label, role and that BLOB is base64 characters only; die on a violation.
restricted_line() {
	local label="$1" role="$2" blob="$3"
	valid_label "$label" || die "bad label: $label"
	valid_role "$role" || die "bad role: $role (change or read)"
	[[ "$blob" =~ ^[A-Za-z0-9+/=]+$ ]] || die "bad public key blob"
	printf 'restrict,no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-pty,command="/usr/libexec/newton/newton-router --caller=%s --role=%s" ssh-ed25519 %s newton-router-%s\n' \
		"$label" "$role" "$blob" "$label"
}

# Contract: awk_core_program -- prints the shared BusyBox-awk tokenizer (no
# single quote character inside): for each line tokenize() fills the global
# array T and the count NT with the tokens split on blanks outside double
# quotes (a backslash-escaped quote inside quotes does not close them) and
# blob_of() returns the token after the first one starting with ssh-, ecdsa-
# or sk- (empty when there is none). The shared is_comment() helper returns
# 1 when the current line starts with optional blanks and `#`, so the
# awk_filter_program and awk_match_program callers can skip comment lines
# the same way the awk_filter_program skipped them before.
awk_core_program() {
	cat <<'AWKEOF'
function tokenize(  ch, i, n, t, q, e) {
	delete T
	NT = 0
	t = ""
	q = 0
	e = 0
	n = length($0)
	for (i = 1; i <= n; i++) {
		ch = substr($0, i, 1)
		if (e) {
			t = t ch
			e = 0
			continue
		}
		if (q) {
			if (ch == "\\") {
				e = 1
			} else if (ch == "\"") {
				q = 0
			}
			t = t ch
			continue
		}
		if (ch == "\"") {
			q = 1
			t = t ch
			continue
		}
		if (ch == " " || ch == "\t") {
			if (t != "") {
				NT++
				T[NT] = t
				t = ""
			}
			continue
		}
		t = t ch
	}
	if (t != "") {
		NT++
		T[NT] = t
	}
}
function blob_of(  j) {
	for (j = 1; j < NT; j++) {
		if (T[j] ~ /^(ssh-|ecdsa-|sk-)/) {
			return T[j + 1]
		}
	}
	return ""
}
function is_comment() { return ($0 ~ /^[ \t]*#/) }
AWKEOF
}

# Contract: awk_blob_program -- prints an awk program (no single quote
# character inside, BusyBox awk, no gawk extensions) that prints, for every
# input line, the blob: the token after the first token that starts with
# ssh-, ecdsa- or sk- (tokens split on blanks outside double quotes, a
# backslash-escaped quote inside quotes does not close them); nothing for a
# line without such a token.
awk_blob_program() {
	awk_core_program
	cat <<'AWKEOF'
{ tokenize(); b = blob_of(); if (b != "") print b }
AWKEOF
}

# Contract: awk_filter_program -- prints an awk program (no single quote
# character inside, BusyBox awk) that reads the awk variable blob and prints
# every line whose blob is not blob, and every blank, comment (#) or
# unparsable (no ssh-/ecdsa-/sk- token) line, unchanged. Comment lines are
# detected by the shared is_comment() helper from awk_core_program, so a
# commented-out copy of a key is never mistaken for a real one.
awk_filter_program() {
	awk_core_program
	cat <<'AWKEOF'
{ if (is_comment()) { print } else { tokenize(); b = blob_of(); if (b == "" || b != blob) print } }
AWKEOF
}

# Contract: awk_match_program -- prints an awk program (no single quote
# character inside, BusyBox awk) that reads the awk variable blob and prints
# the lines whose blob equals blob. Comment lines are skipped through the
# shared is_comment() helper from awk_core_program, so a commented-out copy
# of the key does not count as a match.
awk_match_program() {
	awk_core_program
	cat <<'AWKEOF'
{ if (is_comment()) next; tokenize(); b = blob_of(); if (b != "" && b == blob) print }
AWKEOF
}

# Contract: auth_count -- prints the `grep -c ''` line count of R_AUTH_KEYS
# (the ${RR} prefix on the location) through one rsh_admin call; the exit
# status is the call's.
auth_count() {
	rsh_admin "grep -c '' \"${RR}${R_AUTH_KEYS}\"" </dev/null 2>/dev/null
}

# Contract: auth_has_blob BLOB -- validates BLOB (base64 characters, else
# die) and exits 0 when some line of R_AUTH_KEYS has BLOB as its blob, 1
# when not, and any other status when the awk read or rsh_admin call fails;
# one rsh_admin call running the awk_match_program output.
auth_has_blob() {
	local blob="$1"
	[[ "$blob" =~ ^[A-Za-z0-9+/=]+$ ]] || die "bad public key blob"
	rsh_admin "out=\$(awk -v blob='${blob}' '$(awk_match_program)' \"${RR}${R_AUTH_KEYS}\") || exit 3; [ -n \"\$out\" ] && exit 0; exit 1" </dev/null 2>/dev/null
}

# Contract: auth_label_blob LABEL -- validates LABEL (label regex, else
# die) and prints the blob of the line of R_AUTH_KEYS whose last token is
# newton-router-LABEL, nothing when there is none; one rsh_admin call.
auth_label_blob() {
	local label="$1" prog
	valid_label "$label" || die "bad label: $label"
	prog=$(awk_core_program; cat <<'AWKEOF'
{ tokenize(); if (NT > 0 && T[NT] == "newton-router-" L) { b = blob_of(); if (b != "") print b } }
AWKEOF
)
	rsh_admin "awk -v L='${label}' '${prog}' \"${RR}${R_AUTH_KEYS}\"" </dev/null 2>/dev/null
}

# Contract: auth_newton_label_blobs LABEL -- validates LABEL (label regex,
# else die) and prints one field per Newton line for LABEL: the line's public
# blob, or `-` when the line has no parsable blob.  A Newton line for LABEL
# holds command="/usr/libexec/newton/newton-router and --caller=LABEL followed
# by a space or double quote, or its last token is newton-router-LABEL.  The
# awk program is fixed text and LABEL travels only through awk -v; one
# rsh_admin call.
auth_newton_label_blobs() {
	local label="$1" prog
	valid_label "$label" || die "bad label: $label"
	prog=$(awk_core_program; cat <<'AWKEOF'
{
	matched = 0
	if (index($0, "command=\"/usr/libexec/newton/newton-router") && (index($0, "--caller=" L " ") || index($0, "--caller=" L "\"")))
		matched = 1
	tokenize()
	if (NT > 0 && T[NT] == "newton-router-" L)
		matched = 1
	if (!matched)
		next
	b = blob_of()
	if (b == "")
		print "-"
	else
		print b
}
AWKEOF
)
	rsh_admin "awk -v L='${label}' '${prog}' \"${RR}${R_AUTH_KEYS}\"" </dev/null 2>/dev/null
}


# Contract: auth_append_line LINE -- validates LINE (only A-Za-z0-9 and
# the characters space , = _ . / + : " - pass; anything else dies with
# "bad authorized_keys line", the restricted line of
# restricted_line passes), then appends the authorized_keys line LINE to
# R_AUTH_KEYS in one rsh_admin call: builds authorized_keys.new from the
# live file with cp -p (an empty file when it is absent), adds a missing
# final LF, appends LINE, checks the grep -c '' count rose by exactly one
# and the old lines are still there, then chmod 600 and mv; on a failed
# check removes .new, leaves the live file untouched and returns 1.
auth_append_line() {
	local line="$1" script
	local re='^[A-Za-z0-9 ,=_./+:"-]+$'
	[[ "$line" =~ $re ]] || die "bad authorized_keys line"
	script="f=\"${RR}${R_AUTH_KEYS}\"
n=\"\${f}.new\"
before=\$(grep -c '' \"\$f\" 2>/dev/null)
before=\${before:-0}
if [ -e \"\$f\" ]; then cp -p \"\$f\" \"\$n\" || exit 1; else : > \"\$n\" || exit 1; fi
if [ -s \"\$n\" ] && [ -n \"\$(tail -c 1 \"\$n\")\" ]; then printf '\\n' >> \"\$n\"; fi
printf '%s\\n' '${line}' >> \"\$n\" || exit 1
after=\$(grep -c '' \"\$n\")
if [ \"\$after\" != \"\$((before + 1))\" ]; then rm -f \"\$n\"; exit 1; fi
if [ \"\$before\" -gt 0 ] && ! printf '%s\\n' \"\$(tail -n 1 \"\$f\")\" | grep -qF -f - \"\$n\"; then rm -f \"\$n\"; exit 1; fi
chmod 600 \"\$n\" || exit 1
mv \"\$n\" \"\$f\" || exit 1"
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: auth_remove_blob BLOB -- validates BLOB (base64 characters,
# else die) and removes every line of R_AUTH_KEYS whose blob is BLOB in one
# rsh_admin call: authorized_keys.new is built with the awk_filter_program
# output, the count must fall by exactly the number of matched lines, then
# chmod 600 and mv; prints the number removed; returns 1 and leaves the
# live file untouched (no .new left) when the check fails.
auth_remove_blob() {
	local blob="$1" script
	[[ "$blob" =~ ^[A-Za-z0-9+/=]+$ ]] || die "bad public key blob"
	script="f=\"${RR}${R_AUTH_KEYS}\"
n=\"\${f}.new\"
before=\$(grep -c '' \"\$f\" 2>/dev/null)
[ -n \"\$before\" ] || exit 1
matches=\$(awk -v blob='${blob}' '$(awk_match_program)' \"\$f\" | grep -c '')
[ \"\$matches\" -gt 0 ] 2>/dev/null || { echo 0; exit 0; }
awk -v blob='${blob}' '$(awk_filter_program)' \"\$f\" > \"\$n\" || { rm -f \"\$n\"; exit 1; }
after=\$(grep -c '' \"\$n\")
removed=\$((before - after))
[ \"\$removed\" -eq \"\$matches\" ] || { rm -f \"\$n\"; exit 1; }
chmod 600 \"\$n\" || exit 1
mv \"\$n\" \"\$f\" || exit 1
echo \"\$removed\""
	rsh_admin "$script" </dev/null 2>/dev/null
}


# Contract: auth_remove_exact_line LINE -- validates LINE with the
# auth_append_line rule (anything else dies), then removes only lines equal to
# the exact text LINE in one rsh_admin call.  `grep -vxF` preserves every other
# byte, including another line that carries the same public-key blob; the count
# must fall by exactly the number of exact matches.  Prints the number removed
# and, like auth_remove_blob, returns 1 without touching the live file when a
# check fails.
auth_remove_exact_line() {
	local line="$1" script
	local re='^[A-Za-z0-9 ,=_./+:"-]+$'
	[[ "$line" =~ $re ]] || die "bad authorized_keys line"
	script="f=\"${RR}${R_AUTH_KEYS}\"
n=\"\${f}.new\"
before=\$(grep -c '' \"\$f\" 2>/dev/null)
[ -n \"\$before\" ] || exit 1
matches=\$(grep -xF -- '${line}' \"\$f\" | grep -c '')
[ \"\$matches\" -gt 0 ] 2>/dev/null || { echo 0; exit 0; }
filter_rc=0
grep -vxF -- '${line}' \"\$f\" > \"\$n\" || filter_rc=\$?
[ \"\$filter_rc\" -eq 0 ] || [ \"\$filter_rc\" -eq 1 ] || { rm -f \"\$n\"; exit 1; }
after=\$(grep -c '' \"\$n\")
removed=\$((before - after))
[ \"\$removed\" -eq \"\$matches\" ] || { rm -f \"\$n\"; exit 1; }
chmod 600 \"\$n\" || exit 1
mv \"\$n\" \"\$f\" || exit 1
echo \"\$removed\""
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: auth_remove_label LABEL -- validates LABEL (label regex, else
# die) and removes every line of R_AUTH_KEYS whose last token is
# newton-router-LABEL in one rsh_admin call: authorized_keys.new is built
# with the label filter program, the count must fall by exactly the number
# of matched lines, then chmod 600 and mv; prints the number removed;
# returns 1 and leaves the live file untouched (no .new left) when the
# check fails.
auth_remove_label() {
	local label="$1" match filter script
	valid_label "$label" || die "bad label: $label"
	match=$(awk_core_program; cat <<'AWKEOF'
{ tokenize(); if (NT > 0 && T[NT] == "newton-router-" L) print }
AWKEOF
)
	filter=$(awk_core_program; cat <<'AWKEOF'
{ tokenize(); if (NT == 0 || T[NT] != "newton-router-" L) print }
AWKEOF
)
	script="f=\"${RR}${R_AUTH_KEYS}\"
n=\"\${f}.new\"
before=\$(grep -c '' \"\$f\" 2>/dev/null)
[ -n \"\$before\" ] || exit 1
matches=\$(awk -v L='${label}' '${match}' \"\$f\" | grep -c '')
[ \"\$matches\" -gt 0 ] 2>/dev/null || { echo 0; exit 0; }
awk -v L='${label}' '${filter}' \"\$f\" > \"\$n\" || { rm -f \"\$n\"; exit 1; }
after=\$(grep -c '' \"\$n\")
removed=\$((before - after))
[ \"\$removed\" -eq \"\$matches\" ] || { rm -f \"\$n\"; exit 1; }
chmod 600 \"\$n\" || exit 1
mv \"\$n\" \"\$f\" || exit 1
echo \"\$removed\""
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: hello_direct NONCE -- validates NONCE (32 lowercase hex, else
# die), runs `${RR}/usr/libexec/newton/newton-router hello NONCE` through
# rsh_admin with </dev/null, prints the reply line and exits 0 only when
# its first two words are `hello NONCE`; otherwise the exit status is the
# call's (or 1 on a bad reply).
hello_direct() {
	local nonce="$1" reply first second
	[[ "$nonce" =~ ^[0-9a-f]{32}$ ]] || die "bad nonce"
	reply=$(rsh_admin "\"${RR}${R_PROG}\" hello ${nonce}" </dev/null 2>/dev/null) || return $?
	IFS=' ' read -r first second _ <<<"$reply"
	[[ "$first" == "hello" && "$second" == "$nonce" ]] || return 1
	printf '%s\n' "$reply"
}

# Contract: hello_key KEYFILE NONCE -- validates NONCE (32 lowercase hex,
# else die) and sends the request text `hello NONCE` (the forced command
# receives it as its request) through rsh_key with
# </dev/null; prints the reply line and exits 0 only when its first two
# words are `hello NONCE`; otherwise the exit status is the call's (or 1).
hello_key() {
	local keyfile="$1" nonce="$2" reply first second
	[[ "$nonce" =~ ^[0-9a-f]{32}$ ]] || die "bad nonce"
	reply=$(rsh_key "$keyfile" "hello ${nonce}" </dev/null 2>/dev/null) || return $?
	IFS=' ' read -r first second _ <<<"$reply"
	[[ "$first" == "hello" && "$second" == "$nonce" ]] || return 1
	printf '%s\n' "$reply"
}

# Contract: hello_field LINE NAME -- prints the value of the word
# `NAME=value` of LINE, exit 1 when the word is missing (agent=0 does not
# answer a request for tty).
hello_field() {
	local line="$1" name="$2" word
	local -a words
	IFS=' ' read -ra words <<<"$line"
	for word in "${words[@]}"; do
		[[ "$word" == *=* && "${word%%=*}" == "$name" ]] || continue
		printf '%s\n' "${word#*=}"
		return 0
	done
	return 1
}

# Contract: check_report [PLAIN_BLOB] -- ONE read-only rsh_admin call with
# fixed POSIX text (</dev/null, ${RR} on file locations, PLAIN_BLOB
# validated as base64 before it is embedded) that prints exactly these
# key=value lines: release (unknown when empty), busybox, one tool_missing per
# missing G0 tool, tools_checked (the number tested), overlay_kib,
# dropbear_passwordauth, dropbear_rootpasswordauth (unknown when the dropbear
# section cannot be read; unset when only the option is absent), ak_lines (0
# only when the file is absent, unknown on a read failure), ak_labels,
# ak_plain (present|absent, or
# unknown when no blob was passed), guard (not-installed, else the status
# line), lock (none|live|stale), wan_health (installed|not-installed|differs,
# comparing the router sha256 of the two WAN-health files against the source
# files in $SRC), and a final report_end=1 completeness marker; the exit
# status is the call's.
check_report() {
	local blob="${1:-}" tools match labels script
	if [[ -n "$blob" ]]; then
		[[ "$blob" =~ ^[A-Za-z0-9+/=]+$ ]] || die "bad public key blob"
	fi
	tools="${G0_TOOLS[*]}"
	match=$(awk_match_program)
	labels=$(awk_core_program; cat <<'AWKEOF'
BEGIN { labs = "" }
{ tokenize(); if (NT > 0 && T[NT] ~ /^newton-router-/) { l = substr(T[NT], 15); if (labs == "") labs = l; else labs = labs "," l } }
END { print "ak_labels=" labs }
AWKEOF
	)
	# Embed the source sha256 of the two WAN-health files as fixed text
	# so the router-side comparison is argv-safe and ${RR} stays on every
	# router location. sha256_file dies when a source is missing, so the
	# tool has already left before the comparison can be skipped.
	local wan_src0 wan_src1
	wan_src0=$(sha256_file "${SRC}/${EXTRA_FILES[0]%%|*}")
	wan_src1=$(sha256_file "${SRC}/${EXTRA_FILES[1]%%|*}")
	script=$(cat <<EOF
. "${RR}/etc/openwrt_release" 2>/dev/null
echo "release=\${DISTRIB_RELEASE:-unknown}"
busybox_line=\$(busybox 2>/dev/null | head -n 1)
[ -n "\$busybox_line" ] || busybox_line=\$(busybox --help 2>&1 | head -n 1)
case "\$busybox_line" in
	BusyBox*) echo "busybox=\$busybox_line" ;;
	*) echo "busybox=unknown" ;;
esac
tools_checked=0
for t in ${tools}; do
	tools_checked=\$((tools_checked + 1))
	command -v "\$t" >/dev/null 2>&1 || echo "tool_missing=\$t"
done
echo "tools_checked=\$tools_checked"
echo "overlay_kib=\$(df -k "${RR}/overlay" 2>/dev/null | awk 'NR==2 {print \$4}')"
if uci -q get 'dropbear.@dropbear[0]' >/dev/null 2>&1; then
	v=\$(uci -q get 'dropbear.@dropbear[0].PasswordAuth' 2>/dev/null)
	echo "dropbear_passwordauth=\${v:-unset}"
	v=\$(uci -q get 'dropbear.@dropbear[0].RootPasswordAuth' 2>/dev/null)
	echo "dropbear_rootpasswordauth=\${v:-unset}"
else
	echo "dropbear_passwordauth=unknown"
	echo "dropbear_rootpasswordauth=unknown"
fi
f="${RR}${R_AUTH_KEYS}"
if [ ! -e "\$f" ]; then
	echo "ak_lines=0"
else
	n=\$(grep -c '' "\$f" 2>/dev/null)
	rc=\$?
	if [ "\$rc" -le 1 ] 2>/dev/null; then
		echo "ak_lines=\${n:-0}"
	else
		echo "ak_lines=unknown"
	fi
fi
awk '${labels}' "\$f" 2>/dev/null
blob='${blob}'
p=unknown
if [ -n "\$blob" ]; then
	if awk -v blob="\$blob" '${match}' "\$f" 2>/dev/null | grep -q .; then p=present; else p=absent; fi
fi
echo "ak_plain=\$p"
if [ -e "${RR}${R_GUARD}" ]; then
	echo "guard=\$("${RR}${R_GUARD}" status 2>/dev/null)"
else
	echo "guard=not-installed"
fi
if [ -f "${RR}${R_LOCK}/sid" ]; then
	sid=\$(cat "${RR}${R_LOCK}/sid" 2>/dev/null)
	if [ -n "\$sid" ] && ubus call session list 2>/dev/null | grep -qF "\$sid"; then
		echo "lock=live"
	else
		echo "lock=stale"
	fi
else
	echo "lock=none"
fi
wan_src0='${wan_src0}'
wan_src1='${wan_src1}'
wan_live0=""
wan_live1=""
if [ -e "${RR}${R_WANHEALTH}" ]; then
	wan_live0=\$(sha256sum "${RR}${R_WANHEALTH}" 2>/dev/null | awk '{print \$1}')
fi
if [ -e "${RR}${R_WANHEALTH_INIT}" ]; then
	wan_live1=\$(sha256sum "${RR}${R_WANHEALTH_INIT}" 2>/dev/null | awk '{print \$1}')
fi
if [ -z "\$wan_live0" ] || [ -z "\$wan_live1" ]; then
	echo "wan_health=not-installed"
elif [ "\$wan_live0" = "\$wan_src0" ] && [ "\$wan_live1" = "\$wan_src1" ]; then
	echo "wan_health=installed"
else
	echo "wan_health=differs"
fi
echo "report_end=1"
EOF
	)
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: _uci_is_false VALUE -- exit 0 when VALUE is one of the uci
# boolean false words (0 no off false disabled, in any letter case); exit 1
# for every other value, including an empty value and `unset` (the uci
# default is true); pure.
_uci_is_false() {
	local v="${1:-}" lower
	# empty and unset are the default (true), so a missing value is NOT false
	[[ -z "$v" ]] && return 1
	lower=$(printf '%s' "$v" | tr '[:upper:]' '[:lower:]')
	case "$lower" in
		0|no|off|false|disabled) return 0 ;;
		*) return 1 ;;
	esac
}

# Contract: check_lines -- reads the check_report output on stdin and
# prints the PASS/FAIL/INFO/WARN lines (INFO release and
# busybox, PASS tools N/N present or one FAIL tool NAME per missing tool
# unless the missing name is the wifi probe, in which case a single WARN
# is printed and the PASS line counts the present tools as M/N with
# M=N-1; a router without wifi, or an image without iwinfo, is still
# valid because only wifi reads need iwinfo), INFO overlay free, the
# two dropbear lines, the authorized_keys INFO line, the guard line, the
# helper lock line, the wan-health INFO line); parsing is complete before any
# status is printed. Missing required fields, a tools_checked count different
# from G0_TOOLS, or a missing/bad report_end prints only `FAIL router report
# incomplete` and returns 3. The wan-health line is
# always INFO and never FAIL/WARN so it does not change the verdict or
# exit code; exit 1 when it printed a FAIL, else 0; pure: it never calls
# the router.
check_lines() {
	local line key val release='' busybox='' overlay_kib=''
	local dpa='' drpa='' ak_lines='' ak_labels='' ak_plain='' guard='' lock=''
	local wan_health='' tools_checked='' report_end=''
	local have_release=0 have_tools_checked=0 have_dpa=0 have_drpa=0
	local have_ak_lines=0 have_report_end=0
	local -a missing=()
	local t fails=0 present
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		key="${line%%=*}"
		val="${line#*=}"
		case "$key" in
			release) release="$val"; have_release=1 ;;
			busybox) busybox="$val" ;;
			tool_missing) missing+=("$val") ;;
			tools_checked) tools_checked="$val"; have_tools_checked=1 ;;
			overlay_kib) overlay_kib="$val" ;;
			dropbear_passwordauth) dpa="$val"; have_dpa=1 ;;
			dropbear_rootpasswordauth) drpa="$val"; have_drpa=1 ;;
			ak_lines) ak_lines="$val"; have_ak_lines=1 ;;
			ak_labels) ak_labels="$val" ;;
			ak_plain) ak_plain="$val" ;;
			guard) guard="$val" ;;
			lock) lock="$val" ;;
			wan_health) wan_health="$val" ;;
			report_end) report_end="$val"; have_report_end=1 ;;
		esac
	done
	if [[ $have_release -ne 1 || $have_tools_checked -ne 1 ||
		$have_dpa -ne 1 || $have_drpa -ne 1 || $have_ak_lines -ne 1 ||
		$have_report_end -ne 1 || "$tools_checked" != "${#G0_TOOLS[@]}" ||
		"$report_end" != "1" ]]; then
		fail "router report incomplete"
		return 3
	fi
	info "release ${release}"
	info "busybox ${busybox}"
	if [[ ${#missing[@]} -eq 0 ]]; then
		pass "tools ${#G0_TOOLS[@]}/${#G0_TOOLS[@]} present"
	else
		present=${#G0_TOOLS[@]}
		for t in "${missing[@]}"; do
			if [[ "$t" == "iwinfo" ]]; then
				warn "iwinfo absent: wifi reads unavailable"
				present=$((present - 1))
			else
				fail "tool ${t}"
				fails=1
			fi
		done
		if [[ $fails -eq 0 ]]; then
			pass "tools ${present}/${#G0_TOOLS[@]} present"
		fi
	fi
	info "overlay free ${overlay_kib} KiB"
	# uci booleans: 0 no off false disabled (any letter case) are false,
	# 1 yes on true enabled are true, unset (the router's word for an
	# absent option) means the default (true); an empty value or unknown
	# says nothing and FAILs (the empty value is unknown,
	# not the default); the FAIL wording names
	# "off" so the same line covers every false word
	if [[ "$dpa" == "unknown" || -z "$dpa" ]]; then
		fail "dropbear PasswordAuth unknown"
		fails=1
	elif _uci_is_false "$dpa"; then
		fail "dropbear PasswordAuth off"
		fails=1
	else
		pass "dropbear PasswordAuth on"
	fi
	if [[ "$drpa" == "unknown" || -z "$drpa" ]]; then
		fail "dropbear RootPasswordAuth unknown"
		fails=1
	elif _uci_is_false "$drpa"; then
		fail "dropbear RootPasswordAuth off"
		fails=1
	else
		pass "dropbear RootPasswordAuth on"
	fi
	if [[ "$ak_lines" == "unknown" ]]; then
		fail "authorized_keys line count unknown"
		fails=1
	else
		info "authorized_keys ${ak_lines} lines; newton labels: ${ak_labels}; plain key: ${ak_plain}"
	fi
	if [[ "$guard" == "not-installed" ]]; then
		info "guard not-installed"
	else
		case "$guard" in
			idle) pass "guard idle" ;;
			restored*) info "guard ${guard}" ;;
			*) fail "guard ${guard}"; fails=1 ;;
		esac
	fi
	case "$lock" in
		none) pass "helper lock none" ;;
		live) fail "helper lock live"; fails=1 ;;
		stale) warn "helper lock stale" ;;
		*) fail "helper lock ${lock}"; fails=1 ;;
	esac
	# wan-health is informational only; it never changes the verdict or
	# the exit code. No line when the router printed no such field.
	case "$wan_health" in
		installed) info "wan-health installed" ;;
		not-installed) info "wan-health not-installed" ;;
		differs) info "wan-health differs from sources" ;;
		'') ;;
		*) info "wan-health ${wan_health}" ;;
	esac
	[[ $fails -eq 0 ]]
}

# filled by install_code_files: the router paths this run replaced, each
# REMOTE|prev (a .prev was made) or REMOTE|noprev
INSTALL_REPLACED=()

# Contract: install_check_sources -- verifies that every CODE_FILES source
# and every EXTRA_FILES source exists under $SRC; a missing file dies
# (exit 2) naming that file; no router call is made.
install_check_sources() {
	local row rel
	for row in "${CODE_FILES[@]}" "${EXTRA_FILES[@]}"; do
		rel="${row%%|*}"
		[[ -f "${SRC}/${rel}" ]] || die "missing source file: ${SRC}/${rel}"
	done
}

# Contract: refuse_if_busy MODE -- step 1 of install (3.2) and step 2 of
# upgrade (3.7): one fixed-text rsh_admin call; a live helper lock
# (${R_LOCK}/sid named by `ubus call session list`) refuses in both
# modes; a guard status starting with pending refuses in both modes; a
# guard status starting with failed refuses only in install mode;
# the guard status is reported as `guard_status=...`
# in the same call so the caller can learn whether it is exactly
# `idle`; GUARD_IDLE is set to 1 when the status is exactly idle, 0
# otherwise (also 0 when the guard is not installed). A refusal prints
# WARN "<mode> refused: <reason>", STATE_NOTE 'router unchanged' and
# stopped "<mode> refused: the router is busy" (exit 1); returns 0
# when the router is not busy, else the call's exit status.
refuse_if_busy() {
	local mode="$1" out rc line why='' script guard_status=''
	script=$(cat <<EOF
if [ -f "${RR}${R_LOCK}/sid" ]; then
	sid=\$(cat "${RR}${R_LOCK}/sid" 2>/dev/null)
	if [ -n "\$sid" ] && ubus call session list 2>/dev/null | grep -qF "\$sid"; then
		echo "busy=helper-lock \$sid"
	fi
fi
if [ -e "${RR}${R_GUARD}" ]; then
	status=\$("${RR}${R_GUARD}" status 2>/dev/null)
	if [ "$mode" = "install" ]; then
		case "\$status" in
			pending*|failed*) echo "busy=guard \$status" ;;
		esac
	else
		case "\$status" in
			pending*) echo "busy=guard \$status" ;;
		esac
	fi
	echo "guard_status=\$status"
fi
EOF
)
	out=$(rsh_admin "$script" </dev/null 2>/dev/null)
	rc=$?
	[[ $rc -ne 0 ]] && return "$rc"
	while IFS= read -r line; do
		if [[ "$line" == busy=* ]]; then
			why="$line"
		elif [[ "$line" == guard_status=* ]]; then
			guard_status="${line#guard_status=}"
		fi
	done <<<"$out"
	if [[ "$guard_status" == "idle" ]]; then
		GUARD_IDLE=1
	else
		GUARD_IDLE=0
	fi
	if [[ -n "$why" ]]; then
		warn "${mode} refused: ${why#busy=}"
		STATE_NOTE='router unchanged'
		stopped "${mode} refused: the router is busy"
	fi
	return 0
}

# install_refuse_if_busy -- the install-side alias of refuse_if_busy
# ( RC1 refactor; install's behaviour and text are unchanged).
install_refuse_if_busy() {
	refuse_if_busy install
}

# Contract: install_dirs -- step 2 of 3.2: mkdir -p of the two router
# directories and chmod 755 (/usr/libexec/newton) and 700 (/etc/newton)
# in one rsh_admin call; the exit status is the call's.
install_dirs() {
	rsh_admin "mkdir -p \"${RR}/usr/libexec/newton\" \"${RR}${R_NEWTON_DIR}\" && chmod 755 \"${RR}/usr/libexec/newton\" && chmod 700 \"${RR}${R_NEWTON_DIR}\"" </dev/null 2>/dev/null
}

# Contract: install_code_files -- step 3 of 3.2: checks every source
# file of CODE_FILES under $SRC first (a missing one dies, exit 2,
# before anything is sent), then put_file for each row (the rotate
# argument for the rows that say yes); INSTALL_REPLACED remembers each
# router path this run replaced, as REMOTE|prev when a .prev was made,
# else REMOTE|noprev; returns 0 or 1. Resets INSTALL_REPLACED so the
# extras appended later by install_wan_health_files are seen together.
install_code_files() {
	install_check_sources
	INSTALL_REPLACED=()
	put_code_rows CODE_FILES
}

# Contract: put_code_rows ARRAY_NAME -- the shared inner loop of step 3
# (install and upgrade): runs put_file on every row of the array named
# by ARRAY_NAME (each row rel|remote|mode|rotate) and APPENDS
# REMOTE|prev or REMOTE|noprev to INSTALL_REPLACED when PUT_CHANGED=1;
# returns 0 on success or 1 on the first failed put_file. install_run
# calls it twice (CODE_FILES then EXTRA_FILES) and install_restore then
# sees the union, so the failure note mentions both. The caller is
# responsible for resetting INSTALL_REPLACED at the start of the action
# (install_code_files / the upgrade code path). install_check_sources is
# also the caller's responsibility.
put_code_rows() {
	local array_name="$1" row rel remote mode rotate
	local -n rows="$array_name"
	for row in "${rows[@]}"; do
		IFS='|' read -r rel remote mode rotate <<<"$row"
		if [[ "$rotate" == "yes" ]]; then
			put_file "${SRC}/${rel}" "$remote" "$mode" rotate || return 1
		else
			put_file "${SRC}/${rel}" "$remote" "$mode" || return 1
		fi
		if [[ $PUT_CHANGED -eq 1 ]]; then
			if [[ $PUT_ROTATED -eq 1 ]]; then
				INSTALL_REPLACED+=("${remote}|prev")
			else
				INSTALL_REPLACED+=("${remote}|noprev")
			fi
		fi
	done
	return 0
}

# Contract: install_wan_health_files -- the WAN-health extension of step 3:
# runs put_code_rows on EXTRA_FILES; the rows now rotate=yes so a .prev is
# made whenever the file is already on the router (the upgrade path). On a
# first install the file does not exist yet, no .prev is made, and
# install_restore rm -fs it on failure (the noprev branch). On an upgrade
# a .prev is taken and install_restore restores from it on failure. Returns
# 0 or 1.
install_wan_health_files() {
	put_code_rows EXTRA_FILES
}

# Contract: wan_health_stop -- ONE rsh_admin call (fixed text, ${RR} on the
# location, </dev/null) that runs `${RR}${R_WANHEALTH_INIT} stop` only when
# the init file exists; an absent init is success and the exit status is the
# call's. Stop is kept separate from disable so a failed stop can never be
# masked by a later successful disable.
wan_health_stop() {
	rsh_admin "if [ -e '${RR}${R_WANHEALTH_INIT}' ]; then '${RR}${R_WANHEALTH_INIT}' stop; fi" </dev/null 2>/dev/null
}

# Contract: wan_health_disable -- ONE rsh_admin call (fixed text, ${RR} on
# the location, </dev/null) that runs `${RR}${R_WANHEALTH_INIT} disable` only
# when the init file exists; an absent init is success and the exit status is
# the call's.
wan_health_disable() {
	rsh_admin "if [ -e '${RR}${R_WANHEALTH_INIT}' ]; then '${RR}${R_WANHEALTH_INIT}' disable; fi" </dev/null 2>/dev/null
}

# Contract: wan_health_enabled -- ONE rsh_admin call (fixed text, ${RR} on
# the location, </dev/null) that tests exactly for the S95 start link created
# by the init's enable: exit 0 means enabled, exit 1 means not enabled, and
# any other exit status is the failing ssh call's.
wan_health_enabled() {
	rsh_admin "[ -e '${RR}/etc/rc.d/S95newton-wan-health' ]" </dev/null 2>/dev/null
}

# Contract: wan_health_restart -- ONE rsh_admin call (fixed text, ${RR} on
# the location, </dev/null) that runs `${RR}${R_WANHEALTH_INIT} restart`; the
# caller must first decide with wan_health_enabled that the service is
# enabled. The exit status is the call's.
wan_health_restart() {
	rsh_admin "'${RR}${R_WANHEALTH_INIT}' restart" </dev/null 2>/dev/null
}

# Contract: install_wan_health_config -- ONE fixed-text rsh_admin call
# (</dev/null, ${RR} on every location) that:
# (a) creates /etc/config/newton_wanhealth EMPTY if it does not exist
#     (`[ -e f ] || : > f`; never overwrites an existing one). When created
#     here the file is chmod 600 so `uci set newton_wanhealth.main.enabled=1`
#     will not fail on a router that has never seen the package; an
#     existing file keeps its content AND its mode (user data); and
# (b) runs `${RR}${R_WANHEALTH_INIT} enable` -- the init's start_service
#     does nothing unless newton_wanhealth.main.enabled is 1, so enabling
#     the symlink is inert until the operator flips the knob;
# (c) runs `${RR}${R_WANHEALTH_INIT} start` (live OpenWrt 25.12 finding:
#     procd only registers `procd_add_reload_trigger newton_wanhealth`
#     when the init has been STARTED at least once, so just `enable`
#     leaves a Newton change that sets enabled=1 stuck until the next
#     reboot; start is a no-op until enabled=1, so it is still safe to
#     run during install). The two invocations are joined with `&&`:
#     when enable cannot complete, install never silently runs start,
#     and the call's non-zero exit makes install fail at extras 2
#     (install_restore + STOPPED). The exit status is the call's.
install_wan_health_config() {
	rsh_admin "f=\"${RR}/etc/config/newton_wanhealth\"; if [ ! -e \"\$f\" ]; then : > \"\$f\" && chmod 600 \"\$f\"; fi; \"${RR}${R_WANHEALTH_INIT}\" enable && \"${RR}${R_WANHEALTH_INIT}\" start" </dev/null 2>/dev/null
}

# Contract: install_wan_health_verify -- ONE fixed-text rsh_admin call
# (</dev/null, ${RR} on every location) that prints sha256sum of the two
# router files; the caller compares the two lines with sha256_file of
# the two EXTRA_FILES sources; returns 0 only when both lines match in
# order; returns 1 on any other rsh_admin output, on a missing line, or
# on any sha mismatch.
install_wan_health_verify() {
	local row0 row1 rel0 rel1 want0 want1 out sha0 sha1
	row0="${EXTRA_FILES[0]}"
	row1="${EXTRA_FILES[1]}"
	rel0="${row0%%|*}"
	rel1="${row1%%|*}"
	want0=$(sha256_file "${SRC}/${rel0}")
	want1=$(sha256_file "${SRC}/${rel1}")
	out=$(rsh_admin "sha256sum \"${RR}${R_WANHEALTH}\" \"${RR}${R_WANHEALTH_INIT}\"" </dev/null 2>/dev/null) || return 1
	sha0=$(printf '%s\n' "$out" | head -n 1 | awk '{print $1}')
	sha1=$(printf '%s\n' "$out" | sed -n '2p' | awk '{print $1}')
	[[ "$sha0" == "$want0" && "$sha1" == "$want1" ]] || return 1
	return 0
}

# Contract: install_guard_enable -- step 4 of 3.2: runs `${RR}/etc/
# init.d/newton-guard enable`, then reads `${RR}${R_GUARD} status` and
# returns 0 only when it is `idle` or starts with `restored `; the exit
# status is the failing call's or 1 on a bad status.
install_guard_enable() {
	local status
	rsh_admin "\"${RR}${R_INIT}\" enable" </dev/null 2>/dev/null || return 1
	status=$(rsh_admin "\"${RR}${R_GUARD}\" status" </dev/null 2>/dev/null) || return 1
	case "$status" in
		idle|restored\ *) return 0 ;;
		*) return 1 ;;
	esac
}

# Contract: zones_text -- pure; prints the design 2.1 zones file on
# stdout: one mgmt-interface, one mgmt-zone and one wan-zone line per
# entry of DEV_WAN_ZONES, from DEV_MGMT_IFACE, DEV_MGMT_ZONE and
# DEV_WAN_ZONES; never calls the router.
zones_text() {
	local wan="$DEV_WAN_ZONES" zone
	printf 'mgmt-interface %s\n' "$DEV_MGMT_IFACE"
	printf 'mgmt-zone %s\n' "$DEV_MGMT_ZONE"
	local IFS=','
	# the expansion must word-split on the commas
	for zone in $wan; do
		printf 'wan-zone %s\n' "$zone"
	done
}

# Contract: install_config_files -- step 5 of 3.2: writes the three
# design 2.1 config files through put_text with mode 600: device-id
# (DEVICE), profile (DEV_PROFILE) and zones (zones_text); returns 0 or
# the failing put_text's 1.
install_config_files() {
	printf '%s\n' "$DEVICE" | put_text "${R_NEWTON_DIR}/device-id" 600 || return 1
	printf '%s\n' "$DEV_PROFILE" | put_text "${R_NEWTON_DIR}/profile" 600 || return 1
	zones_text | put_text "${R_NEWTON_DIR}/zones" 600 || return 1
}

# Contract: install_sysupgrade -- step 6 of 3.2: appends only the
# missing SYSUPGRADE_LINES to /etc/sysupgrade.conf in one rsh_admin
# call: the .new file is built on the router from the live file (empty
# when it does not exist yet) with `grep -qxF` per line, then mv; when
# no line is missing the .new is removed and the live file is not
# touched; the exit status is the call's.
install_sysupgrade() {
	local script
	script=$(cat <<EOF
f="${RR}/etc/sysupgrade.conf"
n="\${f}.new"
if [ -f "\$f" ]; then cp -p "\$f" "\$n" || exit 1; else : > "\$n" || exit 1; fi
if [ -s "\$n" ] && [ -n "\$(tail -c 1 "\$n")" ]; then printf '\n' >> "\$n" || exit 1; fi
added=0
for want in ${SYSUPGRADE_LINES[*]}; do
	grep -qxF "\$want" "\$n" || { printf '%s\n' "\$want" >> "\$n"; added=\$((added + 1)); }
done
[ "\$added" -gt 0 ] || { rm -f "\$n"; exit 0; }
mv "\$n" "\$f" || exit 1
EOF
)
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: verify_hello WANT_GUARD_INIT -- shared check of install
# step 7 (3.2) and upgrade step 4 (3.7): hello_direct with a fresh
# nonce; the prog and helper fields must equal sha256_file of the two
# first sources of CODE_FILES; when WANT_GUARD_INIT is 1 the guard and
# init fields must also match; the mode field must be prod; returns 0
# or 1.
verify_hello() {
	local want_guard_init="$1" nonce reply row rel want field i
	local -a names=(prog helper guard init)
	local n=2
	[[ "$want_guard_init" == "1" ]] && n=4
	nonce=$(new_nonce)
	reply=$(hello_direct "$nonce") || return 1
	for i in $(seq 0 $((n - 1))); do
		row="${CODE_FILES[i]}"
		rel="${row%%|*}"
		want=$(sha256_file "${SRC}/${rel}")
		field=$(hello_field "$reply" "${names[i]}") || return 1
		[[ "$field" == "$want" ]] || return 1
	done
	field=$(hello_field "$reply" mode) || return 1
	[[ "$field" == "prod" ]] || return 1
	return 0
}

# Contract: install_verify -- step 7 of 3.2: verify_hello with all
# four fields; returns 0 or 1.
install_verify() {
	verify_hello 1
}

# Contract: proof_hello KEYFILE LABEL ROLE -- a fresh key-lane hello must
# report the restricted identity and protections; prints one proof line.
proof_hello() {
	local keyfile="$1" label="$2" role="$3" nonce reply got
	nonce=$(new_nonce)
	reply=$(hello_key "$keyfile" "$nonce") || reply=''
	if [[ -n "$reply" \
		&& "$(hello_field "$reply" caller 2>/dev/null)" == "$label" \
		&& "$(hello_field "$reply" role 2>/dev/null)" == "$role" \
		&& "$(hello_field "$reply" door 2>/dev/null)" == "ssh" \
		&& "$(hello_field "$reply" mode 2>/dev/null)" == "prod" \
		&& "$(hello_field "$reply" agent 2>/dev/null)" == "0" ]]; then
		pass "proof hello: restricted identity"
		return 0
	fi
	# the reply line holds no secret; trim to 200 characters so the FAIL
	# line stays small when the program echoes the whole hello payload
	got="${reply:0:200}"
	fail "proof hello: expected caller=${label} role=${role} door=ssh mode=prod agent=0; got '${got}'"
	return 1
}

# Contract: proof_probe_fail KEYFILE LABEL ROLE -- a fresh key-lane probe
# carries stdin and exit 1; prints one proof line.
proof_probe_fail() {
	local keyfile="$1" out rc
	out="${TMP_DIR}/proof-probe.out"
	printf 'fail\n' | rsh_key "$keyfile" probe >"$out" 2>/dev/null
	rc=${PIPESTATUS[1]}
	if [[ $rc -eq 1 && "$(<"$out")" == "probe fail fail planted" ]]; then
		pass "proof probe-fail: stdin and exit status"
		return 0
	fi
	fail "proof probe-fail: expected exit 1 and 'probe fail fail planted'; got exit ${rc}"
	return 1
}

# Contract: proof_bad_arg KEYFILE LABEL ROLE -- a fresh key-lane bad hello
# must exit 2 with error bad-arg 1; prints one proof line.
proof_bad_arg() {
	local keyfile="$1" err rc
	err="${TMP_DIR}/proof-bad-arg.err"
	rsh_key "$keyfile" 'hello zz' </dev/null >/dev/null 2>"$err"
	rc=$?
	if [[ $rc -eq 2 ]] && grep -qxF 'error bad-arg 1' "$err"; then
		pass "proof bad-arg: rejected"
		return 0
	fi
	fail "proof bad-arg: expected exit 2 and 'error bad-arg 1'; got exit ${rc}"
	return 1
}

# Contract: proof_selftest_refused KEYFILE LABEL ROLE -- a fresh key-lane
# approval selftest must be direct-only, exit 3; prints one proof line.
proof_selftest_refused() {
	local keyfile="$1" nonce err rc
	nonce=$(new_nonce)
	err="${TMP_DIR}/proof-selftest.err"
	rsh_key "$keyfile" "approval-selftest ${nonce}" </dev/null >/dev/null 2>"$err"
	rc=$?
	if [[ $rc -eq 3 ]] && grep -qxF 'error direct-only' "$err"; then
		pass "proof selftest-refused: direct-only"
		return 0
	fi
	fail "proof selftest-refused: expected exit 3 and 'error direct-only'; got exit ${rc}"
	return 1
}

# Contract: proof_backup KEYFILE LABEL ROLE -- a fresh key-lane backup is a
# valid etc/config tarball for change or a role refusal for read; one line.
proof_backup() {
	local keyfile="$1" role="$3" out err rc tar_rc listing
	out="${TMP_DIR}/proof-backup.tar.gz"
	err="${TMP_DIR}/proof-backup.err"
	rsh_key "$keyfile" backup </dev/null >"$out" 2>"$err"
	rc=$?
	if [[ "$role" == "change" ]]; then
		# the tar listing is read into a variable first: with set -o
		# pipefail, piping tar into grep -q used to fail the test as
		# soon as grep closed the pipe, so a listing larger than the
		# pipe buffer (64 KiB) killed tar with SIGPIPE and a good
		# archive looked bad
		listing=$(tar -tzf "$out" 2>/dev/null)
		tar_rc=$?
		if [[ $rc -eq 0 ]] && gzip -t "$out" 2>/dev/null \
			&& [[ $tar_rc -eq 0 ]] \
			&& grep -q '^etc/config' <<<"$listing"; then
			pass "proof backup: change-role archive"
			return 0
		fi
		fail "proof backup: expected a valid etc/config tarball; got ssh_rc=${rc} tar_rc=${tar_rc}"
		return 1
	fi
	if [[ $rc -eq 3 ]] && grep -qxF 'error role' "$err"; then
		pass "proof backup: read-role refused"
		return 0
	fi
	fail "proof backup: expected exit 3 and 'error role' for a read-role call; got exit ${rc}"
	return 1
}

# Contract: proof_unknown_and_empty KEYFILE LABEL ROLE -- fresh key-lane id
# and no-command calls must report their grammar errors; prints one line.
proof_unknown_and_empty() {
	local keyfile="$1" err1 err2 rc1 rc2
	err1="${TMP_DIR}/proof-unknown.err"
	err2="${TMP_DIR}/proof-empty.err"
	rsh_key "$keyfile" id </dev/null >/dev/null 2>"$err1"
	rc1=$?
	ssh_base_opts
	timeout --foreground 30 ssh "${SSH_OPTS[@]}" -T -i "$keyfile" \
		-o IdentitiesOnly=yes -o BatchMode=yes \
		-o PreferredAuthentications=publickey -o PasswordAuthentication=no \
		"root@$DEV_HOST" </dev/null >/dev/null 2>"$err2"
	rc2=$?
	if [[ $rc1 -eq 2 && $rc2 -eq 2 ]] \
		&& grep -qxF 'error unknown-subcommand' "$err1" \
		&& grep -qxF 'error empty-request' "$err2"; then
		pass "proof unknown-and-empty: rejected"
		return 0
	fi
	fail "proof unknown-and-empty: expected exit 2 for both 'id' and no-command; got exit ${rc1} / ${rc2}"
	return 1
}

# Contract: free_port -- prints one currently free TCP port on 127.0.0.1.
free_port() {
	python3 -c 'import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()'
}

# Contract: forward_ssh_start KEYFILE MODE_ARGS... -- starts one bounded
# key-lane forwarding ssh in the background and prints its pid.
forward_ssh_start() {
	local keyfile="$1"
	shift
	ssh_base_opts
	timeout --foreground 30 ssh "${SSH_OPTS[@]}" -i "$keyfile" \
		-o IdentitiesOnly=yes -o BatchMode=yes \
		-o PreferredAuthentications=publickey -o PasswordAuthentication=no \
		"$@" "root@$DEV_HOST" </dev/null \
		>"${TMP_DIR}/proof-forward.out" 2>"${TMP_DIR}/proof-forward.err" &
	printf '%s\n' "$!"
}

# Contract: forward_admin_start ARGS... -- starts one bounded admin-lane
# forwarding ssh in the background and prints its pid.  ADMIN_MODE=plain-key
# means the plain-key lane (with PLAIN_KEY); the password lane is rsh_pw's
# per-call FIFO askpass (mkfifo -m 600, background writer, SSH_ASKPASS,
# SSH_ASKPASS_REQUIRE=force and DISPLAY set for this one ssh only); the
# password never reaches argv, a file or the environment of anything but
# that one ssh.  The writer pid goes into FWD_WRITER and the fifo path
# into FWD_FIFO so forward_ssh_stop can reap it and remove the fifo.
forward_admin_start() {
	if [[ "$ADMIN_MODE" == "plain-key" ]]; then
		forward_ssh_start "$PLAIN_KEY" "$@"
		return
	fi
	local fifo wr
	ssh_base_opts
	admin_password_get
	askpass_prepare
	fifo="${TMP_DIR}/askpass.fifo"
	mkfifo -m 600 -- "$fifo" || die "cannot create the askpass fifo"
	printf '%s\n' "$ROOT_PW" >"$fifo" &
	wr=$!
	FWD_WRITER=$wr
	FWD_FIFO=$fifo
	SSH_ASKPASS="$ASKPASS" SSH_ASKPASS_REQUIRE=force DISPLAY="${DISPLAY:-x}" \
		timeout --foreground 30 ssh "${SSH_OPTS[@]}" \
		-o BatchMode=no -o PreferredAuthentications=password,keyboard-interactive \
		-o PubkeyAuthentication=no -o NumberOfPasswordPrompts=1 \
		"$@" "root@$DEV_HOST" </dev/null \
		>"${TMP_DIR}/proof-forward.out" 2>"${TMP_DIR}/proof-forward.err" &
	printf '%s\n' "$!"
}

# Contract: forward_wait_port PID PORT -- waits at most five local seconds
# for PORT to accept or PID to exit; returns 0 only when the port accepted.
forward_wait_port() {
	local pid="$1" port="$2" i
	for i in {1..50}; do
		if python3 -c 'import socket, sys
s = socket.create_connection(("127.0.0.1", int(sys.argv[1])), 0.1)
s.close()' "$port" >/dev/null 2>&1; then
			return 0
		fi
		kill -0 "$pid" 2>/dev/null || return 1
		wait_local 0.1
	done
	return 1
}

# Contract: forward_ssh_stop PID -- kills and reaps one forwarding ssh
# without output; when an askpass writer is pending (the password-lane
# forward_admin_start) kills and reaps the writer and removes the fifo;
# returns the wait status of the ssh.
forward_ssh_stop() {
	local pid="$1" rc
	kill "$pid" 2>/dev/null || true
	rc=0
	wait "$pid" 2>/dev/null || rc=$?
	if [[ -n "${FWD_WRITER:-}" && $FWD_WRITER -gt 0 ]]; then
		kill "$FWD_WRITER" 2>/dev/null || true
		wait "$FWD_WRITER" 2>/dev/null || true
		FWD_WRITER=0
	fi
	if [[ -n "${FWD_FIFO:-}" ]]; then
		rm -f -- "$FWD_FIFO"
		FWD_FIFO=''
	fi
	return "$rc"
}

# Contract: forward_target_split CANDIDATE -- prints HOST and PORT of one
# candidate as ONE line `HOST PORT`; PORT is everything after the LAST colon
# (${candidate##*:}), HOST everything before it (${candidate%:*}); when HOST
# is wrapped in [ ] the brackets are removed ([fd00::1]:2222 -> fd00::1 2222).
# No router call, no ssh, no output other than that line.
forward_target_split() {
	local candidate="$1"
	local thost="${candidate%:*}"
	local tport="${candidate##*:}"
	if [[ "$thost" == \[*\] ]]; then
		thost="${thost#[}"
		thost="${thost%]}"
	fi
	printf '%s %s\n' "$thost" "$tport"
}

# Contract: forward_l_spec PORT THOST TPORT -- prints the -L argument
# `127.0.0.1:PORT:THOST:TPORT`, with THOST wrapped in [] when it contains :
# and does not already start with [. No other output.
forward_l_spec() {
	local port="$1" thost="$2" tport="$3"
	local wrapped
	if [[ "$thost" == *:* && "$thost" != \[* ]]; then
		wrapped="[${thost}]"
	else
		wrapped="$thost"
	fi
	printf '127.0.0.1:%s:%s:%s\n' "$port" "$wrapped" "$tport"
}

# Contract: forward_banner KIND LANE THOST TPORT [KEYFILE] -- start an
# admin-lane (LANE=admin) or key-lane (LANE=key, KEYFILE required) forward
# of KIND L (-L 127.0.0.1:PORT:THOST:TPORT) or D (-D 127.0.0.1:PORT),
# probe it with nc and report: 0 = an SSH- banner arrived through the
# forward; 1 = no banner; 2 = no free port or the local port never came up.
# For -L an IPv6 THOST that contains `:` is wrapped in [].  Errors from nc
# are ignored; only the banner check matters.
forward_banner() {
	local kind="$1" lane="$2" thost="$3" tport="$4" keyfile="${5:-}"
	local port pid spec
	local pidfile="${TMP_DIR}/proof-forward.pid" nc_out="${TMP_DIR}/proof-nc.out"
	if ! port=$(free_port); then
		return 2
	fi
	if [[ "$kind" == "L" ]]; then
		spec=$(forward_l_spec "$port" "$thost" "$tport")
		if [[ "$lane" == "admin" ]]; then
			forward_admin_start -N -L "$spec" >"$pidfile"
		else
			forward_ssh_start "$keyfile" -N -L "$spec" >"$pidfile"
		fi
	elif [[ "$kind" == "D" ]]; then
		if [[ "$lane" == "admin" ]]; then
			forward_admin_start -N -D "127.0.0.1:${port}" >"$pidfile"
		else
			forward_ssh_start "$keyfile" -N -D "127.0.0.1:${port}" >"$pidfile"
		fi
	else
		return 2
	fi
	IFS= read -r pid <"$pidfile"
	if ! forward_wait_port "$pid" "$port"; then
		forward_ssh_stop "$pid" || true
		return 2
	fi
	if [[ "$kind" == "L" ]]; then
		nc -w 3 127.0.0.1 "$port" </dev/null >"$nc_out" 2>/dev/null || true
	else
		nc -X 5 -x "127.0.0.1:${port}" "$thost" "$tport" </dev/null >"$nc_out" 2>/dev/null || true
	fi
	local rc=1
	if grep -q 'SSH-' "$nc_out"; then
		rc=0
	fi
	forward_ssh_stop "$pid" || true
	return "$rc"
}

# Contract: proof_forwards KEYFILE LABEL ROLE -- real L, D and R attempts on
# fresh restricted-key connections must carry no SSH bytes; a positive
# control runs the same forwards through the admin lane first; prints one
# proof line.
proof_forwards() {
	local keyfile="$1"
	local pid i rrc running lrc drc ok=1
	local r_ok=1 reason=''
	local pidfile="${TMP_DIR}/proof-forward.pid" nc_out="${TMP_DIR}/proof-nc.out"
	local thost='' tport='' target=''
	local -a try_targets=()
	local candidate
	if ! command -v nc >/dev/null 2>&1; then
		fail "proof forwards: nc not found"
		return 1
	fi
	# positive control: try loopback:22 first, then the inventory host:port
	# (only as a different candidate when it differs from loopback:22)
	try_targets=("127.0.0.1:22")
	if [[ "$DEV_HOST" != "127.0.0.1" || "$DEV_PORT" != "22" ]]; then
		try_targets+=("${DEV_HOST}:${DEV_PORT}")
	fi
	for candidate in "${try_targets[@]}"; do
		read -r thost tport <<<"$(forward_target_split "$candidate")"
		if forward_banner L admin "$thost" "$tport"; then
			target="$candidate"
			break
		fi
	done
	if [[ -z "$target" ]]; then
		fail "proof forwards: expected the admin path to carry an SSH banner through -L (tried 127.0.0.1:22 and ${DEV_HOST}:${DEV_PORT}); got none, so a blocked forward cannot be told from a closed target"
		return 1
	fi
	if ! forward_banner D admin "$thost" "$tport"; then
		fail "proof forwards: expected the admin path to carry an SSH banner through -D to ${thost}:${tport}; got none (does the local nc support -X and -x?)"
		return 1
	fi
	# negative tests with the restricted key at the SAME target
	lrc=0
	forward_banner L key "$thost" "$tport" "$keyfile" || lrc=$?
	case "$lrc" in
		0)	ok=0; reason+=" -L carried SSH bytes" ;;
		2)	ok=0; reason+=" -L could not be tried" ;;
		1)	;;  # pass: no banner
	esac
	drc=0
	forward_banner D key "$thost" "$tport" "$keyfile" || drc=$?
	case "$drc" in
		0)	ok=0; reason+=" -D carried SSH bytes" ;;
		2)	ok=0; reason+=" -D could not be tried" ;;
		1)	;;  # pass: no banner
	esac
	# -R: still a refused forward at the router
	local port
	if port=$(free_port); then
		forward_ssh_start "$keyfile" -N -R "${port}:127.0.0.1:22" \
			-o ExitOnForwardFailure=yes >"$pidfile"
		IFS= read -r pid <"$pidfile"
		running=1
		for i in {1..50}; do
			if ! kill -0 "$pid" 2>/dev/null; then
				running=0
				break
			fi
			wait_local 0.1
		done
		forward_ssh_stop "$pid"
		rrc=$?
		if [[ $running -ne 0 || $rrc -eq 0 ]]; then
			r_ok=0
			ok=0
		fi
	else
		r_ok=0
		ok=0
	fi
	if [[ $ok -eq 1 ]]; then
		pass "proof forwards: blocked"
		return 0
	fi
	[[ $r_ok -eq 1 ]] || reason+=" -R was not refused"
	fail "proof forwards: expected no SSH bytes through -L and -D and a refused -R; got:${reason}"
	return 1
}

# Contract: proof_pty_agent KEYFILE LABEL ROLE -- fresh -tt and private-agent
# key-lane hellos must report tty=0 and agent=0; prints one proof line. The
# -tt attempt ALSO passes when ssh exits 255, its stderr carries the
# dropbear line "PTY allocation request failed", and stdout carries no
# hello body at all — the no-pty authorized_keys option is what makes
# dropbear refuse the PTY, so a refused connection proves the option was
# honored. An exit 255 with any other error, an exit 255 with the PTY
# message AND a body, or any other non-zero exit without a hello body
# all still FAIL. The agent half is unchanged.
proof_pty_agent() {
	local keyfile="$1" nonce out err pid i ready=0 ok=1 sock tty_ok=1 agent_ok=1
	local pty_rc=0
	out="${TMP_DIR}/proof-pty-agent.out"
	err="${TMP_DIR}/proof-pty-agent.err"
	nonce=$(new_nonce)
	ssh_base_opts
	timeout --foreground 30 ssh "${SSH_OPTS[@]}" -tt -i "$keyfile" \
		-o IdentitiesOnly=yes -o BatchMode=yes \
		-o PreferredAuthentications=publickey -o PasswordAuthentication=no \
		"root@$DEV_HOST" "hello ${nonce}" </dev/null >"$out" 2>"$err"
	pty_rc=$?
	if grep -qF "PTY allocation request failed" "$err" 2>/dev/null; then
		# dropbear refused the PTY allocation: the only way this proves
		# the no-pty option was honored is an empty body + ssh exit 255.
		# If the body still ran (a hostile or buggy dropbear), FAIL.
		if [[ $pty_rc -ne 255 || -s "$out" ]]; then
			tty_ok=0
			ok=0
		fi
	else
		# no PTY refusal: ssh must exit 0 and the hello body must answer tty=0.
		if [[ $pty_rc -ne 0 || "$(hello_field "$(<"$out")" tty 2>/dev/null)" != "0" ]]; then
			tty_ok=0
			ok=0
		fi
	fi
	sock="${TMP_DIR}/agent.sock"
	ssh-agent -D -a "$sock" </dev/null >/dev/null 2>&1 &
	pid=$!
	for i in {1..50}; do
		if [[ -S "$sock" ]]; then
			ready=1
			break
		fi
		kill -0 "$pid" 2>/dev/null || break
		wait_local 0.1
	done
	if [[ $ready -eq 1 ]]; then
		nonce=$(new_nonce)
		ssh_base_opts
		SSH_AUTH_SOCK="$sock" timeout --foreground 30 ssh "${SSH_OPTS[@]}" -A \
			-i "$keyfile" -o IdentitiesOnly=yes -o BatchMode=yes \
			-o PreferredAuthentications=publickey -o PasswordAuthentication=no \
			"root@$DEV_HOST" "hello ${nonce}" </dev/null >"$out" 2>/dev/null || ok=0
		if [[ "$(hello_field "$(<"$out")" agent 2>/dev/null)" != "0" ]]; then
			agent_ok=0
			ok=0
		fi
	else
		agent_ok=0
		ok=0
	fi
	kill "$pid" 2>/dev/null || true
	wait "$pid" 2>/dev/null || true
	if [[ $ok -eq 1 ]]; then
		pass "proof pty-agent: blocked"
		return 0
	fi
	fail "proof pty-agent: expected tty=0 and agent=0; got tty_ok=${tty_ok} agent_ok=${agent_ok}"
	return 1
}

# Contract: proof_sftp_scp KEYFILE LABEL ROLE -- fresh restricted-key sftp
# and scp calls must both fail; prints one proof line.
proof_sftp_scp() {
	local keyfile="$1" rc1 rc2
	printf 'ls /\n' | rsftp_key "$keyfile" >/dev/null 2>&1
	rc1=${PIPESTATUS[1]}
	rscp_key "$keyfile" /dev/null /tmp/newton-proof </dev/null >/dev/null 2>&1
	rc2=$?
	if [[ $rc1 -ne 0 && $rc2 -ne 0 ]]; then
		pass "proof sftp-scp: blocked"
		return 0
	fi
	fail "proof sftp-scp: expected both sftp and scp to fail; got sftp=${rc1} scp=${rc2}"
	return 1
}

# Contract: proof_setenv KEYFILE LABEL ROLE -- a fresh key-lane hello with
# NEWTON_ROUTER_ROOT set must remain in prod mode; prints one proof line.
proof_setenv() {
	local keyfile="$1" nonce out rc mode=''
	nonce=$(new_nonce)
	out="${TMP_DIR}/proof-setenv.out"
	ssh_base_opts
	timeout --foreground 30 ssh "${SSH_OPTS[@]}" -i "$keyfile" \
		-o IdentitiesOnly=yes -o BatchMode=yes \
		-o PreferredAuthentications=publickey -o PasswordAuthentication=no \
		-o SetEnv=NEWTON_ROUTER_ROOT=/tmp "root@$DEV_HOST" "hello ${nonce}" \
		</dev/null >"$out" 2>/dev/null
	rc=$?
	mode=$(hello_field "$(<"$out")" mode 2>/dev/null) || mode=''
	if [[ $rc -eq 0 && "$mode" == "prod" ]]; then
		pass "proof setenv: prod preserved"
		return 0
	fi
	fail "proof setenv: expected mode=prod; got rc=${rc} mode='${mode}'"
	return 1
}

# Contract: prove_restricted_key LABEL ROLE KEYFILE -- runs proofs a-j in
# order without stopping; returns 1 if any proof failed, otherwise 0.
prove_restricted_key() {
	local label="$1" role="$2" keyfile="$3" failed=0
	proof_hello "$keyfile" "$label" "$role" || failed=1
	proof_probe_fail "$keyfile" "$label" "$role" || failed=1
	proof_bad_arg "$keyfile" "$label" "$role" || failed=1
	proof_selftest_refused "$keyfile" "$label" "$role" || failed=1
	proof_backup "$keyfile" "$label" "$role" || failed=1
	proof_unknown_and_empty "$keyfile" "$label" "$role" || failed=1
	proof_forwards "$keyfile" "$label" "$role" || failed=1
	proof_pty_agent "$keyfile" "$label" "$role" || failed=1
	proof_sftp_scp "$keyfile" "$label" "$role" || failed=1
	proof_setenv "$keyfile" "$label" "$role" || failed=1
	[[ $failed -eq 0 ]]
}

# Contract: install_restore -- the failure path of 3.2: restores every
# entry of INSTALL_REPLACED that has a .prev (`cp -p REMOTE.prev
# REMOTE.new`, chmod 755, mv); runs hello_direct again with a fresh
# nonce and sets STATE_NOTE to say which files were restored, or that
# no .prev existed (first install) and the broken file is still on the
# router, with the hello result; the WAN-health extras (rotate=yes,
# R9b+c) follow the same path: when the file already existed (upgrade)
# a .prev was made and is copied back, when it did not (first install)
# it is stopped, disabled and rm -f'd (each step checked) so the router is
# not left with a half-installed or orphaned wan-health tool; prints nothing.
install_restore() {
	local entry remote restored='' no_prev='' nonce hello=failed extras_to_remove=''
	local stop_failed=0 disable_failed=0 remove_failed=0
	for entry in "${INSTALL_REPLACED[@]}"; do
		remote="${entry%%|*}"
		# WAN-health extras use the same mechanism as CODE_FILES: a
		# .prev means the file existed before this run (upgrade path),
		# so copy it back; no .prev means the file did not exist
		# (first install), so rm -f the half-installed file.
		if [[ "$remote" == "${R_WANHEALTH}" \
			|| "$remote" == "${R_WANHEALTH_INIT}" ]]; then
			if [[ "$entry" == *\|prev ]]; then
				if rsh_admin "cp -p \"${RR}${remote}.prev\" \"${RR}${remote}.new\" && chmod 755 \"${RR}${remote}.new\" && mv \"${RR}${remote}.new\" \"${RR}${remote}\"" </dev/null 2>/dev/null; then
					restored="${restored}${remote} "
				fi
			else
				extras_to_remove="${extras_to_remove}${remote} "
			fi
			continue
		fi
		if [[ "$entry" != *\|prev ]]; then
			no_prev="${no_prev}${remote} "
			continue
		fi
		if rsh_admin "cp -p \"${RR}${remote}.prev\" \"${RR}${remote}.new\" && chmod 755 \"${RR}${remote}.new\" && mv \"${RR}${remote}.new\" \"${RR}${remote}\"" </dev/null 2>/dev/null; then
			restored="${restored}${remote} "
		fi
	done
	if [[ -n "$extras_to_remove" ]]; then
		# The install path has already enabled and started this init. Stop and
		# disable it in checked, separate calls before deleting either file.
		if ! wan_health_stop; then
			stop_failed=1
		elif ! wan_health_disable; then
			disable_failed=1
		fi
	fi
	if [[ -n "$extras_to_remove" && $stop_failed -eq 0 && $disable_failed -eq 0 ]]; then
		local rm_cmd='rm -f'
		local extra
		for extra in ${extras_to_remove}; do
			rm_cmd+=" \"${RR}${extra}\""
		done
		rsh_admin "$rm_cmd" </dev/null 2>/dev/null || remove_failed=1
	fi
	nonce=$(new_nonce)
	if hello_direct "$nonce" >/dev/null; then
		hello=ok
	fi
	if [[ -n "$restored" ]]; then
		STATE_NOTE="restored from .prev: ${restored% }; hello after restore: ${hello}"
	elif [[ -n "$no_prev" ]]; then
		STATE_NOTE="no .prev existed (first install); the broken file is still on the router; hello: ${hello}"
	elif [[ -n "$extras_to_remove" && $((stop_failed + disable_failed + remove_failed)) -eq 0 ]]; then
		STATE_NOTE="removed the wan-health extras: ${extras_to_remove% }; hello after restore: ${hello}"
	elif [[ -n "$extras_to_remove" ]]; then
		STATE_NOTE="hello after restore: ${hello}"
	else
		STATE_NOTE="no file was replaced this run; hello: ${hello}"
	fi
	if [[ $stop_failed -eq 1 ]]; then
		STATE_NOTE+="; wan-health stop failed; files remain: ${extras_to_remove% }"
	elif [[ $disable_failed -eq 1 ]]; then
		STATE_NOTE+="; wan-health disable failed; files remain: ${extras_to_remove% }"
	elif [[ $remove_failed -eq 1 ]]; then
		STATE_NOTE+="; wan-health file removal failed; files remain: ${extras_to_remove% }"
	fi
}

# Contract: swap_prepare -- swap-key sub-step 1 (design 8.3): die unless
# ADMIN_MODE is plain-key, set KEYFILE through keypair_path, make the pair
# only when it is missing and NEW_KEY is set, then read OLD_BLOB from the
# plain key's pub blob, NEW_BLOB from the new key and NEW_LINE the restricted
# line for LABEL/change/NEW_BLOB; a die
# inside $(...) only ends the subshell, so after each assignment the
# variable is re-checked and an empty result dies; also die when
# OLD_BLOB equals NEW_BLOB (replacing the plain key with the same key
# would drop both, so the later key filter would remove everything).
swap_prepare() {
	[[ "$ADMIN_MODE" == "plain-key" ]] \
		|| die "swap-key needs the plain-key admin path"
	keypair_path "$LABEL"
	if [[ ! -f "$KEYFILE" ]]; then
		[[ $NEW_KEY -eq 1 ]] \
			|| die "no key for label $LABEL on this host ($KEYFILE is missing): the key lives on the Newton host that added it; run this there, or pass --new-key to make a new key on purpose"
		keypair_create "$LABEL"
	fi
	OLD_BLOB=$(pub_blob "$PLAIN_KEY")
	[[ -n "$OLD_BLOB" ]] || die "cannot read the public key: $PLAIN_KEY"
	NEW_BLOB=$(pub_blob "$KEYFILE")
	[[ -n "$NEW_BLOB" ]] || die "cannot read the public key: $KEYFILE"
	NEW_LINE=$(restricted_line "$LABEL" change "$NEW_BLOB")
	[[ -n "$NEW_LINE" ]] || die "cannot build the restricted line"
	if [[ "$OLD_BLOB" == "$NEW_BLOB" ]]; then
		die "the plain key and the new key are the same key"
	fi
}

# Contract: swap_router_done -- no arguments; exit 0 only when a fresh
# hello_key with KEYFILE has caller=$LABEL role=change door=ssh mode=prod,
# AND rsh_key with PLAIN_KEY running `true` </dev/null exits 255 (the plain
# key is refused); anything else exit 1. No password is involved.
swap_router_done() {
	local nonce reply rc
	nonce=$(new_nonce)
	reply=$(hello_key "$KEYFILE" "$nonce" </dev/null 2>/dev/null) || return 1
	if [[ "$(hello_field "$reply" caller 2>/dev/null)" != "$LABEL" \
		|| "$(hello_field "$reply" role 2>/dev/null)" != "change" \
		|| "$(hello_field "$reply" door 2>/dev/null)" != "ssh" \
		|| "$(hello_field "$reply" mode 2>/dev/null)" != "prod" ]]; then
		return 1
	fi
	rsh_key "$PLAIN_KEY" true </dev/null 2>/dev/null
	rc=$?
	[[ $rc -eq 255 ]] || return 1
	return 0
}

# Contract: swap_already_done -- no arguments; exit 0 only when the router
# is done according to swap_router_done AND the inventory already names
# KEYFILE; anything else exits 1.
swap_already_done() {
	[[ "$DEV_KEY_FILE" == "$KEYFILE" ]] && swap_router_done
}

# Contract: swap_stage_new_line -- swap-key sub-step 2 (design 8.3): set
# SWAP_APPENDED=0 first; ONE rsh_admin call (fixed text, ${RR} on the
# locations, </dev/null) always runs `cp -p` of the live file to
# .newton-prev and `chmod 600`, so even a retry refreshes the restore point;
# append NEW_LINE only when auth_has_blob NEW_BLOB exits 1, setting
# SWAP_APPENDED=1; when it exits 0 leave the live file unchanged;
# finally both auth_has_blob NEW_BLOB and OLD_BLOB must exit 0 (the plain
# line must still be there); returns 0 on success, 1 on any failure; an
# auth_has_blob status other than 0 or 1 is a failure.
swap_stage_new_line() {
	local prev="${RR}${R_AUTH_KEYS}.newton-prev"
	local live="${RR}${R_AUTH_KEYS}"
	local rc
	SWAP_APPENDED=0
	rsh_admin "cp -p \"$live\" \"$prev\" && chmod 600 \"$prev\"" </dev/null 2>/dev/null || return 1
	auth_has_blob "$NEW_BLOB" </dev/null 2>/dev/null
	rc=$?
	case "$rc" in
		0) ;;
		1)
			auth_append_line "$NEW_LINE" || return 1
			SWAP_APPENDED=1
			;;
		*)
			return 1
			;;
	esac
	auth_has_blob "$NEW_BLOB" </dev/null 2>/dev/null
	rc=$?
	[[ $rc -eq 0 ]] || return 1
	auth_has_blob "$OLD_BLOB" </dev/null 2>/dev/null
	rc=$?
	[[ $rc -eq 0 ]] || return 1
	return 0
}

# Contract: swap_prove_new_key -- swap-key sub-step 3 (design 8.3):
# prove_restricted_key with LABEL/change/KEYFILE; on failure, when
# SWAP_APPENDED=1 the new line is removed with auth_remove_blob (it must
# print 1, else STATE_NOTE='the new line could not be removed again')
# and STATE_NOTE='router unchanged (the new line was removed again)';
# when SWAP_APPENDED=0 STATE_NOTE='the new line was already there and
# was left in place'; then stopped "the new key failed its proofs".
swap_prove_new_key() {
	local removed
	if prove_restricted_key "$LABEL" change "$KEYFILE"; then
		return 0
	fi
	if [[ $SWAP_APPENDED -eq 1 ]]; then
		removed=$(auth_remove_blob "$NEW_BLOB" </dev/null 2>/dev/null) || {
			STATE_NOTE='the new line could not be removed again'
			stopped "the new key failed its proofs"
		}
		if [[ "$removed" != "1" ]]; then
			STATE_NOTE='the new line could not be removed again'
			stopped "the new key failed its proofs"
		fi
		STATE_NOTE='router unchanged (the new line was removed again)'
	else
		STATE_NOTE='the new line was already there and was left in place'
	fi
	stopped "the new key failed its proofs"
}

# Contract: deadman_text NONCE -- pure: validate NONCE with valid_hex
# (else die) and print the design's fixed text of sub-step 4 with NONCE
# in place of <nonce2> and ${RR} in front of the three file locations
# (the grep target /tmp/newton/hello, the cp source .newton-prev, the cp
# destination authorized_keys); with RR empty the output is byte for byte
# the design line plus a final newline.
deadman_text() {
	local nonce="$1"
	valid_hex "$nonce" || die "bad nonce"
	printf '%s\n' "setsid sh -c 'sleep 90; grep -q \"^${nonce} \" ${RR}/tmp/newton/hello 2>/dev/null || { cp -p ${RR}/etc/dropbear/authorized_keys.newton-prev ${RR}/etc/dropbear/authorized_keys; logger -t newton-setup \"key swap not proven in 90 s; authorized_keys restored\"; }' </dev/null >/dev/null 2>&1 &"
}

# Contract: swap_deadman_tools -- ONE rsh_admin call (fixed text, </dev/null)
# that runs, for each of setsid sleep grep cp logger ps, `command -v "$t"
# >/dev/null 2>&1 || echo "$t"` on the router; prints the missing names on
# one line separated by single spaces and returns 1 when any is missing;
# prints nothing and returns 0 when none is missing; returns 2 when the ssh
# call itself failed (a failed call is NEVER a pass).
swap_deadman_tools() {
	local out
	if ! out=$(rsh_admin 'for t in setsid sleep grep cp logger ps; do command -v "$t" >/dev/null 2>&1 || echo "$t"; done' </dev/null 2>/dev/null); then
		return 2
	fi
	if [[ -n "$out" ]]; then
		printf '%s\n' "$(printf '%s' "$out" | tr '\n' ' ' | sed 's/ $//')"
		return 1
	fi
	return 0
}

# Contract: swap_deadman_count -- with ONE fixed-text rsh_admin call and </dev/null, print the non-negative count of router `ps` lines containing `sleep 90`; print nothing and return 1 when the call fails or its output is invalid.
swap_deadman_count() {
	local out
	if ! out=$(rsh_admin "ps 2>/dev/null | grep -c '[s]leep 90'; exit 0" </dev/null 2>/dev/null); then
		return 1
	fi
	if [[ ! "$out" =~ ^[0-9]+$ ]]; then
		return 1
	fi
	printf '%s\n' "$out"
}

# Contract: swap_start_deadman NONCE -- runs deadman_text NONCE through
# rsh_admin with </dev/null; an empty text (a die of the $(deadman_text ...)
# subshell) returns 1 without a call; before starting, record the sleep-90
# count (failure returns 1 without starting); a non-zero start status is
# returned to the caller; then use up to five count checks, waiting one
# second after each failure except the last, and succeed only when the count
# rises above its before value, so a stale or unrelated `sleep 90` cannot
# stand in for this run's switch.
swap_start_deadman() {
	local text i rc before after
	text=$(deadman_text "$1")
	if [[ -z "$text" ]]; then
		return 1
	fi
	if ! before=$(swap_deadman_count); then
		return 1
	fi
	rsh_admin "$text" </dev/null 2>/dev/null
	rc=$?
	[[ $rc -eq 0 ]] || return "$rc"
	for i in 1 2 3 4; do
		if after=$(swap_deadman_count) && (( 10#$after > 10#$before )); then
			return 0
		fi
		wait_router 1
	done
	if after=$(swap_deadman_count) && (( 10#$after > 10#$before )); then
		return 0
	fi
	return 1
}

# -----------------------------------------------------------------------
# Helpers of the `lab-snapshot` action
# -----------------------------------------------------------------------

# Contract: lab_toml_get TABLE KEY -- prints the value of KEY in the table
# TABLE of NEWTON_LAB_TOML (default ${DEFAULT_SRC}/lab/lab.toml, as in
# lab_passphrase_path); the table name may include a single dot, the part
# after the dot is a sub-table name (the device name may hold dashes);
# strings get `~` expanded, integers print as decimal; prints nothing
# and returns 0 when the file, the table, the sub-table, the key or a
# value of an unexpected type (bool, list, dict, ...) is missing; pure,
# never calls the router or curl.
lab_toml_get() {
	local table="$1" key="$2" toml sub
	toml="${NEWTON_LAB_TOML:-${DEFAULT_SRC}/lab/lab.toml}"
	if [[ "$table" == *.* ]]; then
		sub="${table#*.}"
		table="${table%%.*}"
	else
		sub=''
	fi
	python3 - "$toml" "$table" "$sub" "$key" <<'PYEOF'
import os
import sys
import tomllib

toml, table, sub, key = sys.argv[1:5]

try:
    with open(toml, "rb") as fh:
        data = tomllib.load(fh)
except Exception:
    sys.exit(0)
t = data.get(table)
if not isinstance(t, dict):
    sys.exit(0)
if sub:
    t = t.get(sub)
    if not isinstance(t, dict):
        sys.exit(0)
value = t.get(key)
if isinstance(value, bool):
    sys.exit(0)
if isinstance(value, int):
    print(value)
    sys.exit(0)
if isinstance(value, str):
    print(os.path.expanduser(value))
    sys.exit(0)
sys.exit(0)
PYEOF
}

# Contract: lab_device_get KEY -- lab_toml_get "devices.${DEVICE}" KEY.
lab_device_get() {
	lab_toml_get "devices.${DEVICE}" "$1"
}

# Contract: pve_snapshot_name VERSION -- pure: prints `baseline-newton-`
# followed by VERSION with every character outside [A-Za-z0-9_-] turned
# into `-`; the result must match ^[A-Za-z][A-Za-z0-9_-]+$ else die
# (exit 2); an empty version dies too; never calls the router or curl.
pve_snapshot_name() {
	local version="$1" out
	[[ -n "$version" ]] || die "pve_snapshot_name: empty version"
	out=$(printf '%s' "$version" | tr -c 'A-Za-z0-9_-' '-')
	out="baseline-newton-${out}"
	[[ "$out" =~ ^[A-Za-z][A-Za-z0-9_-]+$ ]] \
		|| die "pve_snapshot_name: bad name: $out"
	printf '%s\n' "$out"
}

# Contract: pve_load -- fills PVE_HOST, PVE_NODE from [pve].host and
# [pve].node, PVE_TOKEN from the file named by [pve].token_file and
# PVE_PIN from the file named by [pve].pin_file (file contents with
# trailing whitespace and newlines removed), and PVE_VMID from
# `lab_device_get vmid`; dies "error: ..." (exit 2) naming what is
# missing or unreadable (host, node, token_file, pin_file, vmid).
# PVE_TOKEN is a secret: never export it, never print it, never put it
# in a file or in any command's argv.
pve_load() {
	local token_file pin_file
	PVE_HOST=$(lab_toml_get pve host)
	PVE_NODE=$(lab_toml_get pve node)
	token_file=$(lab_toml_get pve token_file)
	pin_file=$(lab_toml_get pve pin_file)
	[[ -n "$PVE_HOST" ]] || die "pve host is not set"
	[[ -n "$PVE_NODE" ]] || die "pve node is not set"
	[[ -n "$token_file" ]] || die "pve token_file is not set"
	[[ -n "$pin_file" ]] || die "pve pin_file is not set"
	if ! PVE_TOKEN=$(cat -- "$token_file" 2>/dev/null && printf x); then
		die "pve token_file is not readable: $token_file"
	fi
	PVE_TOKEN=${PVE_TOKEN%x}
	PVE_TOKEN=${PVE_TOKEN%"${PVE_TOKEN##*[![:space:]]}"}
	if ! PVE_PIN=$(cat -- "$pin_file" 2>/dev/null && printf x); then
		die "pve pin_file is not readable: $pin_file"
	fi
	PVE_PIN=${PVE_PIN%x}
	PVE_PIN=${PVE_PIN%"${PVE_PIN##*[![:space:]]}"}
	PVE_VMID=$(lab_device_get vmid)
	[[ -n "$PVE_VMID" ]] || die "vmid is not set"
}

# Contract: pve_request METHOD URL [FORMFIELD] -- runs
# `curl -sk --fail --max-time 30 --pinnedpubkey "$PVE_PIN" -K - -X
# METHOD [-d FORMFIELD] URL` with the `Authorization` header reaching
# curl ONLY through the config on stdin (a printf builtin piped into
# curl, the format `'header = "Authorization: %s"\n'`, the token via the
# positional argument so it never reaches any bash argv or env); a token
# holding a double quote, backslash, single quote or newline makes the
# function die before curl runs; prints the response body on stdout; the
# exit status is curl's; no bash-level timeout and no `-K` file other
# than stdin.
pve_request() {
	local method="$1" url="$2" form="${3:-}" token="$PVE_TOKEN"
	case "$token" in
		*\"*|*\\*|*\'*)
			die "pve_request: token contains a quote or backslash" ;;
	esac
	case "$token" in
		*$'\n'*)
			die "pve_request: token contains a newline" ;;
	esac
	if [[ -n "$form" ]]; then
		printf 'header = "Authorization: %s"\n' "$token" \
			| curl -sk --fail --max-time 30 \
				--pinnedpubkey "$PVE_PIN" \
				-K - -X "$method" -d "$form" "$url"
	else
		printf 'header = "Authorization: %s"\n' "$token" \
			| curl -sk --fail --max-time 30 \
				--pinnedpubkey "$PVE_PIN" \
				-K - -X "$method" "$url"
	fi
}

# Contract: pve_json_field PATH -- pure: reads a JSON document on stdin,
# prints the value at the dotted PATH such as `data` or `data.status`;
# empty (exit 0) when the path is missing or any step is not a dict
# mapping; PATH via argv, JSON via stdin (a pipe or redirect); never
# calls the router or curl.
pve_json_field() {
	local path="$1"
	python3 -c '
import json
import sys

path = sys.argv[1]
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for part in path.split("."):
    if isinstance(data, dict) and part in data:
        data = data[part]
    else:
        sys.exit(0)
if data is None or isinstance(data, (dict, list)):
    sys.exit(0)
print(data)
' "$path"
}

# Contract: pve_wait_task UPID -- polls GET
# `https://${PVE_HOST}:8006/api2/json/nodes/${PVE_NODE}/tasks/<UPID
# percent-encoded with nothing kept safe>/status` with `wait_local 2`
# between polls for at most 120 seconds (60 polls); returns 0 only when
# `data.status` is `stopped` and `data.exitstatus` is `OK`; prints
# `INFO pve task ...` lines only for the final state (the OK, the bad
# exit status and the timeout).
pve_wait_task() {
	local upid="$1" body status exit_status url upid_q i
	upid_q=$(python3 - "$upid" <<'PYEOF'
import sys
import urllib.parse
print(urllib.parse.quote(sys.argv[1], safe=""))
PYEOF
	)
	url="https://${PVE_HOST}:8006/api2/json/nodes/${PVE_NODE}/tasks/${upid_q}/status"
	for i in $(seq 1 60); do
		body=$(pve_request GET "$url") || return $?
		status=$(printf '%s' "$body" | pve_json_field data.status) || status=''
		if [[ "$status" == "stopped" ]]; then
			exit_status=$(printf '%s' "$body" | pve_json_field data.exitstatus) \
				|| exit_status=''
			if [[ "$exit_status" == "OK" ]]; then
				info "pve task ${upid}: stopped OK"
				return 0
			fi
			info "pve task ${upid}: stopped ${exit_status}"
			return 1
		fi
		wait_local 2
	done
	info "pve task ${upid}: timeout (60 polls, 120 s)"
	return 1
}

# ---------------------------------------------------------------------------
# the no-install mode (ADR-021 points 2, 3, 8 and 9)
# ---------------------------------------------------------------------------

# The rpcd user's UCI section, the user name and the owner tag.  The
# GROUP LISTS are not here: they come from the `newton-rpcd` CLI
# (rpcd_groups), so the router's login section and Newton's own
# expectations cannot drift apart.
RPCD_SECTION='newton'
RPCD_USER_NAME='newton'
RPCD_OWNER_TAG='newton-mcp'

# filled by rpcd_groups
RPCD_READ_GROUPS=()
RPCD_WRITE_GROUPS=()

# filled by rpcd_sections_scan
RPCD_PRESENT=0
RPCD_OURS=0
RPCD_FOREIGN=0

# Contract: valid_rpcd_group NAME -- exit 0 when NAME matches
# ^[A-Za-z0-9._-]{1,64}$, else exit 1.  A group name reaches the router's
# shell text (a grep pattern) and the login section, so it is checked
# before it is used.
valid_rpcd_group() {
	[[ "$1" =~ ^[A-Za-z0-9._-]{1,64}$ ]]
}

# Contract: valid_rpcd_tag NAME -- exit 0 when NAME matches
# ^[A-Za-z0-9._-]{1,64}$, else exit 1.  The section name, the user name and
# the owner tag are compared on the router (a case pattern), so a name with
# a glob character in it is refused before it is used.
valid_rpcd_tag() {
	[[ "$1" =~ ^[A-Za-z0-9._-]{1,64}$ ]]
}

# Contract: valid_pin VALUE -- exit 0 when VALUE is the base64 sha256 of a
# 32-byte digest (44 characters), else exit 1.
valid_pin() {
	[[ "$1" =~ ^[A-Za-z0-9+/]{43}=$ ]]
}

# Contract: valid_rpcd_hash VALUE -- exit 0 when VALUE is a sha512-crypt
# hash ($6$<salt>$<86 characters>), else exit 1.  The hash is the only
# thing that goes to the router, so a hash of another shape never gets
# there.
valid_rpcd_hash() {
	[[ "$1" =~ ^\$6\$[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}$ ]]
}

# Contract: rpcd_groups -- fills the arrays RPCD_READ_GROUPS and
# RPCD_WRITE_GROUPS from `newton-rpcd groups`; dies (exit 2, "error: ...")
# when the program is missing, fails, or prints a line the grammar does
# not allow.  The lists are never written in this script.
rpcd_groups() {
	local out line kind group
	RPCD_READ_GROUPS=()
	RPCD_WRITE_GROUPS=()
	[[ -x "$RPCD" ]] || die "newton-rpcd not found: $RPCD"
	out=$("$RPCD" groups 2>/dev/null) || die "newton-rpcd groups failed: $RPCD"
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		kind="${line%% *}"
		group="${line#* }"
		[[ "$group" != "$line" ]] || die "newton-rpcd groups printed a bad line"
		valid_rpcd_group "$group" \
			|| die "newton-rpcd groups printed a bad group name: $group"
		case "$kind" in
			read) RPCD_READ_GROUPS+=("$group") ;;
			write) RPCD_WRITE_GROUPS+=("$group") ;;
			never) ;;
			*) die "newton-rpcd groups printed a bad line: $line" ;;
		esac
	done <<<"$out"
	[[ ${#RPCD_READ_GROUPS[@]} -gt 0 ]] \
		|| die "newton-rpcd groups printed no read group"
	[[ ${#RPCD_WRITE_GROUPS[@]} -gt 0 ]] \
		|| die "newton-rpcd groups printed no write group"
}

# Contract: rpcd_apply_pending -- exit 0 when an apply is pending on the
# router (the OpenWrt undo window is open), exit 1 when none is, exit 2
# when the call itself failed.  The detector is the measured one: while a
# rollback window is open /var/run/rpcd/snapshot-files holds one file per
# changed config (LuCI's applies included).  An EMPTY directory is not a
# window: a refused apply leaves it behind, empty, and it stays that way
# (measured on lab-r1), so the directory alone must not stop the setup
# or the uninstall for good.
#
# When a window is open the mtime of the NEWEST undo file (epoch
# seconds) is printed on stdout.  It is 0 when the age cannot be read:
# an undo file of an unknown age is treated as a live window.
rpcd_apply_pending() {
	local rc=0 out=''
	out=$(rsh_admin "$(cat <<EOF
d='${RR}/var/run/rpcd/snapshot-files'
if [ -z "\$(ls -A "\$d" 2>/dev/null)" ]; then exit 1; fi
newest=0
for f in "\$d"/*; do
	[ -f "\$f" ] || continue
	m=\$(stat -c %Y "\$f" 2>/dev/null) || continue
	case "\$m" in '' | *[!0-9]*) continue ;; esac
	if [ "\$m" -gt "\$newest" ]; then newest="\$m"; fi
done
echo "pending=\$newest"
EOF
)" </dev/null 2>/dev/null)
	rc=$?
	case "$rc" in
		0)
			printf '%s\n' "${out#pending=}"
			return 0
			;;
		1) return 1 ;;
		*) return 2 ;;
	esac
}

# Contract: rpcd_age_text SECONDS -- the age in the words a person reads:
# "23 minutes", "2 hours", "1 day".
rpcd_age_text() {
	local secs="$1" mins=0 hours=0 days=0
	mins=$((secs / 60))
	if [[ "$mins" -ge 1440 ]]; then
		days=$((mins / 1440))
		if [[ "$days" -eq 1 ]]; then printf '1 day'; else printf '%s days' "$days"; fi
	elif [[ "$mins" -ge 60 ]]; then
		hours=$((mins / 60))
		if [[ "$hours" -eq 1 ]]; then printf '1 hour'; else printf '%s hours' "$hours"; fi
	else
		if [[ "$mins" -eq 1 ]]; then printf '1 minute'; else printf '%s minutes' "$mins"; fi
	fi
}

# Contract: rpcd_pending_window_message MTIME FRESH -- the message for a
# window that is open on the router.  A restart of the router's web
# service forgets the window but leaves the undo file behind for good
# (measured, a4m-02): an undo file older than 15 minutes is a leftover
# and not a live window.  The run is still refused (the change may be
# live and Newton cannot prove it is not), and the message says how the
# owner gets the router back into a state Newton can work with.  FRESH
# is the message of a window that is still young.
rpcd_pending_window_message() {
	local mtime="$1" fresh="$2" now='' age=0 text=''
	case "$mtime" in
		'' | *[!0-9]*) printf '%s\n' "$fresh"; return 0 ;;
	esac
	[[ "$mtime" -gt 0 ]] || { printf '%s\n' "$fresh"; return 0; }
	now=$(date +%s 2>/dev/null) || now=''
	[[ -n "$now" ]] || { printf '%s\n' "$fresh"; return 0; }
	age=$((now - mtime))
	[[ "$age" -ge 900 ]] || { printf '%s\n' "$fresh"; return 0; }
	text=$(rpcd_age_text "$age")
	printf 'the router has a leftover undo file from %s ago (its web service restarted during a change). If nobody is changing the router right now, reboot it, or as root run: rm -rf /var/run/rpcd/snapshot-files\n' "$text"
}

# Contract: rpcd_https_probe -- ONE rsh_admin call that prints the two
# facts of the HTTPS check: https=<listen_https> and cert=<the path of
# the certificate file>; the exit status is the call's.
rpcd_https_probe() {
	local script
	script=$(cat <<EOF
v=\$(uci -q get uhttpd.main.listen_https 2>/dev/null)
c=\$(uci -q get uhttpd.main.cert 2>/dev/null)
echo "https=\$v"
echo "cert=\$c"
EOF
	)
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: rpcd_groups_check -- ONE rsh_admin call that prints
# "group=<name> ok" or "group=<name> missing" for every group Newton asks
# for; the exit status is the call's.
rpcd_groups_check() {
	local script='' g
	for g in "${RPCD_READ_GROUPS[@]}" "${RPCD_WRITE_GROUPS[@]}"; do
		script+=" '$g'"
	done
	script=$(cat <<EOF
for g in${script}; do
	if grep -q "\"\$g\"" "${RR}/usr/share/rpcd/acl.d/"*.json 2>/dev/null; then
		echo "group=\$g ok"
	else
		echo "group=\$g missing"
	fi
done
EOF
	)
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: rpcd_sections_probe -- ONE rsh_admin call that prints the
# facts of the router's rpcd config, one record per section: the line
# "section" starts a record, then type=login|other, user=ours|other|none,
# owner=ours|other|none and newton=yes|no, and the stream ends with the
# fixed line "end".  The values of the router are NEVER printed: the
# router compares them and prints one of three fixed words, so a value
# with a newline in it cannot become a second field of the protocol (the
# host scanner would read it as one).  The section NAMES never leave the
# router (only the flag does), so a name can never reach a command.  The
# exit status is the call's.
#
# Two rules make the records true:
#   * the listing runs into a variable and its own status is checked:
#     busybox ash has no `set -o pipefail`, so a pipeline would report
#     the status of the last command and hide a failed `uci show rpcd`
#     (an empty listing then looks like "no sections at all");
#   * every value is read with a sentinel, so the trailing newline of
#     the router's own value is part of the comparison: a command
#     substitution drops trailing newlines, and an owner of
#     "newton-mcp\n" would look like Newton's own; an option that is
#     not set prints nothing, so "x" alone is "none".
rpcd_sections_probe() {
	local script
	valid_rpcd_tag "$RPCD_SECTION" || return 1
	valid_rpcd_tag "$RPCD_USER_NAME" || return 1
	valid_rpcd_tag "$RPCD_OWNER_TAG" || return 1
	script=$(cat <<EOF
S='${RPCD_SECTION}'
U='${RPCD_USER_NAME}'
O='${RPCD_OWNER_TAG}'
NL='
'
out=\$(uci -q show rpcd 2>/dev/null)
st=\$?
if [ "\$st" -ne 0 ]; then
	exit "\$st"
fi
printf '%s\n' "\$out" | sed -n 's/^rpcd\.\([^.=]*\)=.*/\1/p' | while read -r s; do
	echo "section"
	t=\$(uci -q get "rpcd.\$s" 2>/dev/null; echo x)
	case "\$t" in
		"login\$NL"x) echo "type=login" ;;
		*) echo "type=other" ;;
	esac
	u=\$(uci -q get "rpcd.\$s.username" 2>/dev/null; echo x)
	case "\$u" in
		"\$U\$NL"x) echo "user=ours" ;;
		x|"\$NL"x) echo "user=none" ;;
		*) echo "user=other" ;;
	esac
	o=\$(uci -q get "rpcd.\$s.newton_owner" 2>/dev/null; echo x)
	case "\$o" in
		"\$O\$NL"x) echo "owner=ours" ;;
		x|"\$NL"x) echo "owner=none" ;;
		*) echo "owner=other" ;;
	esac
	if [ "\$s" = "\$S" ]; then echo "newton=yes"; else echo "newton=no"; fi
done
echo "end"
EOF
	)
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: rpcd_sections_scan -- reads the output of rpcd_sections_probe
# on stdin and fills RPCD_PRESENT (1 when the router has a section named
# newton), RPCD_OURS (1 when that section carries Newton's owner tag) and
# RPCD_FOREIGN (1 when another login section uses the username newton);
# every value is shape-checked first; exit 2 when the stream does not fit
# the grammar (a field that is not one of the four, a field that appears
# twice, a record that misses one, a line that is not known, a stream that
# does not end with the fixed line "end"), so a forged or unreadable
# router stops the run instead of being read as "nothing there" or as the
# last value of a field.
#
# The "end" line is what makes a stream complete: the probe prints it
# after the last record, so a stream that was cut short (a dropped
# connection, a router that stopped halfway) is refused instead of being
# read as a complete listing.
rpcd_sections_scan() {
	local -a lines=()
	local line key val index=0 count=0
	local type='' user='' owner='' isnewton=''
	local n_type=0 n_user=0 n_owner=0 n_newton=0
	RPCD_PRESENT=0
	RPCD_OURS=0
	RPCD_FOREIGN=0
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		lines+=("$line")
	done
	count=${#lines[@]}
	# the stream must end with the fixed line "end"
	(( count > 0 )) || return 2
	[[ "${lines[$((count - 1))]}" == "end" ]] || return 2
	for (( index = 0; index < count; index++ )); do
		line="${lines[$index]}"
		if [[ "$line" == "end" ]]; then
			# the "end" line is the last line: nothing may follow it
			(( index == count - 1 )) || return 2
			# the closing "end" flushes the last record
			if (( n_type + n_user + n_owner + n_newton > 0 )); then
				(( n_type == 1 && n_user == 1 && n_owner == 1 \
					&& n_newton == 1 )) || return 2
				rpcd_record "$type" "$user" "$owner" "$isnewton" \
					|| return 2
			fi
			return 0
		fi
		if [[ "$line" == "section" ]]; then
			if (( n_type + n_user + n_owner + n_newton > 0 )); then
				(( n_type == 1 && n_user == 1 && n_owner == 1 \
					&& n_newton == 1 )) || return 2
				rpcd_record "$type" "$user" "$owner" "$isnewton" \
					|| return 2
			fi
			type=''; user=''; owner=''; isnewton=''
			n_type=0; n_user=0; n_owner=0; n_newton=0
			continue
		fi
		key="${line%%=*}"
		val="${line#*=}"
		case "$key" in
			type)
				(( n_type == 0 )) || return 2
				n_type=1
				type="$val"
				;;
			user)
				(( n_user == 0 )) || return 2
				n_user=1
				user="$val"
				;;
			owner)
				(( n_owner == 0 )) || return 2
				n_owner=1
				owner="$val"
				;;
			newton)
				(( n_newton == 0 )) || return 2
				n_newton=1
				isnewton="$val"
				;;
			*) return 2 ;;
		esac
	done
	# no "end" line: the stream was cut short
	return 2
}

# Contract: rpcd_record TYPE USER OWNER ISNEWTON -- one section of the
# router's rpcd config: the shape of every value is checked (a value that
# does not fit refuses the run), and the two facts the no-install mode
# needs are remembered (RPCD_PRESENT, RPCD_OURS, RPCD_FOREIGN); exit 2
# when a value does not fit its grammar.
rpcd_record() {
	local type="$1" user="$2" owner="$3" isnewton="$4"
	case "$type" in
		login|other) ;;
		*) return 2 ;;
	esac
	case "$user" in
		ours|other|none) ;;
		*) return 2 ;;
	esac
	case "$owner" in
		ours|other|none) ;;
		*) return 2 ;;
	esac
	case "$isnewton" in
		yes|no) ;;
		*) return 2 ;;
	esac
	if [[ "$isnewton" == "yes" ]]; then
		RPCD_PRESENT=1
		if [[ "$owner" == "ours" ]]; then
			RPCD_OURS=1
		fi
		return 0
	fi
	if [[ "$type" == "login" && "$user" == "ours" ]]; then
		RPCD_FOREIGN=1
	fi
	return 0
}

# Contract: rpcd_write_section HASH DELETE -- ONE rsh_admin call that
# writes the login section: the section is deleted first when DELETE is
# `delete` (only then was it proved to be Newton's own), then it is
# created with Newton's owner tag, the username, the password hash and
# the read and write lists, and the config is committed; the exit status
# is the call's.  The hash and the group names are checked before they
# are embedded.
#
# EVERY command of the script is checked, not just the last one: a
# command substitution (or a `;` between two commands) reports only the
# status of the last one, so a failed `uci set` would look like a
# written section.  The owner tag is written before the password, so a
# section that is only half written is still Newton's own and the
# uninstall can remove it.
rpcd_write_section() {
	local hash="$1" delete="$2" script='' g
	valid_rpcd_hash "$hash" || return 1
	script=''
	if [[ "$delete" == "delete" ]]; then
		script+="uci -q delete rpcd.${RPCD_SECTION} || exit 3; "
	fi
	script+="uci set rpcd.${RPCD_SECTION}=login || exit 4; "
	script+="uci set rpcd.${RPCD_SECTION}.newton_owner='${RPCD_OWNER_TAG}' || exit 4; "
	script+="uci set rpcd.${RPCD_SECTION}.username='${RPCD_USER_NAME}' || exit 4; "
	script+="uci set rpcd.${RPCD_SECTION}.password='${hash}' || exit 4; "
	for g in "${RPCD_READ_GROUPS[@]}"; do
		valid_rpcd_group "$g" || return 1
		script+="uci add_list rpcd.${RPCD_SECTION}.read='${g}' || exit 5; "
	done
	for g in "${RPCD_WRITE_GROUPS[@]}"; do
		valid_rpcd_group "$g" || return 1
		script+="uci add_list rpcd.${RPCD_SECTION}.write='${g}' || exit 5; "
	done
	script+="uci commit rpcd || exit 6"
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: rpcd_remove_section -- ONE rsh_admin call that deletes the
# login section and commits the config; the exit status is the call's.
# Both commands are checked: the status of the commit alone says
# nothing about the delete, so a delete that failed and a commit that
# worked would look like a removal.
rpcd_remove_section() {
	rsh_admin "uci -q delete rpcd.${RPCD_SECTION} || exit 3; uci commit rpcd || exit 4" </dev/null 2>/dev/null
}

# Contract: rpcd_section_absent -- exit 0 when the router's rpcd config
# has no section named newton, exit 1 when it has one, exit 2 when the
# rpcd config could not be read.  A removal is only reported when the
# probe proves it: the commands that removed it are not a proof.
rpcd_section_absent() {
	local out=''
	out=$(rpcd_sections_probe) || return 2
	rpcd_sections_scan <<<"$out" || return 2
	[[ "$RPCD_PRESENT" -eq 0 ]]
}

# Contract: rpcd_sessions -- ONE rsh_admin call that prints the ids of
# the rpcd sessions whose username is newton, one per line; the exit
# status is the call's.  The listing runs into a variable first and its
# own status is checked: busybox ash has no `set -o pipefail`, so a
# pipeline would report the status of awk and hide a failed `ubus call
# session list` (an empty list then looks like "no session").
#
# The shape is the one measured on Pulsar (OpenWrt 25.12, 2026-11-02):
# one top-level JSON object per session, its id in "ubus_rpc_session"
# and the login name in "data" -> "username"; rpcd always lists its own
# unauthenticated session, so a listing holds at least one object.  The
# awk reads each object whole and prints at its closing brace, so the
# order of the fields does not matter.  It fails on anything else (a
# line outside an object, an object without a 32-hex id, unbalanced
# braces, a backslash, an object without the members rpcd prints for a
# session, no unauthenticated session): a status-0 answer that is not
# a session list is never read as "there is no session".
rpcd_sessions() {
	local script
	script=$(cat <<'EOF'
out=$(ubus call session list 2>/dev/null)
st=$?
if [ "$st" -ne 0 ]; then
	exit "$st"
fi
printf '%s\n' "$out" | awk '
BEGIN { depth = 0; n = 0; bad = 0 }
/\\/ { bad = 1; exit 1 }
{
	t = $0
	sub(/^[ \t]+/, "", t)
	sub(/[ \t]+$/, "", t)
	if (depth == 0) {
		if (t == "") { next }
		if (t != "{") { bad = 1; exit 1 }
		depth = 1; sid = ""; user = ""; indata = 0; members = ""
		next
	}
	if (depth == 1 && t ~ /^"ubus_rpc_session": "[^"]*",?$/) {
		split(t, f, "\""); sid = f[4]
	}
	if (depth == 1 && t ~ /^"(timeout|expires)": [0-9]+,?$/) {
		split(t, f, "\""); members = members f[2] " "
	}
	if (depth == 1 && t ~ /^"(acls|data)": \{/) {
		split(t, f, "\""); members = members f[2] " "
	}
	if (depth == 1 && t ~ /^"data": \{/) { indata = 1 }
	if (depth == 2 && indata && t ~ /^"username": "[^"]*",?$/) {
		split(t, f, "\""); user = f[4]
	}
	# count the braces outside strings (no backslash, so no escaped quote)
	s = t
	gsub(/"[^"]*"/, "", s)
	if (s ~ /"/) { bad = 1; exit 1 }
	depth += gsub(/[{[]/, "", s) - gsub(/[]}]/, "", s)
	if (depth < 0) { bad = 1; exit 1 }
	if (depth == 1) { indata = 0 }
	if (depth == 0) {
		if (sid !~ /^[0-9a-f]+$/ || length(sid) != 32) { bad = 1; exit 1 }
		# every member rpcd prints for a session, and rpcd own
		# unauthenticated session among them
		if (members !~ /timeout / || members !~ /expires / || members !~ /acls / || members !~ /data /) { bad = 1; exit 1 }
		if (sid == "00000000000000000000000000000000") { anon = 1 }
		n++
		if (user == "newton") { print sid }
	}
}
END {
	if (bad || depth != 0 || n == 0 || !anon) { exit 1 }
}'
EOF
	)
	rsh_admin "$script" </dev/null 2>/dev/null
}

# Contract: rpcd_destroy_session SID -- destroys one rpcd session over
# the admin lane; the id must be 32 hex characters before it is embedded
# in the command; the exit status is the call's.
rpcd_destroy_session() {
	local sid="$1"
	[[ "$sid" =~ ^[0-9a-f]{32}$ ]] || return 1
	rsh_admin "ubus call session destroy '{\"ubus_rpc_session\":\"${sid}\"}'" </dev/null 2>/dev/null
}

# Contract: rpcd_password_new -- prints a fresh rpcd password: 32 random
# bytes as hex (64 characters); exit 1 when openssl is missing or fails.
rpcd_password_new() {
	local out
	command -v openssl >/dev/null 2>&1 || return 1
	out=$(openssl rand -hex 32 2>/dev/null) || return 1
	[[ "$out" =~ ^[0-9a-f]{64}$ ]] || return 1
	printf '%s\n' "$out"
}

# Contract: rpcd_hash -- prints the sha512-crypt hash of the password on
# stdin; the password never appears in an argv; exit 1 when openssl is
# missing, fails, or prints a hash of another shape.
rpcd_hash() {
	local out
	command -v openssl >/dev/null 2>&1 || return 1
	out=$(openssl passwd -6 -stdin 2>/dev/null) || return 1
	valid_rpcd_hash "$out" || return 1
	printf '%s\n' "$out"
}

# Contract: rpcd_password_file_write PASSWORD -- writes the password into
# ${KEYS_DIR}/${DEVICE}.rpcd with mode 0600: a temporary file in KEYS_DIR
# (umask 077) is renamed over it, so the file is never half written;
# prints nothing; exit 1 on any failure.
rpcd_password_file_write() {
	local pw="$1" dir="$KEYS_DIR" file tmp
	file="${dir}/${DEVICE}.rpcd"
	# refuse before the mkdir below: KEYS_DIR is operator-settable
	# (NEWTON_KEYS_DIR) and holds the device credentials, so a parent any
	# local user can write to is a symlink-planting hole for them
	check_state_dir_parent_sticky "$dir" NEWTON_KEYS_DIR || return 1
	mkdir -p -- "$dir" || return 1
	chmod 700 -- "$dir" || return 1
	tmp=$(mktemp "${dir}/.${DEVICE}.rpcd.XXXXXX") || return 1
	if ! printf '%s\n' "$pw" >"$tmp" || ! chmod 600 -- "$tmp" \
		|| ! mv -f -- "$tmp" "$file"; then
		rm -f -- "$tmp"
		return 1
	fi
	return 0
}

# Contract: rpcd_password_file -- prints the path of the device's rpcd
# password file (${KEYS_DIR}/${DEVICE}.rpcd); nothing else.
rpcd_password_file() {
	printf '%s\n' "${KEYS_DIR}/${DEVICE}.rpcd"
}

# Contract: rpcd_https_host -- prints the host of the router's web API:
# the owner's https_host when the inventory has one, else the device
# host; nothing else.
rpcd_https_host() {
	if [[ -n "$DEV_HTTPS_HOST" ]]; then
		printf '%s\n' "$DEV_HTTPS_HOST"
	else
		printf '%s\n' "$DEV_HOST"
	fi
}

# Contract: rpcd_https_port -- prints the port of the router's web API:
# the owner's https_port when the inventory has one, else 443; nothing
# else.
rpcd_https_port() {
	if [[ -n "$DEV_HTTPS_PORT" ]]; then
		printf '%s\n' "$DEV_HTTPS_PORT"
	else
		printf '%s\n' '443'
	fi
}

# Contract: inventory_fields_text DEVICE [OP KEY VALUE]... -- reads the
# inventory on stdin and prints the new text: every "set KEY VALUE" sets
# the field KEY of the device's table, every "remove KEY" removes it;
# every other line stays byte for byte; exit 2 with "error: ..." on
# stderr when the device is not in the inventory or a field name or a
# value is not acceptable.
inventory_fields_text() {
	local code
	code=$(cat <<'PYEOF'
import re
import sys

DEVICE = sys.argv[1]
ARGS = sys.argv[2:]


def err(msg):
    print("error: " + msg, file=sys.stderr)
    sys.exit(2)


ops = []
index = 0
while index < len(ARGS):
    op = ARGS[index]
    key = ARGS[index + 1]
    if op == "set":
        value = ARGS[index + 2]
        index += 3
    elif op == "remove":
        value = None
        index += 2
    else:
        err("bad operation: " + op)
        break
    if not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", key):
        err("bad field name: " + repr(key))
    if value is not None:
        bad = ("\n" in value or "\r" in value or '"' in value
               or "\\" in value or len(value) > 512)
        if bad:
            err("bad value for " + key)
    ops.append((op, key, value))

text = sys.stdin.read()
lines = text.splitlines(keepends=True)

table_re = re.compile(r"^(\[\[?)([A-Za-z_][A-Za-z0-9_.\-]*)(\]\]?)\s*(#.*)?$")
target = "[devices." + DEVICE + "]"


def table_range(lines):
    """The (first, last) line numbers of the device's table.  The range is
    computed again for every operation: a removal shortens the list, so a
    range that was kept would point past its end."""
    start = None
    end = len(lines)
    for number, line in enumerate(lines):
        stripped = line.rstrip("\n").rstrip()
        if not table_re.match(stripped):
            continue
        if start is None:
            if stripped == target:
                start = number
        else:
            end = number
            break
    return start, end


start, end = table_range(lines)
if start is None:
    err("device not in inventory: " + DEVICE)

for op, key, value in ops:
    start, end = table_range(lines)
    if start is None:
        err("device not in inventory: " + DEVICE)
    field_re = re.compile(r"^\s*" + re.escape(key) + r"\s*=")
    where = -1
    for number in range(start + 1, end):
        if field_re.match(lines[number]):
            where = number
            break
    if op == "remove":
        if where >= 0:
            del lines[where]
        continue
    new_line = '%s = "%s"\n' % (key, value)
    if where >= 0:
        lines[where] = new_line
        continue
    last = start
    for number in range(start + 1, end):
        if lines[number].strip():
            last = number
    if last < len(lines) and not lines[last].endswith("\n"):
        lines[last] = lines[last] + "\n"
    lines.insert(last + 1, new_line)

sys.stdout.write("".join(lines))
PYEOF
	)
	python3 -c "$code" "$@"
}

# Contract: inventory_write DEVICE OP KEY VALUE... -- reads the new
# inventory text on stdin, writes it to $INVENTORY.new (with the mode of
# the old file), checks with tomllib that the device is still there, that
# every OTHER device parses to the same values, that the device parses to
# the same values except for the edited keys, and that the edited keys
# hold exactly the intended values (absent when they were removed); and
# renames the .new over the inventory; on any failure the .new is removed,
# an error is printed on stderr and the function returns 1.
#
# The comparison is the safety net of the editor: the editor works on
# lines, so a line inside a multiline string can look like a field (a
# description that holds `https_spki = "example"`).  Such an edit changes
# another field of the device, and the check refuses it: the inventory is
# never written with a field nobody asked to change.
inventory_write() {
	local device="$1" new_text inv_new mode
	shift
	if ! new_text=$(cat && printf x); then
		printf 'error: cannot read the new inventory text\n' >&2
		return 1
	fi
	new_text=${new_text%x}
	if [[ -z "$new_text" ]]; then
		printf 'error: the new inventory text is empty\n' >&2
		return 1
	fi
	inv_new="${INVENTORY}.new"
	mode=''
	if [[ -e "$INVENTORY" ]]; then
		mode=$(stat -c '%a' -- "$INVENTORY" 2>/dev/null) || mode=''
	fi
	if ! printf '%s' "$new_text" >"$inv_new"; then
		rm -f "$inv_new"
		printf 'error: cannot write %s\n' "$inv_new" >&2
		return 1
	fi
	if [[ -n "$mode" ]]; then
		if ! chmod "$mode" -- "$inv_new"; then
			rm -f "$inv_new"
			printf 'error: cannot chmod %s\n' "$inv_new" >&2
			return 1
		fi
	fi
	if ! python3 - "$inv_new" "$INVENTORY" "$device" "$@" <<'PYEOF'
import sys
import tomllib

inv_new = sys.argv[1]
inv_old = sys.argv[2]
device = sys.argv[3]
ARGS = sys.argv[4:]


def err(msg):
    print("error: " + msg, file=sys.stderr)
    sys.exit(2)


# the edits the caller asked for: key -> the value it must have (None
# when the key must be gone)
edited = {}
index = 0
while index < len(ARGS):
    op = ARGS[index]
    key = ARGS[index + 1]
    if op == "set":
        edited[key] = ARGS[index + 2]
        index += 3
    elif op == "remove":
        edited[key] = None
        index += 2
    else:
        err("bad operation: " + op)

with open(inv_new, "rb") as fh:
    new_data = tomllib.load(fh)
devs = new_data.get("devices", {})
if not isinstance(devs, dict) or device not in devs:
    err("device missing after write: " + device)
entry = devs[device]
if not isinstance(entry, dict):
    err("device is not a table after write: " + device)

with open(inv_old, "rb") as fh:
    old_data = tomllib.load(fh)
old_devs = old_data.get("devices", {}) or {}
for name, old_entry in old_devs.items():
    if name == device:
        continue
    if devs.get(name) != old_entry:
        err("device " + name + " values changed")

# everything outside the devices table is untouched
old_rest = {k: v for k, v in old_data.items() if k != "devices"}
new_rest = {k: v for k, v in new_data.items() if k != "devices"}
if old_rest != new_rest:
    err("the inventory outside the devices table changed")

# the device itself: every field that was not edited is identical
old_entry = old_devs.get(device)
if not isinstance(old_entry, dict):
    err("device " + device + " is not a table before the write")
for key, value in old_entry.items():
    if key in edited:
        continue
    if key not in entry:
        err("field " + key + " of device " + device + " was removed")
    elif entry[key] != value:
        err("field " + key + " of device " + device + " changed")
for key in entry:
    if key in edited:
        continue
    if key not in old_entry:
        err("field " + key + " was added to device " + device)

# the edited fields hold exactly what the caller asked for
for key, value in edited.items():
    if value is None:
        if key in entry:
            err("field " + key + " of device " + device + " was not removed")
        continue
    if key not in entry:
        err("field " + key + " of device " + device + " is missing")
    elif entry[key] != value:
        err("field " + key + " of device " + device + " has another value")
PYEOF
	then
		rm -f "$inv_new"
		printf 'error: the inventory does not hold what the edit asked for\n' >&2
		return 1
	fi
	if ! mv -- "$inv_new" "$INVENTORY"; then
		rm -f "$inv_new"
		printf 'error: cannot rename over inventory\n' >&2
		return 1
	fi
	return 0
}

# Contract: inventory_edit DEVICE OP KEY VALUE... -- reads the inventory,
# computes the new text with the editor (inventory_fields_text), checks it
# (inventory_write) and writes it; exit 1 when the inventory cannot be
# read, cannot be edited safely or cannot be written.
inventory_edit() {
	local device="$1" new_text
	shift
	if ! new_text=$(inventory_fields_text "$device" "$@" <"$INVENTORY" \
		&& printf x); then
		return 1
	fi
	new_text=${new_text%x}
	printf '%s' "$new_text" | inventory_write "$device" "$@"
}

# Contract: inventory_set_noinstall DEVICE PWFILE PIN -- sets the three
# no-install fields of the device (access, rpcd_password_file and
# https_spki) in the inventory, keeping every other field; exit 1 when
# the inventory cannot be read, edited safely or written.
inventory_set_noinstall() {
	local device="$1" pwfile="$2" pin="$3"
	inventory_edit "$device" set access no-install \
		set rpcd_password_file "$pwfile" set https_spki "$pin"
}

# Contract: inventory_remove_noinstall DEVICE -- removes every no-install
# field of the device from the inventory: access, rpcd_password_file,
# https_spki and installed_offer.  The uninstall ends the no-install mode:
# the entry is then a plain device in the default (installed) mode, which
# both loaders read, and it is not installed yet (the install comes
# next).  The fields go only after the router-side steps proved that the
# login is gone; exit 1 when the inventory cannot be edited safely or
# written.
inventory_remove_noinstall() {
	local device="$1"
	inventory_edit "$device" remove access remove rpcd_password_file \
		remove https_spki remove installed_offer
}

# Contract: access_modes_notes -- no arguments; prints the two access
# modes side by side (ADR-021 point 9): what each mode puts on the
# router, what protects the owner in it and what it cannot do, in plain
# words.  Ten NOTE lines, one per sentence: the first five about the
# no-install mode, the last five about the installed mode.
#
# The text is the shared one.  The same ten sentences stand in the
# installer's closing text (scripts/newton-install), in README.md, in
# SETUP.md and in SKILL.md, and the test
# tests/protocol/test_router_setup_modes.py keeps the copies equal, so
# no place promises more than another.  The numbers (the file count and
# the size of the installed program) are the ones the disclosure block
# measures from the sources the install uploads; the test measures them
# again and fails when they drift.
access_modes_notes() {
	note "no-install: Newton puts nothing on the router except one web-interface user."
	note "no-install: Every change uses OpenWrt's own undo timer."
	note "no-install: Limit: if the router reboots or its web service restarts while a change waits for confirmation, the change stays."
	note "no-install: Limit: whoever steals Newton's router password could take an interface down, restart Wi-Fi, kick a device off, or store files in /etc/luci-uploads, without your approval."
	note "no-install: Newton applies only DHCP static leases and DNS entries itself; every other change is a script you approve and run."
	note "installed: Newton puts a program on the router: a small set of shell scripts (6 files, about 216 KB), no packages and no compiled code."
	note "installed: Newton's key can run that program and nothing else, so the agent never gets a root shell."
	note "installed: If a Newton change is still waiting for confirmation at boot, the guard puts the last good settings back, so a reboot cannot leave that change stuck."
	note "installed: More checks can run, and fewer changes need a script."
	note "installed: uninstall removes Newton's program and key; it keeps the guard's saved settings and the rest of /etc/newton (its lock and log), the program directory, the WAN-health settings in /etc/config/newton_wanhealth, the keys from before swap-key and the sysupgrade file: the saved settings and the copy of your keys are what you restore by hand."
}

# Contract: owner_command -- no arguments; prints the command the owner
# runs, in the installed layout: the launcher refuses to run as anyone
# but the `newton` user (scripts/newton-install writes that launcher),
# so a command the owner copies has to carry the prefix.  One helper, so
# every place that prints a command for the owner prints the same one.
owner_command() {
	printf 'sudo -u newton /usr/local/bin/newton-router-setup'
}

# Contract: installed_offer_no -- no arguments; records the owner's "no"
# in the inventory (installed_offer = "declined") through the safe
# inventory editor and prints the one line that says how to ask again.
# The editor is the same one the no-install setup writes the login with,
# so a hand-edited inventory is never the result.
installed_offer_no() {
	if ! inventory_edit "$DEVICE" set installed_offer declined; then
		STATE_NOTE="the answer was not recorded; the inventory was NOT updated"
		stopped "cannot edit the inventory safely; edit it by hand: ${INVENTORY}"
	fi
	note "the installed mode was declined for ${DEVICE}; to ask again run: $(owner_command) ${DEVICE} offer-installed"
}

# Contract: installed_offer_yes -- no arguments; a "yes" stores nothing:
# the declined field (if there is one) goes away, so the owner can be
# asked again later.  The two steps that switch the mode are printed and
# are NOT run: switching the mode is an explicit setup action the owner
# runs (ADR-021 point 1).
installed_offer_yes() {
	if ! inventory_edit "$DEVICE" remove installed_offer; then
		STATE_NOTE="the answer was not recorded; the inventory was NOT updated"
		stopped "cannot edit the inventory safely; remove the 'installed_offer' line of ${DEVICE} by hand: ${INVENTORY}"
	fi
	note "to switch ${DEVICE} to the installed mode, run these two commands yourself, in this order:"
	note "  $(owner_command) ${DEVICE} uninstall   (removes the no-install login and ends the no-install mode)"
	note "  $(owner_command) ${DEVICE} install"
	note "the installed mode's key swap (swap-key) logs in with a plain key, which a no-install setup does not make: make that key and add it to the router first (INSTALL.md, step 7c)"
}

# Contract: installed_offer_question -- no arguments; asks the owner ONCE
# whether the installed mode should also be used on this router (ADR-021
# point 1), with the trade-off in plain words.  The question is asked
# only when there is a terminal to read it; a "no" is remembered
# (installed_offer = "declined"), a "yes" stores nothing and prints the
# two steps that switch the mode.  Any other answer stores nothing: the
# owner did not answer, and the question comes again next time.
installed_offer_question() {
	local answer=''
	if ! has_terminal; then
		note "no terminal to ask the installed-mode offer; nothing was recorded"
		return 0
	fi
	printf '%s' "Also use installed mode on this router? It puts Newton's program and guard on the router (y/N) " >&2
	read_answer answer
	case "$answer" in
	[yY]|[yY][eE][sS])
		installed_offer_yes
		return 0
		;;
	[nN]|[nN][oO])
		installed_offer_no
		return 0
		;;
	esac
	note "the answer to the installed-mode offer was not recorded; to ask again run: $(owner_command) ${DEVICE} offer-installed"
	return 0
}

# Contract: installed_offer_step -- no arguments; the offer at the end of
# the no-install setup (ADR-021 point 1).  A device whose inventory says
# the owner declined the offer is not asked again; every other device is
# asked once.
installed_offer_step() {
	if [[ "$DEV_INSTALLED_OFFER" == "declined" ]]; then
		note "the installed mode was already declined for ${DEVICE}; to ask again run: $(owner_command) ${DEVICE} offer-installed"
		return 0
	fi
	installed_offer_question
}

# Contract: noinstall_old_plain_key_notice -- no arguments; when the admin
# login of this run is the password and the default plain key's public file
# (<home>/.ssh/id_ed25519.pub; the private key is never read) names a key
# that the router's authorized keys still hold, prints one INFO line: an
# older setup left it there, Newton never removes a key, and the owner
# removes the line by hand.  Any failure to find out prints nothing; the
# router is only read.
noinstall_old_plain_key_notice() {
	local home pub blob=''
	[[ "$ADMIN_MODE" == "password" ]] || return 0
	home=$(home_dir) || return 0
	pub="${home}/.ssh/id_ed25519.pub"
	[[ -f "$pub" ]] || return 0
	blob=$(awk 'NR==1 {print $2}' "$pub" 2>/dev/null) || return 0
	[[ "$blob" =~ ^[A-Za-z0-9+/=]+$ ]] || return 0
	if auth_has_blob "$blob" >/dev/null 2>&1; then
		info "a plain admin key from an older setup is still in ${R_AUTH_KEYS} on the router; Newton never removes a key: to remove it, delete its line from that file on the router, or keep it for your own use"
	fi
	return 0
}

# Contract: action_no_install -- the no-install setup of ADR-021 point 8:
# ten numbered steps, each one a PASS line, each stopping at the first
# failure with the state of the router named; the four closing NOTE lines
# of ADR-021 point 9 and the DONE line.  The router keeps nothing of
# Newton but one login section in /etc/config/rpcd.
action_no_install() {
	local out='' line='' group='' absent_group='' cert_value='' https_value=''
	local pin='' hash='' password='' pwfile='' host='' port='' verify_out=''
	local delete_flag='keep' rc=0
	require_known_hosts
	# step 1: the device is an OpenWrt router without Newton's program
	if [[ "$DEV_PLATFORM" != "openwrt" ]]; then
		STATE_NOTE='router unchanged'
		stopped "this device is not an OpenWrt router; the no-install mode is for OpenWrt"
	fi
	# ADR-021 point 9: the two access modes side by side, before the
	# router is touched at all.  The offer of the installed mode comes
	# at the end of the run, but the side-by-side is shown once, here.
	access_modes_notes
	# The footprint check runs on EVERY no-install run, whatever the
	# inventory says: a device the inventory already calls "no-install"
	# can still hold Newton's program.  0 = the program is there, 1 = it
	# is not there, anything else (a dead ssh, a timeout) = the router
	# could not be read.  A failure is never read as "not installed":
	# that would let the no-install mode sit next to an installed Newton.
	router_has_file "$R_PROG"
	rc=$?
	case "$rc" in
		0)
			STATE_NOTE='router unchanged'
			stopped "Newton is installed on this router; run ${BT}uninstall${BT} first, then ${BT}no-install${BT}"
			;;
		1) : ;;
		*)
			STATE_NOTE='router unchanged'
			stopped "cannot check the router"
			;;
	esac
	pass "no-install step 1: the device is an OpenWrt router without Newton's program"
	noinstall_old_plain_key_notice
	# step 2: no apply is pending on the router
	out=$(rpcd_apply_pending)
	rc=$?
	case "$rc" in
		0)
			STATE_NOTE='router unchanged'
			stopped "$(rpcd_pending_window_message "$out" 'an apply is pending on the router (LuCI or Newton); wait for it to finish')"
			;;
		2)
			STATE_NOTE='router unchanged'
			stopped "cannot read the pending-apply state of the router"
			;;
	esac
	pass "no-install step 2: no apply is pending on the router"
	# step 3: the router has an HTTPS web interface
	out=$(rpcd_https_probe) || {
		STATE_NOTE='router unchanged'
		stopped "cannot read the web interface of the router"
	}
	while IFS= read -r line; do
		case "$line" in
			https=*) https_value="${line#https=}" ;;
			cert=*) cert_value="${line#cert=}" ;;
		esac
	done <<<"$out"
	if [[ -z "$https_value" ]]; then
		STATE_NOTE='router unchanged'
		stopped "the router has no HTTPS web interface. Install the luci-ssl package on the router (System > Software in LuCI, or ${BT}apk add luci-ssl${BT}), then run this again."
	fi
	valid_path_chars "$cert_value" || {
		STATE_NOTE='router unchanged'
		stopped "the router named a certificate path Newton cannot read"
	}
	rsh_admin "test -f '${RR}${cert_value}'" </dev/null 2>/dev/null
	rc=$?
	if [[ $rc -ne 0 ]]; then
		STATE_NOTE='router unchanged'
		if [[ $rc -eq 1 ]]; then
			stopped "the router has no HTTPS web interface. Install the luci-ssl package on the router (System > Software in LuCI, or ${BT}apk add luci-ssl${BT}), then run this again."
		else
			stopped "cannot read the certificate file of the router"
		fi
	fi
	pass "no-install step 3: the router has an HTTPS web interface"
	# step 4: the router has the LuCI groups Newton needs
	rpcd_groups
	out=$(rpcd_groups_check) || {
		STATE_NOTE='router unchanged'
		stopped "cannot read the ACL groups of the router"
	}
	while IFS= read -r line; do
		case "$line" in
			"group="*" missing")
				group="${line#group=}"
				group="${group% missing}"
				absent_group="$group"
				;;
		esac
	done <<<"$out"
	if [[ -n "$absent_group" ]]; then
		STATE_NOTE='router unchanged'
		stopped "this router lacks LuCI's ${absent_group} group; no-install needs LuCI"
	fi
	pass "no-install step 4: the router has the LuCI groups Newton needs"
	# step 5: the login section is free, or it is Newton's own
	out=$(rpcd_sections_probe) || {
		STATE_NOTE='router unchanged'
		stopped "cannot read the router's rpcd config"
	}
	if ! rpcd_sections_scan <<<"$out"; then
		STATE_NOTE='router unchanged'
		stopped "the rpcd config of the router is not readable"
	fi
	if [[ "$RPCD_FOREIGN" -eq 1 ]]; then
		STATE_NOTE='router unchanged'
		stopped "another login section on this router uses the username ${RPCD_USER_NAME}; Newton never overwrites it"
	fi
	if [[ "$RPCD_PRESENT" -eq 1 && "$RPCD_OURS" -ne 1 ]]; then
		STATE_NOTE='router unchanged'
		stopped "the rpcd.${RPCD_SECTION} section on this router is not Newton's; Newton never overwrites it"
	fi
	if [[ "$RPCD_OURS" -eq 1 ]]; then
		info "re-setup: the rpcd.${RPCD_SECTION} login section is Newton's own; it gets a new password and a new pin"
		delete_flag='delete'
	fi
	pass "no-install step 5: the login section is free (or is Newton's own)"
	# step 6: the pin of the web certificate, read over the admin lane
	if ! rsh_admin "cat '${RR}${cert_value}'" >"${TMP_DIR}/router-cert" 2>/dev/null; then
		STATE_NOTE='router unchanged'
		stopped "cannot read the web certificate of the router"
	fi
	if [[ ! -s "${TMP_DIR}/router-cert" ]]; then
		STATE_NOTE='router unchanged'
		stopped "the web certificate of the router is empty"
	fi
	pin=$("$RPCD" pin "${TMP_DIR}/router-cert" 2>/dev/null) || {
		STATE_NOTE='router unchanged'
		stopped "cannot read the web certificate of the router"
	}
	pin="${pin%%$'\n'*}"
	valid_pin "$pin" || {
		STATE_NOTE='router unchanged'
		stopped "the web certificate of the router has no usable pin"
	}
	pass "no-install step 6: the certificate pin is ready"
	# step 7: the password (on the host) and its hash (on the router)
	command -v openssl >/dev/null 2>&1 || {
		STATE_NOTE='router unchanged'
		stopped "openssl is not on this host; Newton cannot make the rpcd password hash"
	}
	password=$(rpcd_password_new) || {
		STATE_NOTE='router unchanged'
		stopped "openssl could not make a random rpcd password"
	}
	hash=$(printf '%s' "$password" | rpcd_hash) || {
		STATE_NOTE='router unchanged'
		stopped "openssl could not make the rpcd password hash"
	}
	pwfile=$(rpcd_password_file)
	if ! rpcd_password_file_write "$password"; then
		STATE_NOTE='router unchanged'
		stopped "cannot write the rpcd password file"
	fi
	password=''
	pass "no-install step 7: the rpcd password is ready (only its hash goes to the router)"
	# step 8: the login section on the router
	if ! rpcd_write_section "$hash" "$delete_flag"; then
		STATE_NOTE="the rpcd.${RPCD_SECTION} login section may be partly written; run uninstall"
		stopped "no-install step 8 failed"
	fi
	pass "no-install step 8: the login section is written"
	# step 9: the login works over HTTPS
	host=$(rpcd_https_host)
	port=$(rpcd_https_port)
	if ! verify_out=$("$RPCD" verify --host "$host" --port "$port" \
		--pin "$pin" --password-file "$pwfile" 2>&1); then
		fail "the newton login does not work over HTTPS: $(escape_text "$verify_out")"
		# the state line says what is true: the login is gone, or it may
		# still be there.  The router is never "as it was": the section
		# was Newton's own (a re-setup deleted it), so it is gone.
		if rpcd_remove_section && rpcd_section_absent; then
			STATE_NOTE="the newton login was removed; run no-install again"
		else
			STATE_NOTE="the newton login may still be on the router; run uninstall"
		fi
		stopped "the newton login does not work over HTTPS"
	fi
	pass "no-install step 9: the login works over HTTPS"
	# step 10: the inventory
	if ! inventory_set_noinstall "$DEVICE" "$pwfile" "$pin"; then
		# a login the inventory does not name is a login no action of
		# Newton would remove: take it back off the router, as step 9
		# does, and the password file with it.
		fail "cannot edit the inventory safely: ${INVENTORY}"
		if rpcd_remove_section && rpcd_section_absent; then
			# a re-setup keeps the password file: the inventory still
			# names it, and an entry whose file is gone is one the
			# server refuses
			if [[ "$DEV_ACCESS" == "no-install" ]]; then
				STATE_NOTE="the newton login was removed; fix the inventory, then run no-install again"
			elif rm -f -- "$pwfile"; then
				STATE_NOTE="the newton login was removed; fix the inventory, then run no-install again"
			else
				fail "the rpcd password file is still on this host: ${pwfile}"
				STATE_NOTE="the newton login was removed; the rpcd password file is still on this host"
			fi
		else
			STATE_NOTE="the newton login may still be on the router and the inventory does not name it; fix the inventory, run no-install again, then uninstall"
		fi
		stopped "no-install step 10 failed"
	fi
	pass "no-install step 10: the inventory says access = no-install"
	# step 11: the approval passphrase.  It is host-only work (decision
	# D1): the passphrase is asked with the rules of the installed
	# approval step and the fingerprint is written on this host.
	# Nothing goes on the router for it.
	approval_key_no_install_step
	# step 12: the offer of the installed mode (ADR-021 point 1).  The
	# owner is asked once; a "no" is remembered and is not asked again.
	# The side-by-side of the two modes was already shown at the start
	# of the run, before the router was touched: it is shown once.
	installed_offer_step
	done_line
}

# Contract: action_offer_installed -- the offer of the installed mode on
# its own (ADR-021 point 1): a no-install device only, an installed
# device is refused with one plain line.  The question is the same one
# the no-install setup asks at its end, and the answer is recorded the
# same way.  The action is host-only work: it edits the inventory on
# this host and asks the owner; the router is never touched.
action_offer_installed() {
	if [[ "$DEV_ACCESS" != "no-install" ]]; then
		STATE_NOTE='router unchanged'
		stopped "this device uses installed access; there is nothing to offer"
	fi
	access_modes_notes
	installed_offer_question
	done_line
}

# Contract: uninstall_no_install -- the no-install teardown of ADR-021
# point 8: five numbered steps, each one a PASS line, stopping at the
# first failure with the state of the router named; the login section,
# the rpcd sessions of the newton user, the proof that the login is
# refused and the host-side files and inventory fields are removed.
# Contract: owner_scripts_dir_exists -- exit 0 when the host-side state
# directory holds an owner-scripts directory, else exit 1.  The owner
# scripts, their backups and their plan records stay until the device's
# uninstall removes them (decision 8), so the uninstall only asks for
# the cleanup when there is something to clean.
owner_scripts_dir_exists() {
	local state=''
	state=$(state_dir) || return 1
	[[ -d "${state}/owner-scripts" ]]
}

# Contract: action_owner_run -- the owner script run.  The
# plan, the script and the approval are checked by newton-rpcd (the
# approval is asked for there, in this one command), the script goes to
# the router over the admin lane with the fixed remote command `sh -s`
# and nothing but the script on stdin, and the run ends with the
# read-back.  Five numbered lines are printed: one before the script
# goes out, three while it runs, one after the read-back.
action_owner_run() {
	local state='' script='' fifo='' pid=0 rc=0 reached='no' line='' window='' token='' stopped_before=''
	state=$(state_dir) || exit 2
	script="${state}/owner-scripts/${OWNER_SID}/script.sh"
	if [[ "$OWNER_PRINT" -eq 1 ]]; then
		# --print shows the script and the hash of its bytes; nothing is
		# sent to the router, no approval is claimed, nothing changes.
		"$RPCD" owner-print "$DEVICE" "$OWNER_SID"
		return $?
	fi
	# step 1: the plan, the script and the approval.  This command asks
	# the owner for the approval, so it runs in the foreground: its
	# questions and its plan reach the terminal the owner is sitting at.
	if ! "$RPCD" owner-check "$DEVICE" "$OWNER_SID"; then
		STATE_NOTE='router unchanged'
		stopped "the owner script was not checked; nothing was sent to the router"
	fi
	# The script has not been sent yet.  A stop from here on settles the
	# approval as "not reached" and clears the start of the run, so the
	# plan may be aborted; once the script is sent, the read-back reads
	# the router over HTTPS and decides what it did with the change.
	OWNER_SCRIPT_SENT=0
	# step 2: the router password comes after the approval, never before
	# it, so the two prompts never mix.
	if [[ "$ADMIN_MODE" == "password" ]]; then
		admin_password_get
	fi
	# step 3: the script goes to the router.  The lines the script prints
	# are mapped to the owner's lines as they arrive.
	fifo="${TMP_DIR}/owner-script.out"
	mkfifo -m 600 -- "$fifo" || die "cannot create the fifo for the owner script"
	OWNER_SCRIPT_SENT=1
	rsh_owner_script "$script" >"$fifo" &
	pid=$!
	while IFS= read -r line || [[ -n "$line" ]]; do
		case "$line" in
			NEWTON-APPLYING*)
				reached='yes'
				;;
			NEWTON-CHECKED*)
				printf '[2/5] router unchanged since the plan, nothing pending\n'
				;;
			NEWTON-STAGED*)
				printf '[3/5] change staged in a private session (nothing changed yet)\n'
				;;
			NEWTON-NOTE:*)
				# the router has an empty leftover of a refused change:
				# it does not block Newton, and nothing removes it
				note "${line#NEWTON-NOTE: }"
				;;
			NEWTON-APPLIED*)
				window="${line#*window=}"
				window="${window%% *}"
				[[ "$window" =~ ^[0-9]+$ ]] || window='?'
				# The session the script opened is a confirm-only
				# token.  It is never printed, never in the argv,
				# the environment, a file or a log: it goes to the
				# read-back on stdin, and nowhere else.
				token=''
				case "$line" in
					*" session="*)
						token="${line#* session=}"
						token="${token%% *}"
						;;
				esac
				[[ "$token" =~ ^[0-9a-f]{32}$ ]] || token=''
				printf '[4/5] APPLIED. Undo timer: %s s. Newton is checking now.\n' "$window"
				;;
			NEWTON-STOP:*)
				if [[ "$reached" == "no" ]]; then
					# The stop came before the NEWTON-APPLYING line:
					# the script stopped before it touched
					# anything, so the change never reached the
					# router.  It is the only stop that proves
					# that: every other stop of the script comes
					# after the applying line.
					stopped_before="${line#NEWTON-STOP: }"
				fi
				printf '%s\n' "${line#NEWTON-STOP: }"
				;;
		esac
	done <"$fifo"
	wait "$pid"
	rc=$?
	rm -f -- "$fifo"
	# The script was sent to the router, so from here on the READ-BACK
	# decides: the host cannot prove from the exit status of the lane
	# that the script did nothing on the router.  The read-back runs
	# for every exit of the lane, and the approval is spent: the token
	# may have reached the router.
	#
	# The one exception is the script's own precondition stop: it is
	# printed before the NEWTON-APPLYING line, so it proves the script
	# stopped before it touched anything.  Then the change never
	# reached the router, the approval is restored and the owner may
	# run the plan again.
	if [[ "$reached" == "no" && -n "$stopped_before" ]]; then
		note "the script stopped before it touched anything: $stopped_before"
	else
		reached='yes'
		if [[ $rc -eq 255 || $rc -eq 124 ]]; then
			# The lane died: the login failed, or the lane timed out.
			report_admin_login_failure
			note "the lane to the router was lost; the change may be live, so Newton reads it back"
		fi
	fi
	# step 4: the read-back and the verdict.
	if ! owner_finish_run "$token" "$reached"; then
		# the read-back ran and could not decide: it must not run again
		OWNER_SCRIPT_SENT=2
		STATE_NOTE='the change may still be waiting for confirmation'
		stopped "Newton could not read the change back"
	fi
	# the read-back ran: the cleanup of an exit must not run it again
	OWNER_SCRIPT_SENT=2
}

# Contract: owner_finish_run TOKEN REACHED -- the read-back of a run.
# The session the script opened comes in on STDIN: it is a confirm-only
# token, and it must never reach the argv, the environment, a file or a
# log.  Without a token there is nothing that may confirm the change,
# and the read-back runs without one.
owner_finish_run() {
	local token="${1:-}" reached="${2:-no}"
	if [[ -n "$token" ]]; then
		printf '%s\n' "$token" | "$RPCD" owner-finish "$DEVICE" "$OWNER_SID" --reached "$reached"
		return $?
	fi
	"$RPCD" owner-finish "$DEVICE" "$OWNER_SID" --reached "$reached" </dev/null
}

# Contract: action_owner_finish -- the read-only re-check of a run: the
# router is read again and the verdict is printed.  No script is sent
# and nothing is written to the router.  The approval of the run is
# settled as spent (--reached yes): the script reached the router in the
# run this re-check belongs to, and an approval is never reused.
action_owner_finish() {
	# The re-check only reads and reports: it takes no session, so it
	# reads nothing from stdin (the owner's terminal stays his).
	"$RPCD" owner-finish "$DEVICE" "$OWNER_SID" --reached yes </dev/null
}

uninstall_no_install() {
	local out='' line='' sid='' host='' port='' count=0 rc=0 pwfile=''
	require_known_hosts
	# step 1: no apply is pending (a teardown must not drop an undo)
	out=$(rpcd_apply_pending)
	rc=$?
	case "$rc" in
		0)
			STATE_NOTE='router unchanged'
			stopped "$(rpcd_pending_window_message "$out" 'an rpcd restart or a teardown now could drop the pending undo')"
			;;
		2)
			STATE_NOTE='router unchanged'
			stopped "cannot read the pending-apply state of the router"
			;;
	esac
	pass "uninstall step 1: no apply is pending on the router"
	# step 2: the login section
	out=$(rpcd_sections_probe) || {
		STATE_NOTE='router unchanged'
		stopped "cannot read the router's rpcd config"
	}
	if ! rpcd_sections_scan <<<"$out"; then
		STATE_NOTE='router unchanged'
		stopped "the rpcd config of the router is not readable"
	fi
	if [[ "$RPCD_PRESENT" -eq 1 ]]; then
		if [[ "$RPCD_OURS" -ne 1 ]]; then
			STATE_NOTE='router unchanged'
			stopped "the rpcd.${RPCD_SECTION} section on this router is not Newton's; Newton never touches it"
		fi
		if ! rpcd_remove_section; then
			STATE_NOTE="the rpcd.${RPCD_SECTION} login section may still be there; run uninstall again"
			stopped "uninstall step 2 failed"
		fi
		# the removal is proved with the probe, not assumed: the
		# commands that removed it are not a proof
		if ! rpcd_section_absent; then
			STATE_NOTE="the rpcd.${RPCD_SECTION} login section may still be there; run uninstall again"
			stopped "uninstall step 2 failed"
		fi
		pass "uninstall step 2: the login section is gone"
	else
		pass "uninstall step 2: nothing to remove"
	fi
	# step 3: the rpcd sessions of the newton user
	out=$(rpcd_sessions) || {
		STATE_NOTE="the login section is gone; the rpcd sessions could not be read"
		stopped "uninstall step 3 failed: cannot list sessions"
	}
	# A failed destroy is a stop, with one exception: a listed session
	# can time out on its own before the destroy reaches it (rpcd then
	# answers "Not found", seen live on Pulsar).  The ubus command exits
	# 252 for it (measured on Pulsar, 2026-11-02).  That one is the
	# expiry race and it is ignored; every other failed destroy stops the
	# run, because the session may still be usable.  The re-listing below
	# is the proof that no session is left.
	while IFS= read -r sid; do
		[[ -n "$sid" ]] || continue
		rc=0
		rpcd_destroy_session "$sid" || rc=$?
		if [[ "$rc" -ne 0 && "$rc" -ne 252 ]]; then
			STATE_NOTE="the login section is gone; a rpcd session of the newton user could not be destroyed"
			stopped "uninstall step 3 failed"
		fi
	done <<<"$out"
	out=$(rpcd_sessions) || {
		STATE_NOTE="the login section is gone; the rpcd sessions could not be read"
		stopped "uninstall step 3 failed"
	}
	count=$(printf '%s' "$out" | grep -c '[^[:space:]]' || true)
	if [[ "$count" != "0" ]]; then
		STATE_NOTE="the login section is gone; ${count} rpcd session(s) are still there"
		stopped "uninstall step 3 failed"
	fi
	pass "uninstall step 3: no rpcd session of the newton user is left"
	# step 4: the proof that the login is refused
	if [[ -n "$DEV_HTTPS_SPKI" && -n "$DEV_RPCD_PASSWORD_FILE" ]]; then
		if [[ -f "$DEV_RPCD_PASSWORD_FILE" ]]; then
			host=$(rpcd_https_host)
			port=$(rpcd_https_port)
			if ! "$RPCD" verify-refused --host "$host" --port "$port" \
				--pin "$DEV_HTTPS_SPKI" \
				--password-file "$DEV_RPCD_PASSWORD_FILE" >/dev/null 2>&1; then
				STATE_NOTE="the login section is gone; the login was still accepted"
				stopped "the newton login still works"
			fi
			pass "uninstall step 4: the login is refused"
		else
			info "the password file is gone; the login proof was skipped"
		fi
	else
		info "no pin or no password file in the inventory; the login proof was skipped"
	fi
	# step 5: the owner scripts of THIS device: the script, the backup
	# and the run record of every owner plan of this device, and only of
	# this device (decision 8: they stay until the uninstall).  This runs
	# before the inventory fields are removed, so the device is still
	# known to be a no-install one.
	if owner_scripts_dir_exists; then
		out=$("$RPCD" owner-cleanup "$DEVICE") || {
			STATE_NOTE="the router is clean; the owner scripts of this device are still on this host"
			stopped "uninstall step 5 failed: cannot remove the owner scripts"
		}
		while IFS= read -r line; do
			[[ -n "$line" ]] || continue
			printf '%s\n' "$line"
		done <<<"$out"
		pass "uninstall step 5: the owner scripts of this device are gone"
	fi
	# step 6: the host-side files and the inventory fields
	# The inventory goes first: while it names the password file, the
	# file stays, so a stop here never leaves an entry the loaders
	# refuse (a no-install entry whose password file is gone).
	pwfile=$(rpcd_password_file)
	if ! inventory_remove_noinstall "$DEVICE"; then
		STATE_NOTE="the router is clean; the inventory was NOT updated and the password file is still on this host"
		stopped "cannot edit the inventory safely; remove the 'access', 'rpcd_password_file', 'https_spki' and 'installed_offer' lines of ${DEVICE} by hand: ${INVENTORY}"
	fi
	if ! rm -f -- "$pwfile"; then
		fail "the rpcd password file is still on this host: ${pwfile}"
		STATE_NOTE="the router is clean and the inventory is updated; the rpcd password file is still on this host"
		stopped "cannot remove the rpcd password file: ${pwfile}"
	fi
	pass "uninstall step 6: the host files are gone and the no-install mode is over"
	done_line
}

# Contract: main "$@" -- init, parse_args, load_inventory,
# refuse_no_install_action, choose_admin_path,
# then for every ACTION except `check` calls require_known_hosts first
# (so a missing known_hosts file ends with exit 2 and no password
# prompt), and then for EVERY action prefetches the admin password in
# the parent shell when ADMIN_MODE is `password` (the prompt must run in
# the parent shell, never inside `$(...)` so that the typed-input
# stream stays in sync for the action's later captured ssh calls);
# `check` skips the known_hosts prerequisite because its first admin
# call uses accept-new and learns the host key; dispatches to
# action_<name>; the exit status is the action's.
main() {
	local host_only=0
	init
	parse_args "$@"
	load_inventory "$DEVICE"
	refuse_no_install_action
	# The approval key of a no-install device is host-only work (decision
	# D1): it needs no admin lane, no host key and no router at all, so
	# the admin path is not chosen for it.
	if [[ "$ACTION" == "approval-key" && "$DEV_ACCESS" == "no-install" ]]; then
		host_only=1
	fi
	# The offer of the installed mode is host-only work too:
	# it edits the inventory on this host and asks the owner a question;
	# the router is never touched, so no admin lane and no host key are
	# needed for it.
	if [[ "$ACTION" == "offer-installed" ]]; then
		host_only=1
	fi
	if [[ "$host_only" -eq 0 ]]; then
		choose_admin_path
	fi
	validate_action_args
	if [[ "$host_only" -eq 0 && "$ACTION" != "check" && "$ACTION" != "owner-finish" ]]; then
		require_known_hosts
	fi
	if [[ "$host_only" -eq 0 && "$ADMIN_MODE" == "password" ]]; then
		case "$ACTION" in
			owner-run)
				# The owner script asks for Newton's own approval
				# first (in newton-rpcd owner-check), so the router
				# password prompt must not come before it.
				;;
			owner-finish)
				# A read-only re-check: it talks to the router over
				# the pinned HTTPS of the rpcd login, never over ssh,
				# so it asks for no password at all.
				;;
			*)
				admin_password_get
				;;
		esac
	fi
	local fn="action_${ACTION//-/_}"
	"$fn"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
