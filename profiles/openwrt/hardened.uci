# GENERATED by profiles/build.py from manifest.toml: do not edit
# tier: hardened
# lab-bound batches (lab-r1 names, not portable): OW-MGMT-02, OW-NTP-01, OW-ZONE-02, OW-DNS-06, OW-DHCP-01, OW-LOG-01
# conditional batches (commented out below, need a package): OW-FW-06 (miniupnpd-nftables)

# OW-MGMT-01 SSH on LAN only
set dropbear.@dropbear[0].Interface='lan'

# OW-MGMT-02 LuCI/uhttpd on LAN only
# lab-bound: names an interface, zone or address that exists only on lab-r1
delete uhttpd.main.listen_http
add_list uhttpd.main.listen_http='10.109.0.11:80'
delete uhttpd.main.listen_https
add_list uhttpd.main.listen_https='10.109.0.11:443'

# OW-MGMT-03 HTTPS redirect
set uhttpd.main.redirect_https='1'

# OW-FW-01 WAN zone input/forward DROP (default on stock is input REJECT, forward DROP)
set firewall.{fw_wan_zone}.input='DROP'

# OW-FW-02 SYN flood protection
set firewall.@defaults[0].synflood_protect='1'

# OW-FW-03 Drop invalid packets
set firewall.@defaults[0].drop_invalid='1'

# OW-FW-06 UPnP/NAT-PMP off
# conditional: needs package miniupnpd-nftables; not applied by this file
# set upnpd.config.enabled='0'

# OW-DNS-01 Rebind protection
set dhcp.@dnsmasq[0].rebind_protection='1'
set dhcp.@dnsmasq[0].rebind_localhost='0'

# OW-DNS-02 Resolver LAN-only
set dhcp.@dnsmasq[0].localservice='1'
set dhcp.@dnsmasq[0].nonwildcard='1'

# OW-DNS-03 Query hygiene
set dhcp.@dnsmasq[0].domainneeded='1'
set dhcp.@dnsmasq[0].boguspriv='1'

# OW-DHCP-02 Rogue DHCP guard: DHCP never offered on WAN
set dhcp.wan.ignore='1'

# OW-NTP-01 Local NTP, restricted
# lab-bound: names an interface, zone or address that exists only on lab-r1
set system.ntp.use_dhcp='0'
set system.ntp.enable_server='1'
set system.ntp.interface='lab'
delete system.ntp.server
add_list system.ntp.server='time.cloudflare.com'
add_list system.ntp.server='time.google.com'
add_list system.ntp.server='pool.ntp.org'

# OW-V6-04 RA/DHCPv6 not served on WAN, guest and IoT unless needed
set dhcp.wan.ra='disabled'
set dhcp.wan.dhcpv6='disabled'

# OW-MGMT-05 SSH brute-force limits
set dropbear.@dropbear[0].MaxAuthTries='3'
set dropbear.@dropbear[0].IdleTimeout='600'

# OW-MGMT-07 Console login required
set system.@system[0].ttylogin='1'

# OW-MGMT-09 LuCI session lifetime
set luci.sauth.sessiontime='600'

# OW-FW-04 Block WAN ping
set firewall.{fw_allow_ping}.enabled='0'

# OW-FW-07 Anti-spoof / bogon block on WAN
set firewall.bogon_wan=rule
set firewall.bogon_wan.name='Drop-Bogon-WAN'
set firewall.bogon_wan.src='wan'
set firewall.bogon_wan.proto='all'
set firewall.bogon_wan.target='DROP'
add_list firewall.bogon_wan.src_ip='10.0.0.0/8'
add_list firewall.bogon_wan.src_ip='172.16.0.0/12'
add_list firewall.bogon_wan.src_ip='192.168.0.0/16'
add_list firewall.bogon_wan.src_ip='169.254.0.0/16'

# OW-FW-08 Default-deny outbound from IoT/guest (see ZONE-02)
# no lines of its own: the change is in OW-ZONE-02 (same scenario)

# OW-FW-09 Firewall logging of drops
set firewall.{fw_wan_zone}.log='1'
set firewall.{fw_wan_zone}.log_limit='10/minute'

# OW-ZONE-02 IoT zone isolated, no inbound from IoT to LAN, LAN->IoT allowed
# lab-bound: names an interface, zone or address that exists only on lab-r1
set network.iot=interface
set network.iot.proto='static'
set network.iot.device='{lan_device}.40'
set network.iot.ipaddr='192.168.40.1'
set network.iot.netmask='255.255.255.0'
set dhcp.iot=dhcp
set dhcp.iot.interface='iot'
set dhcp.iot.start='100'
set dhcp.iot.limit='100'
set dhcp.iot.leasetime='1h'
set firewall.iot_zone=zone
set firewall.iot_zone.name='iot'
set firewall.iot_zone.network='iot'
set firewall.iot_zone.input='REJECT'
set firewall.iot_zone.output='ACCEPT'
set firewall.iot_zone.forward='REJECT'
set firewall.lab_iot=forwarding
set firewall.lab_iot.src='lab'
set firewall.lab_iot.dest='iot'
set firewall.iot_dhcp=rule
set firewall.iot_dhcp.name='Allow-IoT-DHCP'
set firewall.iot_dhcp.src='iot'
set firewall.iot_dhcp.proto='udp'
set firewall.iot_dhcp.dest_port='67'
set firewall.iot_dhcp.target='ACCEPT'
set firewall.iot_dns=rule
set firewall.iot_dns.name='Allow-IoT-DNS'
set firewall.iot_dns.src='iot'
set firewall.iot_dns.proto='tcp udp'
set firewall.iot_dns.dest_port='53'
set firewall.iot_dns.target='ACCEPT'

# OW-DNS-06 Force LAN DNS through router
# lab-bound: names an interface, zone or address that exists only on lab-r1
set firewall.dns_redirect=redirect
set firewall.dns_redirect.name='Redirect-DNS'
set firewall.dns_redirect.src='lab'
set firewall.dns_redirect.target='DNAT'
set firewall.dns_redirect.proto='tcp udp'
set firewall.dns_redirect.src_dport='53'
set firewall.dns_redirect.dest_port='53'
set firewall.dns_redirect.family='any'

# OW-DHCP-01 Small DHCP pool and lease time, static leases for known devices
# lab-bound: names an interface, zone or address that exists only on lab-r1
set dhcp.lab.limit='50'

# OW-LOG-01 Remote syslog
# lab-bound: names an interface, zone or address that exists only on lab-r1
set system.@system[0].log_ip='{client_lab_ip}'
set system.@system[0].log_port='514'
set system.@system[0].log_proto='udp'
set system.@system[0].log_remote='1'

# OW-LOG-02 Log buffer size
set system.@system[0].log_size='512'
