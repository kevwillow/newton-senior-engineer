# OpenWrt openvpn config (uci file form). All secrets are obvious placeholders.
config openvpn 'fakevpn'
	option enabled '1'
	option config '/etc/openvpn/fakevpn.conf'
	option dev 'tun0'
	option proto 'udp'
	option secret 'fake-openvpn-shared-secret-xyz123'
	option tls_auth '/etc/openvpn/ta.key'
	option auth_user_pass '/etc/openvpn/auth.user'
	option password 'fake-openvpn-token-value-abc456'
	option shared_key 'fake-openvpn-tls-auth-static-key-value-789'
	option cipher 'AES-256-CBC'
	option auth 'SHA256'
	option comp_lzo 'adaptive'