      "filter": "(objectClass=*)",
      "attrs": [
        "dSHeuristics",
        "tombstoneLifetime",
        "distinguishedName"
      ],
      "binary": [],
      "ranged": [],
      "sd": false,
      "limit": 1,
      "presence_only": false
    },
