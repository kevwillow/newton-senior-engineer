      ],
      "binary": [
        "msDS-OptionalFeatureGUID"
      ],
      "ranged": [],
      "sd": false,
      "limit": 100,
      "presence_only": false
    },
    {
      "id": "partitions",
      "base": "CN=Partitions,{config}",
      "scope": "base",
      "filter": "(objectClass=*)",
      "attrs": [
        "msDS-Behavior-Version",
        "distinguishedName"
      ],
      "binary": [],
      "ranged": [],
      "sd": false,
      "limit": 1,
      "presence_only": false
    },
    {
