{
  "v": 1,
  "queries": [
    {
      "id": "domain_head",
      "base": "{domain}",
      "scope": "base",
      "filter": "(objectClass=*)",
      "attrs": [
        "objectSid",
        "ms-DS-MachineAccountQuota",
        "msDS-Behavior-Version",
        "minPwdLength",
        "pwdHistoryLength",
        "maxPwdAge",
        "minPwdAge",
        "pwdProperties",
        "lockoutThreshold",
        "lockoutDuration",
        "lockOutObservationWindow",
        "gPLink",
        "fSMORoleOwner",
        "distinguishedName"
      ],
      "binary": [
        "objectSid"
      ],
      "ranged": [],
      "sd": true,
      "limit": 1,
      "presence_only": false
    },
    {
      "id": "users",
      "base": "{domain}",
      "scope": "sub",
      "filter": "(&(objectCategory=person)(objectClass=user))",
      "attrs": [
        "sAMAccountName",
        "objectSid",
        "userAccountControl",
        "pwdLastSet",
        "lastLogonTimestamp",
        "servicePrincipalName",
        "adminCount",
        "primaryGroupID",
        "msDS-SupportedEncryptionTypes",
        "accountExpires",
        "sIDHistory",
        "whenCreated",
        "distinguishedName"
      ],
      "binary": [
        "objectSid",
        "sIDHistory"
      ],
      "ranged": [],
      "sd": false,
      "limit": 50000,
      "presence_only": false
    },
    {
      "id": "computers",
      "base": "{domain}",
      "scope": "sub",
      "filter": "(objectCategory=computer)",
      "attrs": [
        "sAMAccountName",
        "objectSid",
        "userAccountControl",
        "pwdLastSet",
        "lastLogonTimestamp",
        "servicePrincipalName",
        "primaryGroupID",
        "msDS-AllowedToDelegateTo",
        "msDS-AllowedToActOnBehalfOfOtherIdentity",
        "msDS-SupportedEncryptionTypes",
        "sIDHistory",
        "whenCreated",
        "operatingSystem",
        "operatingSystemVersion",
        "ms-Mcs-AdmPwdExpirationTime",
        "msLAPS-PasswordExpirationTime",
        "distinguishedName"
      ],
      "binary": [
        "objectSid",
        "sIDHistory",
        "msDS-AllowedToActOnBehalfOfOtherIdentity"
      ],
      "ranged": [],
      "sd": false,
      "limit": 50000,
      "presence_only": false
    },
    {
      "id": "groups",
      "base": "{domain}",
      "scope": "sub",
      "filter": "(objectClass=group)",
      "attrs": [
        "sAMAccountName",
        "objectSid",
        "member",
        "groupType",
        "adminCount",
        "sIDHistory",
        "distinguishedName"
      ],
      "binary": [
        "objectSid",
        "sIDHistory"
      ],
      "ranged": [
        "member"
      ],
      "sd": false,
      "limit": 50000,
      "presence_only": false
    },
    {
      "id": "fsps",
      "base": "CN=ForeignSecurityPrincipals,{domain}",
      "scope": "sub",
      "filter": "(objectClass=foreignSecurityPrincipal)",
      "attrs": [
        "objectSid",
        "distinguishedName"
      ],
      "binary": [
        "objectSid"
      ],
      "ranged": [],
      "sd": false,
      "limit": 20000,
      "presence_only": false
    },
    {
      "id": "gmsa",
      "base": "{domain}",
      "scope": "sub",
      "filter": "(objectClass=msDS-GroupManagedServiceAccount)",
      "attrs": [
        "sAMAccountName",
        "objectSid",
        "pwdLastSet",
        "servicePrincipalName",
        "msDS-ManagedPasswordInterval",
        "msDS-GroupMSAMembership",
        "distinguishedName"
      ],
      "binary": [
        "objectSid",
        "msDS-GroupMSAMembership"
      ],
      "ranged": [],
      "sd": false,
      "limit": 5000,
      "presence_only": false
    },
    {
      "id": "kds_root_keys",
      "base": "CN=Master Root Keys,CN=Group Key Distribution Service,CN=Services,{config}",
      "scope": "sub",
      "filter": "(objectClass=msKds-ProvRootKey)",
      "attrs": [
        "msKds-CreateTime",
