def current_time() -> float:
    """The clock of the DC."""
    return time.time()


def _log(message: str) -> None:
    """One line of the log of the helper.

    The line never holds a value of the request and never holds the
    secret.
    """
    print(f"newton-ad-samba-write: {message}", file=sys.stderr)


def do_read(request: Mapping[str, Any]) -> dict[str, Any]:
    """The read mode: what this DC sees (section 6)."""
    directory = bind()
    pdc = directory.holds_pdc_role()
    try:
        ids, live, facts = resolve(directory, str(request["verb"]), request["target"], True, pdc)
    except NotFound:
        return {"v": 1, "code": "not_found"}
    return {"v": 1, "code": "ok", "live": live, "ids": ids, "facts": facts}


def _write_account(directory: Directory) -> Any:
    """The one directory object of the account the helper writes as."""
    found = directory.by_sam(WRITE_ACCOUNT, _ACCOUNT_ATTRS)
    if len(found) != 1:
        raise Refused("error", "the write account is not in the directory")
    return found[0]


def target_is_write_account(
    directory: Directory, ids: Mapping[str, Any]
) -> bool:
    """True when any resolved target object has the write account's SID."""
    write_sid = directory.sid(_write_account(directory))
    if not write_sid:
        raise Refused("error", "the write account has no SID")
    return any(
        isinstance(ids.get(name), str) and ids[name] == write_sid
        for name in ("sid", "group_sid", "member_sid")
    )


def target_is_krbtgt_or_trust(
    directory: Directory, ids: Mapping[str, Any]
) -> bool:
    """True for RID 502, krbtgt names and INTERDOMAIN_TRUST_ACCOUNT."""
    for prefix in ("", "group_", "member_"):
        sam = ids.get(prefix + "sam")
        if isinstance(sam, str):
            lowered = sam.lower()
            if lowered == KRBTGT_SAM or lowered.startswith(RODC_KRBTGT_PREFIX):
                return True
        sid = ids.get(prefix + "sid")
        if isinstance(sid, str) and _rid_of(sid) == KRBTGT_RID:
            return True
        guid = ids.get(prefix + "guid")
        if not isinstance(guid, str):
            continue
        message = directory.by_guid(guid, _ACCOUNT_ATTRS)
        if message is None:
            return True
        control = directory.integer(message, UAC_ATTRIBUTE)
        if control is not None and control & INTERDOMAIN_TRUST_ACCOUNT:
            return True
    return False


def write_account_is_privileged(directory: Directory) -> bool:
    """True when the write account is in a privileged group.

    The tokenGroups of the account are transitive: they hold every group
    the account is a member of, directly or not.  They are read
    base-scoped on the account itself.  The check fails closed: no
    token group at all, an empty list, and a value that is not a SID
    all count as a privileged account.
    """
    dn = directory.dn_of(_write_account(directory))
    message = directory.by_dn(dn, ("tokenGroups",))
    if message is None:
        return True
    values = directory.values(message, "tokenGroups")
    if not values:
        return True
    for raw in values:
        try:
            sid = directory.sid_text(raw)
        except Exception:
            return True
        if sid_is_privileged(sid):
            return True
    return False


def write_after(directory: Directory, request: Mapping[str, Any]) -> str | None:
    """The write of the after-image (step 6 of section 6).

    A user-create answers the name of the object it made.  The name is
    computed before the add: a parent that cannot be read back after the
    add still leaves the owner of the transaction with the name of the
    object to look for.
    """
    verb = str(request["verb"])
    target = request["target"]
    before = request["before"]
    after = request["after"]

    if verb == "user-create":
        parent = directory.by_guid(str(target["parent_guid"]), _GROUP_ATTRS)
        if parent is None:
            raise Refused("not_found", "the parent of the new object is not there")
        sam = str(target["sam"])
        secret = request.get("secret")
        if not isinstance(secret, str):
            raise Refused("schema", "the user-create carries no secret")
        dn = f"CN={sam},{directory.dn_of(parent)}"
        directory.db.add(
            {
                "dn": dn,
                "objectClass": "user",
                "cn": sam,
                "sAMAccountName": sam,
                "userPrincipalName": f"{sam}@{directory.domain_dns_name()}",
                "userAccountControl": "514",
                "unicodePwd": ('"' + secret + '"').encode("utf-16-le"),
            }
        )
        return dn

    if verb in ("member-add", "member-remove"):
        dn = _group_dn(directory, target)
        if dn is None:
            raise Refused("not_found", "the group is not there")
        member = _member_dn(directory, target.get("member_guid"))
        if member is None:
            raise Refused("not_found", "the member is not there")
        if verb == "member-add":
            _modify(directory, dn, MEMBER_ATTRIBUTE, None, member)
        else:
            _modify(directory, dn, MEMBER_ATTRIBUTE, member, None)
        return None

    if verb == "maq":
        _modify(
            directory,
            directory.domain_dn(),
            MAQ_ATTRIBUTE,
            str(before["maq"]).encode("ascii"),
            str(after["maq"]).encode("ascii"),
        )
        return None

    if verb == "move":
        message = _account_message(directory, target)
        if message is None:
            raise Refused("not_found", "the target is not there")
        current_dn = directory.dn_of(message)
        parent = directory.by_guid(str(after["parent"]), _GROUP_ATTRS)
        if parent is None:
            raise Refused("not_found", "the new parent is not there")
        new_dn = split_dn(current_dn)[0] + "," + directory.dn_of(parent)
        try:
            # The move of an object is a rename of it: a modify of the
            # distinguished name answers 53 (measured on Samba 4.22.11,
            # 2026-11-09).
            directory.db.rename(current_dn, new_dn)
        except directory.ldb.LdbError as exc:
            if ldb_code(exc) == error_code(
                directory.ldb, "ERR_NO_SUCH_OBJECT", 32
            ):
                raise Refused("conflict", "the object to move is not there") from None
            raise
        return None

    dn = _account_dn(directory, target)
    if dn is None:
        raise Refused("not_found", "the target is not there")
    if verb in ("uac-clear", "disable", "enable"):
        _modify(
            directory,
            dn,
            UAC_ATTRIBUTE,
            str(before["uac"]).encode("ascii"),
            str(after["uac"]).encode("ascii"),
        )
    elif verb == "enc-types":
        old = before["etypes"]
        new = after["etypes"]
        _modify(
            directory,
            dn,
            ETYPES_ATTRIBUTE,
            None if old == "absent" else str(old).encode("ascii"),
            None if new == "absent" else str(new).encode("ascii"),
        )
    elif verb == "unlock":
        _modify(
            directory,
            dn,
            LOCKOUT_ATTRIBUTE,
            str(before["lockout"]).encode("ascii"),
            str(after["lockout"]).encode("ascii"),
        )
    return None


def read_back(
    directory: Directory,
    request: Mapping[str, Any],
    created: str | None,
) -> dict[str, Any]:
    """The live values of the target after the write (step 7)."""
    verb = str(request["verb"])
    target = request["target"]
    if verb == "user-create":
        return {"object": "present" if created else "absent"}
    if verb in ("member-add", "member-remove"):
        group = directory.by_guid(str(target["group_guid"]), _GROUP_ATTRS)
        member = directory.by_guid(str(target["member_guid"]), _ACCOUNT_ATTRS)
        if group is None or member is None:
            return {}
        present = directory.dn_of(member) in directory.members(group)
        return {"member": "present" if present else "absent"}
    if verb == "maq":
        head = directory.by_dn(directory.domain_dn(), _DOMAIN_ATTRS)
        quota = directory.integer(head, MAQ_ATTRIBUTE) if head is not None else None
        return {"maq": 0 if quota is None else quota}
    message = _account_message(directory, target)
    if message is None:
        return {}
    if verb in ("uac-clear", "disable", "enable"):
        control = directory.integer(message, UAC_ATTRIBUTE)
        return {"uac": 0 if control is None else control}
    if verb == "enc-types":
        types = directory.integer(message, ETYPES_ATTRIBUTE)
        return {"etypes": "absent" if types is None else types}
    if verb == "unlock":
        lockout = directory.integer(message, LOCKOUT_ATTRIBUTE)
        return {"lockout": 0 if lockout is None else lockout}
    if verb == "move":
        parent = directory.by_dn(parent_dn(directory.dn_of(message)), _GROUP_ATTRS)
        return {"parent": directory.guid(parent) if parent is not None else None}
    return {}


def user_create_dn(directory: Directory, request: Mapping[str, Any]) -> str | None:
    """The exact DN passed to the successful user add.

    The answer is None when the parent of the new object cannot be read
    back: the name of the object is then unknown.
    """
    target = request["target"]
    parent = directory.by_guid(str(target["parent_guid"]), _GROUP_ATTRS)
    if parent is None:
        return None
    return f"CN={target['sam']},{directory.dn_of(parent)}"


def read_created(
    directory: Directory,
    request: Mapping[str, Any],
) -> tuple[str | None, str | None]:
    """The guid and the uSNChanged of the object a user-create made."""
    dn = user_create_dn(directory, request)
    if dn is None:
        return None, None
    message = directory.by_dn(dn, _ACCOUNT_ATTRS)
    if message is None:
        return None, None
    return directory.guid(message), directory.text(message, "uSNChanged")


def _settle(
    record: dict[str, Any],
    path: str,
    directory: Directory,
    written: bool,
) -> None:
    """The final state of a record whose run did not finish.

    Nothing was written: the record is refused.  A write happened: the
    undo runs at once, and the record says whether it restored its
    value.
    """
    if written:
        try:
            run_undo(directory, record, path)
            return
        except Exception:
            record["state"] = "undo_failed"
            write_record(path, record)
            return
    record["state"] = "refused"
    write_record(path, record)


def do_apply(request: Mapping[str, Any], now: int) -> dict[str, Any]:
    """The apply mode: the steps of section 6.

    The order of the checks is the one of the steps of ``apply``
    (SPEC-1.4-REQUEST section 6, "Modes and responses"): the rules of
    the schema, then the token, then the expiry, then the replay, then
    the rules of the verb, then the role of this DC, and only then the
    rest; the order of the token, the expiry and the replay inside it
    is the one of section 4, "The digest and the token".  An unsigned
    request learns nothing beyond the schema and the token.
    """
    verb = str(request["verb"])
    if verb == "user-create" and not isinstance(request.get("secret"), str):
        # The secret is part of the schema of a user-create: it is
        # checked before the record is created and before the timer is
        # armed.
        raise Refused("schema", "the user-create carries no secret")

    key = read_key()
    expected = token(key, digest(request), int(request["nbf"]), int(request["exp"]))
    if not hmac.compare_digest(expected, str(request["token"])):
        raise Refused("bad_token", "the token does not match the key")
    if not int(request["nbf"]) - 60 <= now <= int(request["exp"]):
        raise Refused("expired", "the approval is outside the window")

    txid = str(request["txid"])
    path = record_path(txid)
    if os.path.exists(path):
        raise Refused("replay", "the record of the transaction is already there")

    check_verb_rules(request)

    directory = bind()
    pdc = directory.holds_pdc_role()
    if not pdc:
        raise Refused("not_pdc", "this dc does not hold the pdc emulator role")

    record: dict[str, Any] = {
        "v": 1,
        "txid": txid,
        "request": {
            key: value for key, value in request.items() if key not in ("secret", "token")
        },
        "state": "armed",
        "undo_at": now + int(request["window"]),
        "restored": False,
        "conflicts": [],
        "created": None,
        "created_usnchanged": None,
    }
    try:
        create_record(path, record)
    except FileExistsError:
        raise Refused("replay", "the record of the transaction is already there") from None

    written = False
    settled = False
    created_dn: str | None = None
    try:
        try:
            ids, live, facts = resolve(directory, verb, request["target"], False, pdc)
        except NotFound:
            raise Refused("not_found", "the target is not there") from None

        if target_is_write_account(directory, ids):
            raise Refused("denied", "the write account is never a target or member")
        if target_is_krbtgt_or_trust(directory, ids):
            raise Refused("denied", "krbtgt and trust accounts are never written")

        refusal = live_verb_refusal(directory, request, facts)
        if refusal:
            raise Refused(refusal, "the verb does not fit the live object")

        if verb == "move":
            message = _account_message(directory, request["target"])
            if message is None:
                raise Refused("not_found", "the target is not there")
            refusal = move_parents_ok(directory, message, request["after"])
            if refusal:
                raise Refused(refusal, "the parent of the move is refused")

        if write_account_is_privileged(directory):
            raise Refused("privileged", "the write account is in a privileged group")

        derived = derive_risk(verb, facts)
        if derived != request["risk"]:
            raise Refused(
                "risk_mismatch", "the risk of the request is not the derived one"
            )

        if live != request["before"]:
            raise Refused(
                "conflict",
                "the live value is not the before-image",
                {"live": live},
            )

        if verb != "unlock":
            arm_undo(txid, int(request["window"]))

        try:
            created_dn = write_after(directory, request)
        except directory.ldb.LdbError as exc:
            code = map_ldb_error(exc, directory.ldb)
            disarm_undo(txid)
            if code == "conflict":
                raise Refused("conflict", "the old value was stale") from None
            try:
                run_undo(directory, record, path)
            except Exception:
                record["state"] = "undo_failed"
                write_record(path, record)
            settled = True
            raise Refused(code, "the write failed") from None
        written = True

        created: str | None = None
        if verb == "user-create":
            created, usn = read_created(directory, request)
            if not created or not usn:
                # The name of the object the add made is the one the
                # write computed before the add: the parent that cannot
                # be read back does not take it away.
                dn = created_dn
                restored = False
                conflicts: list[str] = []
                if dn is not None:
                    try:
                        directory.db.delete(dn)
                        restored = True
                    except Exception:
                        conflicts.append(dn)
                record["restored"] = restored
                record["conflicts"] = conflicts
                record["state"] = "undone" if restored else "undo_failed"
                # The record is written before the timer is cancelled: a
                # record that cannot be written leaves the undo armed.
                write_record(path, record)
                disarm_undo(txid)
                settled = True
                raise Refused("error", "the undo facts of the new user are missing")
            record["created"] = created
            record["created_usnchanged"] = usn
        if verb == "unlock":
            # An unlock arms no undo (section 3): nothing can put it back,
            # so the transaction is confirmed and the sweep leaves it alone.
            record["state"] = "confirmed"
        after_live = read_back(directory, request, created)
        write_record(path, record)
        settled = True
        answer: dict[str, Any] = {
            "v": 1,
            "code": "ok",
            "live": after_live,
            "undo_at": record["undo_at"],
        }
        if created is not None:
            answer["created"] = created
        return answer
    except Refused:
        if not settled:
            # Nothing was written: the record is refused, never armed.
            # A write that happened is put back at once.
            _settle(record, path, directory, written)
        raise
    except Exception:
        if not settled:
            _settle(record, path, directory, written)
        raise


def do_confirm(request: Mapping[str, Any]) -> dict[str, Any]:
    """The confirm mode (section 6).

    The confirmation is recorded before the timer of the undo is
    cancelled: a confirmation that is not recorded leaves the undo
    armed, and the undo puts the change back.  The cancel comes after
    the record, and a cancel that fails does not change the answer: the
    timer that fires anyway finds a confirmed record and does nothing.
    """
    txid = str(request["txid"])
    path = record_path(txid)
    record = read_record(path)
    if record is None:
        raise Refused("not_found", "there is no record of the transaction")
    if record.get("state") in ("undone", "undo_failed", "refused"):
        raise Refused("conflict", "the transaction is not armed")
    stored = record.get("request")
    if not isinstance(stored, dict):
        raise Refused("error", "the record of the transaction is not usable")
    directory = bind()
    pdc = directory.holds_pdc_role()
    try:
        _ids, live, facts = resolve(
            directory, str(stored["verb"]), stored["target"], False, pdc
        )
    except NotFound:
        raise Refused("conflict", "the target is not there") from None
    if live != stored.get("after"):
        raise Refused("conflict", "the target does not show the after-image")
    record["state"] = "confirmed"
    try:
        write_record(path, record)
    except Exception:
        # The confirmation is not recorded: the timer stays armed and it
        # puts the change back.
        raise Refused("error", "the confirmation could not be recorded") from None
    if not disarm_undo(txid):
        print(
            "the timer of the undo was not cancelled; it will find a"
            " confirmed record and do nothing",
            file=sys.stderr,
        )
    return {"v": 1, "code": "ok"}


def do_abort(request: Mapping[str, Any]) -> dict[str, Any]:
    """The abort mode: the undo runs at once (section 6).

    Only an armed transaction may be aborted: a transaction that is
    confirmed, refused or already undone changes nothing.
    """
    txid = str(request["txid"])
    path = record_path(txid)
    record = read_record(path)
    if record is None:
        raise Refused("not_found", "there is no record of the transaction")
    if record.get("state") != "armed":
        raise Refused("conflict", "the transaction is not armed")
    directory = bind()
    restored, conflicts = run_undo(directory, record, path)
    disarm_undo(txid)
    return {"v": 1, "code": "ok", "restored": restored, "conflicts": conflicts}


def do_status(request: Mapping[str, Any]) -> dict[str, Any]:
    """The status mode (section 6)."""
    txid = str(request["txid"])
    record = read_record(record_path(txid))
    if record is None:
        raise Refused("not_found", "there is no record of the transaction")
    return {
        "v": 1,
        "code": "ok",
        "state": record.get("state"),
        "undo_at": record.get("undo_at"),
        "restored": record.get("restored"),
        "conflicts": list(record.get("conflicts") or []),
    }


def do_undo(txid: str, now: int) -> dict[str, Any]:
    """The undo of one transaction, from the timer."""
    path = record_path(txid)
    record = read_record(path)
    if record is None:
        raise Refused("not_found", "there is no record of the transaction")
    if record.get("state") != "armed":
        return {
            "v": 1,
            "code": "ok",
            "restored": False,
            "conflicts": list(record.get("conflicts") or []),
        }
    directory = bind()
    restored, conflicts = run_undo(directory, record, path)
    return {"v": 1, "code": "ok", "restored": restored, "conflicts": conflicts}


# ---- the entry point --------------------------------------------------------


def _stdin_path(stdin: bytes, env: Mapping[str, str]) -> dict[str, Any]:
    """The way in over stdin (section 1)."""
    if env.get("SUDO_USER") != LOGIN_NAME:
        raise Refused("denied", "the login is not the write login")
    problem = install_problem()
    if problem:
        raise Refused("unavailable", problem)
    if len(stdin) > MAX_REQUEST_BYTES:
        raise Refused("schema", "the request is bigger than 64 KiB")
    request = parse_request(stdin)
    if request["device"] != read_device():
        raise Refused("schema", "the request names another device")
    mode = str(request["mode"])

    lock = StoreLock(lock_path())
    lock.acquire()
    try:
        # The clock is read once the lock is held: the deadline of the
        # undo and the expiry of the approval are the same moment.
        now = int(current_time())
        sweep(now)
        if mode == "read":
            lock.release()
            return do_read(request)
        if mode == "apply":
            return do_apply(request, now)
        if mode == "confirm":
            return do_confirm(request)
        if mode == "abort":
            return do_abort(request)
        return do_status(request)
    finally:
        lock.release()


def _undo_path(argv: Sequence[str], env: Mapping[str, str]) -> dict[str, Any]:
    """The way in for the undo (section 1)."""
    if env.get("SUDO_USER"):
        raise Refused("denied", "the undo never runs through the ssh channel")
    if len(argv) != 2 or argv[0] != "--undo":
        raise Refused("schema", "the helper takes no other argument")
    txid = str(argv[1])
    if TXID_RE.fullmatch(txid) is None:
        raise Refused("schema", "the txid is outside its pattern")
    problem = install_problem()
    if problem:
        raise Refused("unavailable", problem)
    with StoreLock(lock_path()):
        # The clock is read once the lock is held.
        now = int(current_time())
        sweep(now, skip=txid)
        return do_undo(txid, now)


def handle(
    argv: Sequence[str],
    stdin: bytes,
    env: Mapping[str, str],
) -> dict[str, Any]:
    """Answer one request, whatever it is.

    The answer is the document of section 6 and the helper never raises:
    a crash is a refusal with the code ``error``.
    """
    try:
        if argv:
            return _undo_path(argv, env)
        return _stdin_path(stdin, env)
    except Refused as exc:
        _log(f"refused {exc.code}")
        answer: dict[str, Any] = {"v": 1, "code": exc.code}
        answer.update(exc.extra)
        return answer
    except Exception:
        _log("error")
        return {"v": 1, "code": "error"}


def main() -> int:
    """The entry point of the helper."""
    try:
        # one byte more than the limit: the request is too big then
        stdin = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    except Exception:
        stdin = b""
    answer = handle(sys.argv[1:], stdin, os.environ)
    sys.stdout.write(json.dumps(answer, sort_keys=True, separators=(",", ":")) + "\n")
    sys.stdout.flush()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
